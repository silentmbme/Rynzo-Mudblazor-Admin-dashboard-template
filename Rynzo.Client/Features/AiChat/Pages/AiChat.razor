@page "/apps/ai-chat"
@implements IAsyncDisposable
@using Rynzo.Client.Features.AiChat.Models
@using Rynzo.Client.Features.AiChat.Services
@using Rynzo.Client.Features.AiChat.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
<PageTitle>AI Chat | Rynzo</PageTitle>
<div class="ai-chat-app"><div class="chat-page-heading"><PageHeader Title="AI Chat" Description="A focused space for ideas, writing, and everyday questions."><Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="NewChat">New conversation</MudButton></Actions></PageHeader></div><div class="chat-workspace"><aside class="chat-history"><div class="chat-history-brand"><span><MudIcon Icon="@RynzoIcons.Get("Sparkles")" /></span><div><b>Rynzo assistant</b><small>Your creative workspace</small></div></div><MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@RynzoIcons.Get("Plus")" OnClick="NewChat">New conversation</MudButton><h3>Conversations</h3><MudTextField T="string" @bind-Value="_historySearch" Immediate="true" Placeholder="Search conversations" aria-label="Search conversations" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" Class="chat-history-search" /><div class="chat-history-list">@foreach(var conversation in _state.Conversations.Where(c=>c.Title.Contains(_historySearch,StringComparison.OrdinalIgnoreCase))){<button type="button" aria-current="@(conversation.Id==_state.ActiveId?"true":null)" @onclick="@(() => Switch(conversation.Id))"><MudIcon Icon="@RynzoIcons.Get("MessageSquare")" /><span>@conversation.Title</span><MudIcon Icon="@RynzoIcons.Get("ChevronRight")" Class="chat-history-arrow" /></button>}</div><div class="chat-demo-notice"><h4><MudIcon Icon="@RynzoIcons.Get("Bot")" />Local demo mode</h4><p>Preset responses. Conversations stay in this page session.</p></div></aside><section class="chat-main"><header><span><MudIcon Icon="@RynzoIcons.Get("Bot")" /></span><div><h2>@_state.Active.Title</h2><p>Rynzo assistant · Preset demo replies</p></div><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@RynzoIcons.Get("Download")" Disabled="@(_state.Active.Messages.Length==0)" aria-label="Export conversation" OnClick="Export"><span class="chat-export-text">Export</span></MudButton></header><div class="chat-log" role="log" aria-label="Chat messages" aria-live="polite">@if(_state.Active.Messages.Length==0){<div class="chat-welcome"><span><MudIcon Icon="@RynzoIcons.Get("Sparkles")" /></span><small class="chat-welcome-eyebrow">A LITTLE INSPIRATION. A FRESH PERSPECTIVE.</small><h3>What would you like to explore?</h3><p>Start with a sample prompt or write a message below.</p><div class="chat-suggestions">@foreach(var suggestion in _state.Source.Suggestions){<button type="button" @onclick="@(() => Send(suggestion.Prompt))"><span style="@($"color:var({suggestion.Color});background:color-mix(in oklch,var({suggestion.Color}) 12%,transparent)")"><MudIcon Icon="@RynzoIcons.Get(suggestion.Icon)" /></span><h4>@suggestion.Title</h4><p>@suggestion.Prompt</p></button>}</div></div>}else{<div class="chat-message-list">@foreach(var message in _state.Active.Messages){<ChatMessageView @key="message.Id" Message="message" Copied="@(_copied==message.Id)" Copy="Copy" />}</div>}<div @ref="_end"></div></div><form class="chat-composer" @onsubmit="Submit" @onsubmit:preventDefault="true"><input id="@_fileId" type="file" multiple hidden @onchange="@(() => AttachFiles(false))" /><input id="@_imageId" type="file" multiple hidden accept="image/jpeg,image/png,image/webp,image/gif" @onchange="@(() => AttachFiles(true))" />@if(_state.Attachments.Count>0){<div class="chat-draft-attachments">@foreach(var attachment in _state.Attachments){<div>@if(attachment.Kind=="image"){<img src="@attachment.Url" alt="" />}else{<MudIcon Icon="@RynzoIcons.Get("Paperclip")" Color="Color.Primary" />}<span>@attachment.Name</span><MudIconButton Icon="@RynzoIcons.Get("X")" Size="Size.Small" aria-label="@($"Remove attachment {attachment.Name}")" OnClick="@(() => _state.Attachments.RemoveAll(a=>a.Id==attachment.Id))" /></div>}</div>}<div class="chat-composer-input"><textarea @ref="_textarea" aria-label="Message AI assistant" rows="2" maxlength="4000" placeholder="Ask a question…" @bind="_state.Draft" @bind:event="oninput"></textarea><MudIconButton Icon="@RynzoIcons.Get("Send")" Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="@(_state.Draft.Trim().Length==0&&_state.Attachments.Count==0)" aria-label="Send message" /></div><div class="chat-tools"><MudIconButton Icon="@RynzoIcons.Get("Paperclip")" Size="Size.Small" aria-label="Attach file" OnClick="@(() => Choose(false))" /><MudIconButton Icon="@RynzoIcons.Get("Link2")" Size="Size.Small" aria-label="Attach link" OnClick="AttachLink" /><MudIconButton Icon="@RynzoIcons.Get("ImagePlus")" Size="Size.Small" aria-label="Attach image" OnClick="@(() => Choose(true))" /><MudIconButton Icon="@RynzoIcons.Get("Mic")" Size="Size.Small" Color="@(_listening?Color.Error:Color.Default)" aria-label="Voice input" aria-pressed="@(_listening?"true":"false")" OnClick="Voice" />@if(_listening){<span role="status">Listening? click to stop</span>}</div><p class="chat-composer-caption">Demo responses · Enter to send · Shift + Enter for a new line</p></form></section></div></div>
@code{
    private readonly AiChatState _state=new();
    private readonly string _session=Guid.NewGuid().ToString(),_fileId="chat-file-"+Guid.NewGuid().ToString("N"),_imageId="chat-image-"+Guid.NewGuid().ToString("N");
    private string _historySearch="",_linkValue="";
    private string? _copied;
    private bool _listening,_scroll;
    private ElementReference _textarea,_end;
    private IJSObjectReference? _module,_download;
    private DotNetObjectReference<AiChat>? _receiver;
    private sealed record FileResult(ChatAttachment[] Items,string[] Errors);
    private static readonly BreadcrumbItem[] Breadcrumbs=[new("Apps",null),new("AI Chat",null,true)];
    protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender){_module=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-chat-browser.js");_receiver=DotNetObjectReference.Create(this);await _module.InvokeVoidAsync("connect",_session,_receiver,_textarea,_end);_scroll=true;}if(_scroll&&_module is not null){_scroll=false;await _module.InvokeVoidAsync("scroll",_session);}}
    private async Task Abort(){if(_module is not null)await _module.InvokeVoidAsync("abort",_session);}
    private async Task NewChat(){await Abort();_state.NewChat();_scroll=true;}
    private async Task Switch(string id){await Abort();_state.Switch(id);_scroll=true;}
    private Task Submit()=>Send(_state.Draft);
    private async Task Send(string content){if(_state.Send(content)){await Abort();_scroll=true;}}
    [JSInvokable]public async Task SendFromKeyboard(){await Send(_state.Draft);StateHasChanged();}
    private async Task Copy(ChatMessage message){try{if(_module is not null){await _module.InvokeVoidAsync("copy",message.Content);_copied=message.Id;}}catch(JSException){Snackbar.Add("Could not copy the message",Severity.Error);}}
    private async Task Export(){if(_state.Active.Messages.Length==0)return;_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/plain-text-download.js");await _download.InvokeVoidAsync("download","ai-chat.txt",_state.Export());}
    private async Task Choose(bool imageOnly){if(_module is not null)await _module.InvokeVoidAsync("chooseFile",imageOnly?_imageId:_fileId);}
    private async Task AttachFiles(bool imageOnly){if(_module is null)return;var result=await _module.InvokeAsync<FileResult>("readFiles",imageOnly?_imageId:_fileId,imageOnly,4-_state.Attachments.Count);foreach(var error in result.Errors)Snackbar.Add(error,Severity.Error);foreach(var attachment in result.Items)_state.AddAttachment(attachment);}
    private async Task AttachLink(){var dialog=await Dialogs.ShowAsync<ChatLinkDialog>("Attach a link",new DialogParameters<ChatLinkDialog>{{d=>d.Value,_linkValue},{d=>d.Count,_state.Attachments.Count},{d=>d.ValueUpdated,EventCallback.Factory.Create<string>(this,value=>_linkValue=value)}},new DialogOptions{CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small});var result=await dialog.Result;if(result is {Canceled:false,Data:ChatAttachment attachment}){_state.AddAttachment(attachment);_linkValue="";}}
    private async Task Voice(){if(_module is not null)await _module.InvokeVoidAsync("voice",_session,_listening);}
    [JSInvokable]public void VoiceTranscript(string transcript){var draft=(_state.Draft+" "+transcript).Trim();_state.Draft=draft.Length>4000?draft[..4000]:draft;StateHasChanged();}
    [JSInvokable]public void VoiceStarted(){_listening=true;StateHasChanged();}
    [JSInvokable]public void VoiceEnded(){_listening=false;StateHasChanged();}
    [JSInvokable]public void VoiceError(string error){_listening=false;Snackbar.Add(error,Severity.Error);StateHasChanged();}
    public async ValueTask DisposeAsync(){if(_module is not null)try{await _module.InvokeVoidAsync("disconnect",_session);await _module.DisposeAsync();}catch(JSDisconnectedException){}if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}_receiver?.Dispose();}
}


