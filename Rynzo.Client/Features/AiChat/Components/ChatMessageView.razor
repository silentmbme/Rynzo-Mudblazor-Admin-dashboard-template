@using Rynzo.Client.Features.AiChat.Models
@using Rynzo.Client.Theme
<article class="chat-message @(Message.Role=="user"?"chat-user":"")"><span class="chat-avatar">@if(Message.Role=="user"){<img src="assets/images/users/user-4.jpg" alt="You" width="34" height="34" />}else{<MudIcon Icon="@RynzoIcons.Get("Bot")" />}</span><div><p class="chat-sender">@(Message.Role=="user"?"You":"Demo assistant")</p><div class="chat-bubble">@Message.Content@foreach(var attachment in Message.Attachments??[]){<div class="chat-message-attachment">@if(attachment.Kind=="image"){<img src="@attachment.Url" alt="@attachment.Name" />}<a href="@attachment.Url" download="@(attachment.Kind!="link"?attachment.Name:null)" target="@(attachment.Kind=="link"?"_blank":null)" rel="noopener noreferrer">@attachment.Name</a></div>}</div>@if(Message.Role=="assistant"){<MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@RynzoIcons.Get(Copied?"Check":"Copy")" OnClick="@(() => Copy.InvokeAsync(Message))">@(Copied?"Copied":"Copy response")</MudButton>}</div></article>
@code{[Parameter,EditorRequired]public ChatMessage Message{get;set;}=null!;[Parameter]public bool Copied{get;set;}[Parameter]public EventCallback<ChatMessage> Copy{get;set;}}

