@using Rynzo.Client.Features.AiChat.Models
@inject IJSRuntime JS
@implements IAsyncDisposable
<MudDialog><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">Attach a link</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Add a web link to your message. Links are not fetched in demo mode.</MudText><MudTextField T="string" @bind-Value="Value" Immediate="true" Label="URL" InputId="chat-link" InputType="InputType.Url" Placeholder="https://example.com" Variant="Variant.Outlined" />@if(_error is not null){<MudText Color="Color.Error" role="alert" Class="mt-3">@_error</MudText>}<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add" Class="mt-4">Add link</MudButton></DialogContent></MudDialog>
@code{[Parameter]public string Value{get;set;}="";[Parameter]public int Count{get;set;}[Parameter]public EventCallback<string> ValueUpdated{get;set;}[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private string? _error;private IJSObjectReference? _module;private async Task Add(){_module??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-chat-browser.js");var attachment=await _module.InvokeAsync<ChatAttachment?>("parseLink",Value);if(attachment is null){_error="Enter a valid HTTP or HTTPS URL.";return;}if(Count>=4){_error="Attach up to four items per message.";return;}Dialog.Close(DialogResult.Ok(attachment));}public async ValueTask DisposeAsync(){await ValueUpdated.InvokeAsync(Value);if(_module is not null)try{await _module.DisposeAsync();}catch(JSDisconnectedException){}}}
