@using Rynzo.Client.Features.Chat.Services
@using Rynzo.Client.Theme
<div class="conversation-list"><header><div><h2>Messages</h2><p>Your conversations</p></div><MudIconButton Icon="@RynzoIcons.Get("SquarePen")" aria-label="New chat" OnClick="@(() => New.InvokeAsync())" /></header><section><MudTextField T="string" Value="State.Search" ValueChanged="Search" Immediate="true" Placeholder="Search messages" aria-label="Search messages" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><nav>@foreach(var filter in new[]{"All","Unread","Groups","Archived"}){<MudButton Variant="@(State.Filter==filter?Variant.Filled:Variant.Text)" Color="@(State.Filter==filter?Color.Primary:Color.Default)" Size="Size.Small" OnClick="@(() => Filter(filter))">@filter</MudButton>}</nav></section><div class="conversation-items">@foreach(var item in State.Displayed){<button class="@(State.ActiveId==item.Id?"active":"")" data-conversation="@item.Id" @onclick="@(() => Open.InvokeAsync(item.Id))"><ConversationPortrait Name="@item.Name" Status="@item.Status" /><span><span><b>@item.Name</b><small>@item.Time</small></span><span><small>@item.Subtitle</small>@if(item.Muted){<MudIcon Icon="@RynzoIcons.Get("BellOff")" Size="Size.Small" />}</span></span><i>@if(item.Pinned){<MudIcon Icon="@RynzoIcons.Get("Pin")" Size="Size.Small" Color="Color.Primary" />}@if(item.Unread>0){<strong>@item.Unread</strong>}</i></button>}@if(State.Displayed.Length==0){<p class="conversation-empty">No conversations found.</p>}</div></div>
@code{[Parameter,EditorRequired]public ChatState State{get;set;}=null!;[Parameter]public EventCallback Changed{get;set;}[Parameter]public EventCallback<string> Open{get;set;}[Parameter]public EventCallback New{get;set;}private async Task Search(string value){State.Search=value;await Changed.InvokeAsync();}private async Task Filter(string value){State.Filter=value;await Changed.InvokeAsync();}}

