@using Rynzo.Client.Features.Chat.Models
@using Rynzo.Client.Theme
@if(Message.Author=="system"){<div class="conversation-system" data-message="@Message.Id"><span>@Message.Text</span></div>}else{<div class="conversation-bubble @(Message.Author=="me"?"mine":"")" data-message="@Message.Id"><img class="conversation-message-avatar" src="@Rynzo.Client.Features.Chat.Services.ChatState.Portrait(Message.Author == "me" ? "You" : SenderName)" alt="@(Message.Author == "me" ? "You" : SenderName)" width="30" height="30" /><div><article>@if(Message.Reply is not null){<blockquote>@Message.Reply</blockquote>}<p>@Message.Text</p>@if(Message.Attachment is { } attachment){@if(attachment.Type=="image"){<button class="conversation-image" @onclick="@(() => Image.InvokeAsync())"><img src="@attachment.Url" alt="@attachment.Name" /></button>}else{<div class="conversation-file"><MudIcon Icon="@RynzoIcons.Get("File")" Color="Color.Primary" />@attachment.Name</div>}}<small>@Message.Time @if(Message.Author=="me"){<MudIcon Icon="@RynzoIcons.Get("CheckCheck")" Size="Size.Small" />}</small></article>@if(Message.Reactions is not null){<div class="conversation-reactions">@foreach(var reaction in Message.Reactions){<button @onclick="@(() => React.InvokeAsync(reaction.Key))">@reaction.Key @reaction.Value</button>}</div>}<div class="conversation-actions">@foreach(var emoji in new[]{"👍","❤️","😊"}){<button aria-label="@($"React {emoji}")" @onclick="@(() => React.InvokeAsync(emoji))">@emoji</button>}<MudIconButton Icon="@RynzoIcons.Get("Reply")" Size="Size.Small" aria-label="Reply" OnClick="@(() => Reply.InvokeAsync())" />@if(Message.Author=="me"){<MudIconButton Icon="@RynzoIcons.Get("Pencil")" Size="Size.Small" aria-label="Edit" OnClick="@(() => Edit.InvokeAsync())" />}<MudIconButton Icon="@RynzoIcons.Get("Pin")" Size="Size.Small" aria-label="Pin" OnClick="@(() => Pin.InvokeAsync())" />@if(Message.Author=="me"){<MudIconButton Icon="@RynzoIcons.Get("Trash2")" Size="Size.Small" Color="Color.Error" aria-label="Delete" OnClick="@(() => Delete.InvokeAsync())" />}</div></div></div>}
@code{[Parameter]public string SenderName{get;set;}="";[Parameter,EditorRequired]public ConversationMessage Message{get;set;}=null!;[Parameter]public EventCallback Reply{get;set;}[Parameter]public EventCallback Edit{get;set;}[Parameter]public EventCallback Pin{get;set;}[Parameter]public EventCallback Delete{get;set;}[Parameter]public EventCallback Image{get;set;}[Parameter]public EventCallback<string> React{get;set;}}


