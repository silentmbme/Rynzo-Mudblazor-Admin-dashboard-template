@using Rynzo.Client.Features.Chat.Models
@using Rynzo.Client.Theme
<div class="conversation-info"><header><span class="conversation-info-eyebrow">CONVERSATION WORKSPACE</span><h2>@(Active.Group?"Group information":"Contact information")</h2><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close conversation info" OnClick="@(() => Close.InvokeAsync())" /><p>Conversation details, shared items, and notification controls.</p></header><div><div class="conversation-profile"><div class="conversation-cover"><span><MudIcon Icon="@RynzoIcons.Get("MessageSquare")" Size="Size.Small" />Connected through Rynzo</span></div><ConversationPortrait Name="@Active.Name" /><h3>@Active.Name</h3><p>@(Active.Group?$"{Active.Members?.Length??0} members":Active.Email)</p><MudChip T="string" Size="Size.Small" Color="@(Active.Status=="online"?Color.Success:Active.Status=="away"?Color.Warning:Color.Default)">@(Active.Status=="online"?"Available":Active.Status=="away"?"Away":"Offline")</MudChip><div class="conversation-info-buttons"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("MessageSquare")" OnClick="@(() => Close.InvokeAsync())">Message</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Phone")" OnClick="@(() => Call.InvokeAsync(false))">Call</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Video")" OnClick="@(() => Call.InvokeAsync(true))">Video</MudButton></div></div>@if(!Active.Group){<section><h4><MudIcon Icon="@RynzoIcons.Get("User")" Size="Size.Small" />Contact details</h4><div class="conversation-contact"><div class="contact-detail-row"><span class="contact-detail-icon"><MudIcon Icon="@RynzoIcons.Get("Mail")" /></span><div><span class="contact-detail-label">Email address</span><MudLink Href="@($"mailto:{Active.Email}")" Class="contact-detail-email">@Active.Email</MudLink></div><span class="contact-detail-arrow" aria-hidden="true"><MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" Size="Size.Small" /></span></div><div class="contact-detail-row"><span class="contact-detail-icon"><MudIcon Icon="@RynzoIcons.Get("Clock3")" /></span><div><span class="contact-detail-label">Local time</span><span class="contact-detail-time">10:30 AM <small>UTC-08:00</small></span></div></div></div></section>}else{<section><h4>Members (@(Active.Members?.Length??0))</h4><div class="conversation-members">@foreach(var member in Active.Members??[]){<div><ConversationPortrait Name="@member" /><span>@member</span>@if(member=="You"){<small>You</small>}</div>}</div><MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-3" StartIcon="@RynzoIcons.Get("UserPlus")" OnClick="@(() => Add.InvokeAsync())">Add member</MudButton></section>}<section class="conversation-info-stats"><div><b>@Active.Messages.Length</b><p>Messages</p></div><div><b>@Active.Messages.Count(m=>m.Attachment is not null)</b><p>Shared files</p></div><div><b>@Active.Messages.Count(m=>m.Pinned is not null)</b><p>Pinned</p></div></section><section><h4><MudIcon Icon="@RynzoIcons.Get("Pin")" Size="Size.Small" />Pinned messages<span>@Active.Messages.Count(m=>m.Pinned is not null)</span></h4>@foreach(var message in Active.Messages.Where(m=>m.Pinned is not null)){<div class="conversation-pinned"><small><MudIcon Icon="@RynzoIcons.Get("Pin")" />Pinned message</small><p>@message.Text</p></div>}@if(!Active.Messages.Any(m=>m.Pinned is not null)){<p class="conversation-info-empty">No pinned messages in this conversation.</p>}</section><section><h4><MudIcon Icon="@RynzoIcons.Get("Image")" Size="Size.Small" />Shared media<span>@Active.Messages.Count(m=>m.Attachment?.Type=="image")</span></h4><div class="conversation-media">@foreach(var message in Active.Messages.Where(m=>m.Attachment?.Type=="image")){<button aria-label="@($"View {message.Attachment!.Name}")" @onclick="@(() => Image.InvokeAsync(message))"><img src="@message.Attachment!.Url" alt="@message.Attachment.Name" /></button>}</div>@if(!Active.Messages.Any(m=>m.Attachment?.Type=="image")){<p class="conversation-info-empty">No media shared yet.</p>}</section><footer><div class="conversation-settings-heading"><h4>Conversation settings</h4><p>Manage notifications and your local conversation history.</p></div><MudButton Variant="Variant.Outlined" FullWidth="true" StartIcon="@RynzoIcons.Get(Active.Muted?"Bell":"BellOff")" OnClick="@(() => Mute.InvokeAsync())">@(Active.Muted?"Unmute notifications":"Mute notifications")</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true" StartIcon="@RynzoIcons.Get("Trash2")" OnClick="@(() => Delete.InvokeAsync())">Delete conversation</MudButton></footer></div></div>
@code{[Parameter,EditorRequired]public Conversation Active{get;set;}=null!;[Parameter]public EventCallback Close{get;set;}[Parameter]public EventCallback<bool> Call{get;set;}[Parameter]public EventCallback Mute{get;set;}[Parameter]public EventCallback Add{get;set;}[Parameter]public EventCallback Delete{get;set;}[Parameter]public EventCallback<ConversationMessage> Image{get;set;}}



