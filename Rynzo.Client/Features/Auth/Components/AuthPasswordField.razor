@using Rynzo.Client.Theme
<div class="auth-field">
<label for="@_id">@Label</label>
<MudTextField T="string" InputId="@_id" Value="@Value" ValueChanged="ValueChanged" Immediate="true"
              InputType="@(_visible ? InputType.Text : InputType.Password)" Variant="Variant.Outlined" Margin="Margin.Dense"
              Adornment="Adornment.End" AdornmentIcon="@RynzoIcons.Get(_visible ? "EyeOff" : "Eye")"
              AdornmentAriaLabel="@(_visible ? "Hide password" : "Show password")" OnAdornmentClick="@(() => _visible = !_visible)"
              Error="@(!string.IsNullOrEmpty(Error))" ErrorText="@Error" autocomplete="@AutoComplete" />
</div>
@code {
    private readonly string _id = $"auth-password-{Guid.NewGuid():N}";
    [Parameter] public string Label { get; set; } = "Password";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string AutoComplete { get; set; } = "current-password";
    [Parameter] public string? Error { get; set; }
    private bool _visible;
}
