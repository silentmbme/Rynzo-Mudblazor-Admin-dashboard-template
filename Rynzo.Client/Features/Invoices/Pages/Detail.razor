@page "/invoices/detail"
@using Rynzo.Client.Features.Finance.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@using System.Globalization
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Invoice Details | Rynzo</PageTitle>
<div class="invoice-detail-page"><DashboardPageHeader Title="Invoice Details" Description="Review the client, due date, and status of a sample invoice."><Actions><div><MudButton Variant="Variant.Outlined" Href="/invoices/list" StartIcon="@RynzoIcons.Get("ArrowLeft")">Invoice list</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export invoice</MudButton></div></Actions></DashboardPageHeader>
<div class="id-selector"><span><MudIcon Icon="@RynzoIcons.Get("FileText")" />Invoice record</span><select aria-label="Select invoice" @bind="SelectedId">@foreach(var invoice in Records){<option value="@invoice.Id">@invoice.Id / @invoice.Name</option>}</select><small>Sample balances as of October 9, 2026 / USD</small></div>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mb-5">@Notice</MudAlert>}
<MudCard Class="id-overview rynzo-widget-card" aria-label="Invoice overview" Elevation="0" Outlined="true" data-widget-element="section"><div class="id-overview-identity"><span class="id-overview-icon"><MudIcon Icon="@RynzoIcons.Get("FileText")" /></span><div><span class="id-eyebrow">Invoice overview</span><h2>@Current.Id</h2><p>@Current.Name</p></div></div><div class="id-overview-field"><span>Total amount</span><strong>@Money(Current.Amount)</strong><small>USD / @Current.Category</small></div><div class="id-overview-field"><span>Due date</span><b>@Current.Date.ToString("dd MMM yyyy",CultureInfo.InvariantCulture)</b><span class="id-status @(Current.Status=="Paid"?"paid":"unpaid")"><i></i>@Current.Status</span></div></MudCard><div class="id-layout"><section class="id-sheet" aria-label="Invoice document"><div class="id-sheet-heading"><div class="id-brand"><span><MudIcon Icon="@RynzoIcons.Get("FileText")" /></span><div><b>Invoice document</b><small>Rynzo / Billing workspace</small></div></div><div><span class="id-eyebrow">Invoice</span><h2>@Current.Id</h2><span class="id-status @(Current.Status=="Paid"?"paid":"unpaid")"><i></i>@Current.Status</span></div></div><div class="id-parties"><div><span class="id-eyebrow">Billed to</span><h3>@Current.Name</h3><p>@Current.Category</p></div><div><span class="id-eyebrow">Due date</span><h3>@Current.Date.ToString("MMM dd, yyyy",CultureInfo.InvariantCulture)</h3><p>@(Current.Status=="Unpaid"&&Current.Date<ReportingDate?"Past due in the sample reporting period":"Sample invoice due date")</p></div></div><div class="id-description"><span class="id-eyebrow">Services &amp; charges</span><h3>Invoice breakdown</h3><p>Category-level amount from the source invoice record.</p></div><div class="id-table-scroll"><table><thead><tr><th>Description</th><th>Category</th><th>Amount</th></tr></thead><tbody><tr><td><div class="id-line-item"><span><MudIcon Icon="@RynzoIcons.Get("Briefcase")" /></span><div><b>@Current.Category</b><small>@Current.Name / @Current.Id</small></div></div></td><td>@Current.Category</td><td>@Money(Current.Amount)</td></tr></tbody></table></div><div class="id-document-total"><span>Total invoice value</span><strong>@Money(Current.Amount)</strong></div><div class="id-document-note"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>This source record provides an invoice total only. Item quantities, tax, discounts, and payment instructions are not supplied.</p></div><div class="id-sheet-footer"><span>@Current.Id</span><span>Fictional financial record / USD</span></div></section>
<aside class="id-sidebar"><MudCard Class="id-client-card rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span class="id-eyebrow">Client account</span><div><span><MudIcon Icon="@RynzoIcons.Get("Building2")" /></span><h3>@Current.Name</h3></div><p>@Current.Category</p></MudCard><MudCard Class="id-balance rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header class="id-summary-header"><span class="id-summary-icon"><MudIcon Icon="@RynzoIcons.Get("Wallet")" /></span><div><span class="id-eyebrow">Account summary</span><small>Invoice amount</small></div></header><strong>@Money(Current.Amount)</strong><div class="id-summary-row"><span>Payment status</span><b class="id-summary-status @(Current.Status=="Paid"?"paid":"unpaid")"><i></i>@Current.Status</b></div><div class="id-summary-row"><span>Open receivable</span><b>@Money(Current.Status=="Unpaid"?Current.Amount:0)</b></div><div class="id-summary-row"><span>Currency</span><b>USD</b></div>@if(Current.Status=="Unpaid"){<MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Check")" OnClick="MarkPaid">Mark paid</MudButton>}else{<span class="id-paid-note"><MudIcon Icon="@RynzoIcons.Get("Check")" />Marked paid in the sample register</span>}</MudCard><MudCard Class="id-context rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="id-context-heading"><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /></span><div><span class="id-eyebrow">Data scope</span><h3>Session workspace</h3></div></div><p>Status changes apply only to this page session. Marking paid updates the sample record and does not process a payment.</p><div class="id-context-separation"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>The invoice list and Finance pages maintain their own session data.</p></div></MudCard></aside></div></div>
@code {
 [SupplyParameterFromQuery(Name="id")] public string? InvoiceId{get;set;}private readonly List<FinanceRecord> Records=FinanceSource.Invoices.ToList();private string SelectedId="INV-1001",Notice="";private IJSObjectReference? Download;private static readonly DateOnly ReportingDate=new(2026,10,9);private FinanceRecord Current=>Records.First(x=>x.Id==SelectedId);protected override void OnParametersSet(){if(InvoiceId is not null&&Records.Any(x=>x.Id==InvoiceId))SelectedId=InvoiceId;}
 private static string Money(decimal value)=>value.ToString("C0",CultureInfo.GetCultureInfo("en-US"));private void MarkPaid(){var index=Records.FindIndex(x=>x.Id==SelectedId);Records[index]=Current with{Status="Paid"};Notice=$"{SelectedId} marked paid in this page session. No payment was processed.";}
 private async Task Export(){static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var invoice=Current;var csv="ID,Client,Category,Amount USD,Status,Due date\r\n"+string.Join(",",new[]{invoice.Id,invoice.Name,invoice.Category,invoice.Amount.ToString(CultureInfo.InvariantCulture),invoice.Status,invoice.Date.ToString("yyyy-MM-dd")}.Select(Cell));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download",invoice.Id+".csv",csv,"text/csv;charset=utf-8");Notice=$"{invoice.Id} exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
