@page "/invoices/create"
@using Rynzo.Client.Features.Finance.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@using System.Globalization
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Create Invoice | Rynzo</PageTitle>
<div class="create-invoice-page"><DashboardPageHeader Title="Create Invoice" Description="Prepare a sample invoice and review its details before saving."><Actions><MudButton Href="/invoices/list" Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("ArrowLeft")">Invoice list</MudButton></Actions></DashboardPageHeader>
@if(Created is not null){<MudAlert Severity="Severity.Success" role="status" Class="mb-5">@Created.Id created in this page session. Download the invoice CSV below.</MudAlert>}
<div class="ci-layout"><section class="ci-editor"><div class="ci-section-heading"><span>01</span><div><h2>Client &amp; invoice details</h2><p>Set the recipient and category for this invoice.</p></div><MudIcon Icon="@RynzoIcons.Get("FileText")" /></div><div class="ci-fields"><label for="ci-client">Client name <span>*</span></label><MudTextField T="string" @bind-Value="Client" InputId="ci-client" Immediate="true" aria-label="Invoice client" Placeholder="e.g. Northstar Retail" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="120" Disabled="@(Created is not null)" /><label for="ci-category">Category</label><MudTextField T="string" @bind-Value="Category" InputId="ci-category" Immediate="true" aria-label="Invoice category" Placeholder="e.g. Consulting" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="80" Disabled="@(Created is not null)" /></div><div class="ci-section-heading second"><span>02</span><div><h2>Amount &amp; due date</h2><p>Review the value and payment deadline.</p></div><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" /></div><div class="ci-fields"><div class="ci-field-grid"><div><label for="ci-amount">Amount (USD) <span>*</span></label><MudNumericField T="decimal" @bind-Value="Amount" InputId="ci-amount" Immediate="true" aria-label="Invoice amount" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Disabled="@(Created is not null)" /></div><div><label for="ci-due">Due date <span>*</span></label><input id="ci-due" type="date" aria-label="Invoice due date" value="@Due" @onchange="@(e=>Due=e.Value?.ToString()??"")" disabled="@(Created is not null)" /></div></div><p class="ci-field-hint">New invoices start as unpaid. Amounts are recorded in USD.</p>@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}<div class="ci-actions">@if(Created is null){<MudButton Variant="Variant.Text" OnClick="Reset">Reset form</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Check")" OnClick="Save">Create invoice</MudButton>}else{<MudButton Variant="Variant.Outlined" OnClick="Reset">Create another</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Download")" OnClick="DownloadInvoice">Download CSV</MudButton>}</div></div><div class="ci-session"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /><p>Sample workspace. Creation is local to this page and does not send an invoice or process a payment. List and detail pages maintain separate session data.</p></div></section>
<aside class="ci-preview"><div class="ci-preview-heading"><span class="ci-eyebrow">Live preview</span><span><i></i>@(Created is null?"Draft":"Created")</span></div><div class="ci-document"><div class="ci-document-top"><span class="ci-file"><MudIcon Icon="@RynzoIcons.Get("FileText")" /></span><div><b>INVOICE</b><small>@(Created?.Id??"Assigned on creation")</small></div></div><div class="ci-preview-client"><span class="ci-eyebrow">Billed to</span><h2>@(string.IsNullOrWhiteSpace(Client)?"Client name":Client)</h2><p>@(string.IsNullOrWhiteSpace(Category)?"General":Category)</p></div><div class="ci-preview-due"><span>Due date</span><b>@(DateOnly.TryParse(Due,out var date)?date.ToString("dd MMM yyyy",CultureInfo.InvariantCulture):"Select a date")</b></div><div class="ci-preview-line"><span>@(string.IsNullOrWhiteSpace(Category)?"General":Category)</span><b>@Money(Amount)</b></div><div class="ci-preview-total"><span>Total invoice value</span><strong>@Money(Amount)</strong><small>USD</small></div><div class="ci-preview-status"><span>Payment status</span><b>Unpaid</b></div><p class="ci-preview-note">Category-level invoice total. No item quantities, tax, discounts, or payment instructions are added.</p></div><p class="ci-outside-note">Review the client name, amount, and due date before creating the invoice.</p></aside></div></div>
@code {
 private string Client="",Category="General",Due="2026-10-26",Error="";private decimal Amount;private FinanceRecord? Created;private int NextId=FinanceSource.Invoices.Max(x=>int.Parse(x.Id[4..]))+1;private IJSObjectReference? Download;
 private static string Money(decimal amount)=>amount.ToString("C2",CultureInfo.GetCultureInfo("en-US"));private void Save(){if(Created is not null)return;if(string.IsNullOrWhiteSpace(Client)||Amount<=0){Error="Enter a client name and positive amount.";return;}if(!DateOnly.TryParse(Due,out var due)){Error="Select a valid due date.";return;}Created=new($"INV-{NextId++}",Client.Trim(),string.IsNullOrWhiteSpace(Category)?"General":Category.Trim(),Amount,0,"Unpaid",due);Client=Created.Name;Category=Created.Category;Error="";}
 private void Reset(){Client="";Category="General";Due="2026-10-26";Amount=0;Error="";Created=null;}
 private async Task DownloadInvoice(){if(Created is not {} invoice)return;static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var csv="ID,Client,Category,Amount USD,Status,Due date\r\n"+string.Join(",",new[]{invoice.Id,invoice.Name,invoice.Category,invoice.Amount.ToString(CultureInfo.InvariantCulture),invoice.Status,invoice.Date.ToString("yyyy-MM-dd")}.Select(Cell));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download",invoice.Id+".csv",csv,"text/csv;charset=utf-8");}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
