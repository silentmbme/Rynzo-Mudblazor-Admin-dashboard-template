@page "/invoices/list"
@using System.Globalization
@using Rynzo.Client.Features.Finance.Models
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Invoices | Rynzo</PageTitle>
<div class="invoices-page">
<PageHeader Title="Invoices" Description="Keep receivables organized, from outstanding balances to collected revenue."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export invoices</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenAdd">Add invoice</MudButton></Actions></PageHeader>
<section class="il-summary" aria-label="Invoice summary"><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("FileText")" />Total invoice value</span><strong>@Money(Total)</strong><small>@Visible.Count() records in view</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Check")" />Paid invoices</span><strong>@Money(Paid)</strong><small>@Visible.Count(x=>x.Status=="Paid") collected</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Clock3")" />Open receivables</span><strong>@Money(Unpaid)</strong><small>@Visible.Count(x=>x.Status=="Unpaid") unpaid</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />Overdue balance</span><strong>@Money(Overdue)</strong><small>Included in open receivables</small></MudCard></section><div class="il-context"><span>Sample balances as of October 9, 2026 / USD</span><b>@Collection% collected</b><span>Paid value as a share of invoice value</span></div><MudCard Class="inv-library rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="inv-eyebrow">BILLING WORKSPACE</span><h2>Invoice directory <span>@Visible.Count()</span></h2><p>Review balances, due dates, and payment status.</p></div><span class="inv-session"><i></i>Session workspace</span></header><nav class="inv-tabs" aria-label="Invoice views">@foreach(var tab in new[]{"All invoices","Paid","Unpaid","Overdue"}){<button class="@(ActiveTab==tab?"is-active":"")" aria-pressed="@(ActiveTab==tab)" @onclick="@(()=>SetTab(tab))">@tab <span>@CountTab(tab)</span></button>}</nav><div class="inv-filters"><MudTextField T="string" @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search invoice, client, or category..." aria-label="Search invoices" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Invoice status" @bind="_status"><option value="All">All statuses</option>@foreach(var status in _records.Select(x=>x.Status).Distinct().Order()){<option>@status</option>}</select><select aria-label="Invoice view" @bind="_view"><option>All invoices</option><option>Overdue</option></select><select aria-label="Invoice sorting" @bind="_sort"><option value="newest">Newest first</option><option value="largest">Largest amount</option></select><MudButton Variant="Variant.Text" OnClick="Reset">Reset filters</MudButton></div><div class="inv-table-scroll" tabindex="0" aria-label="Invoices"><table><thead><tr><th>Invoice</th><th>Client</th><th>Category</th><th>Due date</th><th>Status</th><th>Amount</th><th></th></tr></thead><tbody>@foreach(var invoice in Visible){<tr><td><button class="inv-open" @onclick="@(()=>_selected=invoice)"><span class="inv-file"><MudIcon Icon="@RynzoIcons.Get("FileText")" /></span><span><b>@invoice.Id</b><small>Sample invoice</small></span></button></td><td><b class="inv-client">@invoice.Name</b></td><td>@invoice.Category</td><td><span class="@(IsOverdue(invoice)?"inv-overdue-date":"")">@invoice.Date.ToString("MMM dd, yyyy",CultureInfo.GetCultureInfo("en-US"))</span>@if(IsOverdue(invoice)){<small class="inv-overdue-hint">Past due</small>}</td><td><span class="inv-status @(invoice.Status=="Paid"?"is-paid":"")"><i></i>@invoice.Status</span></td><td><b class="inv-amount">@Money(invoice.Amount)</b><small class="inv-usd">USD</small></td><td><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"View {invoice.Id}")" OnClick="@(()=>_selected=invoice)" /></td></tr>}</tbody></table></div>@if(!Visible.Any()){<div class="inv-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No matching invoices</h3><p>Try another search or reset your filters.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}<footer><span>Showing @Visible.Count() of @_records.Count sample invoices</span><span>Invoice value <b>@Money(Total)</b></span></footer></MudCard><p class="inv-note"><MudIcon Icon="@RynzoIcons.Get("Info")" />Changes stay in this page session. Marking an invoice paid updates the sample record only.</p>
</div>
<MudDialog @bind-Visible="_adding"><TitleContent><h2 class="inv-dialog-title">Add invoice</h2></TitleContent><DialogContent><p class="inv-dialog-note">Create an unpaid invoice in this sample workspace.</p><div class="inv-form"><label><span>Client name</span><input aria-label="Invoice client" @bind="_name" placeholder="e.g. Northstar Retail" /></label><label><span>Category</span><input aria-label="Invoice category" @bind="_category" /></label><label><span>Amount (USD)</span><input type="number" min="0.01" step="0.01" aria-label="Invoice amount" @bind="_amount" /></label><label><span>Due date</span><MudDatePicker @bind-Date="_date" Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="Invoice due date" /></label></div></DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>_adding=false)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add">Add invoice</MudButton></DialogActions></MudDialog>
<MudDialog @bind-Visible="DetailVisible"><TitleContent>@if(_selected is {} headingInvoice){<div class="inv-dialog-heading"><span><MudIcon Icon="@RynzoIcons.Get("FileText")" /></span><div><small>SAMPLE INVOICE</small><h2>@headingInvoice.Id</h2></div></div>}</TitleContent><DialogContent>@if(_selected is {} selectedInvoice){<div class="inv-detail-total"><small>Invoice amount</small><b>@Money(selectedInvoice.Amount)</b><span>@selectedInvoice.Status</span></div><dl class="inv-detail-fields"><div><dt>Client</dt><dd>@selectedInvoice.Name</dd></div><div><dt>Category</dt><dd>@selectedInvoice.Category</dd></div><div><dt>Due date</dt><dd>@selectedInvoice.Date.ToString("yyyy-MM-dd")</dd></div><div><dt>Status</dt><dd>@selectedInvoice.Status</dd></div></dl><p class="inv-dialog-note">Sample financial record. Status updates do not process payments.</p>}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>_selected=null)">Close</MudButton>@if(_selected?.Status=="Unpaid"){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="MarkPaid">Mark paid</MudButton>}</DialogActions></MudDialog>
@code{
    private readonly List<FinanceRecord> _records=FinanceSource.Invoices.ToList();
    private static readonly DateOnly ReportingDate=new(2026,10,9);
    private string _query="",_status="All",_view="All invoices",_sort="newest",_name="",_category="General";
    private decimal _amount;
    private DateTime? _date=new(2026,10,9);
    private bool _adding;
    private FinanceRecord? _selected;
    private IJSObjectReference? _download;
    private bool DetailVisible{get=>_selected is not null;set{if(!value)_selected=null;}}
    private static bool IsOverdue(FinanceRecord invoice)=>invoice.Status=="Unpaid"&&invoice.Date<ReportingDate;
    private IEnumerable<FinanceRecord> Visible=>_records.Where(x=>(_status=="All"||x.Status==_status)&&(_view!="Overdue"||IsOverdue(x))&&$"{x.Id} {x.Name} {x.Category}".Contains(_query,StringComparison.OrdinalIgnoreCase)).OrderByDescending(x=>_sort=="largest"?x.Amount:x.Date.DayNumber);
    private decimal Total=>Visible.Sum(x=>x.Amount);
    private decimal Paid=>Visible.Where(x=>x.Status=="Paid").Sum(x=>x.Amount);
    private decimal Unpaid=>Visible.Where(x=>x.Status=="Unpaid").Sum(x=>x.Amount);
    private decimal Overdue=>Visible.Where(IsOverdue).Sum(x=>x.Amount);
    private int Collection=>Total==0?0:(int)(Paid/Total*100);
    private string ActiveTab=>_view=="Overdue"?"Overdue":_status=="All"?"All invoices":_status;
    private int CountTab(string tab)=>tab=="Overdue"?_records.Count(IsOverdue):_records.Count(x=>tab=="All invoices"||x.Status==tab);
    private void SetTab(string tab){_view=tab=="Overdue"?"Overdue":"All invoices";_status=tab is "Paid" or "Unpaid"?tab:"All";}
    private void Reset(){_query="";_status="All";_view="All invoices";_sort="newest";}
    private static string Money(decimal value)=>value.ToString("C0",CultureInfo.GetCultureInfo("en-US"));
    private void OpenAdd(){_name="";_category="General";_amount=0;_date=new DateTime(2026,10,9);_adding=true;}
    private void Add(){if(string.IsNullOrWhiteSpace(_name)||_amount<=0){Snackbar.Add("Enter a client name and positive amount.",Severity.Error);return;}_records.Insert(0,new($"INV-{1001+_records.Count}",_name.Trim(),string.IsNullOrWhiteSpace(_category)?"General":_category,_amount,0,"Unpaid",DateOnly.FromDateTime(_date??DateTime.Today)));_adding=false;Snackbar.Add("Sample invoice created.",Severity.Success);}
    private void MarkPaid(){if(_selected is null)return;var index=_records.FindIndex(x=>x.Id==_selected.Id);if(index>=0)_records[index]=_selected with{Status="Paid"};_selected=null;Snackbar.Add("Sample invoice marked paid.",Severity.Success);}
    private async Task Export(){static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new List<string>{"ID,Name,Category,Amount USD,Spent USD,Status,Date"};rows.AddRange(Visible.Select(x=>string.Join(",",new[]{x.Id,x.Name,x.Category,x.Amount.ToString(CultureInfo.InvariantCulture),x.Used.ToString(CultureInfo.InvariantCulture),x.Status,x.Date.ToString("yyyy-MM-dd")}.Select(Cell))));_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await _download.InvokeVoidAsync("download","invoices.csv",string.Join("\r\n",rows),"text/csv;charset=utf-8");Snackbar.Add("Invoice CSV exported.",Severity.Success);}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}
}
