@using Rynzo.Client.Theme
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Features.AiAnalytics.Models
@implements IAsyncDisposable
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<section class="insights-view" aria-label="AI insights workspace">
<div class="aii-compact-metrics"><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Sparkles")" /></span><div><small>Insights discovered</small><b>@AiAnalyticsSource.Insights.Length</b></div><p>Across four business areas</p></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("TrendingUp")" /></span><div><small>High-impact opportunities</small><b>@AiAnalyticsSource.Insights.Count(x=>x.Impact==High)</b></div><p>Prioritize in your next review</p></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Check")" /></span><div><small>Reviewed insights</small><b>@Reviewed</b></div><p>@(AiAnalyticsSource.Insights.Length-Reviewed) remaining to review</p></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Target")" /></span><div><small>Actions in progress</small><b>@InProgress</b></div><p>Recommendations being evaluated</p></MudCard></div><div class="aii-analysis-row"><section class="aii-discovery"><header><span class="aii-eyebrow">DISCOVERY ACTIVITY</span><h2>Insight discovery</h2><p>Oct 3-9, 2026 / Fixed sample history</p></header><DashboardChart Kind="insights" OptionsModule="./ai-workspace-options.js" Data="DiscoveryData" Height="240" Label="Insight discovery history" /><span class="aii-period">7-day overview</span></section><MudCard Class="aii-spotlight rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><span><MudIcon Icon="@RynzoIcons.Get("Sparkles")" />FEATURED FINDING</span><span class="aii-sample">Sample analysis</span></header><h2>@Featured.Title</h2><p>@Featured.Evidence</p><div class="aii-spotlight-footer"><div><b>@Featured.Metric</b><small>@Featured.Label</small></div><MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@RynzoIcons.Get("ArrowUpRight")" OnClick="@(()=>_selected=Featured)">Explore finding</MudButton></div></MudCard></div><section class="aii-focus"><header><span class="aii-eyebrow">EXPLORE BY BUSINESS AREA</span><h2>Focus areas</h2><p>Choose an area to explore its findings.</p></header><nav aria-label="Insight categories"><button class="@(_category==All?"is-active":"")" aria-pressed="@(_category==All)" @onclick="@(()=>_category=All)"><span><MudIcon Icon="@RynzoIcons.Get("Layers")" />All areas</span><b>@AiAnalyticsSource.Insights.Length</b></button>@foreach(var category in Cats){<button class="@(_category==category?"is-active":"")" aria-pressed="@(_category==category)" @onclick="@(()=>SelectCategory(category))"><span><MudIcon Icon="@RynzoIcons.Get(CategoryIcon(category))" />@category</span><b>@AiAnalyticsSource.Insights.Count(x=>x.Category==category)</b></button>}</nav></section><div class="aii-workbench"><div class="aii-feed"><header class="aii-feed-heading"><div><span class="aii-eyebrow">EVIDENCE &amp; OPPORTUNITIES</span><h2>Your insight feed <span>@Visible.Count()</span></h2><p>@Visible.Count() of @AiAnalyticsSource.Insights.Length findings / Session-only changes</p></div><div class="aii-feed-actions"><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export insights</MudButton><MudButton Variant="@(SavedOnly?Variant.Filled:Variant.Outlined)" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Bookmark")" aria-pressed="@SavedOnly" OnClick="@(()=>SavedOnly=!SavedOnly)">Saved (@_saved.Count)</MudButton></div></header><div class="aii-filters"><MudTextField T="string" @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search title, owner, or source..." aria-label="Search AI records" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Filter AI records" @bind="_category"><option value="All">All categories</option>@foreach(var category in Cats){<option>@category</option>}</select><select aria-label="Insight status" @bind="_filter"><option value="All">All statuses</option><option>New</option><option>Reviewed</option><option>In progress</option></select><select aria-label="Sort insights" @bind="_sort"><option value="priority">Highest impact</option><option value="confidence">Highest confidence</option><option value="title">Title A-Z</option></select><MudButton Variant="Variant.Text" OnClick="Reset">Reset filters</MudButton></div>
@if(!string.IsNullOrWhiteSpace(_notice)){<div class="aii-notice" role="status"><MudIcon Icon="@RynzoIcons.Get("Check")" />@_notice</div>}
<div class="aii-insight-list">@foreach(var item in Visible){<MudCard @key="item.Id" Class="aii-insight rynzo-widget-card" Style="@($"--insight-tone:var(--{CategoryTone(item.Category)})")" Elevation="0" Outlined="true" data-widget-element="article"><div class="aii-insight-main"><header><span class="aii-category"><MudIcon Icon="@RynzoIcons.Get(CategoryIcon(item.Category))" />@item.Category</span><span class="aii-impact @(item.Impact==High?"is-high":"")">@item.Impact impact</span><small>@item.Id</small><MudIconButton Icon="@RynzoIcons.Get("Bookmark")" Color="@(IsSaved(item)?Color.Primary:Color.Default)" aria-label="@($"Save {item.Id}")" aria-pressed="@IsSaved(item)" OnClick="@(()=>ToggleSave(item))" /></header><button class="aii-insight-title" @onclick="@(()=>_selected=item)">@item.Title</button><p class="aii-evidence">@item.Evidence</p><div class="aii-next-step"><span><MudIcon Icon="@RynzoIcons.Get("ArrowRight")" />NEXT STEP</span><p>@item.Action</p></div></div><aside class="aii-insight-signal"><span class="aii-eyebrow">OBSERVED SIGNAL</span><b>@item.Metric</b><small>@item.Label</small><svg viewBox="0 0 90 45" role="img" aria-label="Seven-point illustrative trend"><polyline points="@TrendPoints(item)" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg><span class="aii-confidence"><b>@item.Confidence%</b> sample confidence</span></aside><footer><span class="aii-owner"><MudIcon Icon="@RynzoIcons.Get("Users")" />@item.Owner</span><span class="aii-source">@item.Source</span><span class="aii-status">@Status(item)</span><MudButton Variant="Variant.Text" EndIcon="@RynzoIcons.Get("ArrowUpRight")" OnClick="@(()=>_selected=item)">Review insight</MudButton></footer></MudCard>}</div>
@if(!Visible.Any()){<div class="aii-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No matching insights</h3><p>Adjust your filters or show all insights.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}
</div></div>
@if(_selected is {} selected){<MudDialog @bind-Visible="DialogVisible"><TitleContent><div class="aii-dialog-heading"><span><MudIcon Icon="@RynzoIcons.Get(CategoryIcon(selected.Category))" /></span><div><small>@selected.Id / SAMPLE ANALYSIS</small><h2>@selected.Title</h2></div></div></TitleContent><DialogContent><div class="aii-detail-metrics"><div><small>Impact</small><b>@selected.Impact</b></div><div><small>Confidence</small><b>@selected.Confidence%</b></div><div><small>Sample records</small><b>@selected.Sample.ToString("N0")</b></div></div><section class="aii-detail-evidence"><h3>What the data suggests</h3><p>@selected.Evidence</p><small>Source: @selected.Source / Oct 3-9, 2026</small></section><section class="aii-detail-recommendation"><span class="aii-eyebrow">RECOMMENDED NEXT STEP</span><p>@selected.Action</p><small>Suggested owner: @selected.Owner</small></section><p class="aii-dialog-note">Sample analysis, not a live AI output. Confidence scores and trends are illustrative. Validate the underlying data before acting.</p></DialogContent><DialogActions><MudButton OnClick="@(()=>UpdateStatus(ReviewedStatus))">Mark reviewed</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(()=>UpdateStatus(InProgressStatus))">Start review</MudButton>@if(_status.ContainsKey(selected.Id)){<MudButton Variant="Variant.Outlined" OnClick="@(()=>UpdateStatus(New))">Reopen</MudButton>}</DialogActions></MudDialog>}
</section>
@code {
    private static readonly object DiscoveryData=new { };
    private static Insight Featured=>AiAnalyticsSource.Insights[0];
    private static string CategoryIcon(string category)=>category switch { "Revenue"=>"TrendingUp", "Customers"=>"Users", "Operations"=>"Layers", _=>"Target" };
    private static string CategoryTone(string category)=>category switch { "Revenue"=>"primary", "Customers"=>"info", "Operations"=>"warning", _=>"success" };
    private const string All="All", New="New", ReviewedStatus="Reviewed", InProgressStatus="In progress", Priority="priority", Confidence="confidence", TitleSort="title", High="High";
    private string _query="", _category=All, _filter=All, _sort=Priority, _notice="";
    private bool SavedOnly; private readonly HashSet<string> _saved=[]; private readonly Dictionary<string,string> _status=[]; private Insight? _selected;
    private bool DialogVisible {get=>_selected is not null; set{if(!value)_selected=null;}}
    private readonly string[] Cats=["Revenue","Customers","Operations","Marketing"]; private readonly string[] Days=["Oct 3","Oct 4","Oct 5","Oct 6","Oct 7","Oct 8","Oct 9"]; private readonly int[] Discovery=[12,18,15,24,20,28,32]; private readonly int[] Impact=[4,6,5,9,8,11,13];
    private int Reviewed=>_status.Count(x=>x.Value==ReviewedStatus); private int InProgress=>_status.Count(x=>x.Value==InProgressStatus); private IEnumerable<Insight> Visible=>AiAnalyticsSource.Insights.Where(i=>$"{i.Title} {i.Id} {i.Owner} {i.Source}".Contains(_query.Trim(),StringComparison.OrdinalIgnoreCase)&&(_category==All||i.Category==_category)&&(_filter==All||Status(i)==_filter)&&(!SavedOnly||_saved.Contains(i.Id))).OrderByDescending(i=>_sort==Confidence?i.Confidence:_sort==TitleSort?0:(i.Impact==High?1000:0)+i.Confidence).ThenBy(i=>_sort==TitleSort?i.Title:i.Id);
    private string Status(Insight i)=>_status.TryGetValue(i.Id,out var s)?s:New; private bool IsSaved(Insight i)=>_saved.Contains(i.Id); private void ToggleSave(Insight i){if(!_saved.Add(i.Id))_saved.Remove(i.Id);} private void SelectCategory(string c)=>_category=_category==c?All:c; private void Reset(){_query="";_category=All;_filter=All;SavedOnly=false;}
    private void UpdateStatus(string status){if(_selected is null)return;_status[_selected.Id]=status;_notice=$"{_selected.Id} marked {status.ToLowerInvariant()}";_selected=null;}
    private async Task Export()
    {
        var rows = new List<string> { "ID,Title,Category,Impact,Confidence,Status,Owner" };
        rows.AddRange(Visible.Select(i => string.Join(',', i.Id, $"\"{i.Title.Replace("\"", "\"\"")}\"", i.Category, i.Impact, i.Confidence, Status(i), i.Owner)));
        var csv = string.Join("\r\n", rows);
        await DownloadFile("ai-insights.csv",csv,"text/csv;charset=utf-8");
        _notice = $"Exported {Visible.Count()} insights.";
    }
    private Color StatusColor(Insight i)=>Status(i)==ReviewedStatus?Color.Success:Status(i)==InProgressStatus?Color.Info:Color.Default; private static Color CategoryColor(string c)=>c switch{"Revenue"=>Color.Primary,"Customers"=>Color.Info,"Operations"=>Color.Warning,"Marketing"=>Color.Success,_=>Color.Default}; private static string ToneClass(string c)=>c.ToLowerInvariant();
    private string TrendPoints(Insight i)=>string.Join(" ",(i.Trend??[]).Select((v,index)=>$"{index*14},{45-v*.5:0.#}")); private string ImpactPoints=>string.Join(" ",Impact.Select((v,index)=>$"{index*116.6:0.#},{160-v*10:0.#}"));
private IJSObjectReference? _download; private async Task DownloadFile(string name,string contents,string type){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await _download.InvokeVoidAsync("download",name,contents,type);} public async ValueTask DisposeAsync(){if(_download is not null){try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}}
}


