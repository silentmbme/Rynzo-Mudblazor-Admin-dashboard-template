@using Rynzo.Client.Features.AiAnalytics.Models
@using Rynzo.Client.Features.AiAnalytics.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@implements IAsyncDisposable
<section class="models-view">

<div class="model-metrics"><AiMetric Label="Model profiles" Value="@State.Models.Count.ToString()" Caption="Three workspace categories" /><AiMetric Label="Active profiles" Value="@State.Models.Count(m=>m.Enabled).ToString()" Caption="@($"{State.Models.Count(m=>!m.Enabled)} paused profiles")" Icon="Activity" Tone="success" /><AiMetric Label="Human review enabled" Value="@State.Models.Count(m=>m.HumanReview).ToString()" Caption="Demo review preferences" Icon="ShieldCheck" Tone="info" /><AiMetric Label="Customized profiles" Value="@State.Changed.ToString()" Caption="Changed from sample defaults" Icon="SlidersHorizontal" Tone="warning" /></div>
<div class="model-banner"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" Color="Color.Primary" /><div><b>Demo configuration workspace</b><p>Configure illustrative model profiles without an API connection. Saving, activating, and validation checks update this page only; no live models, logging, or review policies are changed.</p></div><MudChip T="string" Color="Color.Primary" Size="Size.Small">Session only</MudChip></div>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" Class="mb-5" role="status">@Notice</MudAlert>}
<div class="model-layout"><div><div class="model-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search models" Placeholder="Search model profiles..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Model status" @bind="Status"><option value="All">All statuses</option><option>Active</option><option>Paused</option></select><select aria-label="Model category" @bind="Category"><option value="All">All categories</option><option>Analytics</option><option>Conversations</option><option>Content</option></select></div>
<div class="model-grid">@foreach(var m in Visible){<MudCard Class="model-card rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div class="model-card-top"><span class="model-icon" style="@($"--tone:var(--{m.Tone})")"><MudIcon Icon="@RynzoIcons.Get(ModelIcon(m))" /></span><MudStack Row="true" AlignItems="AlignItems.Center"><MudChip T="string" Color="@(m.Enabled?Color.Success:Color.Default)" Size="Size.Small">@(m.Enabled?"Active":"Paused")</MudChip><MudSwitch T="bool" Value="m.Enabled" ValueChanged="@(v=>Toggle(m,v))" Color="Color.Primary" aria-label="@($"Enable {m.Name}")" /></MudStack></div><small>@m.Id / @m.Category / @m.Version</small><MudText Typo="Typo.h5" Class="mt-1">@m.Name</MudText><p class="model-purpose">@m.Purpose</p><div class="model-values"><div><small>Temperature</small><b>@m.Temperature.ToString("F1",System.Globalization.CultureInfo.InvariantCulture)</b></div><div><small>Output tokens</small><b>@m.Tokens.ToString("N0")</b></div><div><small>Threshold</small><b>@m.Threshold%</b></div></div><MudStack Row="true" Wrap="Wrap.Wrap"><MudChip T="string" Color="@(m.HumanReview?Color.Info:Color.Default)" Size="Size.Small">@(m.HumanReview?"Human review":"Auto review preference")</MudChip><MudChip T="string" Size="Size.Small">@m.Timeout s timeout</MudChip></MudStack><MudStack Row="true" Class="mt-5"><MudButton FullWidth="true" Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("SlidersHorizontal")" aria-label="@($"Configure {m.Id}")" OnClick="@(()=>Open(m))">Configure</MudButton><MudButton StartIcon="@RynzoIcons.Get("Check")" aria-label="@($"Validate {m.Id}")" OnClick="@(()=>ValidateProfile(m))">Validate</MudButton></MudStack></MudCard>}</div>
@if(!Visible.Any()){<div class="model-empty"><p>No model profiles match your filters.</p><MudButton Variant="Variant.Outlined" OnClick="ResetFilters">Reset filters</MudButton></div>}</div>
<aside class="model-side"><MudCard Class="model-side-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="model-panel-header"><MudText Typo="Typo.h6">Configuration guide</MudText></div><div class="pa-5">@foreach(var row in Guide){<div class="guide-row"><b>@row.Item1</b><p>@row.Item2</p></div>}</div></MudCard><MudCard Class="model-side-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="model-panel-header"><MudText Typo="Typo.h6">Session activity</MudText><small>Your five most recent configuration actions</small></div><div class="pa-5">@if(State.Events.Count==0){<MudIcon Icon="@RynzoIcons.Get("Activity")" /><p>Configuration changes appear here.</p>}@foreach(var e in State.Events){<div class="activity-row"><MudIcon Icon="@RynzoIcons.Get("Clock3")" Color="Color.Primary" Size="Size.Small" /><div><b>@e.Model</b><p>@e.Action</p><small>@e.Time.ToString("HH:mm")</small></div></div>}</div></MudCard></aside></div>
<MudDialog Visible="@(Draft is not null)" VisibleChanged="@(v=>{if(!v)Draft=null;})" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">Configure @Draft?.Name</MudText></TitleContent><DialogContent>@if(Draft is {} d){<small>@d.Id / Draft changes apply only when you save. No live model is connected.</small><MudStack Row="true" Wrap="Wrap.Wrap" Class="my-5">@foreach(var t in Tabs){<MudButton Variant="@(Tab==t?Variant.Filled:Variant.Text)" Color="Color.Primary" aria-pressed="@(Tab==t)" OnClick="@(()=>Tab=t)">@t</MudButton>}</MudStack>@if(Tab=="Generation"){<MudAlert Severity="Severity.Info" Variant="Variant.Text">Set response variation and output length. These controls edit a sample profile.</MudAlert><MudSlider T="double" Value="d.Temperature" ValueChanged="@(v=>Change(d with{Temperature=v}))" Min="0" Max="1" Step="0.1" aria-label="Model temperature">Temperature: @d.Temperature.ToString("F1")</MudSlider><div class="model-slider-labels"><small>Consistent</small><small>Creative</small></div><label class="model-field-label">Maximum output tokens</label><MudNumericField T="int" Value="d.Tokens" ValueChanged="@(v=>Change(d with{Tokens=v}))" aria-label="Maximum output tokens" Variant="Variant.Outlined" Immediate="true" /><small>256-8192 tokens. A token is a piece of text, not necessarily a word.</small>}else if(Tab=="Review & runtime"){<label class="model-field-label">Confidence threshold</label><MudNumericField T="int" Value="d.Threshold" ValueChanged="@(v=>Change(d with{Threshold=v}))" aria-label="Confidence threshold" Variant="Variant.Outlined" Immediate="true" /><label class="model-field-label">Model timeout</label><MudNumericField T="int" Value="d.Timeout" ValueChanged="@(v=>Change(d with{Timeout=v}))" aria-label="Model timeout" Variant="Variant.Outlined" Immediate="true" /><label class="model-field-label">Retry attempts</label><MudNumericField T="int" Value="d.Retries" ValueChanged="@(v=>Change(d with{Retries=v}))" aria-label="Retry attempts" Variant="Variant.Outlined" Immediate="true" /><MudSwitch T="bool" Value="d.HumanReview" ValueChanged="@(v=>Change(d with{HumanReview=v}))" Label="Human review" Color="Color.Primary" /><p>Demo preference to flag outputs for human review.</p><MudSwitch T="bool" Value="d.Logging" ValueChanged="@(v=>Change(d with{Logging=v}))" Label="Request logging" Color="Color.Primary" /><p>Demo preference only; enabling this does not log requests.</p>}else{<label class="model-field-label">Model instructions</label><MudTextField T="string" Value="d.Prompt" ValueChanged="@(v=>Change(d with{Prompt=v}))" aria-label="Model instructions" Variant="Variant.Outlined" Lines="7" MaxLength="2000" Immediate="true" /><small>@d.Prompt.Length/2000 characters. Avoid putting credentials or private customer details in instructions.</small>}@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}@if(Check.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mt-4">@Check</MudAlert>}}</DialogContent><DialogActions><MudButton OnClick="ResetDraft">Reset draft</MudButton><MudButton Variant="Variant.Outlined" OnClick="ValidateDraft">Validate draft</MudButton><MudButton OnClick="@(()=>Draft=null)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save configuration</MudButton></DialogActions></MudDialog>
</section>
@code{
 private readonly ModelConfigurationState State=new();private string Query="",Status="All",Category="All",Notice="",Error="",Check="",Tab="Generation";private AiModel? Draft;private IJSObjectReference? Download;
 private static readonly DialogOptions DialogOptions=new(){MaxWidth=MaxWidth.Medium,FullWidth=true};private static readonly string[] Tabs=["Generation","Review & runtime","Instructions"];
 private static readonly (string,string)[] Guide=[("Generation behavior","Lower temperatures favor consistent responses; higher values allow more variation."),("Confidence threshold","Sample minimum score preference for review. It does not guarantee accuracy."),("Output limits","Token limits control response length. Timeout and retry values are demo runtime preferences.")];
 private IEnumerable<AiModel> Visible=>State.Models.Where(m=>$"{m.Name} {m.Id} {m.Purpose}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Status=="All"||(Status=="Active"?m.Enabled:!m.Enabled))&&(Category=="All"||Category==m.Category));
 private static string ModelIcon(AiModel m)=>m.Id switch{"MOD-01"=>"Sparkles","MOD-02"=>"Bot","MOD-03"=>"Target","MOD-04"=>"Layers","MOD-05"=>"Globe",_=>"FileText"};
 private void Notify(string model,string action)=>Notice=$"{model}: {action}. Changes apply only to this session.";private void Toggle(AiModel m,bool enabled){State.Toggle(m,enabled);Notify(m.Name,enabled?"Profile activated":"Profile paused");}private void Open(AiModel m){Draft=m with{};Tab="Generation";Error=Check="";}private void Change(AiModel draft){Draft=draft;Check="";}private void ResetFilters(){Query="";Status=Category="All";}private void ResetDraft(){if(Draft is not null)Draft=AiAnalyticsSource.Models.First(m=>m.Id==Draft.Id) with{};Error=Check="";}private void ValidateDraft(){if(Draft is null)return;Error=ModelConfigurationState.Validate(Draft);Check=Error.Length>0?"":"All configuration fields are valid. This check does not test model outputs or connectivity.";}private void ValidateProfile(AiModel m){var issue=ModelConfigurationState.Validate(m);var action=issue.Length>0?$"Validation failed: {issue}":"Local configuration validation passed";State.Record(m.Name,action);Notify(m.Name,action);}private void Save(){if(Draft is null)return;Error=State.Save(Draft);if(Error.Length>0)return;Notify(Draft.Name,"Configuration saved");Draft=null;}
 public async Task ExportSettingsAsync(){var json=System.Text.Json.JsonSerializer.Serialize(new{environment="demo",sessionOnly=true,models=State.Models},new System.Text.Json.JsonSerializerOptions{PropertyNamingPolicy=System.Text.Json.JsonNamingPolicy.CamelCase,WriteIndented=true});Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","demo-model-settings.json",json,"application/json");Notice="Demo model configuration exported. No API credentials are included.";await InvokeAsync(StateHasChanged);}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
