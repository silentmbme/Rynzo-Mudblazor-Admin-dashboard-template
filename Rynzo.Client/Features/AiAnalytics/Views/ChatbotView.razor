@using Rynzo.Client.Theme
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Assets
@implements IAsyncDisposable
@using Rynzo.Client.Features.AiAnalytics.Models
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<section class="chatbot-view">
    <div class="cb-kpi-grid" aria-label="Conversation operations">
        <MudCard Class="cb-kpi rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div><span>Conversations</span><i><MudIcon Icon="@RynzoIcons.Get("MessageSquare")" /></i></div><b>@_conversations.Count</b><p>Sample activity / October 9, 2026</p></MudCard>
        <MudCard Class="cb-kpi cb-kpi-resolved rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div><span>Resolved</span><i><MudIcon Icon="@RynzoIcons.Get("CircleCheck")" /></i></div><b>@_conversations.Count(x=>x.Status==Resolved)</b><p>Reviewed and closed conversations</p></MudCard>
        <MudCard Class="cb-kpi cb-kpi-open rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div><span>Awaiting response</span><i><MudIcon Icon="@RynzoIcons.Get("Clock3")" /></i></div><b>@_conversations.Count(x=>x.Status==Open)</b><p>Open conversations to follow up</p></MudCard>
        <MudCard Class="cb-kpi cb-kpi-review rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div><span>Needs human review</span><i><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /></i></div><b>@_conversations.Count(x=>x.Status==Review)</b><p>Prioritize specialist requests</p></MudCard>
    </div>
    @if (!string.IsNullOrWhiteSpace(_notice)){<MudAlert Severity="Severity.Success" Dense="true" Class="chat-notice">@_notice</MudAlert>}
    <div class="chat-filters"><MudTextField @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="Search conversations" Placeholder="Search name, topic, or reference..." Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Conversation status" @bind="_statusFilter"><option value="All">All statuses</option><option>Open</option><option>Resolved</option><option>Needs review</option></select><select aria-label="Conversation channel" @bind="_channelFilter"><option value="All">All channels</option><option>Website</option><option>Mobile</option></select><MudButton Variant="Variant.Text" OnClick="Reset">Reset filters</MudButton><MudText Typo="Typo.caption" Class="chat-filter-count">@Visible.Count() conversations</MudText></div>

    <div class="chat-layout">
        <MudCard Class="chat-panel inbox-panel rynzo-widget-card" Elevation="0" Outlined="true"><div class="panel-heading"><div><MudText Typo="Typo.h6">Inbox</MudText><MudText Typo="Typo.caption">Choose a conversation to review</MudText></div></div><div class="inbox-list">@foreach(var conversation in Visible){<button type="button" class="@(ConversationClass(conversation))" aria-pressed="@(Active?.Id==conversation.Id)" @onclick="@(()=>Choose(conversation.Id))"><img class="avatar" src="@Photo(conversation.Id)" alt="@conversation.Name" /><span class="conversation-copy"><span class="conversation-line"><b>@conversation.Name</b><small>@conversation.Time</small></span><span class="conversation-topic">@conversation.Topic</span><span class="conversation-line"><MudChip T="string" Size="Size.Small" Color="StatusColor(conversation.Status)">@conversation.Status</MudChip><small>@conversation.Channel</small></span></span></button>}</div>@if(!Visible.Any()){<div class="empty-inbox"><MudIcon Icon="@RynzoIcons.Get("Search")" /><MudText Typo="Typo.body2">No matching conversations</MudText><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Reset">Reset filters</MudButton></div>}</MudCard>

        <MudCard Class="chat-panel transcript-panel rynzo-widget-card" Elevation="0" Outlined="true"><div class="panel-heading"><div><MudText Typo="Typo.h6">@(Active?.Topic ?? "Conversation review")</MudText><MudText Typo="Typo.caption">@(Active is null ? "Choose a conversation from the inbox" : $"{Active.Id} - {Active.Name}")</MudText></div>@if(Active is not null){<MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@RynzoIcons.Get("Download")" OnClick="ExportTranscript">Export</MudButton>}</div>@if(Active is { } active){<div class="transcript-toolbar"><span><MudIcon Icon="@(active.Channel==Website ? RynzoIcons.Get("Globe") : RynzoIcons.Get("Smartphone"))" Size="Size.Small" /> @active.Channel / <MudChip T="string" Size="Size.Small" Color="@(active.Priority==High?Color.Warning:Color.Default)">@active.Priority priority</MudChip></span><span>@if(active.Status!=Resolved){<MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@RynzoIcons.Get("Check")" OnClick="@(()=>ChangeStatus(Resolved))">Mark resolved</MudButton>}else{<MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(()=>ChangeStatus(Open))">Reopen</MudButton>}@if(active.Status!=Review){<MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(()=>ChangeStatus(Review))">Flag for review</MudButton>}</span></div><div class="transcript"><MudText Typo="Typo.overline" Align="Align.Center">October 9, 2026 - Illustrative transcript</MudText>@foreach(var message in Transcript){<div class="message-row @(message.Role==Customer?"customer":"outbound")"><span class="message-avatar">@if(message.Role==Customer){<img src="@Photo(active.Id)" alt="@active.Name" />}else{<MudIcon Icon="@RynzoIcons.Get(message.Role==Assistant?"Bot":"UserRound")" />}</span><div class="message-bubble"><div><b>@(message.Role==Customer?active.Name:message.Role==Assistant?"Sample AI assistant":"Agent preview")</b><small>@message.Time</small></div><p>@message.Text</p></div></div>}</div><div class="reply-box"><MudText Typo="Typo.caption" Class="suggestion-label"><MudIcon Icon="@RynzoIcons.Get("Sparkles")" Size="Size.Small" /> Suggested follow-ups</MudText><div class="suggestions"><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(active.Status==Resolved)" OnClick="@(()=>SetDraft("Thanks for reaching out. Could you share more details?"))">Ask for details <MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" Size="Size.Small" /></MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(active.Status==Resolved)" OnClick="@(()=>SetDraft("I will flag this request for a specialist to review."))">Specialist review <MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" Size="Size.Small" /></MudButton></div><MudTextField @bind-Value="_draft" aria-label="Reply preview" Placeholder="@(active.Status==Resolved?"Reopen this conversation to draft a reply.":"Write a local reply preview...")" Lines="3" MaxLength="2000" Disabled="@(active.Status==Resolved)" Variant="Variant.Outlined" /><div class="reply-footer"><MudText Typo="Typo.caption">Demo only - no customer messages are sent.</MudText><MudButton Variant="Variant.Filled" Size="Size.Small" Disabled="@(string.IsNullOrWhiteSpace(_draft)||active.Status==Resolved)" OnClick="SendReply" EndIcon="@RynzoIcons.Get("ArrowUpRight")">Add reply preview</MudButton></div></div>}else{<div class="no-selection">No conversation selected. Adjust your filters to see the inbox.</div>}</MudCard>

        @if(Active is { } selected){<div class="context-column"><MudCard Class="chat-panel context-card rynzo-widget-card" Elevation="0" Outlined="true"><MudText Typo="Typo.h6">Conversation context</MudText><div class="contact-summary"><img class="avatar large" src="@Photo(selected.Id)" alt="@selected.Name" /><span><b>@selected.Name</b><small>@selected.Email</small></span></div><dl><dt>Topic</dt><dd>@selected.Tag</dd><dt>Channel</dt><dd>@selected.Channel</dd><dt>Status</dt><dd>@selected.Status</dd><dt>Messages</dt><dd>@Transcript.Count()</dd></dl></MudCard><MudCard Class="chat-panel context-card rynzo-widget-card" Elevation="0" Outlined="true"><MudText Typo="Typo.h6">AI quality signal</MudText><div class="quality-heading"><small>Sample confidence</small><b>@selected.Confidence%</b></div><span class="cb-quality-badge">@(selected.Confidence<85?"Specialist review recommended":"Validate against support guidance")</span><MudText Typo="Typo.caption">@(selected.Confidence<85?"Review this response carefully. Account and billing changes need specialist verification.":"Check the answer against your support guidance before resolving the conversation.")</MudText><small>Illustrative score, not a model evaluation.</small></MudCard><MudCard Class="chat-panel context-card rynzo-widget-card" Elevation="0" Outlined="true"><div class="note-heading"><MudText Typo="Typo.h6">Internal note</MudText><MudIcon Icon="@RynzoIcons.Get("StickyNote")" Size="Size.Small" /></div>@if(_notes.TryGetValue(selected.Id,out var note)){<div class="saved-note">@note</div>}<MudTextField @bind-Value="_noteDraft" aria-label="Internal note" Placeholder="Add a review note..." Lines="3" MaxLength="1000" Variant="Variant.Outlined" /><MudButton Variant="Variant.Outlined" FullWidth="true" Disabled="@(string.IsNullOrWhiteSpace(_noteDraft))" OnClick="SaveNote">Save note</MudButton><MudText Typo="Typo.caption">Notes and replies last for this session.</MudText></MudCard></div>}
    </div>
</section>

@code {
    private const string All="All", Open="Open", Resolved="Resolved", Review="Needs review", Website="Website", Mobile="Mobile", High="High", Customer="customer", Assistant="assistant";
    private List<Conversation> _conversations=AiAnalyticsSource.Conversations.ToList(); private string _query="",_statusFilter=All,_channelFilter=All,_selected="CHAT-301",_draft="",_noteDraft="",_notice=""; private readonly Dictionary<string,List<Message>> _messages=[]; private readonly Dictionary<string,string> _notes=[];
    private IEnumerable<Conversation> Visible=>_conversations.Where(c=>(_statusFilter==All||c.Status==_statusFilter)&&(_channelFilter==All||c.Channel==_channelFilter)&&$"{c.Id} {c.Name} {c.Topic} {c.Tag}".Contains(_query.Trim(),StringComparison.OrdinalIgnoreCase)); private Conversation? Active=>Visible.FirstOrDefault(c=>c.Id==_selected)??Visible.FirstOrDefault(); private IEnumerable<Message> Transcript=>Active is null?[]:new[]{new Message(Customer,Active.Question,Active.Time),new Message(Assistant,Active.Answer,Active.Time)}.Concat(_messages.TryGetValue(Active.Id,out var extra)?extra:[]);
    private void SetDraft(string value)=>_draft=value; private void Choose(string id){_selected=id;_draft="";_noteDraft="";} private void Reset(){_query="";_statusFilter=All;_channelFilter=All;_draft="";_noteDraft="";} private void ChangeStatus(string status){if(Active is null)return;var activeId=Active.Id;_conversations=_conversations.Select(c=>c.Id==activeId?c with{Status=status}:c).ToList();_draft="";_noteDraft="";_notice=$"{activeId} marked {status.ToLowerInvariant()} in this sample workspace.";}
    private void SendReply(){if(Active is null||string.IsNullOrWhiteSpace(_draft))return;if(!_messages.ContainsKey(Active.Id))_messages[Active.Id]=[];_messages[Active.Id].Add(new Message("agent",_draft.Trim(),"Preview"));_draft="";_notice=$"Local reply preview added to {Active.Id}. No message was sent.";} private void SaveNote(){if(Active is null||string.IsNullOrWhiteSpace(_noteDraft))return;_notes[Active.Id]=_noteDraft.Trim();_noteDraft="";_notice=$"Internal note saved for {Active.Id}.";}
    private async Task ExportTranscript(){if(Active is null)return;var text=$"{Active.Id} - {Active.Name}\nTopic: {Active.Topic}\nStatus: {Active.Status}\nSample conversation - no messages sent externally\n\n"+string.Join("\n",Transcript.Select(m=>$"{m.Role} ({m.Time}): {m.Text}"))+ $"\n\nInternal note: {(_notes.TryGetValue(Active.Id,out var n)?n:"None")}";await DownloadFile($"{Active.Id}-transcript.txt",text,"text/plain;charset=utf-8");_notice="Sample transcript exported.";}
    private string ConversationClass(Conversation c)=>$"conversation-row {(Active?.Id==c.Id?"selected":"")}"; private static string Initials(string name)=>string.Join("",name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>x[0])); private static Color StatusColor(string status)=>status==Resolved?Color.Success:status==Review?Color.Warning:Color.Info; private sealed record Message(string Role,string Text,string Time);
private static string Photo(string id)=>id switch {"CHAT-303"=>SourceUserImages.Get("sophia carter"),"CHAT-301" or "CHAT-307"=>"assets/images/users/user-1.jpg","CHAT-302" or "CHAT-306"=>"assets/images/users/user-2.jpg","CHAT-305"=>"assets/images/users/user-3.jpg",_=>"assets/images/users/user-4.jpg"};
private IJSObjectReference? _download; private async Task DownloadFile(string name,string contents,string type){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await _download.InvokeVoidAsync("download",name,contents,type);} public async ValueTask DisposeAsync(){if(_download is not null){try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}}
}



