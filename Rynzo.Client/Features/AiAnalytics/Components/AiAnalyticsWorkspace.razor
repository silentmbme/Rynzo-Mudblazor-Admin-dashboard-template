@using Rynzo.Client.Features.AiAnalytics.Views
<AiWorkspaceSurface><div class="ai-workspace"><PageTitle>@Title | Rynzo</PageTitle>@if (Kind == "models") { <Rynzo.Client.Features.Dashboard.Components.DashboardPageHeader Title="@Title" Description="@Description"><Actions><MudButton Variant="Variant.Outlined" StartIcon="@Rynzo.Client.Theme.RynzoIcons.Get("Download")" OnClick="ExportModelSettings">Export settings</MudButton></Actions></Rynzo.Client.Features.Dashboard.Components.DashboardPageHeader> } else { <header class="ai-workspace-heading"><PageHeader Title="@Title" Description="@Description" Breadcrumbs="Breadcrumbs"><Actions>@if(Kind=="chatbot"){<MudChip T="string" Color="Color.Primary" Size="Size.Small">Sample workspace</MudChip>}</Actions></PageHeader></header> } @if(Kind=="insights"){<InsightsView />}else if(Kind=="chatbot"){<ChatbotView />}else if(Kind=="predictions"){<PredictionsView />}else{<ModelsView @ref="Models" />}</div>
</AiWorkspaceSurface>
@code { private ModelsView? Models; private async Task ExportModelSettings() { if (Models is not null) await Models.ExportSettingsAsync(); } [Parameter] public string Kind {get;set;}="insights";private string Title=>Kind switch{"chatbot"=>"Chatbot Assistant","predictions"=>"Predictions","models"=>"Model Settings",_=>"AI Insights"};private string Description=>Kind switch{"chatbot"=>"Review conversations, refine replies, and manage your support queue.","predictions"=>"Compare business forecasts, explore scenarios, and review the assumptions behind each estimate.","models"=>"Manage model behavior, review thresholds, and configuration profiles in your AI workspace.",_=>"Turn signals into focused actions. Explore illustrative findings across your business."};private BreadcrumbItem[] Breadcrumbs=>[new("Management",null),new("AI Analytics",null),new(Title,null,true)];}




