@page "/pages/settings"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject RynzoAppearance Appearance

<PageTitle>Settings | Rynzo</PageTitle>
<div class="settings-page">
    <DashboardPageHeader Title="Settings" Description="Make your account and workspace work for you."><Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Check")" OnClick="Save">Save changes</MudButton></Actions></DashboardPageHeader>
    @if(Notice.Length>0){<MudAlert Severity="@(HasError?Severity.Error:Severity.Success)" role="status" Class="mb-4">@Notice</MudAlert>}
    <div class="st-layout">
        <aside class="st-sidebar"><div class="st-person"><img src="assets/images/users/user-1.jpg" alt="Sample account" /><div><b>@Saved["first"] @Saved["last"]</b><small>Personal workspace</small></div><span class="st-person-dot"></span></div><div class="st-nav-title">Workspace settings</div><nav aria-label="Settings sections">@foreach(var section in Sections){<button type="button" class="@(Tab==section.Name?"selected":"")" aria-pressed="@(Tab==section.Name)" @onclick="@(()=>Select(section.Name))"><span class="st-nav-icon"><MudIcon Icon="@RynzoIcons.Get(section.Icon)" /></span><span><b>@section.Name</b><small>@section.Note</small></span><MudIcon Icon="@RynzoIcons.Get("ChevronRight")" /></button>}</nav><div class="st-sidebar-bottom"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>Profile and account preferences apply to this demo session. Appearance is saved in this browser.</p><a href="/pages/profile">View profile<MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></a></div></aside>
        <main class="st-main"><section class="st-section"><header class="st-section-header"><span class="st-heading-icon"><MudIcon Icon="@RynzoIcons.Get(Current.Icon)" /></span><div><span class="st-eyebrow">Personal workspace / @Tab</span><h2>@Tab settings</h2><p>@Description</p></div><span class="st-save-state"><i class="@(Dirty?"unsaved":"")"></i>@(Dirty?"Unsaved changes":"Up to date")</span></header>
        <div class="st-content">
        @if(Tab=="Profile"){
            <div class="st-profile-preview"><img src="assets/images/users/user-1.jpg" alt="Sample profile portrait" /><div><h3>Your professional identity</h3><p>Keep your contact details current so your team can reach you.</p><span>Sample account / Personal information</span></div></div>
            <div class="st-group-heading"><h3>Personal information</h3><p>The details you share with your workspace.</p></div>
            <div class="st-fields"><label>First name<input @bind='Draft["first"]' @bind:event="oninput" autocomplete="given-name" /></label><label>Last name<input @bind='Draft["last"]' @bind:event="oninput" autocomplete="family-name" /></label><label>Work email<input type="email" @bind='Draft["email"]' @bind:event="oninput" autocomplete="email" /></label><label>Phone<input type="tel" @bind='Draft["phone"]' @bind:event="oninput" autocomplete="tel" /></label><label>Job title<input @bind='Draft["job"]' @bind:event="oninput" /></label><label>Location<input @bind='Draft["location"]' @bind:event="oninput" /></label></div>
        }
        else if(Tab=="Account"){
            <div class="st-group-heading"><h3>Workspace identity</h3><p>Your workspace name and address.</p></div><div class="st-fields"><label>Workspace name<input @bind='Draft["workspace"]' @bind:event="oninput" /></label><label>Workspace URL<input @bind='Draft["url"]' @bind:event="oninput" /><small>Display preference only; this does not change your domain.</small></label></div>
            <div class="st-group-heading st-separated"><h3>Language &amp; region</h3><p>Choose your preferred language and time zone.</p></div><div class="st-fields"><label>Language<select @bind='Draft["language"]'><option>English (US)</option><option>English (UK)</option><option>Spanish</option></select></label><label>Time zone<select @bind='Draft["zone"]'><option>GMT-07:00 Pacific Time</option><option>GMT+00:00 UTC</option><option>GMT+05:30 India Standard Time</option></select></label></div><div class="st-info"><MudIcon Icon="@RynzoIcons.Get("Globe")" /><span>Regional choices are stored as session preferences. They do not translate the interface or reschedule workspace events.</span></div>
        }
        else if(Tab=="Security"||Tab=="Notifications"){
            <div class="st-group-heading"><h3>@(Tab=="Security"?"Access preferences":"Stay in the loop")</h3><p>@(Tab=="Security"?"Review the sign-in protections you would like to use.":"Choose the updates that matter to you.")</p></div>
            @if(Tab=="Security"){<div class="st-info"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /><span>Demo preferences only. These switches do not enable authentication, enforce a timeout, or send alerts.</span></div>}
            <div class="st-toggles">@foreach(var option in ToggleOptions.Where(o=>o.Section==Tab)){<label class="st-toggle-row"><span class="st-toggle-icon"><MudIcon Icon="@RynzoIcons.Get(option.Icon)" /></span><span class="st-toggle-copy"><b>@option.Title</b><small>@option.Detail</small></span><input type="checkbox" checked="@Toggles[option.Key]" @onchange="@(e=>Toggles[option.Key]=e.Value is true)" aria-label="@option.Title" /><span class="st-switch" aria-hidden="true"></span></label>}</div>
            @if(Tab=="Security"){<div class="st-password"><span><MudIcon Icon="@RynzoIcons.Get("LockKeyhole")" /></span><div><h3>Password</h3><p>Last updated 42 days ago (sample).</p></div><MudButton Variant="Variant.Outlined" OnClick='@(()=>Dialog="Password")'>Change password</MudButton></div>}
            else{<div class="st-info"><MudIcon Icon="@RynzoIcons.Get("Bell")" /><span>Notification choices stay in this page session. This demo does not deliver email or push notifications.</span></div>}
        }
        else if(Tab=="Appearance"){
            <div class="st-group-heading"><h3>Interface theme</h3><p>Choose the appearance you prefer. System follows your device setting.</p></div><div class="st-theme-options">@foreach(var mode in new[]{"system","light","dark"}){<button type="button" class="@(Draft["mode"]==mode?"selected":"")" aria-pressed="@(Draft["mode"]==mode)" aria-label="@($"Use {mode} theme")" @onclick='@(()=>Draft["mode"]=mode)'><span class="st-theme-preview @mode"><i></i><span><b></b><i></i><i></i></span></span><span><MudIcon Icon="@RynzoIcons.Get(mode=="system"?"Monitor":mode=="light"?"Sun":"Moon")" />@Title(mode)<i class="st-radio"></i></span></button>}</div>
            <div class="st-group-heading st-separated"><h3>Accent color</h3><p>Use a palette from the established Rynzo design system.</p></div><div class="st-colors">@foreach(var skin in RynzoTheme.Skins){<button type="button" class="@(Draft["skin"]==skin?"selected":"")" aria-pressed="@(Draft["skin"]==skin)" aria-label="@($"Select {SkinTitle(skin)} accent")" @onclick='@(()=>Draft["skin"]=skin)'><span style="@($"background:{RynzoDesignTokens.Get(skin,false).Primary}")">@if(Draft["skin"]==skin){<MudIcon Icon="@RynzoIcons.Get("Check")" />}</span><b>@SkinTitle(skin)</b></button>}</div><div class="st-info"><MudIcon Icon="@RynzoIcons.Get("Palette")" /><span>Save to apply your theme across the workspace and remember it in this browser.</span></div>
        }
        else{
            <div class="st-group-heading"><h3>Your app connections</h3><p>Review the services associated with your sample workspace.</p></div><div class="st-info"><MudIcon Icon="@RynzoIcons.Get("Info")" /><span>Illustrative connections. No external accounts are authorized and no data is synced.</span></div><div class="st-apps">@foreach(var app in Apps){<article><span class="st-app-icon @app.Key"><MudIcon Icon="@RynzoIcons.Get(app.Icon)" /></span><div><h3>@app.Name</h3><p>@app.Detail</p><small class="@(Toggles[app.Key]?"linked":"")"><i></i>@(Toggles[app.Key]?"Connected (sample)":"Not connected")</small></div><MudButton Variant="Variant.Outlined" aria-label="@($"Manage {app.Name}")" OnClick="@(()=>Dialog=app.Key)">@(Toggles[app.Key]?"Manage":"Connect")</MudButton></article>}</div>
        }
        </div><footer class="st-section-footer"><span><MudIcon Icon="@RynzoIcons.Get("Info")" />Changes are saved for this section.</span><div><MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Check")" OnClick="Save">Save @Tab</MudButton></div></footer></section></main>
    </div>
</div>
<MudDialog Visible="@(Dialog.Length>0)" VisibleChanged="@(v=>{if(!v)Dialog="";})" Options="Options"><TitleContent><MudText Typo="Typo.h6">@(Dialog=="Password"?"Password management":ActiveApp?.Name)</MudText></TitleContent><DialogContent><div class="st-dialog">@if(Dialog=="Password"){<MudIcon Icon="@RynzoIcons.Get("LockKeyhole")" /><h3>Authentication is not connected</h3><p>Password changes require your authentication provider. This demo does not collect or change passwords.</p>}else if(ActiveApp is {} app){<MudIcon Icon="@RynzoIcons.Get(app.Icon)" /><h3>@app.Detail</h3><p>This changes only the sample connection preference. It does not sign in to @app.Name, grant permissions, or sync any data. Save Connected Apps to keep the preference for this page session.</p>}</div></DialogContent><DialogActions><MudButton OnClick='@(()=>Dialog="")'>Close</MudButton>@if(ActiveApp is {} connection){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ToggleApp">@(Toggles[connection.Key]?"Disconnect sample":"Connect sample")</MudButton>}</DialogActions></MudDialog>

@code {
    private string Tab="Profile",Notice="",Dialog="";private bool HasError;
    private record Section(string Name,string Icon,string Note);
    private static readonly Section[] Sections=[new("Profile","User","Personal details"),new("Account","ShieldCheck","Workspace preferences"),new("Security","LockKeyhole","Access and sign-in"),new("Notifications","Bell","Alerts and updates"),new("Appearance","Palette","Theme and display"),new("Connected Apps","Link2","External integrations")];
    private Section Current=>Sections.First(s=>s.Name==Tab);
    private string Description=>Tab switch{"Profile"=>"Manage how you appear and how your team reaches you.","Account"=>"Set up your workspace identity and regional preferences.","Security"=>"Review your sample account protection preferences.","Notifications"=>"Control the updates you want to receive.","Appearance"=>"Create a workspace that feels right for you.",_=>"Manage your sample workspace integrations."};
    private readonly Dictionary<string,string> Draft=new(){{"first","Elena"},{"last","Mrquez"},{"email","elena@rynzoadmin.io"},{"phone","+1 415 555 0148"},{"job","Operations Lead"},{"location","San Francisco, CA"},{"workspace","Rynzo"},{"url","rynzoadmin.io"},{"language","English (US)"},{"zone","GMT-07:00 Pacific Time"},{"mode","system"},{"skin","multicolor"}};
    private Dictionary<string,string> Saved=[];
    private readonly Dictionary<string,bool> Toggles=new(){{"2fa",true},{"devices",true},{"timeout",false},{"product",true},{"team",true},{"digest",false},{"notices",true},{"google",true},{"slack",true},{"github",false}};
    private Dictionary<string,bool> SavedToggles=[];
    private record ToggleOption(string Section,string Key,string Title,string Detail,string Icon);
    private static readonly ToggleOption[] ToggleOptions=[new("Security","2fa","Two-factor authentication","Require a verification code when you sign in.","ShieldCheck"),new("Security","devices","New device alerts","Receive an alert when your account is used on a new device.","MonitorSmartphone"),new("Security","timeout","Session timeout","Automatically sign out after 30 minutes of inactivity.","Clock3"),new("Notifications","product","Product updates","News about releases and major improvements.","Megaphone"),new("Notifications","team","Team activity","Mentions, assignments, and collaborative updates.","Users"),new("Notifications","digest","Weekly digest","A concise report of workspace activity every Monday.","CalendarDays"),new("Notifications","notices","Security notices","Important sign-in and account-security information.","ShieldCheck")];
    private record ConnectedApp(string Key,string Name,string Detail,string Icon);
    private static readonly ConnectedApp[] Apps=[new("google","Google Workspace","Calendar and document sync","CalendarDays"),new("slack","Slack","Workspace notifications","MessageSquare"),new("github","GitHub","Repository activity and pull requests","Github")];
    private ConnectedApp? ActiveApp=>Apps.FirstOrDefault(a=>a.Key==Dialog);
    private static readonly DialogOptions Options=new(){MaxWidth=MaxWidth.Small,FullWidth=true,CloseOnEscapeKey=true};
    private string[] FieldKeys=>Tab switch{"Profile"=>["first","last","email","phone","job","location"],"Account"=>["workspace","url","language","zone"],"Appearance"=>["mode","skin"],_=>[]};
    private string[] ToggleKeys=>Tab=="Connected Apps"?Apps.Select(a=>a.Key).ToArray():ToggleOptions.Where(o=>o.Section==Tab).Select(o=>o.Key).ToArray();
    private bool Dirty=>FieldKeys.Any(k=>Draft[k]!=Saved.GetValueOrDefault(k))||ToggleKeys.Any(k=>Toggles[k]!=SavedToggles.GetValueOrDefault(k));
    protected override void OnInitialized(){Saved=new(Draft);SavedToggles=new(Toggles);}
    protected override void OnAfterRender(bool firstRender){if(firstRender){Draft["mode"]=Appearance.Mode;Draft["skin"]=Appearance.Skin;Saved["mode"]=Appearance.Mode;Saved["skin"]=Appearance.Skin;StateHasChanged();}}
    private void Select(string tab){Tab=tab;Notice="";HasError=false;}
    private void Cancel(){foreach(var key in FieldKeys)Draft[key]=Saved[key];foreach(var key in ToggleKeys)Toggles[key]=SavedToggles[key];HasError=false;Notice=$"{Tab} changes discarded.";}
    private async Task Save(){HasError=false;Notice="";if(Tab=="Profile"&&(string.IsNullOrWhiteSpace(Draft["first"])||string.IsNullOrWhiteSpace(Draft["last"]))){HasError=true;Notice="Enter your first and last names.";return;}if(Tab=="Profile"&&!System.Net.Mail.MailAddress.TryCreate(Draft["email"].Trim(),out _)){HasError=true;Notice="Enter a valid work email address.";return;}if(Tab=="Account"&&(string.IsNullOrWhiteSpace(Draft["workspace"])||!Uri.TryCreate("https://"+Draft["url"].Trim(),UriKind.Absolute,out var url)||url.HostNameType!=UriHostNameType.Dns||!url.Host.Contains('.'))){HasError=true;Notice="Enter a workspace name and a valid workspace domain.";return;}if(Tab=="Appearance"){await Appearance.SetOptionAsync("skin",Draft["skin"]);await Appearance.SetOptionAsync("mode",Draft["mode"]);}foreach(var key in FieldKeys){Draft[key]=Draft[key].Trim();Saved[key]=Draft[key];}foreach(var key in ToggleKeys)SavedToggles[key]=Toggles[key];Notice=Tab=="Appearance"?"Appearance applied and saved in this browser.":$"{Tab} preferences saved for this page session.";}
    private void ToggleApp(){if(ActiveApp is {} app)Toggles[app.Key]=!Toggles[app.Key];Dialog="";}
    private static string Title(string value)=>char.ToUpperInvariant(value[0])+value[1..];
    private static string SkinTitle(string skin)=>skin=="multicolor"?"Indigo":Title(skin);
}
