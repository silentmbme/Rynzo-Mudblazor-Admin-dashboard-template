@page "/logistics/shipments"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Features.Dashboard.Services
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Shipments | Rynzo</PageTitle>
<div class="shipments-page"><DashboardPageHeader Title="Shipments" Description="Monitor shipment routes, expected arrivals, and delivery progress."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export shipments</MudButton></Actions></DashboardPageHeader>
<section class="sh-summary">@foreach(var metric in new[]{("Shipments",State.Shipments.Length,"Package"),("In transit",State.Shipments.Count(s=>s.Status=="In transit"),"Truck"),("Delivered",State.Shipments.Count(s=>s.Status=="Delivered"),"Check"),("Delayed",State.Shipments.Count(s=>s.Status=="Delayed"),"Clock3")}){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get(metric.Item3)" />@metric.Item1</span><strong>@metric.Item2</strong><small>Sample shipment records</small></MudCard>}</section><p class="sh-notice"><MudIcon Icon="@RynzoIcons.Get("Info")" />Sample logistics workspace. Tracking is illustrative, with no live location connection. Delivery updates apply to this page session.</p>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mb-5">@Notice</MudAlert>}
<MudCard Class="sh-register rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="sh-heading"><span class="sh-eyebrow">Transport operations</span><h2>Shipment register <small>@Visible.Length</small></h2><p>Review customers, routes, cargo, and the next expected arrival.</p></div><div class="sh-tabs">@foreach(var status in new[]{"All"}.Concat(State.Shipments.Select(s=>s.Status).Distinct())){<button type="button" class="@(Status==status?"selected":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@status<span>@State.Shipments.Count(s=>status=="All"||s.Status==status)</span></button>}</div><div class="sh-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search shipments" Placeholder="Search shipment, customer, or route..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><span><MudIcon Icon="@RynzoIcons.Get("Package")" />@Visible.Sum(s=>s.Weight).ToString("N0") kg in view</span></div>
<div class="sh-table-scroll"><table><thead><tr><th>Shipment / Customer</th><th>Route</th><th>Cargo</th><th>Expected arrival</th><th>Status / Progress</th><th>Actions</th></tr></thead><tbody>@foreach(var shipment in Visible){<tr><td><div class="sh-reference"><span><MudIcon Icon="@RynzoIcons.Get("Package")" /></span><div><b>@shipment.Id</b><small>@shipment.Customer</small></div></div></td><td><div class="sh-route"><span>@shipment.Origin</span><MudIcon Icon="@RynzoIcons.Get("ArrowRight")" /><span>@shipment.Destination</span></div><small>@shipment.Driver / @shipment.Vehicle</small></td><td><b>@shipment.Weight</b> kg</td><td>@shipment.Eta</td><td><span class="sh-status @StatusClass(shipment.Status)"><i></i>@shipment.Status</span><small class="sh-progress">@shipment.Progress% progress</small></td><td><MudButton Variant="Variant.Outlined" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Track {shipment.Id}")" OnClick="@(()=>SelectedId=shipment.Id)">Track shipment</MudButton></td></tr>}</tbody></table></div>@if(Visible.Length==0){<div class="sh-empty"><h3>No matching shipments</h3><p>Try another customer, route, reference, or status.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}<div class="sh-footer"><span>Showing @Visible.Length of @State.Shipments.Length shipments</span><span>Sample records / Session-only updates</span></div></MudCard>
<section class="sh-priorities"><div><span class="sh-eyebrow">Attention queue</span><h2>Delayed shipments</h2><p>Review the route and expected arrival before updating a delivery.</p></div><div class="sh-delay-grid">@foreach(var shipment in State.Shipments.Where(s=>s.Status=="Delayed")){<button type="button" @onclick="@(()=>SelectedId=shipment.Id)"><span><MudIcon Icon="@RynzoIcons.Get("Clock3")" /></span><div><b>@shipment.Id / @shipment.Customer</b><small>@shipment.Origin to @shipment.Destination</small><small>Expected @shipment.Eta</small></div><MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></button>}@if(!State.Shipments.Any(s=>s.Status=="Delayed")){<p>No delayed shipments in the sample register.</p>}</div></section></div>
<MudDialog Visible="@(Selected is not null)" VisibleChanged="@(v=>{if(!v)SelectedId=null;})" Options="Options"><TitleContent><MudText Typo="Typo.h6">Track @Selected?.Id</MudText></TitleContent><DialogContent>@if(Selected is {} shipment){<div class="sh-detail"><span class="sh-eyebrow">Sample shipment / No live location tracking</span><h2>@shipment.Customer</h2><div class="sh-detail-route"><span>@shipment.Origin</span><MudIcon Icon="@RynzoIcons.Get("ArrowRight")" /><span>@shipment.Destination</span></div><span class="sh-status @StatusClass(shipment.Status)"><i></i>@shipment.Status</span><dl>@foreach(var field in new[]{("Driver",shipment.Driver),("Vehicle",shipment.Vehicle),("Expected arrival",shipment.Eta),("Cargo",shipment.Weight+" kg"),("Progress",shipment.Progress+"%"),("Shipment",shipment.Id)}){<div><dt>@field.Item1</dt><dd>@field.Item2</dd></div>}</dl><p>Marking complete updates the local sample record. It does not confirm a real delivery or send a customer notification.</p></div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>SelectedId=null)">Close</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Selected is null||Selected.Status is "Pending" or "Delivered")" OnClick="Deliver">Mark sample delivery complete</MudButton></DialogActions></MudDialog>
@code {
 private readonly LogisticsDashboardState State=new();private string Query="",Status="All",Notice="";private string? SelectedId;private IJSObjectReference? Download;private static readonly DialogOptions Options=new(){MaxWidth=MaxWidth.Small,FullWidth=true};private LogisticsShipment[] Visible=>State.Filter(Query,Status);private LogisticsShipment? Selected=>State.Shipments.FirstOrDefault(s=>s.Id==SelectedId);private static string StatusClass(string status)=>status switch{"Delivered"=>"delivered","Delayed"=>"delayed","In transit"=>"transit",_=>"pending"};private void Reset(){Query="";Status="All";}private void Deliver(){if(SelectedId is {} id&&State.Deliver(id))Notice=$"{id} marked delivered in this page session.";}
 private async Task Export(){Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","logistics-shipments.csv",LogisticsDashboardState.Csv(Visible),"text/csv;charset=utf-8");Notice="Filtered sample shipments exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
