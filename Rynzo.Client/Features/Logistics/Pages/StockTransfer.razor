@page "/logistics/stock-transfer"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Stock Transfer | Rynzo</PageTitle>
<div class="transfers-page"><DashboardPageHeader Title="Stock Transfer" Description="Plan warehouse movements and review the progress of sample stock transfers."><Actions><div><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export transfers</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenCreate">New transfer</MudButton></div></Actions></DashboardPageHeader>
<div class="st-summary">@foreach(var metric in new[]{("Transfers",Transfers.Count,"ArrowLeftRight"),("Drafts",Transfers.Count(t=>t.Status=="Draft"),"Pencil"),("In transit",Transfers.Count(t=>t.Status=="In transit"),"Truck"),("Received",Transfers.Count(t=>t.Status=="Received"),"Check")}){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get(metric.Item3)" />@metric.Item1</span><strong>@metric.Item2</strong><small>Sample movement records</small></MudCard>}</div><p class="st-notice"><MudIcon Icon="@RynzoIcons.Get("Info")" />Fictional transfer workspace. Status changes last for this page session; no warehouse inventory or delivery system is updated.</p>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mb-5">@Notice</MudAlert>}
<section class="st-register"><div class="st-heading"><span class="st-eyebrow">Warehouse movements</span><h2>Transfer register <small>@Visible.Count()</small></h2><p>Review origins, destinations, and the units planned for movement.</p></div><div class="st-toolbar"><div class="st-tabs">@foreach(var status in new[]{"All","Draft","In transit","Received"}){<button type="button" class="@(Status==status?"selected":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@status<span>@Transfers.Count(t=>status=="All"||t.Status==status)</span></button>}</div><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search transfers" Placeholder="Search reference, product, or warehouse..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /></div>
<div class="st-grid">@foreach(var transfer in Visible){<MudCard Class="st-card rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div class="st-card-heading"><span class="st-reference"><MudIcon Icon="@RynzoIcons.Get("ArrowLeftRight")" />@transfer.Id</span><span class="st-status @CssStatus(transfer.Status)"><i></i>@transfer.Status</span></div><div class="st-route"><div><small>From warehouse</small><b>@transfer.From</b></div><span><MudIcon Icon="@RynzoIcons.Get("ArrowRight")" /></span><div><small>To warehouse</small><b>@transfer.To</b></div></div><div class="st-product"><span><MudIcon Icon="@RynzoIcons.Get("Package")" /></span><div><b>@transfer.Product</b><small>@transfer.Sku</small></div><strong>@transfer.Quantity<small>units</small></strong></div><div class="st-card-footer"><span><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />@transfer.Date</span><MudButton Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Transfer {transfer.Id}")" OnClick="@(()=>SelectedId=transfer.Id)">View transfer</MudButton></div></MudCard>}</div>@if(!Visible.Any()){<div class="st-empty"><h3>No matching transfers</h3><p>Try another reference, product, warehouse, or status.</p><MudButton OnClick="Reset">Reset filters</MudButton></div>}<div class="st-footer">Showing @Visible.Count() of @Transfers.Count transfers <span>Demo data / Page-session workflow</span></div></section></div>
<MudDialog Visible="@(Selected is not null)" VisibleChanged="@(v=>{if(!v)SelectedId=null;})" Options="Options"><TitleContent><MudText Typo="Typo.h6">Transfer details</MudText></TitleContent><DialogContent>@if(Selected is {} transfer){<div class="st-detail"><span class="st-eyebrow">@transfer.Id / Sample transfer</span><h2>@transfer.Product</h2><span class="st-status @CssStatus(transfer.Status)"><i></i>@transfer.Status</span><dl>@foreach(var field in new[]{("Source",transfer.From),("Destination",transfer.To),("SKU",transfer.Sku),("Quantity",transfer.Quantity+" units"),("Planned date",transfer.Date),("Status",transfer.Status)}){<div><dt>@field.Item1</dt><dd>@field.Item2</dd></div>}</dl><h3>Transfer note</h3><p>@transfer.Note</p><p class="st-local-note">This workflow does not reserve, deduct, or receive inventory. Status changes apply only to this page session.</p></div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>SelectedId=null)">Close</MudButton>@if(Selected?.Status!="Received"){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Advance">@(Selected?.Status=="Draft"?"Mark in transit":"Mark received")</MudButton>}</DialogActions></MudDialog>
<MudDialog @bind-Visible="Creating" Options="Options"><TitleContent><MudText Typo="Typo.h6">New stock transfer</MudText></TitleContent><DialogContent><div class="st-form"><p>Create a draft movement using sample products and warehouses.</p><label>Product</label><select aria-label="Transfer product" @bind="ProductIndex">@for(var i=0;i<Products.Length;i++){<option value="@i">@Products[i].Name / @Products[i].Sku</option>}</select><div class="st-form-grid"><div><label>From warehouse</label><select aria-label="Source warehouse" @bind="From">@foreach(var warehouse in Warehouses){<option>@warehouse</option>}</select></div><div><label>To warehouse</label><select aria-label="Destination warehouse" @bind="To">@foreach(var warehouse in Warehouses){<option>@warehouse</option>}</select></div></div><label>Quantity (units)</label><MudNumericField T="int" @bind-Value="Quantity" Immediate="true" aria-label="Transfer quantity" Variant="Variant.Outlined" Margin="Margin.Dense" /><label>Planned date</label><input type="date" aria-label="Transfer date" value="@Date" @onchange="@(e=>Date=e.Value?.ToString()??"")" /><label>Transfer note</label><MudTextField T="string" @bind-Value="Note" Immediate="true" aria-label="Transfer note" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" MaxLength="300" />@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}</div></DialogContent><DialogActions><MudButton OnClick="@(()=>Creating=false)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Create draft</MudButton></DialogActions></MudDialog>
@code {
 private sealed record Transfer(string Id,string Sku,string Product,string From,string To,int Quantity,string Date,string Status,string Note);
 private static readonly (string Sku,string Name)[] Products=[("SKU-1001","Shipping cartons"),("SKU-1002","Protective mailers"),("SKU-1003","Packing tape rolls")];private static readonly string[] Warehouses=["Mumbai","Delhi","Bengaluru"];
 private readonly List<Transfer> Transfers=[new("TRF-1001","SKU-1001","Shipping cartons","Mumbai","Delhi",120,"2026-10-26","Draft","Sample replenishment request."),new("TRF-1002","SKU-1002","Protective mailers","Delhi","Bengaluru",80,"2026-10-25","In transit","Sample warehouse balancing."),new("TRF-1003","SKU-1003","Packing tape rolls","Mumbai","Bengaluru",30,"2026-10-24","Received","Sample receipt completed."),new("TRF-1004","SKU-1001","Shipping cartons","Bengaluru","Mumbai",60,"2026-10-27","Draft","Sample packaging allocation.")];
 private string Query="",Status="All",Notice="",Error="",From="Mumbai",To="Delhi",Date="2026-10-26",Note="";private int ProductIndex,Quantity=1;private bool Creating;private string? SelectedId;private IJSObjectReference? Download;private static readonly DialogOptions Options=new(){MaxWidth=MaxWidth.Small,FullWidth=true};private Transfer? Selected=>Transfers.FirstOrDefault(t=>t.Id==SelectedId);private IEnumerable<Transfer> Visible=>Transfers.Where(t=>$"{t.Id} {t.Product} {t.Sku} {t.From} {t.To}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Status=="All"||t.Status==Status));private static string CssStatus(string status)=>status=="Draft"?"draft":status=="In transit"?"transit":"received";
 private void Reset(){Query="";Status="All";}private void OpenCreate(){Creating=true;ProductIndex=0;Quantity=1;From="Mumbai";To="Delhi";Date="2026-10-26";Note=Error="";}private void Save(){if(From==To){Error="Choose different source and destination warehouses.";return;}if(Quantity<=0){Error="Enter a positive quantity.";return;}if(!DateOnly.TryParse(Date,out var day)){Error="Select a valid planned date.";return;}var product=Products[ProductIndex];var id=$"TRF-{Transfers.Max(t=>int.Parse(t.Id[4..]))+1}";Transfers.Insert(0,new(id,product.Sku,product.Name,From,To,Quantity,day.ToString("yyyy-MM-dd"),"Draft",string.IsNullOrWhiteSpace(Note)?"No transfer note added.":Note.Trim()));Creating=false;Notice=$"{id} created as a local draft.";}private void Advance(){if(Selected is not {} transfer||transfer.Status=="Received")return;var next=transfer.Status=="Draft"?"In transit":"Received";Transfers[Transfers.FindIndex(t=>t.Id==transfer.Id)]=transfer with{Status=next};Notice=$"{transfer.Id} marked {next.ToLowerInvariant()} locally. Inventory balances are unchanged.";}
 private async Task Export(){static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new[]{new[]{"Reference","SKU","Product","Source","Destination","Quantity","Date","Status","Note"}}.Concat(Visible.Select(t=>new[]{t.Id,t.Sku,t.Product,t.From,t.To,t.Quantity.ToString(),t.Date,t.Status,t.Note}));var csv=string.Join("\r\n",rows.Select(r=>string.Join(",",r.Select(Cell))));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","sample-stock-transfers.csv",csv,"text/csv;charset=utf-8");Notice="Filtered sample transfers exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
