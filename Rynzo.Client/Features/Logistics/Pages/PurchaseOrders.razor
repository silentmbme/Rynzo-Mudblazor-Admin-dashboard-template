@page "/logistics/purchase-orders"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@using System.Globalization
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Purchase Orders | Rynzo</PageTitle>
<div class="purchase-orders-page"><DashboardPageHeader Title="Purchase Orders" Description="Review supplier orders, planned deliveries, and sample purchasing commitments."><Actions><div><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export orders</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenCreate">New purchase order</MudButton></div></Actions></DashboardPageHeader>
<section class="po-summary">@foreach(var metric in new[]{("Order value",Money(Orders.Sum(o=>o.Total)),"Wallet"),("Draft orders",Orders.Count(o=>o.Status=="Draft").ToString(),"Pencil"),("Ordered",Orders.Count(o=>o.Status=="Ordered").ToString(),"Truck"),("Received",Orders.Count(o=>o.Status=="Received").ToString(),"Check")}){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get(metric.Item3)" />@metric.Item1</span><strong>@metric.Item2</strong><small>Sample purchasing records</small></MudCard>}</section><p class="po-notice"><MudIcon Icon="@RynzoIcons.Get("Info")" />Fictional orders / USD. Changes last for this page session. No supplier orders, payments, or inventory receipts are sent.</p>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mb-5">@Notice</MudAlert>}
<MudCard Class="po-register rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="po-heading"><span class="po-eyebrow">Procurement workspace</span><h2>Purchase order workspace <small>@Visible.Count()</small></h2><p>Keep suppliers, delivery dates, and order values in one place.</p></div><div class="po-tools"><div class="po-tabs">@foreach(var status in new[]{"All","Draft","Ordered","Received"}){<button type="button" class="@(Status==status?"selected":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@status<span>@Orders.Count(o=>status=="All"||o.Status==status)</span></button>}</div><span>Demonstration orders</span></div><div class="po-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search purchase orders" Placeholder="Search reference, supplier, or product..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Purchase order supplier" @bind="SupplierFilter"><option value="All">All suppliers</option>@foreach(var supplier in Orders.Select(o=>o.Supplier).Distinct()){<option>@supplier</option>}</select><select aria-label="Sort purchase orders" @bind="Sort"><option value="date">Delivery date</option><option value="value">Highest value</option></select></div>
<div class="po-order-grid">@foreach(var order in Visible){<MudCard Class="po-purchase-card rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div class="po-purchase-top"><span class="po-purchase-ref"><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" />@order.Id</span><span class="po-status @order.Status.ToLowerInvariant()"><i></i>@order.Status</span></div><div class="po-purchase-supplier"><span><MudIcon Icon="@RynzoIcons.Get("Building2")" /></span><div><small>Supplier</small><h3>@order.Supplier</h3></div></div><div class="po-purchase-product"><span><MudIcon Icon="@RynzoIcons.Get("Package")" /></span><div><b>@order.Product</b><small>@order.Quantity units at @Money(order.UnitPrice) each</small></div></div><div class="po-purchase-delivery"><div><span><MudIcon Icon="@RynzoIcons.Get("MapPin")" />Delivery to</span><b>@order.Warehouse</b></div><div><span><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />Expected date</span><b>@DateOnly.Parse(order.Due).ToString("dd MMM yyyy",CultureInfo.InvariantCulture)</b></div></div><div class="po-purchase-footer"><div><small>Order total / USD</small><strong>@Money(order.Total)</strong></div><MudButton Variant="Variant.Outlined" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Order {order.Id}")" OnClick="@(()=>SelectedId=order.Id)">Review order</MudButton></div></MudCard>}</div>@if(!Visible.Any()){<div class="po-empty"><h3>No matching purchase orders</h3><p>Try another reference, supplier, product, or status.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}<div class="po-footer"><span>Showing @Visible.Count() of @Orders.Count orders</span><span>Current view value <b>@Money(Visible.Sum(o=>o.Total))</b></span></div></MudCard>
<div class="po-bottom"><section><span class="po-eyebrow">Supplier overview</span><h2>Purchasing by supplier</h2><div class="po-supplier-grid">@foreach(var supplier in Orders.Select(o=>o.Supplier).Distinct()){<button type="button" aria-pressed="@(SupplierFilter==supplier)" @onclick="@(()=>SupplierFilter=SupplierFilter==supplier?"All":supplier)"><span>@supplier</span><strong>@Money(Orders.Where(o=>o.Supplier==supplier).Sum(o=>o.Total))</strong><small>@Orders.Count(o=>o.Supplier==supplier) sample orders</small></button>}</div></section><section class="po-guide"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /><h2>Order workflow</h2><p>Drafts can be marked ordered, then received. Each action updates only the local sample record.</p><p>Totals equal quantity multiplied by unit price. Tax, shipping fees, supplier communication, and stock receipts are not calculated.</p></section></div></div>
<MudDialog Visible="@(Selected is not null)" VisibleChanged="@(v=>{if(!v)SelectedId=null;})" Options="Options"><TitleContent><MudText Typo="Typo.h6">Purchase order details</MudText></TitleContent><DialogContent>@if(Selected is {} order){<div class="po-detail"><span class="po-eyebrow">@order.Id / Sample purchase order</span><h2>@order.Supplier</h2><span class="po-status @order.Status.ToLowerInvariant()"><i></i>@order.Status</span><dl>@foreach(var field in new[]{("Product",order.Product),("Warehouse",order.Warehouse),("Quantity",order.Quantity+" units"),("Unit price",Money(order.UnitPrice)),("Expected date",order.Due),("Order total",Money(order.Total))}){<div><dt>@field.Item1</dt><dd>@field.Item2</dd></div>}</dl><p>Sample purchasing commitment. Status changes do not contact suppliers, process payments, or update inventory.</p></div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>SelectedId=null)">Close</MudButton>@if(Selected?.Status!="Received"){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Advance">@(Selected?.Status=="Draft"?"Mark ordered":"Mark received")</MudButton>}</DialogActions></MudDialog>
<MudDialog @bind-Visible="Creating" Options="Options"><TitleContent><MudText Typo="Typo.h6">New purchase order</MudText></TitleContent><DialogContent><div class="po-form"><p>Create a sample draft. No order is sent to a supplier.</p><label>Supplier</label><MudTextField T="string" @bind-Value="Supplier" Immediate="true" aria-label="Order supplier" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" /><label>Product</label><select aria-label="Order product" @bind="Product">@foreach(var product in Products){<option>@product</option>}</select><div class="po-form-grid"><div><label>Quantity</label><MudNumericField T="int" @bind-Value="Quantity" Immediate="true" aria-label="Order quantity" Variant="Variant.Outlined" Margin="Margin.Dense" /></div><div><label>Unit price (USD)</label><MudNumericField T="decimal" @bind-Value="UnitPrice" Immediate="true" aria-label="Order unit price" Variant="Variant.Outlined" Margin="Margin.Dense" /></div></div><label>Delivery warehouse</label><select aria-label="Order warehouse" @bind="Warehouse"><option>Mumbai</option><option>Delhi</option><option>Bengaluru</option></select><label>Expected delivery date</label><input type="date" aria-label="Order delivery date" value="@Due" @onchange="@(e=>Due=e.Value?.ToString()??"")" /><div class="po-form-total"><span>Order total</span><b>@Money(Quantity*UnitPrice)</b></div>@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}</div></DialogContent><DialogActions><MudButton OnClick="@(()=>Creating=false)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Create draft</MudButton></DialogActions></MudDialog>
@code {
 private sealed record Order(string Id,string Supplier,string Product,string Warehouse,int Quantity,decimal UnitPrice,string Due,string Status){public decimal Total=>Quantity*UnitPrice;}
 private static readonly string[] Products=["Shipping cartons","Protective mailers","Packing tape rolls"];
 private readonly List<Order> Orders=[new("PO-1001","Atlas Packaging","Shipping cartons","Mumbai",400,2.5m,"2026-10-28","Draft"),new("PO-1002","Northstar Supplies","Protective mailers","Delhi",300,1.2m,"2026-10-27","Ordered"),new("PO-1003","Cedar Trading","Packing tape rolls","Bengaluru",150,3.5m,"2026-10-24","Received"),new("PO-1004","Atlas Packaging","Shipping cartons","Delhi",200,2.5m,"2026-10-30","Draft")];
 private string Query="",Status="All",SupplierFilter="All",Sort="date",Notice="",Error="",Supplier="",Product="Shipping cartons",Warehouse="Mumbai",Due="2026-10-28";private int Quantity=1;private decimal UnitPrice;private bool Creating;private string? SelectedId;private IJSObjectReference? Download;private static readonly DialogOptions Options=new(){MaxWidth=MaxWidth.Small,FullWidth=true};private Order? Selected=>Orders.FirstOrDefault(o=>o.Id==SelectedId);private static string Money(decimal value)=>value.ToString("C2",CultureInfo.GetCultureInfo("en-US"));
 private IEnumerable<Order> Visible{get{var rows=Orders.Where(o=>$"{o.Id} {o.Supplier} {o.Product}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Status=="All"||o.Status==Status)&&(SupplierFilter=="All"||o.Supplier==SupplierFilter));return Sort=="value"?rows.OrderByDescending(o=>o.Total):rows.OrderBy(o=>o.Due);}}private void Reset(){Query="";Status=SupplierFilter="All";Sort="date";}private void OpenCreate(){Creating=true;Supplier=Error="";Quantity=1;UnitPrice=0;Product=Products[0];Warehouse="Mumbai";Due="2026-10-28";}
 private void Save(){if(string.IsNullOrWhiteSpace(Supplier)||Quantity<=0||UnitPrice<=0){Error="Enter a supplier, positive quantity, and positive unit price.";return;}if(!DateOnly.TryParse(Due,out var date)){Error="Select a valid delivery date.";return;}var id=$"PO-{Orders.Max(o=>int.Parse(o.Id[3..]))+1}";Orders.Insert(0,new(id,Supplier.Trim(),Product,Warehouse,Quantity,UnitPrice,date.ToString("yyyy-MM-dd"),"Draft"));Creating=false;Notice=$"{id} created as a local draft.";}private void Advance(){if(Selected is not {} order||order.Status=="Received")return;var next=order.Status=="Draft"?"Ordered":"Received";Orders[Orders.FindIndex(o=>o.Id==order.Id)]=order with{Status=next};Notice=$"{order.Id} marked {next.ToLowerInvariant()} in this page session.";}
 private async Task Export(){static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new[]{new[]{"Order","Supplier","Product","Warehouse","Quantity","Unit price USD","Total USD","Expected date","Status"}}.Concat(Visible.Select(o=>new[]{o.Id,o.Supplier,o.Product,o.Warehouse,o.Quantity.ToString(),o.UnitPrice.ToString(CultureInfo.InvariantCulture),o.Total.ToString(CultureInfo.InvariantCulture),o.Due,o.Status}));var csv=string.Join("\r\n",rows.Select(r=>string.Join(",",r.Select(Cell))));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","sample-purchase-orders.csv",csv,"text/csv;charset=utf-8");Notice="Filtered sample purchase orders exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
