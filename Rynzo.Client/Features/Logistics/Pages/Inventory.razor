@page "/logistics/inventory"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Inventory | Rynzo</PageTitle>
<div class="inventory-page"><DashboardPageHeader Title="Inventory" Description="Review stock availability, warehouse allocations, and replenishment priorities."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export inventory</MudButton></Actions></DashboardPageHeader>
<section class="li-summary">@foreach(var metric in new[]{("Inventory items",Items.Count,"Package"),("On-hand units",Items.Sum(i=>i.Stock),"Layers"),("Reserved units",Items.Sum(i=>i.Reserved),"ClipboardList"),("Low-stock items",Items.Count(Low),"Activity")}){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get(metric.Item3)" />@metric.Item1</span><strong>@metric.Item2.ToString("N0")</strong><small>Sample warehouse inventory</small></MudCard>}</section><div class="li-notice"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>Fictional inventory records. Adjustments last for this page session and do not update a warehouse or ordering system.</p><span>Demo data</span></div>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" Class="mb-5" role="status">@Notice</MudAlert>}
<MudCard Class="li-register rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="li-heading"><span class="li-eyebrow">Stock control</span><h2>Inventory register <small>@Visible.Count()</small></h2><p>Track on-hand stock, reservations, and available quantities by SKU.</p></div><div class="li-tabs">@foreach(var filter in new[]{"All items","Low stock","In stock"}){<button type="button" class="@(Status==filter?"selected":"")" aria-pressed="@(Status==filter)" @onclick="@(()=>Status=filter)">@filter<span>@Items.Count(i=>filter=="All items"||(filter=="Low stock"?Low(i):!Low(i)))</span></button>}</div><div class="li-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search inventory" Placeholder="Search product or SKU..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Inventory category" @bind="Category"><option value="All">All categories</option>@foreach(var category in Items.Select(i=>i.Category).Distinct()){<option>@category</option>}</select><select aria-label="Inventory warehouse" @bind="Warehouse"><option value="All">All warehouses</option>@foreach(var warehouse in Items.Select(i=>i.Warehouse).Distinct()){<option>@warehouse</option>}</select><select aria-label="Sort inventory" @bind="Sort"><option value="name">Product A-Z</option><option value="available">Least available</option></select></div>
<div class="li-table-scroll"><table><thead><tr><th>Product / SKU</th><th>Warehouse</th><th>On hand</th><th>Reserved</th><th>Available</th><th>Stock status</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Visible){<tr><td><div class="li-product"><span><MudIcon Icon="@RynzoIcons.Get("Package")" /></span><div><b>@item.Name</b><small>@item.Id / @item.Category</small></div></div></td><td><span class="li-location"><MudIcon Icon="@RynzoIcons.Get("MapPin")" />@item.Warehouse</span></td><td>@item.Stock.ToString("N0")</td><td>@item.Reserved.ToString("N0")</td><td><b>@(item.Stock-item.Reserved)</b><small>units</small></td><td><span class="li-status @(Low(item)?"low":"")"><i></i>@(Low(item)?"Low stock":"In stock")</span></td><td><MudButton Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Adjust {item.Id}")" OnClick="@(()=>Open(item))">Adjust stock</MudButton></td></tr>}</tbody></table></div>@if(!Visible.Any()){<div class="li-empty"><h3>No matching inventory</h3><p>Try another product, category, warehouse, or stock filter.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}<div class="li-footer"><span>Showing @Visible.Count() of @Items.Count sample SKUs</span><span>Low stock: available units below the item's reorder threshold</span></div></MudCard>
<div class="li-bottom"><section class="li-warehouses"><div class="li-bottom-heading"><span class="li-eyebrow">Warehouse overview</span><h2>Available stock by location</h2></div><div class="li-location-grid">@foreach(var warehouse in Items.Select(i=>i.Warehouse).Distinct()){<button type="button" aria-pressed="@(Warehouse==warehouse)" @onclick="@(()=>Warehouse=Warehouse==warehouse?"All":warehouse)"><span><MudIcon Icon="@RynzoIcons.Get("MapPin")" />@warehouse</span><strong>@Items.Where(i=>i.Warehouse==warehouse).Sum(i=>i.Stock-i.Reserved).ToString("N0")<small>available units</small></strong><p>@Items.Count(i=>i.Warehouse==warehouse) SKUs in this location</p></button>}</div></section><section class="li-activity"><span class="li-eyebrow">Session activity</span><h2>Recent adjustments</h2>@if(Activity.Count==0){<p>No adjustments yet. Changes to sample stock appear here.</p>}@foreach(var entry in Activity.Take(4)){<div><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" /><span>@entry</span></div>}</section></div></div>
<MudDialog Visible="@(Editing is not null)" VisibleChanged="@(v=>{if(!v)Editing=null;})" Options="Options"><TitleContent><MudText Typo="Typo.h6">Adjust sample stock</MudText></TitleContent><DialogContent>@if(Editing is {} item){<div class="li-form"><span class="li-eyebrow">@item.Id / @item.Warehouse</span><h2>@item.Name</h2><div class="li-form-summary"><span>Reserved units <b>@item.Reserved</b></span><span>Reorder threshold <b>@item.Threshold</b></span></div><label for="li-stock">New on-hand quantity</label><MudNumericField T="int" @bind-Value="Quantity" InputId="li-stock" Immediate="true" aria-label="On-hand quantity" Variant="Variant.Outlined" Margin="Margin.Dense" /><label for="li-note">Adjustment note</label><MudTextField T="string" @bind-Value="Note" InputId="li-note" Immediate="true" aria-label="Adjustment note" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" MaxLength="300" Placeholder="Explain the stock correction..." /><p>On-hand stock cannot be less than reserved units. A note is required. Changes remain local to this page.</p>@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert">@Error</MudAlert>}</div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>Editing=null)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save adjustment</MudButton></DialogActions></MudDialog>
@code {
 private sealed record StockItem(string Id,string Name,string Category,string Warehouse,int Stock,int Reserved,int Threshold);
 private readonly List<StockItem> Items=[new("SKU-1001","Shipping cartons","Packaging","Mumbai",1200,240,200),new("SKU-1002","Protective mailers","Packaging","Delhi",480,120,100),new("SKU-1003","Packing tape rolls","Consumables","Mumbai",85,40,60),new("SKU-1004","Shipping labels","Consumables","Bengaluru",2400,800,500),new("SKU-1005","Pallet covers","Protection","Delhi",70,30,50),new("SKU-1006","Corner protectors","Protection","Bengaluru",360,80,100)];
 private string Query="",Category="All",Warehouse="All",Status="All items",Sort="name",Notice="",Note="",Error="";private int Quantity;private StockItem? Editing;private readonly List<string> Activity=[];private IJSObjectReference? Download;private static readonly DialogOptions Options=new(){MaxWidth=MaxWidth.Small,FullWidth=true};private static bool Low(StockItem item)=>item.Stock-item.Reserved<item.Threshold;
 private IEnumerable<StockItem> Visible{get{var rows=Items.Where(i=>$"{i.Name} {i.Id}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Category=="All"||i.Category==Category)&&(Warehouse=="All"||i.Warehouse==Warehouse)&&(Status=="All items"||(Status=="Low stock"?Low(i):!Low(i))));return Sort=="available"?rows.OrderBy(i=>i.Stock-i.Reserved):rows.OrderBy(i=>i.Name);}}
 private void Reset(){Query="";Category=Warehouse="All";Status="All items";Sort="name";}private void Open(StockItem item){Editing=item;Quantity=item.Stock;Note=Error="";}private void Save(){if(Editing is not {} item)return;if(Quantity<item.Reserved){Error="On-hand quantity cannot be less than reserved units.";return;}if(string.IsNullOrWhiteSpace(Note)){Error="Enter an adjustment note.";return;}Items[Items.FindIndex(i=>i.Id==item.Id)]=item with{Stock=Quantity};Activity.Insert(0,$"{item.Id}: {item.Stock} to {Quantity} units. {Note.Trim()}");Notice=$"{item.Id} stock adjusted in this page session.";Editing=null;}
 private async Task Export(){static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new[]{new[]{"SKU","Product","Category","Warehouse","On hand","Reserved","Available","Reorder threshold"}}.Concat(Visible.Select(i=>new[]{i.Id,i.Name,i.Category,i.Warehouse,i.Stock.ToString(),i.Reserved.ToString(),(i.Stock-i.Reserved).ToString(),i.Threshold.ToString()}));var csv=string.Join("\r\n",rows.Select(r=>string.Join(",",r.Select(Cell))));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","sample-logistics-inventory.csv",csv,"text/csv;charset=utf-8");Notice="Filtered sample inventory exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
