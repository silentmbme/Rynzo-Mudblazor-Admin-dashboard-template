@using Rynzo.Client.Features.Notes.Models
@using Rynzo.Client.Features.Notes.Services
@using Rynzo.Client.Theme
<MudCard Outlined="true" Elevation="0" Class="@((($"note-card {(ListView?"note-list-card":"")}")) + " rynzo-widget-card")" Style="@($"--note-tone:var({Note.Color});background:color-mix(in oklch,var({Note.Color}) 5%,var(--card));border-top-color:var({Note.Color})")"><header><span style="@($"color:var({Note.Color});background:color-mix(in oklch,var({Note.Color}) 12%,transparent)")">@Note.Category</span><MudIconButton Icon="@RynzoIcons.Get("Pin")" Size="Size.Small" Color="@(Note.Pinned?Color.Primary:Color.Default)" aria-label="@($"{(Note.Pinned?"Unpin":"Pin")} {Note.Title}")" aria-pressed="@(Note.Pinned?"true":"false")" OnClick="@(() => Pin.InvokeAsync(Note.Id))" /></header><button type="button" class="note-edit" aria-label="@($"Edit {Note.Title}")" @onclick="@(() => Edit.InvokeAsync(Note))"><h2>@Note.Title</h2><p>@(Note.Content.Length==0?"Empty note — add your thoughts.":Note.Content)</p></button><footer><span>@NotesState.Words(Note.Content) words</span><MudIconButton Icon="@RynzoIcons.Get("Trash2")" Size="Size.Small" aria-label="@($"Delete {Note.Title}")" OnClick="@(() => Delete.InvokeAsync(Note))" /></footer></MudCard>
@code{[Parameter,EditorRequired]public NoteEntry Note{get;set;}=null!;[Parameter]public bool ListView{get;set;}[Parameter]public EventCallback<string> Pin{get;set;}[Parameter]public EventCallback<NoteEntry> Edit{get;set;}[Parameter]public EventCallback<NoteEntry> Delete{get;set;}}
