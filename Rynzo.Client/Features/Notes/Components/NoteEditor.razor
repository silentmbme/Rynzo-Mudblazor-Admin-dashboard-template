@using Rynzo.Client.Features.Notes.Models
@using Rynzo.Client.Features.Notes.Services
@using Rynzo.Client.Theme
@implements IAsyncDisposable
@inject IJSRuntime JS
<MudDialog Style="width:min(576px,calc(100vw - 32px));max-width:576px"><TitleContent><div class="note-modal-title"><span><MudIcon Icon="@RynzoIcons.Get("NotebookPen")" /></span><div><small>YOUR PERSONAL WORKSPACE</small><MudText Typo="Typo.h6" HtmlTag="h2">@(IsNew?"New note":"Edit note")</MudText></div></div></TitleContent><DialogContent><div class="note-editor-intro"><p>Capture an idea, organize a plan, or save something worth remembering.</p></div><form class="note-editor-form" @onsubmit="Save" @onsubmit:preventDefault="true"><label class="note-field-label" for="note-editor-title">Title</label><MudTextField T="string" @bind-Value="Draft.Title" Immediate="true" InputId="note-editor-title" Placeholder="Enter a title" aria-label="Note title" MaxLength="100" Variant="Variant.Outlined" Class="mb-4" /><label class="note-field-label" for="note-editor-content">Content</label><MudTextField T="string" @bind-Value="Draft.Content" Immediate="true" InputId="note-editor-content" Placeholder="Write your note…" aria-label="Note content" Lines="7" MaxLength="10000" Variant="Variant.Outlined" Class="mb-4" /><div class="note-editor-options"><div class="note-category-field"><label class="note-field-label" for="note-editor-category">Category</label><MudSelect T="string" @bind-Value="Draft.Category" InputId="note-editor-category" aria-label="Note category" Variant="Variant.Outlined" Class="note-category-select">@foreach(var category in new[]{"Work","Personal","Ideas"}){<MudSelectItem Value="@category">@category</MudSelectItem>}</MudSelect></div><div><p>Note color <small>Make it easy to spot</small></p><div class="note-colors">@for(var index=0;index<NotesState.Colors.Length;index++){var color=NotesState.Colors[index];<button type="button" aria-label="@($"Note color {index+1}")" aria-pressed="@(Draft.Color==color?"true":"false")" style="@($"background:var({color})")" @onclick="@(() => Draft.Color=color)">@if(Draft.Color==color){<MudIcon Icon="@RynzoIcons.Get("Check")" Size="Size.Small" />}</button>}</div></div></div>@if(_error){<MudText Color="Color.Error" Class="mt-4" role="alert">@NotesState.TitleError</MudText>}<p class="note-editor-hint"><MudIcon Icon="@RynzoIcons.Get("Info")" Size="Size.Small" />Saved for this session. Export to keep a copy.</p><div class="note-editor-actions"><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export</MudButton><div><MudButton Variant="Variant.Text" OnClick="@(() => Dialog.Cancel())">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Check")" ButtonType="ButtonType.Submit">Save note</MudButton></div></div></form></DialogContent></MudDialog>
@code{[Parameter,EditorRequired]public NoteEntry Draft{get;set;}=null!;[Parameter,EditorRequired]public NotesState State{get;set;}=null!;[Parameter]public bool IsNew{get;set;}[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private bool _error;private IJSObjectReference? _download;private void Save(){if(!State.Save(Draft)){_error=true;return;}Dialog.Close(DialogResult.Ok(true));}private async Task Export(){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/plain-text-download.js");await _download.InvokeVoidAsync("download","note.txt",NotesState.Export(Draft));}public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}}


