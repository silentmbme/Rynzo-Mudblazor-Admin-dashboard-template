@using Rynzo.Client.Features.Crm.Models
<MudGrid Spacing="2">@foreach(var field in Fields.Take(2)){var key=field.Key;<MudItem xs="12" sm="6"><MudTextField T="string" Value="@Get(key)" ValueChanged="@((string value) => Set(key,value))" Immediate="true" Placeholder="@field.Label" aria-label="@field.Label" Variant="Variant.Outlined" /></MudItem>}@foreach(var key in new[]{"industry","size","status","owner","country"}){var selected=key;var label=char.ToUpperInvariant(key[0])+key[1..];<MudItem xs="12" sm="6"><MudSelect T="string" Value="@Get(key)" ValueChanged="@((string value) => Set(selected,value))" Placeholder="@label" aria-label="@label" Variant="Variant.Outlined" Class="company-form-select">@foreach(var option in Data.FormOptions[key]){<MudSelectItem Value="@option">@option</MudSelectItem>}</MudSelect></MudItem>}@foreach(var field in Fields.Skip(2)){var key=field.Key;<MudItem xs="12" sm="6"><MudTextField T="string" Value="@Get(key)" ValueChanged="@((string value) => Set(key,value))" Immediate="true" Placeholder="@field.Label" aria-label="@field.Label" Variant="Variant.Outlined" /></MudItem>}<MudItem xs="12"><MudTextField T="string" @bind-Value="Draft.Notes" Immediate="true" Placeholder="Notes" aria-label="Notes" Lines="3" Variant="Variant.Outlined" /></MudItem></MudGrid>
@code{[Parameter,EditorRequired]public CompanyDraft Draft{get;set;}=null!;[Parameter,EditorRequired]public CrmCompaniesSource Data{get;set;}=null!;private static readonly (string Key,string Label)[] Fields=[("name","Company name"),("domain","Domain"),("revenue","Annual revenue"),("tags","Tags (comma separated)")];private string Get(string key)=>key switch{"name"=>Draft.Name,"domain"=>Draft.Domain,"revenue"=>Draft.Revenue,"tags"=>Draft.Tags,"industry"=>Draft.Industry,"size"=>Draft.Size,"status"=>Draft.Status,"owner"=>Draft.Owner,_=>Draft.Country};private void Set(string key,string value){switch(key){case"name":Draft.Name=value;break;case"domain":Draft.Domain=value;break;case"revenue":Draft.Revenue=value;break;case"tags":Draft.Tags=value;break;case"industry":Draft.Industry=value;break;case"size":Draft.Size=value;break;case"status":Draft.Status=value;break;case"owner":Draft.Owner=value;break;default:Draft.Country=value;break;}}}
