@using Rynzo.Client.Features.Crm.Models
<MudGrid Spacing="2">@foreach(var field in TextFields.Take(5)){var key=field.Key;<MudItem xs="12" sm="6"><MudTextField T="string" Value="@Get(key)" ValueChanged="@((string value) => Set(key,value))" Immediate="true" Placeholder="@field.Label" aria-label="@field.Label" Variant="Variant.Outlined" /></MudItem>}@foreach(var field in SelectFields){var key=field.Key;<MudItem xs="12" sm="6"><MudSelect T="string" Value="@Get(key)" ValueChanged="@((string value) => Set(key,value))" Placeholder="@field.Label" aria-label="@field.Label" Variant="Variant.Outlined" Class="contact-form-select">@foreach(var option in Options(key)){<MudSelectItem Value="@option">@option</MudSelectItem>}</MudSelect></MudItem>}@foreach(var field in TextFields.Skip(5)){var key=field.Key;<MudItem xs="12" sm="6"><MudTextField T="string" Value="@Get(key)" ValueChanged="@((string value) => Set(key,value))" Immediate="true" Placeholder="@field.Label" aria-label="@field.Label" Variant="Variant.Outlined" /></MudItem>}<MudItem xs="12"><MudTextField T="string" @bind-Value="Draft.Notes" Immediate="true" Placeholder="Notes" aria-label="Notes" Lines="3" Variant="Variant.Outlined" /></MudItem></MudGrid>
@code{[Parameter,EditorRequired]public ContactDraft Draft{get;set;}=null!;[Parameter,EditorRequired]public CrmContactsSource Data{get;set;}=null!;private static readonly (string Key,string Label)[] TextFields=[("first","First name"),("last","Last name"),("email","Email"),("phone","Phone"),("role","Job title"),("score","Lead score"),("tags","Tags (comma separated)"),("followUp","Next follow-up")];private static readonly (string Key,string Label)[] SelectFields=[("company","Company"),("type","Contact type"),("status","Status"),("owner","Owner"),("source","Source")];private IEnumerable<string> Options(string key)=>key switch{"company"=>Data.Filters[2].Skip(1),"type"=>Data.Filters[0].Skip(1),"status"=>Data.Filters[1].Skip(1),"owner"=>Data.Owners,_=>Data.Filters[4].Skip(1)};private string Get(string key)=>key switch{"first"=>Draft.First,"last"=>Draft.Last,"email"=>Draft.Email,"phone"=>Draft.Phone,"role"=>Draft.Role,"score"=>Draft.Score,"tags"=>Draft.Tags,"followUp"=>Draft.FollowUp,"company"=>Draft.Company,"type"=>Draft.Type,"status"=>Draft.Status,"owner"=>Draft.Owner,_=>Draft.Source};private void Set(string key,string value){switch(key){case"first":Draft.First=value;break;case"last":Draft.Last=value;break;case"email":Draft.Email=value;break;case"phone":Draft.Phone=value;break;case"role":Draft.Role=value;break;case"score":Draft.Score=value;break;case"tags":Draft.Tags=value;break;case"followUp":Draft.FollowUp=value;break;case"company":Draft.Company=value;break;case"type":Draft.Type=value;break;case"status":Draft.Status=value;break;case"owner":Draft.Owner=value;break;default:Draft.Source=value;break;}}}
