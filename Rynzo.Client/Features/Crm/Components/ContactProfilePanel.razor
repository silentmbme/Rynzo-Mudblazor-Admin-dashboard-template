@using Rynzo.Client.Features.Crm.Models
@using Rynzo.Client.Theme
<div class="contact-profile-panel"><header><div><h2>@Contact.Name</h2><p>@Contact.Role @Contact.Company</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close contact profile" OnClick="@(() => Close.InvokeAsync())" /></header><div class="contact-profile-person"><img src="@Rynzo.Client.Assets.SourceUserImages.Get(Contact.Name)" alt="@Contact.Name" /><div><b>@Contact.Name</b><p>@Contact.Email @Contact.Phone</p><div><StatusBadge Text="@Contact.Status" Tone="@Data.StatusTone[Contact.Status]" />@foreach(var tag in Contact.Tags){<StatusBadge Text="@tag" />}</div></div></div><div class="contact-profile-metrics">@foreach(var item in new[]{("Owner",Contact.Owner),("Source",Contact.Source),("Lead Score",Contact.Score+" / Strong"),("Open deals","2"),("Pipeline value",Contact.ProfileValue),("Next follow-up",Contact.FollowUp)}){<section><small>@item.Item1</small><b>@item.Item2</b></section>}</div><section><h3>Recent activity</h3><div class="contact-profile-activity"><p>@Contact.Activity @(Contact.ActivityDays==0?"2 hours ago":"Recently")</p><p>Demo meeting completed Aug 18</p><p>Follow-up scheduled Aug 16</p></div></section><section class="contact-profile-notes"><header><h3>Recent notes</h3><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Action.InvokeAsync("note"))">Add note</MudButton></header>@foreach(var note in Contact.Notes){<p>@note</p>}@if(Contact.Notes.Length==0){<span>No notes yet.</span>}</section><section class="contact-profile-tasks"><header><h3>Open tasks</h3><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Action.InvokeAsync("task"))">Add task</MudButton></header>@foreach(var task in Contact.Tasks){<p>@task</p>}</section><section><h3>Associated deals</h3><div class="contact-profile-deals">@foreach(var deal in new[]{("Enterprise Expansion","Proposal","$52K"),("Automation Rollout","Negotiation","$32.5K")}){<div><span><b>@deal.Item1</b><small>@deal.Item2</small></span><b>@deal.Item3</b></div>}</div></section><footer><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("edit"))">Edit</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("owner"))">Assign owner</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Mail")" OnClick="@(() => Action.InvokeAsync("email"))">Email</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Phone")" OnClick="@(() => Action.InvokeAsync("call"))">Call</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("archive"))">Archive</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => Action.InvokeAsync("delete"))">Delete</MudButton></footer></div>
@code{[Parameter,EditorRequired]public CrmContact Contact{get;set;}=null!;[Parameter,EditorRequired]public CrmContactsSource Data{get;set;}=null!;[Parameter]public EventCallback Close{get;set;}[Parameter]public EventCallback<string> Action{get;set;}}
