@using Rynzo.Client.Features.Crm.Services
@inject ISnackbar Snackbar
<MudDialog Class="lead-action-dialog" Style="max-height:90vh;overflow-y:auto"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">@Title</MudText></TitleContent><DialogContent><p class="mb-4">@Description</p>@if(Mode is "add" or "edit"){<LeadFormEditor Draft="State.Draft" Data="State.Data"/>}@if(Mode is "note" or "task" or "disqualify"){<MudTextField T="string" @bind-Value="State.Text" Immediate="true" Placeholder="@Placeholder" aria-label="@Placeholder" Variant="Variant.Outlined"/>}@if(Mode is "owner" or "bulkOwner" or "stage" or "bulkStage"){<MudSelect T="string" @bind-Value="State.BulkValue" Placeholder="Select an option" aria-label="Lead action value" Variant="Variant.Outlined">@foreach(var value in Mode is "owner" or "bulkOwner"?State.Data.Owners:State.Data.Stages.Take(6)){<MudSelectItem Value="@value">@value</MudSelectItem>}</MudSelect>}@if(Mode=="bulkTag"){<MudTextField T="string" @bind-Value="State.BulkValue" Immediate="true" Placeholder="Tag" aria-label="Lead tag" Variant="Variant.Outlined"/>}@if(Mode=="convert"&&State.Active is { } lead){<div class="lead-convert-preview"><b>Create Deal: @lead.Company opportunity</b><p>Value @lead.ValueText @lead.Probability% probability</p></div>}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>Dialog.Cancel())">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="@(Mode is "delete" or "bulkDelete"?Color.Error:Color.Primary)" OnClick="Save">@Action</MudButton></DialogActions></MudDialog>
@code{[Parameter,EditorRequired]public CrmLeadsState State{get;set;}=null!;[Parameter]public string Mode{get;set;}="add";[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private string Title=>Mode switch{"add"=>"Add Lead","edit"=>"Edit Lead","note"=>"Add Lead Note","task"=>"Create Follow-up Task","owner" or "bulkOwner"=>"Assign Lead Owner","stage" or "bulkStage"=>"Change Lead Stage","convert"=>"Convert Lead","disqualify"=>"Disqualify Lead","archive"=>"Archive this lead?","delete"=>"Delete this lead?","bulkTag"=>"Add tag to selected leads",_=>"Delete selected leads?"};private string Description=>Mode=="convert"?$"Convert {State.Active?.Name} and create the related contact, company and deal in this demo flow.":Mode=="disqualify"?"Select a reason before disqualifying this lead.":Mode is "delete" or "bulkDelete"?"This is demo behavior and removes leads only from local data.":"Complete the details below.";private string Placeholder=>Mode=="note"?"Write an internal note":Mode=="task"?"Task title":"Reason: No Budget, Wrong Fit, No Response...";private string Action=>Mode switch{"add"=>"Create Lead","edit"=>"Save Changes","convert"=>"Convert Lead","disqualify"=>"Disqualify","archive"=>"Archive","delete" or "bulkDelete"=>"Delete","note"=>"Add Note","task"=>"Create Task",_=>"Apply"};private void Save(){if(Mode is "add" or "edit"){if(!State.Save(Mode=="add")){Snackbar.Add("Check required fields, email, score, value and probability",Severity.Error);return;}}else if(!State.Confirm(Mode))return;Dialog.Close(DialogResult.Ok(true));}}
