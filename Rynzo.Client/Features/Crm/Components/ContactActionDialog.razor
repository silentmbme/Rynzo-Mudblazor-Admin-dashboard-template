@using Rynzo.Client.Features.Crm.Services
@inject ISnackbar Snackbar
<MudDialog Class="contact-action-dialog" Style="max-height:90vh;overflow-y:auto"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">@Title</MudText></TitleContent><DialogContent><p class="mb-4">@Description</p>@if(Mode is "add" or "edit"){<ContactFormEditor Draft="State.Draft" Data="State.Data" />}else if(Mode=="note"){<MudTextField T="string" @bind-Value="State.Note" Immediate="true" Placeholder="Write an internal note" aria-label="Write an internal note" Lines="4" Variant="Variant.Outlined" />}else if(Mode=="task"){<MudTextField T="string" @bind-Value="State.TaskTitle" Immediate="true" Placeholder="Task title" aria-label="Task title" Variant="Variant.Outlined" />}else if(Mode is "owner" or "bulkOwner" or "bulkStatus"){<select aria-label="Contact action value" @bind="State.BulkValue" style="width:100%;height:40px;border:1px solid var(--border);border-radius:6px;background:var(--background);color:var(--foreground);padding:0 12px">@foreach(var option in Mode=="bulkStatus"?BulkStatuses:State.Data.Owners){<option>@option</option>}</select>}else if(Mode=="bulkTag"){<MudTextField T="string" @bind-Value="State.BulkValue" Immediate="true" Placeholder="Tag" aria-label="Tag" Variant="Variant.Outlined" />}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(() => Dialog.Cancel())">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="@(Mode is "delete" or "bulkDelete"?Color.Error:Color.Primary)" OnClick="Save">@Action</MudButton></DialogActions></MudDialog>
@code{[Parameter,EditorRequired]public CrmContactsState State{get;set;}=null!;[Parameter]public string Mode{get;set;}="add";[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private static readonly string[] BulkStatuses=["New","Qualified","Nurturing","Active","Inactive"];private string Title=>Mode switch{"add"=>"Add Contact","edit"=>"Edit Contact","note"=>"Add Note","task"=>"Create Follow-up Task","owner" or "bulkOwner"=>"Assign Contact Owner","archive"=>"Archive this contact?","delete"=>"Delete this contact?","bulkStatus"=>"Change contact status","bulkTag"=>"Add tag to selected contacts",_=>"Delete selected contacts?"};private string Description=>Mode=="archive"?"The contact remains in records and can be restored later.":Mode is "delete" or "bulkDelete"?"This is demo behavior and removes records only from local state.":"Complete the details below.";private string Action=>Mode switch{"add"=>"Create Contact","edit"=>"Save Changes","note"=>"Add Note","task"=>"Create Task","archive"=>"Archive","delete" or "bulkDelete"=>"Delete",_=>"Apply"};private void Save(){if(Mode is "add" or "edit"){if(!State.Save(Mode=="add")){Snackbar.Add("Enter first name, last name and a valid email",Severity.Error);return;}}else if(!State.Confirm(Mode))return;Dialog.Close(DialogResult.Ok(true));}}
