@using Rynzo.Client.Features.Crm.Services
@inject ISnackbar Snackbar
<MudDialog Class="company-action-dialog" Style="max-height:90vh;overflow-y:auto"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">@Title</MudText></TitleContent><DialogContent><p class="mb-4">@(Mode is "delete" or "bulkDelete"?"This company may have contacts and open deals. Demo deletion removes it only from local data.":"Complete the details below.")</p>@if(Mode is "add" or "edit"){<CompanyFormEditor Draft="State.Draft" Data="State.Data" />}else if(Mode is "contact" or "deal" or "note" or "task"){<MudTextField T="string" @bind-Value="State.Text" Immediate="true" Placeholder="@Placeholder" aria-label="@Placeholder" Variant="Variant.Outlined" />}else if(Mode is "owner" or "bulkOwner" or "bulkStatus"){<select aria-label="Company action value" @bind="State.BulkValue" style="height:40px;width:100%;border:1px solid var(--border);border-radius:6px;background:var(--background);color:var(--foreground);padding:0 12px">@foreach(var value in Mode=="bulkStatus"?BulkStatuses:State.Data.Owners){<option>@value</option>}</select>}else if(Mode=="bulkTag"){<MudTextField T="string" @bind-Value="State.BulkValue" Immediate="true" Placeholder="Tag" aria-label="Company tag" Variant="Variant.Outlined" />}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(() => Dialog.Cancel())">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="@(Mode is "delete" or "bulkDelete"?Color.Error:Color.Primary)" OnClick="Save">@Action</MudButton></DialogActions></MudDialog>
@code{[Parameter,EditorRequired]public CrmCompaniesState State{get;set;}=null!;[Parameter]public string Mode{get;set;}="add";[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private static readonly string[] BulkStatuses=["Prospect","Customer","Partner","At Risk","Inactive"];private string Title=>Mode switch{"add"=>"Add Company","edit"=>"Edit Company","contact"=>"Add Contact","deal"=>"Add Deal","note"=>"Add Company Note","task"=>"Create Follow-up Task","owner" or "bulkOwner"=>"Assign Account Owner","archive"=>"Archive this company?","delete"=>"Delete this company?","bulkStatus"=>"Change company status","bulkTag"=>"Add tag to selected companies",_=>"Delete selected companies?"};private string Placeholder=>Mode=="contact"?"Contact name and email":Mode=="deal"?"Deal name and value":Mode=="note"?"Write an internal note":"Task title";private string Action=>Mode switch{"add"=>"Create Company","edit"=>"Save Changes","archive"=>"Archive","delete" or "bulkDelete"=>"Delete","contact"=>"Add Contact","deal"=>"Add Deal","note"=>"Add Note","task"=>"Create Task",_=>"Apply"};private void Save(){if(Mode is "add" or "edit"){if(!State.Save(Mode=="add")){Snackbar.Add("Enter a company name, valid domain and non-negative revenue",Severity.Error);return;}}else if(!State.Confirm(Mode))return;Dialog.Close(DialogResult.Ok(true));}}
