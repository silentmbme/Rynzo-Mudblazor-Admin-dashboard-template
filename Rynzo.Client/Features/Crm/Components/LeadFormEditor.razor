@using Rynzo.Client.Features.Crm.Models
<div class="lead-form-grid">@foreach(var field in TextFields){<div><MudTextField T="string" Placeholder="@field.Label" aria-label="@field.Label" Value="@Get(field.Key)" ValueChanged="@((string value) => Set(field.Key,value))" Immediate="true" Variant="Variant.Outlined" /></div>}@foreach(var field in SelectFields){<div><MudSelect T="string" Value="@Get(field.Key)" ValueChanged="@((string value) => Set(field.Key,value))" Placeholder="@field.Label" aria-label="@field.Label" Variant="Variant.Outlined">@foreach(var option in Options(field.Key)){<MudSelectItem Value="@option">@option</MudSelectItem>}</MudSelect></div>}<div class="lead-form-notes"><MudTextField T="string" Placeholder="Notes" aria-label="Notes" Value="@Draft.Notes" ValueChanged="@((string value) => Draft.Notes=value)" Lines="3" Immediate="true" Variant="Variant.Outlined" /></div></div>
@code{[Parameter,EditorRequired]public LeadDraft Draft{get;set;}=null!;[Parameter,EditorRequired]public CrmLeadsSource Data{get;set;}=null!;private static readonly (string Key,string Label)[] TextFields=[("first","First name"),("last","Last name"),("email","Email"),("phone","Phone"),("role","Job title"),("score","Lead score"),("value","Potential value"),("probability","Probability %"),("follow","Next follow-up"),("tags","Tags (comma separated)")];private static readonly (string Key,string Label)[] SelectFields=[("company","Company"),("stage","Stage"),("source","Source"),("owner","Owner")];private IEnumerable<string> Options(string key)=>key switch{"company"=>Data.Filters[3].Skip(1),"stage"=>Data.Stages,"source"=>Data.Filters[2].Skip(1),_=>Data.Owners};private string Get(string key)=>key switch{"first"=>Draft.First,"last"=>Draft.Last,"email"=>Draft.Email,"phone"=>Draft.Phone,"role"=>Draft.Role,"score"=>Draft.Score,"value"=>Draft.Value,"probability"=>Draft.Probability,"follow"=>Draft.Follow,"tags"=>Draft.Tags,"company"=>Draft.Company,"stage"=>Draft.Stage,"source"=>Draft.Source,_=>Draft.Owner};private void Set(string key,string value){switch(key){case"first":Draft.First=value;break;case"last":Draft.Last=value;break;case"email":Draft.Email=value;break;case"phone":Draft.Phone=value;break;case"role":Draft.Role=value;break;case"score":Draft.Score=value;break;case"value":Draft.Value=value;break;case"probability":Draft.Probability=value;break;case"follow":Draft.Follow=value;break;case"tags":Draft.Tags=value;break;case"company":Draft.Company=value;break;case"stage":Draft.Stage=value;break;case"source":Draft.Source=value;break;default:Draft.Owner=value;break;}}}
