@using Rynzo.Client.Features.Crm.Models
@using Rynzo.Client.Assets
@using Rynzo.Client.Theme
<div class="lead-profile-panel"><header><div><h2>@Lead.Name</h2><p>@Lead.Role @Lead.Company</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close lead profile" OnClick="@(()=>Close.InvokeAsync())"/></header><div class="lead-profile-person"><img src="@SourceUserImages.Get(Lead.Name)" alt="@Lead.Name"/><div><b>@Lead.Name</b><p>@Lead.Email @Lead.Phone</p><div><StatusBadge Text="@Lead.Stage" Tone="@Data.Tones[Lead.Stage]"/>@foreach(var tag in Lead.Tags){<StatusBadge Text="@tag"/>}</div></div></div><div class="lead-profile-metrics">@foreach(var metric in new[]{("Score",$"{Lead.Score} / {Lead.ScoreKind}"),("Owner",Lead.Owner),("Source",Lead.Source),("Potential value",Lead.ProfileValueText),("Probability",Lead.Probability+"%"),("Next follow-up",Lead.Follow)}){<section><small>@metric.Item1</small><b>@metric.Item2</b></section>}</div><section><h3>Qualification</h3><div class="lead-qualification">@foreach(var detail in new[]{("Budget","Confirmed"),("Authority","Decision maker"),("Need","High"),("Timeline","This quarter")}){<p><b>@detail.Item1</b><small>@detail.Item2</small></p>}</div></section><section class="lead-profile-notes"><header><h3>Activity, notes &amp; tasks</h3><span><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(()=>Action.InvokeAsync("note"))">Note</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(()=>Action.InvokeAsync("task"))">Task</MudButton></span></header><p>@Lead.Activity Recently</p>@foreach(var note in Lead.Notes){<p>@note</p>}@foreach(var task in Lead.Tasks){<p>@task</p>}</section><footer><MudButton Variant="Variant.Outlined" OnClick="@(()=>Action.InvokeAsync("edit"))">Edit</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(()=>Action.InvokeAsync("owner"))">Assign owner</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(()=>Action.InvokeAsync("stage"))">Change stage</MudButton><MudButton Variant="Variant.Filled" Disabled="@(Lead.Stage=="Converted")" OnClick="@(()=>Action.InvokeAsync("convert"))">Convert lead</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(()=>Action.InvokeAsync("disqualify"))">Disqualify</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(()=>Action.InvokeAsync("archive"))">Archive</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(()=>Action.InvokeAsync("delete"))">Delete</MudButton></footer></div>
@code{[Parameter,EditorRequired]public CrmLead Lead{get;set;}=null!;[Parameter,EditorRequired]public CrmLeadsSource Data{get;set;}=null!;[Parameter]public EventCallback Close{get;set;}[Parameter]public EventCallback<string> Action{get;set;}}
