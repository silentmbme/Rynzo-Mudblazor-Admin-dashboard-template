@using Rynzo.Client.Features.Crm.Models
@using Rynzo.Client.Assets
@using Rynzo.Client.Theme
<div class="company-profile-panel"><header><div><h2>@Company.Name</h2><p>@Company.Domain @Company.Industry</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close company profile" OnClick="@(() => Close.InvokeAsync())" /></header><div class="company-profile-person"><img src="@SourceUserImages.Get(Company.Name)" alt="@Company.Name" /><div><b>@Company.Name</b><p>@Company.Size employees @Company.RevenueValue annual revenue</p><div><StatusBadge Text="@Company.Status" Tone="@Data.Tones[Company.Status]" />@foreach(var tag in Company.Tags){<StatusBadge Text="@tag" />}</div></div></div><div class="company-profile-metrics">@foreach(var metric in new[]{("Owner",Company.Owner),("Contacts",Company.Contacts.ToString()),("Open deals",Company.Deals.ToString()),("Pipeline value",Company.PipelineValue),("Won revenue","$420K"),("Next follow-up",Company.FollowUp)}){<section><small>@metric.Item1</small><b>@metric.Item2</b></section>}</div><section><h3>Key contacts</h3><div class="company-key-contacts">@foreach(var person in new[]{("Ava Thompson","VP Operations"),("Liam Brooks","CTO"),("Emma Davis","Head of Marketing")}){<div><span>@string.Concat(person.Item1.Split(' ').Select(n=>n[..1]))</span><div><b>@person.Item1</b><small>@person.Item2</small></div></div>}</div></section><section><h3>Open deals</h3><div class="company-profile-deals">@foreach(var deal in new[]{("Enterprise Expansion","$128K","Proposal"),("Automation Rollout","$96K","Negotiation"),("Support Renewal","$60K","Qualified")}){<div><span><b>@deal.Item1</b><small>@deal.Item3</small></span><b>@deal.Item2</b></div>}</div></section><section class="company-profile-notes"><header><h3>Notes &amp; tasks</h3><span><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Action.InvokeAsync("note"))">Note</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Action.InvokeAsync("task"))">Task</MudButton></span></header>@foreach(var note in Company.Notes){<p>@note</p>}@foreach(var task in Company.Tasks){<p>@task</p>}</section><footer><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("edit"))">Edit company</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("contact"))">Add contact</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("deal"))">Add deal</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("owner"))">Assign owner</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("archive"))">Archive</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => Action.InvokeAsync("delete"))">Delete</MudButton></footer></div>
@code{[Parameter,EditorRequired]public CrmCompany Company{get;set;}=null!;[Parameter,EditorRequired]public CrmCompaniesSource Data{get;set;}=null!;[Parameter]public EventCallback Close{get;set;}[Parameter]public EventCallback<string> Action{get;set;}}
