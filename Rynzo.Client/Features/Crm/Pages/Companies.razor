@page "/crm/companies"
@implements IAsyncDisposable
@using Rynzo.Client.Features.Crm.Models
@using Rynzo.Client.Features.Crm.Services
@using Rynzo.Client.Features.Crm.Components
@using Rynzo.Client.Assets
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Companies | Rynzo</PageTitle>
<div class="crm-companies-page"><header><PageHeader Title="Companies" Description="Manage customer accounts, ownership, contacts and pipeline activity." Breadcrumbs="Breadcrumbs" /><nav><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="@(() => Export(false))">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Building2")" OnClick="Add">Add company</MudButton></nav></header><MudCard Class="crm-companies-summary rynzo-widget-card" Elevation="0" Outlined="true">@foreach(var metric in Metrics){<div><small>@metric.Item1</small><b>@metric.Item2</b></div>}</MudCard><MudCard Class="crm-companies-workspace rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="crm-companies-filters"><MudTextField T="string" Value="_state.Query" ValueChanged="Search" Immediate="true" Placeholder="Search company, domain, owner or tag" aria-label="Search companies" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><div>@for(var index=0;index<_state.Data.Filters.Length;index++){var filter=index;<select aria-label="@FilterLabels[filter]" @bind="_state.Filters[filter]" @bind:after="Refresh">@foreach(var option in _state.Data.Filters[filter]){<option>@option</option>}</select>}<MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Reset">Reset filters</MudButton></div></div>@if(_state.Selected.Count>0){<div class="crm-companies-bulk"><b>@_state.Selected.Count selected</b><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Modal("bulkOwner"))">Assign owner</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Modal("bulkStatus"))">Change status</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Modal("bulkTag"))">Add tag</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="BulkArchive">Archive</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Export(true))">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="@(() => Modal("bulkDelete"))">Delete</MudButton></div>}<MudTable T="CrmCompany" Items="_visible" Breakpoint="Breakpoint.None" Hover="true" Elevation="0" Class="crm-companies-table"><HeaderContent><MudTh><MudCheckBox T="bool" Value="_state.AllSelected" ValueChanged="@((bool _) => _state.SelectAll())" aria-label="Select all visible companies" Size="Size.Small" /></MudTh>@foreach(var heading in new[]{"Company","Industry","Size","Owner","Contacts","Open deals","Pipeline value","Status","Last activity",""}){<MudTh>@heading</MudTh>}</HeaderContent><RowTemplate Context="company"><MudTd><MudCheckBox T="bool" Value="@_state.Selected.Contains(company.Id)" ValueChanged="@((bool _) => _state.Toggle(company.Id))" aria-label="@($"Select {company.Name}")" Size="Size.Small" /></MudTd><MudTd><button class="crm-company-name" data-company="@company.Id" @onclick="@(() => _state.Active=company)"><img src="@SourceUserImages.Get(company.Name)" alt="@company.Name" /><span><b>@company.Name</b><small>@company.Domain</small></span></button></MudTd><MudTd>@company.Industry</MudTd><MudTd>@company.Size employees</MudTd><MudTd><span class="crm-company-owner"><i>@company.OwnerInitials</i>@company.Owner</span></MudTd><MudTd><b>@company.Contacts</b></MudTd><MudTd>@company.Deals</MudTd><MudTd><b>@company.PipelineValue</b></MudTd><MudTd><StatusBadge Text="@company.Status" Tone="@_state.Data.Tones[company.Status]" /></MudTd><MudTd><p>@company.ActivityLabel</p><small>@company.Activity</small></MudTd><MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => _state.Active=company)">View</MudButton></MudTd></RowTemplate></MudTable>@if(_visible.Length==0){<div class="crm-companies-empty"><MudIcon Icon="@RynzoIcons.Get("Building2")" /><b>No matching companies</b><p>Try adjusting your filters or search terms.</p><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Reset">Clear filters</MudButton></div>}<footer><span>Showing 1-@_visible.Length of 3,842 companies</span><div><select aria-label="Page size" @bind="_state.PageSize" @bind:after="Refresh">@foreach(var size in new[]{20,50,100}){<option value="@size">@size</option>}</select><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="true">Previous</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="true">Next</MudButton></div></footer></MudCard></div>
<MudOverlay Visible="DetailsOpen" DarkBackground="true" LockScroll="true" ZIndex="1399" OnClick="Close" /><MudDrawer Open="DetailsOpen" OpenChanged="@((bool open) => {if(!open&&!_modal)_state.Active=null;})" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Overlay="false" Width="576px" Elevation="0" Style="z-index:1400;max-width:100vw;background:var(--card);overflow-y:auto" Class="company-profile-drawer"><MudFocusTrap Disabled="@(!DetailsOpen)">@if(_state.Active is { } company){<CompanyProfilePanel Company="company" Data="_state.Data" Close="Close" Action="ProfileAction" />}</MudFocusTrap></MudDrawer>
@code{
    private readonly CrmCompaniesState _state=new();private CrmCompany[] _visible=[];private bool _modal;private bool DetailsOpen=>_state.Active is not null&&!_modal;private IJSObjectReference? _download;
    private static readonly BreadcrumbItem[] Breadcrumbs=[new("Rynzo",null),new("CRM",null),new("Companies",null,true)];private static readonly string[] FilterLabels=["Company industry filter","Company size filter","Company revenue filter","Company status filter","Company owner filter","Company region filter","Company tag filter","Company activity filter","Company sorting"];
    private static readonly (string,string)[] Metrics=[("Total Companies","3,842"),("Active Accounts","3,126"),("Enterprise","426"),("New This Month","184"),("At Risk","72"),("Pipeline Value","$4.86M")];
    protected override void OnInitialized()=>Refresh();private void Refresh()=>_visible=_state.Visible;private void Search(string value){_state.Query=value;Refresh();}private void Reset(){_state.Reset();Refresh();}private void Close(){if(!_modal)_state.Active=null;}private Task Add(){_state.BeginAdd();return Modal("add");}private Task ProfileAction(string mode){if(_state.Active is null)return Task.CompletedTask;if(mode=="edit")_state.BeginEdit(_state.Active);return Modal(mode);}
    private void BulkArchive(){_state.Bulk(c=>c with{Status="Archived"});Refresh();Snackbar.Add("Selected companies archived",Severity.Success);}
    private async Task Export(bool selected){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await _download.InvokeVoidAsync("csv","crm-companies.csv",_state.Export(selected));Snackbar.Add("Companies export downloaded",Severity.Success);}
    private async Task Modal(string mode){if(mode=="bulkOwner")_state.BulkValue="Sophia Carter";if(mode=="bulkStatus")_state.BulkValue="Customer";if(mode=="bulkTag")_state.BulkValue="Strategic";var name=_state.Active?.Name??"";_modal=true;var dialog=await Dialogs.ShowAsync<CompanyActionDialog>("",new DialogParameters<CompanyActionDialog>{{d=>d.State,_state},{d=>d.Mode,mode}},new DialogOptions{CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small});var result=await dialog.Result;if(result is {Canceled:false}){Refresh();Snackbar.Add(mode.StartsWith("bulk",StringComparison.Ordinal)?"Bulk action completed":mode switch{"add"=>"Company created","edit"=>"Company updated","note"=>"Note added","task"=>"Task created","owner"=>"Account owner assigned","archive"=>"Company archived","contact"=>$"Contact added to {name}","deal"=>$"Deal added to {name}",_=>"Company deleted from demo data"},Severity.Success);}_modal=false;}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}
}
