@page "/crm/pipeline"
@implements IAsyncDisposable
@using System.Globalization
@using Rynzo.Client.Features.Crm.Models
@using Rynzo.Client.Assets
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Pipeline | Rynzo</PageTitle>
<div class="pipeline-page">
<PageHeader Title="Pipeline" Description="See the next move. Keep every opportunity moving forward."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export pipeline</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(()=>Add("Qualification"))">Add deal</MudButton></Actions></PageHeader>
<MudCard Class="pipeline-overview rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="pipeline-overview-title"><span><MudIcon Icon="@RynzoIcons.Get("Layers")" /></span><div><small>SALES WORKSPACE</small><h2>Your revenue, in motion.</h2><p>Sample opportunities. Changes last for this session.</p></div></div><div class="pipeline-metrics"><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>Open pipeline</small><b>@Money(OpenDeals.Sum(d=>d.Value))</b></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>Weighted forecast</small><b>@Money(OpenDeals.Sum(d=>d.Value*d.Probability/100))</b></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>Open opportunities</small><b>@OpenDeals.Count()</b></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>Won revenue</small><b>@Money(_deals.Where(d=>d.Stage=="Closed Won").Sum(d=>d.Value))</b></MudCard></div></MudCard>
<section class="pipeline-board"><header class="pipeline-toolbar"><div><span class="pipeline-eyebrow">OPPORTUNITY BOARD</span><h2>Sales pipeline <span>@Filtered.Count() deals</span></h2></div><div class="pipeline-controls"><MudTextField T="string" @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search deals or companies..." aria-label="Search pipeline" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Pipeline owner" @bind="_owner"><option>All owners</option>@foreach(var owner in CrmDealSource.Owners){<option>@owner</option>}</select><select aria-label="Pipeline sorting" @bind="_sort"><option>Newest first</option><option>Highest value</option><option>Highest probability</option></select><MudButton Variant="Variant.Text" OnClick="Reset">Reset</MudButton></div></header><div class="pipeline-board-hint"><span><MudIcon Icon="@RynzoIcons.Get("GripVertical")" />Drag deals between stages, or use Move on a card.</span><span>@Money(Filtered.Sum(d=>d.Value)) in view</span></div>
<div class="pipeline-scroll" tabindex="0" aria-label="Sales pipeline board"><div class="pipeline-columns">@foreach(var stage in CrmDealSource.Stages.Where(s=>s!="Archived")){var cards=Filtered.Where(d=>d.Stage==stage).ToArray();<section class="pipeline-column @(_drag is not null?"is-dragging":"")" data-stage="@stage" @ondragover:preventDefault="true" @ondrop="@(()=>Drop(stage))"><header><div><span class="pipeline-stage-dot" style="@($"background:var(--{StageTone(stage)})")"></span><h3>@stage</h3><b>@cards.Length</b><MudIconButton Icon="@RynzoIcons.Get("Plus")" Size="Size.Small" aria-label="@($"Add deal to {stage}")" OnClick="@(()=>Add(stage))" /></div><p>@Money(cards.Sum(d=>d.Value)) <span>total value</span></p></header><div class="pipeline-cards">@foreach(var deal in cards){<MudCard @key="deal.Id" Class="pipeline-card rynzo-widget-card" draggable="true" data-deal="@deal.Id" @ondragstart="@(()=>_drag=deal.Id)" @ondragend="@(()=>_drag=null)" Elevation="0" Outlined="true" data-widget-element="article"><div class="pipeline-card-company"><span><MudIcon Icon="@RynzoIcons.Get("Building2")" />@deal.Company</span><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" Size="Size.Small" aria-label="@($"View {deal.Name}")" OnClick="@(()=>_active=deal)" /></div><button class="pipeline-deal-open" @onclick="@(()=>_active=deal)"><b>@deal.Name</b><small>@deal.Contact</small><strong>@Money(deal.Value)</strong></button><div class="pipeline-probability"><span>Win probability <b>@deal.Probability%</b></span><i><em style="@($"width:{deal.Probability}%;background:var(--{StageTone(stage)})")"></em></i></div><div class="pipeline-next"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" /><span>@deal.Close</span><small>@deal.Next</small></div><footer><span><img src="@SourceUserImages.Get(deal.Owner)" alt="" />@deal.Owner</span><button type="button" class="pipeline-move" aria-label="@($"Move {deal.Name}")" @onclick="@(()=>OpenMove(deal))">Move <MudIcon Icon="@RynzoIcons.Get("ChevronRight")" /></button></footer></MudCard>}@if(cards.Length==0){<div class="pipeline-empty"><MudIcon Icon="@RynzoIcons.Get(stage=="Closed Won"?"Trophy":"Layers")" /><b>No deals here yet</b><span>Move an opportunity into this stage.</span></div>}</div><MudButton Variant="Variant.Text" StartIcon="@RynzoIcons.Get("Plus")" Class="pipeline-add" OnClick="@(()=>Add(stage))">Add deal</MudButton></section>}</div></div>
@if(_deals.Any(d=>d.Stage=="Archived")){<p class="pipeline-archived">@_deals.Count(d=>d.Stage=="Archived") archived deals remain in the session.</p>}
</section></div>
<MudOverlay Visible="@(_active is not null&&!_editing&&!_moving)" DarkBackground="true" ZIndex="1399" OnClick="@(()=>_active=null)" />
<MudDrawer Open="@(_active is not null&&!_editing&&!_moving)" OpenChanged="@((bool open)=>{if(!open&&!_editing&&!_moving)_active=null;})" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Overlay="false" Width="460px" Elevation="0" Style="z-index:1400;max-width:100%;background:var(--card);overflow-y:auto"><MudFocusTrap>@if(_active is {} deal){<div class="pipeline-detail"><header><div><small class="pipeline-eyebrow">OPPORTUNITY DETAILS</small><h2>@deal.Name</h2><p>@deal.Company</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close pipeline details" OnClick="@(()=>_active=null)" /></header><div class="pipeline-detail-value"><small>Deal value</small><b>@Money(deal.Value)</b><span>@Money(deal.Value*deal.Probability/100) weighted forecast</span></div><dl>@foreach(var field in new[]{("Stage",deal.Stage),("Probability",deal.Probability+"%"),("Contact",deal.Contact),("Role",deal.Role),("Owner",deal.Owner),("Close date",deal.Close),("Source",deal.Source),("Next step",deal.Next)}){<div><dt>@field.Item1</dt><dd>@field.Item2</dd></div>}</dl><section><h3>Activity</h3><p>@deal.Activity</p></section><section><h3>Notes &amp; tasks</h3>@foreach(var note in deal.Notes.Concat(deal.Tasks)){<p>@note</p>}@if(deal.Notes.Length+deal.Tasks.Length==0){<p>No notes or tasks yet.</p>}</section><div class="pipeline-detail-tags">@foreach(var tag in deal.Tags){<span>@tag</span>}</div><footer><MudButton Variant="Variant.Outlined" OnClick="@(()=>Edit(deal))">Edit deal</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(()=>OpenMove(deal))">Move stage</MudButton></footer></div>}</MudFocusTrap></MudDrawer>
@if(_editing||_moving){<MudDialog Visible="true" VisibleChanged="@((bool visible)=>{if(!visible)CloseModal();})" Options="ModalOptions"><TitleContent><h2 class="pipeline-modal-title">@(_moving?"Move opportunity":_draftId is null?"New opportunity":"Edit opportunity")</h2></TitleContent><DialogContent>@if(_moving){<p class="pipeline-modal-description">Choose the next stage for @_active?.Name.</p><label class="pipeline-field"><span>Stage</span><select aria-label="Move pipeline stage" @bind="_draftStage">@foreach(var stage in CrmDealSource.Stages){<option>@stage</option>}</select></label>}else{<div class="pipeline-form"><label class="pipeline-field full"><span>Deal name</span><input aria-label="Deal name" @bind="_draftName" placeholder="e.g. Enterprise expansion" /></label><label class="pipeline-field"><span>Company</span><input aria-label="Deal company" @bind="_draftCompany" /></label><label class="pipeline-field"><span>Primary contact</span><input aria-label="Deal contact" @bind="_draftContact" /></label><label class="pipeline-field"><span>Value (USD)</span><input aria-label="Deal value" type="number" min="0" @bind="_draftValue" /></label><label class="pipeline-field"><span>Win probability (%)</span><input aria-label="Deal probability" type="number" min="0" max="100" @bind="_draftProbability" /></label><label class="pipeline-field"><span>Stage</span><select aria-label="Deal stage" @bind="_draftStage">@foreach(var stage in CrmDealSource.Stages){<option>@stage</option>}</select></label><label class="pipeline-field"><span>Owner</span><select aria-label="Deal owner" @bind="_draftOwner">@foreach(var owner in CrmDealSource.Owners){<option>@owner</option>}</select></label><label class="pipeline-field"><span>Expected close</span><input aria-label="Deal close" @bind="_draftClose" placeholder="e.g. Sep 30" /></label><label class="pipeline-field"><span>Next step</span><input aria-label="Deal next step" @bind="_draftNext" /></label></div>}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="CloseModal">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@(_moving?"Move deal":"Save deal")</MudButton></DialogActions></MudDialog>}
@code{
    private readonly List<CrmDeal> _deals=CrmDealSource.Deals.ToList();
    private string _query="",_owner="All owners",_sort="Newest first";
    private int? _drag,_draftId;
    private CrmDeal? _active;
    private bool _editing,_moving;
    private string _draftName="",_draftCompany="",_draftContact="",_draftStage="Qualification",_draftOwner="Sophia Carter",_draftClose="",_draftNext="";
    private decimal _draftValue;
    private int _draftProbability=50;
    private IJSObjectReference? _download;
    private static readonly DialogOptions ModalOptions=new(){CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small};
    private IEnumerable<CrmDeal> OpenDeals=>_deals.Where(d=>d.Stage is not ("Closed Won" or "Closed Lost" or "Archived"));
    private IEnumerable<CrmDeal> Filtered{get{var rows=_deals.Where(d=>d.Stage!="Archived"&&(_owner=="All owners"||d.Owner==_owner)&&$"{d.Name} {d.Company} {d.Contact} {d.Owner}".Contains(_query,StringComparison.OrdinalIgnoreCase));return _sort switch{"Highest value"=>rows.OrderByDescending(d=>d.Value),"Highest probability"=>rows.OrderByDescending(d=>d.Probability),_=>rows.OrderByDescending(d=>d.Id)};}}
    private static string Money(decimal value)=>value.ToString("C0",CultureInfo.GetCultureInfo("en-US"));
    private static string StageTone(string stage)=>stage switch{"Discovery"=>"info","Proposal"=>"warning","Negotiation"=>"chart-3","Contract"=>"info","Closed Won"=>"success","Closed Lost"=>"destructive",_=>"primary"};
    private void Reset(){_query="";_owner="All owners";_sort="Newest first";}
    private void Drop(string stage){if(_drag is {} id)Move(id,stage);_drag=null;}
    private void Move(int id,string stage){var index=_deals.FindIndex(d=>d.Id==id);if(index<0)return;var deal=_deals[index];_deals[index]=deal with{Stage=stage,Probability=stage=="Closed Won"?100:stage=="Closed Lost"?0:deal.Probability,Activity=$"Moved to {stage}"};if(_active?.Id==id)_active=_deals[index];Snackbar.Add($"Deal moved to {stage}",Severity.Success);}
    private void OpenMove(CrmDeal deal){_active=deal;_draftStage=deal.Stage;_moving=true;}
    private void Add(string stage){_active=null;_draftId=null;_draftName="";_draftCompany="";_draftContact="";_draftValue=0;_draftProbability=50;_draftOwner=CrmDealSource.Owners[0];_draftStage=stage;_draftClose="";_draftNext="";_editing=true;}
    private void Edit(CrmDeal deal){_draftId=deal.Id;_draftName=deal.Name;_draftCompany=deal.Company;_draftContact=deal.Contact;_draftValue=deal.Value;_draftProbability=deal.Probability;_draftOwner=deal.Owner;_draftStage=deal.Stage;_draftClose=deal.Close;_draftNext=deal.Next;_editing=true;}
    private void CloseModal(){_moving=false;_editing=false;}
    private void Save(){if(_moving){if(_active is {} deal)Move(deal.Id,_draftStage);CloseModal();return;}if(string.IsNullOrWhiteSpace(_draftName)||_draftValue<0||_draftProbability is <0 or >100){Snackbar.Add("Enter a deal name, a non-negative value, and probability from 0 to 100.",Severity.Error);return;}var existing=_deals.FirstOrDefault(d=>d.Id==_draftId);var updated=new CrmDeal(existing?.Id??(_deals.Count==0?1:_deals.Max(d=>d.Id)+1),_draftName.Trim(),_draftCompany,_draftContact,existing?.Role??"Contact",_draftStage,_draftStage=="Closed Won"?100:_draftStage=="Closed Lost"?0:_draftProbability,_draftValue,_draftOwner,_draftClose,existing?.CloseType??"This Month",existing?.Source??"Manual",_draftNext,"Deal updated",existing?.Tags??[],existing?.Notes??[],existing?.Tasks??[]);if(existing is null)_deals.Add(updated);else _deals[_deals.FindIndex(d=>d.Id==existing.Id)]=updated;_active=null;CloseModal();Snackbar.Add("Deal saved",Severity.Success);}
    private async Task Export(){static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var csv="Deal,Company,Contact,Stage,Owner,Value,Probability,Expected close\n"+string.Join("\n",Filtered.Select(d=>string.Join(",",new[]{d.Name,d.Company,d.Contact,d.Stage,d.Owner,d.Value.ToString(CultureInfo.InvariantCulture),d.Probability.ToString(CultureInfo.InvariantCulture),d.Close}.Select(Cell))));_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await _download.InvokeVoidAsync("csv","crm-pipeline.csv",csv);Snackbar.Add("Pipeline export downloaded",Severity.Success);}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}
}
