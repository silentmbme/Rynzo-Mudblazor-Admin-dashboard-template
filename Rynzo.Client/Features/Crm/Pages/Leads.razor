@page "/crm/leads"
@implements IAsyncDisposable
@using Rynzo.Client.Features.Crm.Models
@using Rynzo.Client.Features.Crm.Services
@using Rynzo.Client.Features.Crm.Components
@using Rynzo.Client.Assets
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Leads | Rynzo</PageTitle>
<div class="crm-leads-page">
    <PageHeader Title="Leads" Description="Build relationships. Turn promising prospects into opportunities."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="@(()=>Export(false))">Export leads</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("UserPlus")" OnClick="Add">Add lead</MudButton></Actions></PageHeader>
    <section class="lead-performance" aria-label="Lead performance"><div class="lead-performance-label"><span><MudIcon Icon="@RynzoIcons.Get("ChartNoAxesCombined")" /></span><div><b>Your lead portfolio</b><small>Sales workspace overview</small></div></div><div class="lead-performance-metrics">@foreach(var metric in Metrics){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>@metric.Item1</small><b>@metric.Item2</b></MudCard>}</div></section>
    <div class="lead-workbench">
        <aside class="lead-filter-panel">
            <header><span class="lead-eyebrow">REFINE YOUR WORKSPACE</span><h2>Lead filters</h2><p>Find the right conversation.</p></header>
            <nav class="lead-stage-nav" aria-label="Lead stages">@foreach(var stage in _state.Data.Filters[0]){<button type="button" class="@(_state.Filters[0]==stage?"is-active":"")" aria-pressed="@(_state.Filters[0]==stage)" @onclick="@(()=>{_state.Filters[0]=stage;Refresh();})"><span>@stage</span><b>@_state.Leads.Count(l=>stage==_state.Data.Filters[0][0]||l.Stage==stage)</b></button>}</nav>
            <details class="lead-advanced-filters" open><summary>Advanced filters <MudIcon Icon="@RynzoIcons.Get("SlidersHorizontal")" /></summary><div class="lead-filter-fields">@for(var index=1;index<_state.Data.Filters.Length;index++){var filter=index;<label><span>@FilterLabels[filter].Replace("Lead ","").Replace(" filter","")</span><select aria-label="@FilterLabels[filter]" @bind="_state.Filters[filter]" @bind:after="Refresh">@foreach(var option in _state.Data.Filters[filter]){<option>@option</option>}</select></label>}</div></details>
            <MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("RotateCcw")" FullWidth="true" OnClick="Reset">Reset filters</MudButton>
            <div class="lead-sidebar-note"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /><p>Session workspace<small>Changes apply to sample records.</small></p></div>
        </aside>
        <section class="lead-directory">
            <header class="lead-directory-header"><div><span class="lead-eyebrow">RELATIONSHIPS IN PROGRESS</span><h2>@(_state.Filters[0]==_state.Data.Filters[0][0]?"All prospects":_state.Filters[0]+" leads") <span>@_visible.Length</span></h2><p>Every contact. A clear next step.</p></div><div class="lead-directory-tools"><MudTextField T="string" Value="_state.Query" ValueChanged="Search" Immediate="true" Placeholder="Search prospects..." aria-label="Search leads" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /></div></header>
            <div class="lead-list-toolbar"><label><MudCheckBox T="bool" Value="_state.AllSelected" ValueChanged="@((bool _)=>_state.SelectAll())" aria-label="Select all visible leads" Size="Size.Small" /><span>Select all</span></label><span>@_visible.Count(l=>l.Score>=80) hot leads in view</span><span class="lead-list-count">@_visible.Length matching prospects</span></div>
            @if(_state.Selected.Count>0){<div class="crm-leads-bulk"><b>@_state.Selected.Count selected</b><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(()=>Modal("bulkOwner"))">Assign owner</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(()=>Modal("bulkStage"))">Change stage</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(()=>Modal("bulkTag"))">Add tag</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="BulkArchive">Archive</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(()=>Export(true))">Export</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(()=>Modal("bulkDelete"))">Delete</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(()=>_state.Selected.Clear())">Clear</MudButton></div>}
            <div class="lead-prospect-list">@foreach(var lead in _visible){<MudCard @key="lead.Id" Class="@((($"lead-prospect {(_state.Selected.Contains(lead.Id)?"is-selected":"")}")) + " rynzo-widget-card")" Elevation="0" Outlined="true" data-widget-element="article">
                <div class="lead-prospect-main"><MudCheckBox T="bool" Value="@_state.Selected.Contains(lead.Id)" ValueChanged="@((bool _)=>_state.Toggle(lead.Id))" aria-label="@($"Select {lead.Name}")" Size="Size.Small" /><button class="crm-lead-name" data-lead="@lead.Id" @onclick="@(()=>_state.Active=lead)"><img src="@SourceUserImages.Get(lead.Name)" alt="@lead.Name" /><span><b>@lead.Name</b><small>@lead.Role <i>/</i> @lead.Company</small></span></button><div class="lead-stage"><StatusBadge Text="@lead.Stage" Tone="@_state.Data.Tones[lead.Stage]" /></div><div class="lead-value"><b>@lead.ValueText</b><small>@lead.Probability% probability</small></div><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"View {lead.Name}")" OnClick="@(()=>_state.Active=lead)" /></div>
                <div class="lead-prospect-body"><div class="lead-contact"><span class="lead-data-label">CONTACT &amp; SOURCE</span><a href="@($"mailto:{lead.Email}")">@lead.Email</a><small>@lead.Source</small></div><div class="lead-qualification-data"><span class="lead-data-label">QUALIFICATION</span><div class="lead-score"><b>@lead.Score</b><span>@lead.ScoreKind</span><i><em style="@($"width:{Math.Clamp(lead.Score,0,100)}%")"></em></i></div></div><div class="lead-followup"><span class="lead-data-label">NEXT FOLLOW-UP</span><b class="@(lead.FollowKind=="Overdue"?"lead-overdue":"")"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />@lead.Follow</b><small>@lead.FollowKind</small></div><div class="lead-owner"><span class="lead-data-label">LEAD OWNER</span><span><img src="@SourceUserImages.Get(lead.Owner)" alt="" />@lead.Owner</span></div></div>
                <footer><span class="lead-activity"><MudIcon Icon="@RynzoIcons.Get("Clock3")" />@lead.Activity <small>@lead.ActivityLabel</small></span><div class="lead-tags">@foreach(var tag in lead.Tags){<span>@tag</span>}</div></footer>
            </MudCard>}</div>
            @if(_visible.Length==0){<div class="crm-leads-empty"><MudIcon Icon="@RynzoIcons.Get("UserRoundSearch")" /><b>No matching leads</b><p>Try adjusting your filters or search terms.</p><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Reset">Clear filters</MudButton></div>}
            <footer class="lead-directory-footer"><span>Showing @_visible.Length of 4,862 leads</span><div><label>Per page <select aria-label="Page size" @bind="_state.PageSize" @bind:after="Refresh">@foreach(var size in PageSizes){<option value="@size">@size</option>}</select></label><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="true">Previous</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="true">Next</MudButton></div></footer>
        </section>
    </div>
</div>
<MudOverlay Visible="DetailsOpen" DarkBackground="true" LockScroll="true" ZIndex="1399" OnClick="Close"/><MudDrawer Open="DetailsOpen" OpenChanged="@((bool open)=>{if(!open&&!_modal)_state.Active=null;})" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Overlay="false" Width="576px" Elevation="0" Style="z-index:1400;max-width:100%;background:var(--card);overflow-y:auto" Class="lead-profile-drawer"><MudFocusTrap Disabled="@(!DetailsOpen)">@if(_state.Active is { } lead){<LeadProfilePanel Lead="lead" Data="_state.Data" Close="Close" Action="ProfileAction"/>}</MudFocusTrap></MudDrawer>
@code{private static readonly List<int> PageSizes = new() { 20, 50, 100 };private readonly CrmLeadsState _state=new();private CrmLead[] _visible=[];private bool _modal;private bool DetailsOpen=>_state.Active is not null&&!_modal;private IJSObjectReference? _download;private static readonly BreadcrumbItem[] Breadcrumbs=[new("Rynzo",null),new("CRM",null),new("Leads",null,true)];private static readonly string[] FilterLabels=["Lead stage filter","Lead score filter","Lead source filter","Lead company filter","Lead owner filter","Lead value filter","Lead follow-up filter","Lead tag filter","Lead sorting"];private static readonly (string,string)[] Metrics=[("Total Leads","4,862"),("New","684"),("Qualified","1,248"),("In Nurture","942"),("Hot Leads","318"),("Potential Value","$3.84M")];protected override void OnInitialized()=>Refresh();private void Refresh()=>_visible=_state.Visible;private void Search(string value){_state.Query=value;Refresh();}private void Reset(){_state.Reset();Refresh();}private void Close(){if(!_modal)_state.Active=null;}private Task Add(){_state.BeginAdd();return Modal("add");}private void BulkArchive(){_state.Bulk(l=>l with{Stage="Archived"});Refresh();Snackbar.Add("Selected leads archived",Severity.Success);}private Task ProfileAction(string mode){if(_state.Active is null)return Task.CompletedTask;if(mode=="edit")_state.BeginEdit(_state.Active);return Modal(mode);}private async Task Export(bool selected){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await _download.InvokeVoidAsync("csv","crm-leads.csv",_state.Export(selected));Snackbar.Add("Leads export downloaded",Severity.Success);}private async Task Modal(string mode){if(mode=="bulkOwner")_state.BulkValue="Sophia Carter";if(mode=="bulkStage")_state.BulkValue="Qualified";if(mode=="bulkTag")_state.BulkValue="High Intent";var name=_state.Active?.Name??"";_modal=true;var dialog=await Dialogs.ShowAsync<LeadActionDialog>("",new DialogParameters<LeadActionDialog>{{d=>d.State,_state},{d=>d.Mode,mode}},new DialogOptions{CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small});var result=await dialog.Result;if(result is {Canceled:false}){Refresh();Snackbar.Add(mode.StartsWith("bulk",StringComparison.Ordinal)?"Bulk action completed":mode switch{"add"=>"Lead created","edit"=>"Lead updated","note"=>"Note added","task"=>"Follow-up task created","owner"=>"Lead owner assigned","stage"=>"Lead stage updated","convert"=>"Lead converted and related deal created","disqualify"=>"Lead disqualified","archive"=>"Lead archived","delete"=>"Lead deleted from demo data",_=>$"Lead action completed for {name}"},Severity.Success);}_modal=false;}public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}}
