@page "/crm/contacts"
@implements IAsyncDisposable
@using Rynzo.Client.Features.Crm.Models
@using Rynzo.Client.Features.Crm.Services
@using Rynzo.Client.Features.Crm.Components
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Contacts | Rynzo</PageTitle>
<div class="crm-contacts-page"><header><PageHeader Title="Contacts" Description="Manage people, relationships, ownership and engagement across your CRM." Breadcrumbs="Breadcrumbs" /><nav><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="@(() => Export(false))">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("UserPlus")" OnClick="Add">Add contact</MudButton></nav></header><MudCard Class="crm-contacts-summary rynzo-widget-card" Elevation="0" Outlined="true">@foreach(var metric in Metrics){<div><small>@metric.Item1</small><b>@metric.Item2</b></div>}</MudCard><MudCard Class="crm-contacts-workspace rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="crm-contacts-filters"><MudTextField T="string" Value="_state.Query" ValueChanged="Search" Immediate="true" Placeholder="Search people, company, title or tags" aria-label="Search contacts" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><div>@for(var index=0;index<_state.Data.Filters.Length;index++){var filter=index;<select aria-label="@FilterLabels[filter]" @bind="_state.Filters[filter]" @bind:after="Refresh">@foreach(var option in _state.Data.Filters[filter]){<option>@option</option>}</select>}<MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Reset">Reset filters</MudButton></div></div>@if(_state.Selected.Count>0){<div class="crm-contacts-bulk"><b>@_state.Selected.Count selected</b><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Modal("bulkOwner"))">Assign owner</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Modal("bulkStatus"))">Change status</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Modal("bulkTag"))">Add tag</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="BulkArchive">Archive</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Export(true))">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="@(() => Modal("bulkDelete"))">Delete</MudButton></div>}<MudTable T="CrmContact" Items="_visible" Breakpoint="Breakpoint.None" Hover="true" Elevation="0" Class="crm-contacts-table"><HeaderContent><MudTh><MudCheckBox T="bool" Value="_state.AllSelected" ValueChanged="@((bool _) => _state.SelectAll())" aria-label="Select all visible contacts" Size="Size.Small" /></MudTh>@foreach(var heading in new[]{"Contact","Company","Role","Owner","Status","Source","Last activity","Next follow-up","Deal value",""}){<MudTh>@heading</MudTh>}</HeaderContent><RowTemplate Context="contact"><MudTd><MudCheckBox T="bool" Value="@_state.Selected.Contains(contact.Id)" ValueChanged="@((bool _) => _state.Toggle(contact.Id))" aria-label="@($"Select {contact.Name}")" Size="Size.Small" /></MudTd><MudTd><button class="crm-contact-name" data-contact="@contact.Id" @onclick="@(() => _state.Active=contact)"><img src="@Rynzo.Client.Assets.SourceUserImages.Get(contact.Name)" alt="@contact.Name" /><span><b>@contact.Name</b><small>@contact.Email</small></span></button></MudTd><MudTd><b>@contact.Company</b><small class="crm-contact-industry">@contact.Industry</small></MudTd><MudTd>@contact.Role</MudTd><MudTd><span class="crm-contact-owner"><i>@contact.OwnerInitials</i>@contact.Owner</span></MudTd><MudTd><StatusBadge Text="@contact.Status" Tone="@_state.Data.StatusTone[contact.Status]" /></MudTd><MudTd>@contact.Source</MudTd><MudTd><p>@contact.ActivityLabel</p><small>@contact.Activity</small></MudTd><MudTd><span class="@(contact.Overdue?"crm-contact-overdue":"")">@contact.FollowUp</span></MudTd><MudTd><b>@contact.DealValue</b><small class="crm-contact-score">@contact.Score score</small></MudTd><MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => _state.Active=contact)">View</MudButton></MudTd></RowTemplate></MudTable>@if(_visible.Length==0){<div class="crm-contacts-empty"><MudIcon Icon="@RynzoIcons.Get("ContactRound")" /><b>No matching contacts</b><p>Try adjusting your filters or search terms.</p><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Reset">Clear filters</MudButton></div>}<footer><span>Showing 1-@_visible.Length of 12,486 contacts</span><div><select aria-label="Page size" @bind="_state.PageSize" @bind:after="Refresh">@foreach(var size in new[]{20,50,100}){<option value="@size">@size</option>}</select><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="true">Previous</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="true">Next</MudButton></div></footer></MudCard></div>
<MudOverlay Visible="DetailsOpen" DarkBackground="true" LockScroll="true" ZIndex="1399" OnClick="Close" /><MudDrawer Open="DetailsOpen" OpenChanged="@((bool open) => {if(!open&&!_modal)_state.Active=null;})" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Overlay="false" Width="576px" Elevation="0" Style="z-index:1400;max-width:100vw;background:var(--card);overflow-y:auto" Class="contact-profile-drawer"><MudFocusTrap Disabled="@(!DetailsOpen)">@if(_state.Active is { } contact){<ContactProfilePanel Contact="contact" Data="_state.Data" Close="Close" Action="ProfileAction" />}</MudFocusTrap></MudDrawer>
@code{
    private readonly CrmContactsState _state=new();private CrmContact[] _visible=[];private bool _modal;private bool DetailsOpen=>_state.Active is not null&&!_modal;private IJSObjectReference? _download;
    private static readonly BreadcrumbItem[] Breadcrumbs=[new("Rynzo",null),new("CRM",null),new("Contacts",null,true)];
    private static readonly string[] FilterLabels=["Contact type filter","Contact status filter","Contact company filter","Contact owner filter","Contact source filter","Contact tag filter","Contact activity filter","Contact sorting"];
    private static readonly (string,string)[] Metrics=[("Total Contacts","12,486"),("Active","9,842"),("New This Month","684"),("Qualified","2,146"),("Needs Follow-up","318"),("VIP / Strategic","126")];
    protected override void OnInitialized()=>Refresh();private void Refresh()=>_visible=_state.Visible;private void Search(string value){_state.Query=value;Refresh();}private void Reset(){_state.Reset();Refresh();}private void Close(){if(!_modal)_state.Active=null;}private Task Add(){_state.BeginAdd();return Modal("add");}
    private void BulkArchive(){_state.Bulk(c=>c with{Status="Archived"});Refresh();Snackbar.Add("Selected contacts archived",Severity.Success);}
    private Task ProfileAction(string mode){if(_state.Active is null)return Task.CompletedTask;if(mode is "email" or "call"){Snackbar.Add(mode=="email"?$"Compose email to {_state.Active.Email}":$"Call action ready for {_state.Active.Phone}",Severity.Success);return Task.CompletedTask;}if(mode=="edit")_state.BeginEdit(_state.Active);return Modal(mode);}
    private async Task Export(bool selected){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await _download.InvokeVoidAsync("csv","crm-contacts.csv",_state.Export(selected));Snackbar.Add("Contacts export downloaded",Severity.Success);}
    private async Task Modal(string mode){if(mode=="bulkOwner")_state.BulkValue="Sophia Carter";if(mode=="bulkStatus")_state.BulkValue="Qualified";if(mode=="bulkTag")_state.BulkValue="Enterprise";_modal=true;var dialog=await Dialogs.ShowAsync<ContactActionDialog>("",new DialogParameters<ContactActionDialog>{{d=>d.State,_state},{d=>d.Mode,mode}},new DialogOptions{CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small});var result=await dialog.Result;if(result is {Canceled:false}){Refresh();Snackbar.Add(mode.StartsWith("bulk",StringComparison.Ordinal)?"Bulk action completed":mode switch{"add"=>"Contact created","edit"=>"Contact updated","note"=>"Note added","task"=>"Follow-up task created","owner"=>"Contact owner assigned","archive"=>"Contact archived",_=>"Contact deleted from demo data"},Severity.Success);}_modal=false;}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}
}
