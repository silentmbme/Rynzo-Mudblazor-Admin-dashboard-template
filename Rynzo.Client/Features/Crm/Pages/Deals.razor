@page "/crm/deals"
@using System.Globalization
@using Rynzo.Client.Features.Crm.Models
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Deals | Rynzo</PageTitle>
<div class="crm-deals-page">
<PageHeader Title="Deals" Description="Move opportunities forward and keep your revenue forecast in focus."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export deals</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenAdd">Add deal</MudButton></Actions></PageHeader>
<MudCard Class="crm-deals-summary rynzo-widget-card" Elevation="0" Outlined="true">@foreach(var metric in Metrics){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><small>@metric.Item1</small><b>@metric.Item2</b></MudCard>}</MudCard>
<section class="deal-pipeline" aria-label="Pipeline stages"><header><div><small class="deal-eyebrow">SALES PIPELINE</small><h2>Every stage, a step closer.</h2></div><button type="button" @onclick="@(()=>_stage="All stages")">View all opportunities <MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></button></header><div class="deal-stage-grid">@foreach(var stage in CrmDealSource.Stages.Take(5)){<button type="button" class="deal-stage @(_stage==stage?"is-active":"")" aria-pressed="@(_stage==stage)" @onclick="@(()=>_stage=stage)"><span><i></i>@stage<b>@_deals.Count(d=>d.Stage==stage)</b></span><strong>@Money(_deals.Where(d=>d.Stage==stage).Sum(d=>d.Value))</strong><small>Pipeline value</small></button>}</div></section>
<MudCard Class="crm-deals-workspace rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header class="deal-library-heading"><div><small class="deal-eyebrow">OPPORTUNITY WORKSPACE</small><h2>Deal directory <span>@Visible.Count() deals</span></h2><p>Track ownership, next steps, and expected revenue.</p></div><span class="deal-session">Session workspace</span></header>        <div class="crm-deals-filterbar"><input @bind="_query" placeholder="Search deals, companies, contacts..." aria-label="Search deals" /><select @bind="_stage"><option>All stages</option>@foreach(var x in CrmDealSource.Stages){<option>@x</option>}</select><select @bind="_probability"><option>All probabilities</option>@foreach(var x in new[]{"0-25%","26-50%","51-75%","76-99%","100%"}){<option>@x</option>}</select><select @bind="_company"><option>All companies</option>@foreach(var x in Companies){<option>@x</option>}</select><select @bind="_owner"><option>All owners</option>@foreach(var x in CrmDealSource.Owners){<option>@x</option>}</select><select @bind="_value"><option>All values</option>@foreach(var x in new[]{"Under $10K","$10K-$50K","$50K-$100K","$100K-$250K","$250K+"}){<option>@x</option>}</select><select @bind="_close"><option>Any close</option>@foreach(var x in new[]{"This Week","This Month","Next Month","This Quarter","Overdue","No Close Date"}){<option>@x</option>}</select><select @bind="_source"><option>All sources</option>@foreach(var x in Sources){<option>@x</option>}</select><select @bind="_tag"><option>All tags</option>@foreach(var x in Tags){<option>@x</option>}</select><select @bind="_sort"><option>Recently Created</option><option>Highest Value</option><option>Lowest Value</option><option>Highest Probability</option><option>Company A-Z</option><option>Deal Name A-Z</option></select><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Reset">Reset filters</MudButton></div>
        @if(_selected.Count>0){<div class="crm-deals-bulk"><b>@_selected.Count selected</b><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>OpenBulk("owner"))">Assign owner</MudButton><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>OpenBulk("stage"))">Change stage</MudButton><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>OpenBulk("tag"))">Add tag</MudButton><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ArchiveSelected">Archive</MudButton><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ExportSelected">Export</MudButton><MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="@(()=>OpenBulk("delete"))">Delete</MudButton></div>}
        <MudTable Items="Visible" Hover="true" Elevation="0" Breakpoint="Breakpoint.None" Class="deals-table"><HeaderContent><MudTh><MudCheckBox T="bool" Value="@AllSelected" ValueChanged="@((bool _) => SelectAll())" aria-label="Select all visible deals" Size="Size.Small" /></MudTh><MudTh>Deal</MudTh><MudTh>Company</MudTh><MudTh>Stage</MudTh><MudTh>Probability</MudTh><MudTh>Value</MudTh><MudTh>Owner</MudTh><MudTh>Expected close</MudTh><MudTh>Source</MudTh><MudTh></MudTh></HeaderContent><RowTemplate Context="deal"><MudTd><MudCheckBox T="bool" Value="@_selected.Contains(deal.Id)" ValueChanged="@((bool _) => Toggle(deal.Id))" aria-label="@($"Select {deal.Name}")" Size="Size.Small" /></MudTd><MudTd><button class="crm-deal-name" @onclick="@(()=>_active=deal)"><b>@deal.Name</b><small>@deal.Contact · @deal.Role</small></button></MudTd><MudTd>@deal.Company</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="Tone(deal.Stage)">@deal.Stage</MudChip></MudTd><MudTd><div class="deal-probability"><b>@deal.Probability%</b><span><i style="@($"width:{Math.Clamp(deal.Probability,0,100)}%")"></i></span></div></MudTd><MudTd><b>@Money(deal.Value)</b><small>@Money(deal.Value*deal.Probability/100) weighted</small></MudTd><MudTd>@deal.Owner</MudTd><MudTd>@deal.Close</MudTd><MudTd>@deal.Source</MudTd><MudTd><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>_active=deal)" StartIcon="@RynzoIcons.Get("ArrowUpRight")">Details</MudButton></MudTd></RowTemplate></MudTable>
        @if(!Visible.Any()){<div class="crm-deals-empty"><b>No matching deals</b><p>Try adjusting your filters or search terms.</p><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Reset">Clear filters</MudButton></div>}
    </MudCard>
</div>
<MudOverlay Visible="@(_active is not null && _modal is null)" DarkBackground="true" OnClick="CloseActive" />
<MudDrawer Open="@(_active is not null && _modal is null)" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Overlay="false" Width="560px" Style="max-width:100%;background:var(--card);overflow-y:auto" Class="crm-deal-drawer">
    @if (_active is { } deal)
    {
        <div class="crm-deal-detail">
            <header><div><h2>@deal.Name</h2><p>@deal.Company · @deal.Contact</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" OnClick="CloseActive" aria-label="Close deal" /></header>
            <div class="crm-deal-detail-metrics"><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>Value</small><b>@Money(deal.Value)</b></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>Probability</small><b>@deal.Probability%</b></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>Stage</small><b>@deal.Stage</b></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>Owner</small><b>@deal.Owner</b></MudCard></div>
            <section><h3>Activity</h3><p>@deal.Activity</p><p>Next: @deal.Next</p></section>
            <section><header><h3>Notes</h3><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(()=>OpenModal("note"))">Add note</MudButton></header>@foreach(var note in deal.Notes){<p>@note</p>}@if(deal.Notes.Length==0){<small>No notes yet.</small>}</section>
            <section><header><h3>Tasks</h3><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(()=>OpenModal("task"))">Add task</MudButton></header>@foreach(var task in deal.Tasks){<p>@task</p>}@if(deal.Tasks.Length==0){<small>No tasks yet.</small>}</section>
            <footer><MudButton Variant="Variant.Outlined" OnClick="@(()=>OpenModal("edit"))">Edit</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(()=>OpenModal("owner"))">Assign owner</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(()=>OpenModal("stage"))">Change stage</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(()=>OpenModal("activity"))">Log activity</MudButton><MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="@(deal.Stage=="Closed Won")" OnClick="@(()=>OpenModal("won"))">Mark won</MudButton><MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="@(()=>OpenModal("lost"))">Mark lost</MudButton><MudButton Variant="Variant.Outlined" OnClick="Duplicate">Duplicate</MudButton><MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@(()=>OpenModal("delete"))">Delete</MudButton></footer>
        </div>
    }
</MudDrawer>
@if(_modal is not null){<MudDialog @bind-Visible="ModalVisible"><TitleContent><div class="deal-modal-title"><MudText Typo="Typo.h6" HtmlTag="h2">@ModalTitle</MudText><MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Close dialog" ButtonType="ButtonType.Button" OnClick="@(() => ModalVisible=false)" /></div></TitleContent><DialogContent>@if(_modal is "add" or "edit"){<MudGrid Spacing="2"><MudItem xs="12" sm="6"><label class="deal-field-label">Deal name</label><MudTextField T="string" @bind-Value="_form.Name" aria-label="Deal name" Variant="Variant.Outlined" Required="true" /></MudItem><MudItem xs="12" sm="6"><label class="deal-field-label">Company</label><MudTextField T="string" @bind-Value="_form.Company" aria-label="Company" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" sm="6"><label class="deal-field-label">Primary contact</label><MudTextField T="string" @bind-Value="_form.Contact" aria-label="Primary contact" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" sm="6"><label class="deal-field-label">Stage</label><MudSelect T="string" @bind-Value="_form.Stage" aria-label="Stage" Variant="Variant.Outlined">@foreach(var x in CrmDealSource.Stages){<MudSelectItem Value="@x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" sm="6"><label class="deal-field-label">Value</label><MudNumericField T="decimal" @bind-Value="_form.Value" aria-label="Value" Variant="Variant.Outlined" Min="0" /></MudItem><MudItem xs="12" sm="6"><label class="deal-field-label">Probability %</label><MudNumericField T="int" @bind-Value="_form.Probability" aria-label="Probability %" Variant="Variant.Outlined" Min="0" Max="100" /></MudItem><MudItem xs="12" sm="6"><label class="deal-field-label">Owner</label><MudSelect T="string" @bind-Value="_form.Owner" aria-label="Owner" Variant="Variant.Outlined">@foreach(var x in CrmDealSource.Owners){<MudSelectItem Value="@x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" sm="6"><label class="deal-field-label">Source</label><MudTextField T="string" @bind-Value="_form.Source" aria-label="Source" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" sm="6"><label class="deal-field-label">Expected close</label><MudTextField T="string" @bind-Value="_form.Close" aria-label="Expected close" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" sm="6"><label class="deal-field-label">Next activity</label><MudTextField T="string" @bind-Value="_form.Next" aria-label="Next activity" Variant="Variant.Outlined" /></MudItem><MudItem xs="12"><label class="deal-field-label">Tags</label><MudTextField T="string" @bind-Value="_form.Tags" aria-label="Tags" Variant="Variant.Outlined" /></MudItem></MudGrid>}else if(_modal is "note" or "task" or "activity"){<MudTextField T="string" @bind-Value="_text" Label="@(_modal=="note"?"Internal note":_modal=="task"?"Task title":"Activity")" Lines="3" Required="true" />}else if(_modal is "owner" or "bulkOwner"){<MudSelect T="string" @bind-Value="_bulk"><MudSelectItem Value="@("Sophia Carter")">Sophia Carter</MudSelectItem>@foreach(var x in CrmDealSource.Owners.Skip(1)){<MudSelectItem Value="@x">@x</MudSelectItem>}</MudSelect>}else if(_modal is "stage" or "bulkStage"){<MudSelect T="string" @bind-Value="_bulk">@foreach(var x in CrmDealSource.Stages){<MudSelectItem Value="@x">@x</MudSelectItem>}</MudSelect>}else if(_modal=="bulkTag"){<label class="deal-field-label">Tag</label><MudTextField T="string" @bind-Value="_bulk" aria-label="Tag" Variant="Variant.Outlined" />}else{<p>This action changes only the local sample data for this session.</p>}</DialogContent><DialogActions><MudButton OnClick="CloseModal">Cancel</MudButton><MudButton Color="@(_modal is "delete" or "bulkDelete" ? Color.Error : Color.Primary)" Variant="Variant.Filled" OnClick="Confirm">@ModalAction</MudButton></DialogActions></MudDialog>}
@code {
    private List<CrmDeal> _deals=CrmDealSource.Deals.ToList(); private HashSet<int> _selected=[]; private CrmDeal? _active; private string? _modal; private string _query="",_stage="All stages",_probability="All probabilities",_company="All companies",_owner="All owners",_value="All values",_close="Any close",_source="All sources",_tag="All tags",_sort="Recently Created",_text="",_bulk="Sophia Carter"; private DealForm _form=new(); private bool ModalVisible { get=>_modal is not null; set { if(!value)_modal=null; } }
    private static readonly BreadcrumbItem[] Breadcrumbs=[new("Rynzo",null),new("CRM",null),new("Deals",null,true)]; private static readonly (string,string)[] Metrics=[("Total Deals","1,284"),("Open","846"),("Won","284"),("Lost","154"),("Open Pipeline","$8.42M"),("Weighted Pipeline","$5.16M")];
    private IEnumerable<string> Companies=>_deals.Select(x=>x.Company).Distinct().Order(); private IEnumerable<string> Sources=>_deals.Select(x=>x.Source).Distinct().Order(); private IEnumerable<string> Tags=>_deals.SelectMany(x=>x.Tags).Distinct().Order(); private bool AllSelected=>Visible.Any()&&Visible.All(x=>_selected.Contains(x.Id));
    private IEnumerable<CrmDeal> Visible=>_deals.Where(Matches).OrderByDescending(x=>_sort=="Highest Value"?x.Value:_sort=="Highest Probability"?x.Probability:x.Id); private bool Matches(CrmDeal d)=>$"{d.Name} {d.Company} {d.Contact} {d.Owner} {d.Source} {string.Join(' ',d.Tags)}".Contains(_query,StringComparison.OrdinalIgnoreCase)&&(_stage=="All stages"||d.Stage==_stage)&&(_company=="All companies"||d.Company==_company)&&(_owner=="All owners"||d.Owner==_owner)&&(_source=="All sources"||d.Source==_source)&&(_tag=="All tags"||d.Tags.Contains(_tag))&&(_probability=="All probabilities"||(_probability=="0-25%"&&d.Probability<=25)||(_probability=="26-50%"&&d.Probability is >25 and <=50)||(_probability=="51-75%"&&d.Probability is >50 and <=75)||(_probability=="76-99%"&&d.Probability is >75 and <100)||(_probability=="100%"&&d.Probability==100))&&(_value=="All values"||(_value=="Under $10K"&&d.Value<10000)||(_value=="$10K-$50K"&&d.Value is >=10000 and <=50000)||(_value=="$50K-$100K"&&d.Value is >50000 and <=100000)||(_value=="$100K-$250K"&&d.Value is >100000 and <=250000)||(_value=="$250K+"&&d.Value>250000))&&(_close=="Any close"||d.CloseType==_close);
    private string ModalTitle=>_modal switch{"add"=>"Add Deal","edit"=>"Edit Deal","note"=>"Add Deal Note","task"=>"Create Deal Task","activity"=>"Log Activity","owner" or "bulkOwner"=>"Assign Deal Owner","stage" or "bulkStage"=>"Change Deal Stage","won"=>"Mark Deal as Won","lost"=>"Mark Deal as Lost","delete"=>"Delete this deal?","bulkDelete"=>"Delete selected deals?","bulkTag"=>"Add tag to selected deals",_=>"Deal action"}; private string ModalAction=>_modal switch{"add"=>"Create Deal","edit"=>"Save Changes","delete" or "bulkDelete"=>"Delete",_=>"Apply"};
    private static string Money(decimal x)=>x.ToString("C0",CultureInfo.GetCultureInfo("en-US")); private static Color Tone(string x)=>x switch{"Closed Won"=>Color.Success,"Closed Lost"=>Color.Error,"Proposal" or "Negotiation"=>Color.Warning,"Contract"=>Color.Info,"Archived"=>Color.Default,_=>Color.Primary};
    private void Reset(){_query="";_stage="All stages";_probability="All probabilities";_company="All companies";_owner="All owners";_value="All values";_close="Any close";_source="All sources";_tag="All tags";_sort="Recently Created";}
    private void Toggle(int id){if(!_selected.Add(id))_selected.Remove(id);} private void SelectAll(){var clear=AllSelected;foreach(var d in Visible){if(clear)_selected.Remove(d.Id);else _selected.Add(d.Id);}}
    private void OpenAdd(){_form=new();_modal="add";} private void OpenBulk(string kind){_bulk=kind=="stage"?"Qualification":"Sophia Carter";_modal="bulk"+char.ToUpperInvariant(kind[0])+kind[1..];} private void OpenModal(string kind){if(_active is null)return;if(kind=="edit")_form=DealForm.From(_active);_text="";_modal=kind;}
    private void CloseActive()=>_active=null; private void CloseModal()=>_modal=null; private void ArchiveSelected(){_deals=_deals.Select(d=>_selected.Contains(d.Id)?d with{Stage="Archived"}:d).ToList();_selected.Clear();Snackbar.Add("Selected deals archived",Severity.Success);}
    private void Duplicate(){if(_active is null)return;_deals.Add(_active with{Id=_deals.Max(x=>x.Id)+1,Name=_active.Name+" copy",Activity="Deal duplicated"});Snackbar.Add("Deal duplicated",Severity.Success);}
    private void Confirm(){if(_modal is "add" or "edit"){if(string.IsNullOrWhiteSpace(_form.Name)||_form.Value<0||_form.Probability is <0 or >100){Snackbar.Add("Enter a deal name, non-negative value and probability from 0-100",Severity.Error);return;}var tags=_form.Tags.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);var patch=new CrmDeal(_active?.Id??_deals.Max(x=>x.Id)+1,_form.Name,_form.Company,_form.Contact,"Decision Maker",_form.Stage,_form.Probability,_form.Value,_form.Owner,_form.Close,"This Month",_form.Source,_form.Next,"Deal updated",tags,_active?.Notes??[],_active?.Tasks??[]);if(_modal=="add")_deals.Add(patch);else _deals=_deals.Select(x=>x.Id==patch.Id?patch:x).ToList();Snackbar.Add(_modal=="add"?"Deal created":"Deal updated",Severity.Success);}else if(_modal=="bulkOwner")_deals=_deals.Select(d=>_selected.Contains(d.Id)?d with{Owner=_bulk}:d).ToList();else if(_modal=="bulkStage")_deals=_deals.Select(d=>_selected.Contains(d.Id)?d with{Stage=_bulk}:d).ToList();else if(_modal=="bulkTag")_deals=_deals.Select(d=>_selected.Contains(d.Id)?d with{Tags=d.Tags.Append(_bulk).ToArray()}:d).ToList();else if(_modal=="bulkDelete")_deals=_deals.Where(d=>!_selected.Contains(d.Id)).ToList();else if(_active is { } a){var d=_deals.FirstOrDefault(x=>x.Id==a.Id);if(d is not null)_deals=_deals.Select(x=>x.Id!=a.Id?x:_modal switch{"note"=>x with{Notes=x.Notes.Append(_text).ToArray()},"task"=>x with{Tasks=x.Tasks.Append(_text).ToArray()},"activity"=>x with{Activity=_text},"owner"=>x with{Owner=_bulk},"stage"=>x with{Stage=_bulk},"won"=>x with{Stage="Closed Won",Probability=100},"lost"=>x with{Stage="Closed Lost",Probability=0},"delete"=>null,_=>x}).Where(x=>x is not null).Cast<CrmDeal>().ToList();} _selected.Clear();_active=null;_modal=null;Snackbar.Add("Deal action completed",Severity.Success);}
    private async Task Export(){var csv="Deal,Company,Stage,Probability,Value,Weighted\n"+string.Join("\n",Visible.Select(d=>$"{d.Name},{d.Company},{d.Stage},{d.Probability},{d.Value},{d.Value*d.Probability/100}"));await JS.InvokeVoidAsync("eval",$"(()=>{{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([{System.Text.Json.JsonSerializer.Serialize(csv)}],{{type:'text/csv'}}));a.download='crm-deals.csv';a.click();}})()");Snackbar.Add("Deals export downloaded",Severity.Success);} private Task ExportSelected()=>Export();
    private sealed class DealForm{public string Name{get;set;}="";public string Company{get;set;}="CloudAxis";public string Contact{get;set;}="Ava Thompson";public string Stage{get;set;}="Qualification";public decimal Value{get;set;}=0;public int Probability{get;set;}=50;public string Owner{get;set;}="Sophia Carter";public string Source{get;set;}="Inbound";public string Close{get;set;}="Sep 30";public string Next{get;set;}="Follow-up";public string Tags{get;set;}="";public static DealForm From(CrmDeal d)=>new(){Name=d.Name,Company=d.Company,Contact=d.Contact,Stage=d.Stage,Value=d.Value,Probability=d.Probability,Owner=d.Owner,Source=d.Source,Close=d.Close,Next=d.Next,Tags=string.Join(", ",d.Tags)};}
}

