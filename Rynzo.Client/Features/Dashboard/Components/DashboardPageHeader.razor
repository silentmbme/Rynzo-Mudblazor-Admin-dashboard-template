<header class="dashboard-page-header">
    <div class="dashboard-page-title"><h1>@Title</h1>@if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }</div>
    @if (Actions is not null) { <div class="dashboard-page-actions">@Actions</div> }
</header>
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
