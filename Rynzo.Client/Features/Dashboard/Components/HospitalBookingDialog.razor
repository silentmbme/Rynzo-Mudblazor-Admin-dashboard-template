@using Rynzo.Client.Features.Dashboard.Services
@using Rynzo.Client.Theme
<MudDialog Style="width:min(512px,calc(100vw - 32px));max-width:512px"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">New appointment</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Add a sample booking. Appointment changes are kept for this page session.</MudText><form @onsubmit="Save" @onsubmit:preventDefault="true"><MudTextField T="string" @bind-Value="State.Booking.Patient" Immediate="true" Label="Patient name" InputId="hospital-patient" Placeholder="Enter sample patient name" MaxLength="80" Required="true" UserAttributes="PatientAttributes" Variant="Variant.Outlined" Class="mb-4" /><MudSelect T="string" @bind-Value="State.Booking.DoctorId" Label="Doctor" InputId="hospital-doctor" aria-label="Appointment doctor" Variant="Variant.Outlined" Class="mb-4 hospital-new-doctor">@foreach(var doctor in State.Source.Doctors.Where(d=>d.Available)){<MudSelectItem Value="@doctor.Id">@doctor.Name · @doctor.Department</MudSelectItem>}</MudSelect><MudGrid><MudItem xs="6"><MudTextField T="string" @bind-Value="State.Booking.Date" Immediate="true" Label="Date" InputId="hospital-date" InputType="InputType.Date" Required="true" UserAttributes="DateAttributes" Variant="Variant.Outlined" /></MudItem><MudItem xs="6"><MudTextField T="string" @bind-Value="BookingTime" Immediate="true" Label="Time" InputId="hospital-time" InputType="InputType.Time" Required="true" Variant="Variant.Outlined" /></MudItem></MudGrid><MudSelect T="string" @bind-Value="State.Booking.Type" Label="Visit type" InputId="hospital-visit-type" Variant="Variant.Outlined" Class="mt-4 hospital-visit-type"><MudSelectItem Value="@("Consultation")">Consultation</MudSelectItem><MudSelectItem Value="@("Follow-up")">Follow-up</MudSelectItem></MudSelect>@if(_error is not null){<MudAlert Severity="Severity.Error" Class="mt-4" role="alert">@_error</MudAlert>}<div class="d-flex justify-end gap-2 mt-4"><MudButton Variant="Variant.Outlined" OnClick="@(() => Dialog.Cancel())">Cancel</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@RynzoIcons.Get("Plus")" ButtonType="ButtonType.Submit">Save appointment</MudButton></div></form></DialogContent></MudDialog>
@code{[Parameter,EditorRequired]public HospitalDashboardState State{get;set;}=null!;[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private string BookingTime{get=>State.Booking.Time;set=>State.Booking.Time=value.Length==8&&value.EndsWith(":00",StringComparison.Ordinal)?value[..5]:value;}private string? _error;private static readonly Dictionary<string,object> PatientAttributes=new(){{"minlength",2}};private static readonly Dictionary<string,object> DateAttributes=new(){{"min","2026-10-09"}};private void Save(){_error=State.Book();if(_error is null)Dialog.Close(DialogResult.Ok(true));}}


