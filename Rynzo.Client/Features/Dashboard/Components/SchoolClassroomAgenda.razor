@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Theme
<div class="school-agenda-toolbar"><span><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" Size="Size.Small" Color="Color.Primary" />Morning sessions</span><span>45 minutes per lesson</span></div><div class="school-agenda-list">@foreach(var teacher in Teachers){var index=Array.IndexOf(Grades,teacher.Grade);<article><div class="school-lesson-time"><b>@(new[]{"09:00","10:00","11:00"}[index])</b><small>@(new[]{"09:45","10:45","11:45"}[index])</small><i></i></div><div class="school-lesson"><div><span class="school-lesson-icon"><MudIcon Icon="@RynzoIcons.Get(teacher.Subject=="Mathematics"?"GraduationCap":teacher.Subject=="Science"?"ClipboardCheck":"BookOpen")" /></span><div><header><h3>@teacher.Subject</h3><MudChip T="string" Color="Color.Primary" Size="Size.Small">@teacher.Grade</MudChip></header><p>Classroom lesson ? 45 minutes</p></div></div><footer><span><img src="@Portrait(teacher.Name)" alt="" /><b>@teacher.Name</b></span><small>Room @(index+101)</small></footer></div></article>}@if(Teachers.Length==0){<div class="school-agenda-empty"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" /><p>No lessons in this view</p><small>Choose another grade to see its sample schedule.</small></div>}</div>
@code{[Parameter,EditorRequired]public SchoolTeacher[] Teachers{get;set;}=[];[Parameter,EditorRequired]public string[] Grades{get;set;}=[];public static string Portrait(string name)=>name=="Sophia Carter"?"assets/images/users/sophia-carter.jpg":name=="Daniel Lee"?"assets/images/users/user-4.jpg":"assets/images/users/user-1.jpg";}
