@using Rynzo.Client.Features.Dashboard.Models
<MudDialog Style="width:min(512px,calc(100vw - 32px));max-width:512px"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">Appointment details</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Sample patient visit information.</MudText><dl style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding:16px;border:1px solid var(--border);border-radius:8px;background:color-mix(in srgb,var(--muted) 30%,transparent)">@foreach(var field in Fields){<div><dt style="font-size:12px;color:var(--muted-foreground)">@field.Label</dt><dd style="margin-top:4px;font-size:14px;font-weight:500">@field.Value</dd></div>}</dl></DialogContent></MudDialog>
@code{[Parameter,EditorRequired]public HospitalAppointment Appointment{get;set;}=null!;[Parameter,EditorRequired]public string DoctorName{get;set;}="";private (string Label,string Value)[] Fields=>[("Patient",Appointment.Patient),("Appointment ID",Appointment.Id),("Doctor",DoctorName),("Department",Appointment.Department),("Date / time",$"{Appointment.Date} · {Appointment.Time}"),("Status",Appointment.Status)];}
