@implements IAsyncDisposable
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject RynzoAppearance Appearance
<div class="executive-chart" style="min-height:@(Height)px" role="img" aria-label="@Label" @ref="_element"></div>
@if (_loading) { <MudSkeleton Height="@(Height + "px")" Animation="Animation.Wave" /> }
@if (_failed) { <MudAlert Severity="Severity.Error">Chart could not load. <MudButton OnClick="Retry">Retry</MudButton></MudAlert> }
@code {
    [Parameter, EditorRequired] public ExecutiveData Data { get; set; } = null!;
    [Parameter] public string Kind { get; set; } = "revenue";
    [Parameter] public int Index { get; set; }
    [Parameter] public int Height { get; set; } = 310;
    [Parameter] public string Label { get; set; } = "";
    private ElementReference _element;
    private IJSObjectReference? _module;
    private bool _loading = true, _failed, _dirty = true, _disposed;
    protected override void OnInitialized() => Appearance.Changed += Refresh;
    private void Refresh() { _dirty = true; _ = InvokeAsync(StateHasChanged); }
    private void Retry() { _failed = false; _loading = true; _dirty = true; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_dirty || _disposed) return;
        _dirty = false;
        try {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./theme/executive-charts.js");
            await _module.InvokeVoidAsync("render", _element, Kind, Data, Index, Height);
        } catch (JSException) { _failed = true; }
        _loading = false;
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Appearance.Changed -= Refresh;
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("dispose", _element); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
