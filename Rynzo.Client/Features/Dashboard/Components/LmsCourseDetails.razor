@using Rynzo.Client.Features.Dashboard.Models
<MudDialog Style="width:min(512px, calc(100vw - 32px));max-width:512px"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">@Course.Title</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Sample course details and learning outcomes.</MudText><div class="d-flex gap-2 mb-4"><MudChip T="string" Color="Color.Primary">@Course.Category</MudChip><MudChip T="string" Color="@(Course.Status=="Published"?Color.Success:Color.Warning)">@Course.Status</MudChip></div><MudGrid>@foreach(var item in Details){<MudItem xs="6"><MudPaper Outlined="true" Elevation="0" Class="pa-4"><MudText Typo="Typo.caption" Color="Color.Secondary">@item.Label</MudText><MudText Typo="Typo.body2"><b>@item.Value</b></MudText></MudPaper></MudItem>}</MudGrid><MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">@Course.Completed learners have completed this course.</MudText></DialogContent></MudDialog>
@code{[Parameter,EditorRequired]public LmsCourse Course{get;set;}=null!;[Parameter]public string Instructor{get;set;}="";private (string Label,string Value)[] Details=>[("Instructor",Instructor),("Lessons",Course.Lessons.ToString()),("Enrollments",Course.Students.ToString()),("Price",Course.Price.ToString("C0",System.Globalization.CultureInfo.GetCultureInfo("en-US")))];}
