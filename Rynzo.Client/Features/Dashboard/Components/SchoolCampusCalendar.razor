@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Theme
<MudCard Outlined="true" Elevation="0" Class="school-calendar rynzo-widget-card"><header><div><h2>Campus calendar</h2><p>Upcoming school events ? Sample schedule</p></div><span><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" /></span></header><div class="school-calendar-month"><div><h3>October <span>2026</span></h3><p>Plan ahead for campus life</p></div><MudChip T="string" Color="Color.Primary" Size="Size.Small">3 events</MudChip></div><div class="school-calendar-events">@foreach(var item in Events){<article><div class="school-calendar-date" style="@($"--event-tone:var({item.Color})")"><small>@item.Weekday</small><b>@item.Day</b></div><div><small style="@($"color:var({item.Color})")">@item.Type</small><h3>@item.Title</h3><p>@item.Detail</p></div></article>}</div><footer><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" Size="Size.Small" />All dates shown in the school calendar</footer></MudCard>
@code{[Parameter,EditorRequired]public SchoolEvent[] Events{get;set;}=[];}
