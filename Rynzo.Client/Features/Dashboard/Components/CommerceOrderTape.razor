@using Rynzo.Client.Theme
<div class="commerce-order-tape">@if(Orders.Count == 0){<div class="commerce-clear">Order tape is clear</div>}else{@foreach(var order in Orders){<div class="commerce-order"><time>@order[0]</time><MudIcon Icon="@RynzoIcons.Get("ReceiptText")" Color="Color.Primary" /><span class="commerce-order-customer"><b>@order[2]</b><small>@order[1] @order[4]</small></span><span class="commerce-order-value"><b>@order[3]</b><small>@order[5]</small></span><MudIconButton Icon="@RynzoIcons.Get("CircleCheck")" Color="Color.Success" Size="Size.Small" Class="commerce-complete" aria-label="@($"Complete {order[1]}")" OnClick="@(() => Complete.InvokeAsync(order[1]))" /></div>}}</div>
@code { [Parameter, EditorRequired] public IReadOnlyList<string[]> Orders { get; set; } = []; [Parameter] public EventCallback<string> Complete { get; set; } }
