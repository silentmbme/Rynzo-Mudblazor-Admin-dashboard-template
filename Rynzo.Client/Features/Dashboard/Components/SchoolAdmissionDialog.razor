@using Rynzo.Client.Features.Dashboard.Services
<MudDialog Style="width:min(512px,calc(100vw - 32px));max-width:512px"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">Admit student</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Add a sample student. Fees start unpaid and attendance starts present.</MudText><form @onsubmit="Save" @onsubmit:preventDefault="true"><MudTextField T="string" @bind-Value="State.Admission.Name" Immediate="true" Label="Student name" InputId="school-name" MaxLength="80" Required="true" UserAttributes="NameAttributes" Variant="Variant.Outlined" Class="mb-4" /><MudSelect T="string" @bind-Value="State.Admission.Grade" Label="Grade" InputId="school-grade" Variant="Variant.Outlined" Class="school-new-grade">@foreach(var grade in State.Source.Grades){<MudSelectItem Value="@grade">@grade</MudSelectItem>}</MudSelect><MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" FullWidth="true" Class="mt-4">Save student</MudButton></form></DialogContent></MudDialog>
@code{[Parameter,EditorRequired]public SchoolDashboardState State{get;set;}=null!;[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private static readonly Dictionary<string,object> NameAttributes=new(){{"minlength",2}};private void Save(){if(State.Admit())Dialog.Close(DialogResult.Ok(true));}}
