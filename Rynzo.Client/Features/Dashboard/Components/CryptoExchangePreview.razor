<MudDialog Style="width:min(512px, calc(100vw - 32px));max-width:512px"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">Exchange preview</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Color="Color.Secondary">Illustrative conversion using the sample @Symbol price. This preview does not place an order.</MudText><MudPaper Outlined="true" Elevation="0" Class="pa-4 my-4"><div class="d-flex justify-space-between mb-4"><span>You pay</span><b>@Pay</b></div><div class="d-flex justify-space-between mb-4"><span>You receive</span><b>@Receive</b></div><MudDivider /><div class="d-flex justify-space-between mt-3"><span>Rate</span><span>1 @Symbol = @Rate</span></div></MudPaper></DialogContent><DialogActions><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => Dialog.Close())">Close preview</MudButton></DialogActions></MudDialog>
@code { [CascadingParameter] public IMudDialogInstance Dialog {get;set;}=null!;[Parameter] public string Symbol{get;set;}="";[Parameter]public string Pay{get;set;}="";[Parameter]public string Receive{get;set;}="";[Parameter]public string Rate{get;set;}=""; }
