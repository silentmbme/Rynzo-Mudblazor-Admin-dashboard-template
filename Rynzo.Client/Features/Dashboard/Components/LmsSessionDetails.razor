@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Theme
<MudDialog Style="width:min(512px, calc(100vw - 32px));max-width:512px"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">@Session.Title</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Sample live session information.</MudText><MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4"><div class="d-flex align-center gap-2 mb-3"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" Color="Color.Primary" Size="Size.Small" />@Session.Date</div><div class="d-flex align-center gap-2 mb-3"><MudIcon Icon="@RynzoIcons.Get("Clock3")" Color="Color.Primary" Size="Size.Small" />@Session.Time · @Session.Duration</div><div class="d-flex align-center gap-2"><MudIcon Icon="@RynzoIcons.Get("UsersRound")" Color="Color.Primary" Size="Size.Small" />@Instructor</div></MudPaper><MudText Typo="Typo.body2" Color="Color.Secondary">@Session.Description</MudText></DialogContent></MudDialog>
@code{[Parameter,EditorRequired]public LmsSession Session{get;set;}=null!;[Parameter]public string Instructor{get;set;}="";}
