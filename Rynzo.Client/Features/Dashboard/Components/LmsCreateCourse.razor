@using Rynzo.Client.Features.Dashboard.Services
<MudDialog Style="width:min(512px, calc(100vw - 32px));max-width:512px"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">Create course</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Add a draft to the sample catalog. Changes are kept for this page session.</MudText><form @onsubmit="Save" @onsubmit:preventDefault="true" novalidate><MudTextField T="string" @bind-Value="State.Draft.Title" Immediate="true" Label="Course title" InputId="lms-course-title" MaxLength="100" Required="true" Placeholder="Enter course title" Variant="Variant.Outlined" Class="mb-4" /><MudSelect T="string" @bind-Value="State.Draft.Category" Label="Category" InputId="lms-new-category" Variant="Variant.Outlined" Class="mb-4 lms-new-category">@foreach(var category in State.Source.Categories){<MudSelectItem Value="@category">@category</MudSelectItem>}</MudSelect><MudSelect T="string" @bind-Value="State.Draft.InstructorId" Label="Instructor" InputId="lms-instructor" Variant="Variant.Outlined" Class="mb-4 lms-instructor">@foreach(var instructor in State.Source.Instructors){<MudSelectItem Value="@instructor.Id">@instructor.Name</MudSelectItem>}</MudSelect><MudGrid><MudItem xs="6"><MudTextField T="string" @bind-Value="State.Draft.Lessons" Immediate="true" Label="Lessons" InputId="lms-lessons" InputType="InputType.Number" Required="true" Variant="Variant.Outlined" /></MudItem><MudItem xs="6"><MudTextField T="string" @bind-Value="State.Draft.Price" Immediate="true" Label="Price (USD)" InputId="lms-price" InputType="InputType.Number" Required="true" Variant="Variant.Outlined" /></MudItem></MudGrid>@if(_error){<MudAlert Severity="Severity.Error" Class="mt-4" role="alert">@LmsDashboardState.ValidationError</MudAlert>}<div class="d-flex justify-end gap-2 mt-4"><MudButton Variant="Variant.Outlined" OnClick="@(() => Dialog.Cancel())">Cancel</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit">Save draft</MudButton></div></form></DialogContent></MudDialog>
@code{[Parameter,EditorRequired]public LmsDashboardState State{get;set;}=null!;[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private bool _error;private void Save(){if(!State.Create()){_error=true;return;}Dialog.Close(DialogResult.Ok(true));}}
