<MudCard Outlined="true" Elevation="0" Class="@((($"executive-card {Class}")) + " rynzo-widget-card rynzo-widget-card--structured")">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" HtmlTag="h2">@Title</MudText>
            <MudText Typo="Typo.caption">@Description</MudText>
        </CardHeaderContent>
        <CardHeaderActions>@Actions</CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>@ChildContent</MudCardContent>
</MudCard>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
