@using Rynzo.Client.Theme
<div class="marketing-campaign"><MudIcon Icon="@RynzoIcons.Get("Target")" Color="Color.Primary" /><span class="marketing-campaign-name"><b>@Campaign[0]</b><small>@Campaign[1]</small></span><span><small>Pipeline</small><b>@Campaign[2]</b></span><span><small>ROI</small><b>@Campaign[3]</b></span><MudChip T="string" Size="Size.Small" Color="@(Campaign[5] == "success" ? Color.Success : Campaign[5] == "warning" ? Color.Warning : Color.Info)">@Campaign[4]</MudChip><MudIconButton Icon="@RynzoIcons.Get("ArrowRight")" Color="Color.Primary" Size="Size.Small" aria-label="@($"Open {Campaign[0]}")" OnClick="@(() => Open.InvokeAsync(Campaign[0]))" /></div>
@code { [Parameter, EditorRequired] public string[] Campaign { get; set; } = []; [Parameter] public EventCallback<string> Open { get; set; } }
