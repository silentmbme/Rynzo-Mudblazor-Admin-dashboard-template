@using Rynzo.Client.Features.Dashboard.Services
<MudDialog Style="width:min(512px, calc(100vw - 32px));max-width:512px"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">Add employee</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">Create a sample employee record for this page session.</MudText><form @onsubmit="Save" @onsubmit:preventDefault="true" novalidate><MudTextField T="string" @bind-Value="_name" Immediate="true" Label="Full name" InputId="hrm-name" MaxLength="80" Required="true" Variant="Variant.Outlined" Class="mb-4" /><MudTextField T="string" @bind-Value="_role" Immediate="true" Label="Job title" InputId="hrm-role" MaxLength="80" Required="true" Variant="Variant.Outlined" Class="mb-4" /><MudSelect T="string" @bind-Value="_department" @bind-Value:after="RememberDepartment" Label="Department" InputId="hrm-department" Variant="Variant.Outlined" Class="mb-4">@foreach(var department in State.Source.Departments){<MudSelectItem Value="@department">@department</MudSelectItem>}</MudSelect><MudTextField T="string" @bind-Value="_salary" Immediate="true" Label="Monthly salary (USD)" InputId="hrm-salary" InputType="InputType.Number" Required="true" Variant="Variant.Outlined" Class="mb-4" />@if(_error){<MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@HrmDashboardState.ValidationError</MudAlert>}<MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Save employee</MudButton></form></DialogContent></MudDialog>
@code{[Parameter,EditorRequired]public HrmDashboardState State{get;set;}=null!;[Parameter]public EventCallback<string> DepartmentChanged{get;set;}private Task RememberDepartment()=>DepartmentChanged.InvokeAsync(_department);[Parameter]public string InitialDepartment{get;set;}="Engineering";[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private string _name="",_role="",_salary="5000",_department="Engineering";private bool _error;protected override void OnInitialized()=>_department=InitialDepartment;private void Save(){if(!State.Add(_name,_role,_department,_salary)){_error=true;return;}Dialog.Close(DialogResult.Ok(_department));}}

