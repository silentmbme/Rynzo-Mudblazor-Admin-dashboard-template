@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Theme
<div class="rynzo-widget-host"><MudCard Class="crm-priority rynzo-widget-card" Style="@($"--deal-color:var(--{Deal.Color[3..]})")" Elevation="0" Outlined="true" data-widget-element="article"><div class="crm-priority-title"><div><small>@Deal.Company</small><h3>@Deal.Name</h3></div><b>@Deal.Value</b></div><dl><div><dt>Signal</dt><dd>@Deal.Likelihood</dd></div><div><dt>Timing</dt><dd>@Deal.Due</dd></div></dl><footer><p>Next: @Deal.Next</p><MudButton Size="Size.Small" Disabled="Done" Color="@(Done?Color.Success:Color.Primary)" StartIcon="@(Done?RynzoIcons.Get("Check"):null)" EndIcon="@(!Done?RynzoIcons.Get("ChevronRight"):null)" OnClick="@(() => Complete.InvokeAsync(Deal.Name))">@(Done?"Complete":"Do this now")</MudButton></footer></MudCard></div>
@code{[Parameter,EditorRequired]public CrmPriorityDeal Deal{get;set;}=null!;[Parameter]public bool Done{get;set;}[Parameter]public EventCallback<string> Complete{get;set;}}
