@using Rynzo.Client.Features.Dashboard.Models
<MudDialog Style="width:min(512px, calc(100vw - 32px));max-width:512px"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">Track @Shipment.Id</MudText></TitleContent><DialogContent><p class="logistics-dialog-note">Sample shipment details · No live location tracking</p><div class="logistics-dialog-route"><b>@Shipment.Origin → @Shipment.Destination</b><p>@Shipment.Customer</p></div><div class="logistics-dialog-details"><div><small>Driver / vehicle</small><p>@Shipment.Driver / @Shipment.Vehicle</p></div><div><small>Expected arrival</small><p>@Shipment.Eta</p></div><div><small>Cargo</small><p>@Shipment.Weight kg</p></div><div><small>Progress</small><p>@Shipment.Progress% · @Shipment.Status</p></div></div><MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Shipment.Status is "Delivered" or "Pending")" OnClick="Complete">Mark sample delivery complete</MudButton></DialogContent></MudDialog>
@code {[Parameter,EditorRequired]public LogisticsShipment Shipment{get;set;}=null!;[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private void Complete()=>Dialog.Close(DialogResult.Ok(Shipment.Id));}
