@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Features.Dashboard.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
<MudDialog Style="width:min(512px,calc(100vw - 32px));max-width:512px"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">Sample order confirmed</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">No payment was processed. Your sample order is in the kitchen queue.</MudText><div class="d-flex justify-space-between mb-4"><span>@Order.Id</span><span>@Order.Table</span></div><p style="font-size:14px;line-height:24px;color:var(--muted-foreground)">@Order.Items</p><p style="margin-top:16px;border-top:1px solid var(--border);padding-top:16px;font-size:20px;font-weight:600">Total @RestaurantPosState.Money(Order.Total)</p><MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4" OnClick="Download">Download sample receipt</MudButton></DialogContent></MudDialog>
@code{[Parameter,EditorRequired]public RestaurantOrder Order{get;set;}=null!;private IJSObjectReference? _download;private async Task Download(){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/restaurant-receipt.js");await _download.InvokeVoidAsync("download",$"{Order.Id}-receipt.txt",RestaurantPosState.Receipt(Order));}public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}}
