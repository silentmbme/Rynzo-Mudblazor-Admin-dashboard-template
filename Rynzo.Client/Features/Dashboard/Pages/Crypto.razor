@page "/dashboards/crypto"
@implements IAsyncDisposable
@using System.Globalization
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Features.Dashboard.Services
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
@inject IJSRuntime JS
<PageTitle>Crypto Dashboard — Rynzo</PageTitle>
<div class="crypto-dashboard">
    <DashboardPageHeader Title="Crypto Dashboard" Description="Your portfolio, market movements, and digital assets in one place." ><Actions><div class="crypto-actions"><MudChip T="string" Color="Color.Primary" Size="Size.Small">Sample market data</MudChip><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export portfolio</MudButton></div></Actions></DashboardPageHeader>
    <section class="crypto-stats">
        <MudCard Outlined="true" Elevation="0" Class="crypto-stat rynzo-widget-card rynzo-widget-card--structured"><MudCardContent><div><p>Portfolio balance</p><MudIcon Icon="@RynzoIcons.Get("Wallet")" /></div><strong>@Money(Holdings+_source.Cash)</strong><small><CryptoChange Value="@(DayProfit/(Holdings+_source.Cash-DayProfit)*100)" />@Money(DayProfit) today</small></MudCardContent></MudCard>
        <MudCard Outlined="true" Elevation="0" Class="crypto-stat rynzo-widget-card rynzo-widget-card--structured"><MudCardContent><div><p>Unrealized profit</p><MudIcon Icon="@RynzoIcons.Get("TrendingUp")" /></div><strong>@Money(Holdings-Invested)</strong><small><CryptoChange Value="@((Holdings-Invested)/Invested*100)" />vs. purchase cost</small></MudCardContent></MudCard>
        <MudCard Outlined="true" Elevation="0" Class="crypto-stat rynzo-widget-card rynzo-widget-card--structured"><MudCardContent><div><p>Available cash</p><MudIcon Icon="@RynzoIcons.Get("CircleDollarSign")" /></div><strong>@Money(_source.Cash)</strong><small>USD balance in your sample wallet</small></MudCardContent></MudCard>
        <MudCard Outlined="true" Elevation="0" Class="crypto-stat rynzo-widget-card rynzo-widget-card--structured"><MudCardContent><div><p>Assets held</p><MudIcon Icon="@RynzoIcons.Get("Layers3")" /></div><strong>@_source.Assets.Length</strong><small><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" Color="Color.Success" Size="Size.Small" />Diversified across five assets</small></MudCardContent></MudCard>
    </section>
    <section class="crypto-assets">@foreach(var asset in _source.Assets.Take(4)){<MudButton Variant="Variant.Outlined" Class="@($"crypto-asset {(_symbol==asset.Symbol?"crypto-selected":"")}")" aria-pressed="@(_symbol==asset.Symbol?"true":"false")" OnClick="@(() => SelectAsset(asset.Symbol))"><div class="crypto-asset-heading"><CryptoCoin Asset="asset" Small="true" /><span><b>@asset.Name</b><small>@asset.Symbol / USD</small></span><CryptoChange Value="asset.Change" /></div><div class="crypto-asset-price"><strong>@Money(asset.Price)</strong><svg viewBox="0 0 100 32" aria-hidden="true"><polyline points="@(asset.Change>=0?"0,26 10,22 20,25 30,14 40,18 50,12 60,17 70,7 80,10 90,4 100,6":"0,5 10,8 20,4 30,12 40,9 50,18 60,14 70,25 80,22 90,29 100,26")" fill="none" stroke="@(asset.Change>=0?"var(--success)":"var(--destructive)")" stroke-width="2.5" stroke-linejoin="round" /></svg></div></MudButton>}</section>
    <section class="crypto-grid">
        <DashboardCard Title="Market overview" Description="Illustrative prices ending October 9, 2026" Class="crypto-span-two crypto-market"><Actions><div class="crypto-chart-controls"><MudSelect T="string" @bind-Value="_symbol" @bind-Value:after="Refresh" Variant="Variant.Outlined" Margin="Margin.Dense" Class="crypto-chart-asset" aria-label="Chart asset">@foreach(var asset in _source.Assets){<MudSelectItem Value="@asset.Symbol">@asset.Symbol / USD</MudSelectItem>}</MudSelect><div class="crypto-ranges">@foreach(var range in Ranges){<MudButton Size="Size.Small" Variant="@(_range==range?Variant.Filled:Variant.Text)" aria-pressed="@(_range==range?"true":"false")" OnClick="@(() => SelectRange(range))">@range.ToUpperInvariant()</MudButton>}</div></div></Actions><ChildContent><div class="crypto-market-summary"><CryptoCoin Asset="Asset" /><div><small>@Asset.Name / USD</small><strong>@Money(Asset.Price)</strong></div><span><CryptoChange Value="_history.Change" /><small>over @_range</small></span></div><DashboardChart Data="_chartData" OptionsModule="./crypto-dashboard-options.js" Kind="price" Height="265" Label="Selected crypto asset price history" /><div class="crypto-volume-label"><span>Trading volume</span><b>@Asset.Symbol / USD</b></div><DashboardChart Data="_chartData" OptionsModule="./crypto-dashboard-options.js" Kind="volume" Height="145" Label="Selected crypto asset trading volume" /></ChildContent></DashboardCard>
        <DashboardCard Title="Portfolio allocation" Description="Your digital asset balance" Class="crypto-allocation"><DashboardChart Data="_chartData" OptionsModule="./crypto-dashboard-options.js" Kind="allocation" Height="250" Label="Allocation across five sample crypto assets" /><div class="crypto-allocation-list">@foreach(var asset in _source.Assets){<div><span class="crypto-dot" style="@($"background:var({asset.Color})")"></span><span>@asset.Name</span><b>@F(asset.Price*asset.Holding/Holdings*100,1)%</b><small>@Money(asset.Price*asset.Holding)</small></div>}</div><p class="crypto-cash-held"><span>Cash held separately</span><b>@Money(_source.Cash)</b></p></DashboardCard>
    </section>
    <section class="crypto-grid">
        <DashboardCard Title="Market watchlist" Description="Explore assets and save your favorites" Class="crypto-span-two crypto-watchlist"><Actions><MudButton Size="Size.Small" StartIcon="@RynzoIcons.Get("Star")" Color="@(_onlyWatchlist?Color.Primary:Color.Default)" aria-pressed="@(_onlyWatchlist?"true":"false")" OnClick="@(() => _onlyWatchlist=!_onlyWatchlist)">Favorites (@_watchlist.Count)</MudButton></Actions><ChildContent><div class="crypto-search"><MudTextField T="string" @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" Placeholder="Search name or symbol..." aria-label="Search crypto assets" /></div><MudTable T="CryptoAsset" Items="VisibleAssets" Breakpoint="Breakpoint.None" Elevation="0" Class="crypto-watch-table" aria-label="Market watchlist"><HeaderContent><MudTh>Asset</MudTh><MudTh>Price</MudTh><MudTh>24h change</MudTh><MudTh>Market cap</MudTh><MudTh><span class="sr-only">Watchlist</span></MudTh></HeaderContent><RowTemplate><MudTd><MudButton Class="crypto-name-button" aria-label="@($"Show {context.Name} chart")" OnClick="@(() => SelectAsset(context.Symbol))"><CryptoCoin Asset="context" Small="true" /><span><b>@context.Name</b><small>@context.Symbol</small></span></MudButton></MudTd><MudTd>@Money(context.Price)</MudTd><MudTd><CryptoChange Value="context.Change" /></MudTd><MudTd>$@AiDashboardCalculator.Number(context.MarketCap*1000000)</MudTd><MudTd><MudIconButton Icon="@RynzoIcons.Get("Star")" Color="@(_watchlist.Contains(context.Symbol)?Color.Warning:Color.Default)" Class="@(_watchlist.Contains(context.Symbol)?"crypto-favorite":"")" aria-label="@($"{(_watchlist.Contains(context.Symbol)?"Remove":"Add")} {context.Symbol} {(_watchlist.Contains(context.Symbol)?"from":"to")} watchlist")" aria-pressed="@(_watchlist.Contains(context.Symbol)?"true":"false")" OnClick="@(() => ToggleFavorite(context.Symbol))" /></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-6" Color="Color.Secondary">No assets match your filters.</MudText></NoRecordsContent></MudTable><p class="crypto-table-footer">Showing @VisibleAssets.Count() of @_source.Assets.Length assets · Sample prices</p></ChildContent></DashboardCard>
        <DashboardCard Title="Quick exchange" Description="Try a conversion with sample rates" Class="crypto-exchange"><Actions><MudIcon Icon="@RynzoIcons.Get("ArrowDownUp")" Color="Color.Primary" Size="Size.Small" /></Actions><ChildContent><MudTextField T="string" @bind-Value="_amount" Immediate="true" InputType="InputType.Number" Variant="Variant.Outlined" Label="@($"You pay ({(_reverse?_exchangeSymbol:"USD")})")" InputId="crypto-exchange-amount" aria-label="Exchange amount" /><div class="crypto-reverse"><MudIconButton Variant="Variant.Outlined" Icon="@RynzoIcons.Get("ArrowDownUp")" aria-label="Reverse conversion" OnClick="Reverse" /></div><MudSelect T="string" @bind-Value="_exchangeSymbol" Variant="Variant.Outlined" Label="Crypto asset" InputId="crypto-exchange-asset" Class="crypto-exchange-asset" aria-label="Exchange asset">@foreach(var asset in _source.Assets){<MudSelectItem Value="@asset.Symbol">@asset.Name (@asset.Symbol)</MudSelectItem>}</MudSelect><div class="crypto-estimate"><p>Estimated amount (@(_reverse?"USD":_exchangeSymbol))</p><strong>@Output</strong></div><p class="crypto-exchange-rate">1 @_exchangeSymbol = @Money(ExchangeAsset.Price) · No fee in this preview.</p><MudButton FullWidth="true" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!ValidAmount)" EndIcon="@RynzoIcons.Get("ArrowUpRight")" OnClick="Preview">Preview exchange</MudButton><p class="crypto-demo">Demo only. No funds are moved.</p></ChildContent></DashboardCard>
    </section>
    <section class="crypto-summary-grid">
        <MudCard Outlined="true" Elevation="0" Class="crypto-summary rynzo-widget-card"><div><MudIcon Icon="@RynzoIcons.Get("LockKeyhole")" Color="Color.Primary" /><span><h2>Staking overview</h2><small>Sample ETH position</small></span><MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip></div><strong>1.20 ETH</strong><p><span>Estimated APR</span><b class="crypto-success">3.8%</b></p><p class="crypto-divider"><span>Monthly reward estimate</span><b>@Money(1.2*_source.Assets[1].Price*.038/12)</b></p></MudCard>
        <MudCard Outlined="true" Elevation="0" Class="crypto-summary rynzo-widget-card"><div><MudIcon Icon="@RynzoIcons.Get("Bitcoin")" Color="Color.Warning" /><span><h2>Bitcoin exposure</h2><small>Share of your crypto balance</small></span></div><strong>@F(_source.Assets[0].Holding*_source.Assets[0].Price/Holdings*100,1)%</strong><FinanceProgress Value="@(_source.Assets[0].Holding*_source.Assets[0].Price/Holdings*100)" Tone="warning" /><small>@_source.Assets[0].Holding BTC · @Money(_source.Assets[0].Holding*_source.Assets[0].Price)</small></MudCard>
        <MudCard Outlined="true" Elevation="0" Class="crypto-summary rynzo-widget-card"><div><MudIcon Icon="@RynzoIcons.Get("Globe2")" Color="Color.Info" /><span><h2>Market snapshot</h2><small>Tracked assets only</small></span></div><strong>$@AiDashboardCalculator.Number(_source.Assets.Sum(asset=>asset.Volume*1000000))</strong><small>combined sample 24h volume</small><p class="crypto-divider"><span class="crypto-success">3 advancing</span><span class="crypto-danger">2 declining</span></p></MudCard>
    </section>
    <DashboardCard Title="Recent transactions" Description="Sample wallet activity from October 8–9, 2026" Class="crypto-transactions"><Actions><MudSelect T="string" @bind-Value="_transactionType" Variant="Variant.Outlined" Margin="Margin.Dense" Class="crypto-transaction-filter" aria-label="Filter transactions"><MudSelectItem Value="@("all")">All transactions</MudSelectItem>@foreach(var type in TransactionTypes){<MudSelectItem Value="@type">@type</MudSelectItem>}</MudSelect></Actions><ChildContent><MudTable T="CryptoTransaction" Items="Transactions" Breakpoint="Breakpoint.None" Elevation="0" Class="crypto-transaction-table" aria-label="Recent transactions"><HeaderContent><MudTh>Transaction</MudTh><MudTh>Asset</MudTh><MudTh>Amount</MudTh><MudTh>Value</MudTh><MudTh>Date</MudTh><MudTh>Status</MudTh></HeaderContent><RowTemplate><MudTd><div class="crypto-transaction-name"><MudIcon Icon="@RynzoIcons.Get(context.Type=="Sell"?"ArrowUpRight":"ArrowDownLeft")" Color="@(context.Type=="Sell"?Color.Warning:Color.Success)" /><span><b>@context.Type</b><small>@context.Id</small></span></div></MudTd><MudTd>@context.Symbol</MudTd><MudTd>@context.Quantity.ToString(English) @context.Symbol</MudTd><MudTd>@Money(context.Amount)</MudTd><MudTd>@context.Time</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Status=="Completed"?Color.Success:Color.Warning)">@context.Status</MudChip></MudTd></RowTemplate></MudTable><p class="crypto-table-footer">Showing @Transactions.Count() transactions</p></ChildContent></DashboardCard>
</div>
@code {
    private readonly CryptoSourceData _source=CryptoSourceData.Load();
    private string _symbol="BTC",_range="7d",_query="",_transactionType="all",_exchangeSymbol="BTC",_amount="1000";
    private readonly HashSet<string> _watchlist=["BTC","ETH","SOL"];
    private bool _onlyWatchlist,_reverse;
    private CryptoHistory _history=null!;
    private object _chartData=null!;
    private IJSObjectReference? _download;
    private static readonly string[] Ranges=["24h","7d","30d"],TransactionTypes=["Buy","Sell","Deposit"];
    private static readonly CultureInfo English=CultureInfo.GetCultureInfo("en-US");
    private static readonly BreadcrumbItem[] Breadcrumbs=[new("Dashboards",null),new("Crypto",null,true)];
    private CryptoAsset Asset=>_source.Assets.Single(asset=>asset.Symbol==_symbol);
    private CryptoAsset ExchangeAsset=>_source.Assets.Single(asset=>asset.Symbol==_exchangeSymbol);
    private double Holdings=>_source.Assets.Sum(asset=>asset.Price*asset.Holding);
    private double Invested=>_source.Assets.Sum(asset=>asset.Entry*asset.Holding);
    private double DayProfit=>_source.Assets.Sum(asset=>asset.Holding*(asset.Price-asset.Price/(1+asset.Change/100)));
    private IEnumerable<CryptoAsset> VisibleAssets=>_source.Assets.Where(asset=>(!_onlyWatchlist||_watchlist.Contains(asset.Symbol))&&$"{asset.Name} {asset.Symbol}".Contains(_query.Trim(),StringComparison.OrdinalIgnoreCase));
    private IEnumerable<CryptoTransaction> Transactions=>_source.Transactions.Where(transaction=>_transactionType=="all"||transaction.Type==_transactionType);
    private double Entered=>double.TryParse(_amount,NumberStyles.Float,English,out var value)?value:double.NaN;
    private bool ValidAmount=>!string.IsNullOrWhiteSpace(_amount)&&double.IsFinite(Entered)&&Entered>0;
    private double Converted=>!ValidAmount?0:_reverse?Entered*ExchangeAsset.Price:Entered/ExchangeAsset.Price;
    private string Output=>_reverse?Money(Converted):$"{F(Converted,6)} {_exchangeSymbol}";
    private static string Money(double value)=>AiDashboardCalculator.Cost(value);
    private static string F(double value,int digits)=>value.ToString("F"+digits,English);
    protected override void OnInitialized()=>Refresh();
    private void Refresh(){_history=CryptoDashboardCalculator.History(Asset,_range);_chartData=new {Asset,Range=_range,History=_history,Holdings,Assets=_source.Assets};}
    private void SelectAsset(string symbol){_symbol=symbol;Refresh();}
    private void SelectRange(string range){_range=range;Refresh();}
    private void ToggleFavorite(string symbol){if(!_watchlist.Remove(symbol))_watchlist.Add(symbol);}
    private void Reverse(){_reverse=!_reverse;_amount="1";}
    private async Task Preview()=>await Dialogs.ShowAsync<CryptoExchangePreview>("Exchange preview",new DialogParameters<CryptoExchangePreview>{{dialog=>dialog.Symbol,_exchangeSymbol},{dialog=>dialog.Pay,_reverse?$"{Entered.ToString(English)} {_exchangeSymbol}":Money(Entered)},{dialog=>dialog.Receive,Output},{dialog=>dialog.Rate,Money(ExchangeAsset.Price)}},new DialogOptions{CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small});
    private async Task Export(){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await _download.InvokeVoidAsync("csv","crypto-portfolio.csv",CryptoDashboardCalculator.Csv(_source));}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}
}
