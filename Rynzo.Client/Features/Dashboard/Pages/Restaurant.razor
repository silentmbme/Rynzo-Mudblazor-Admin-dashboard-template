@page "/dashboards/restaurant-pos"
@page "/restaurant-pos.html"
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Features.Dashboard.Services
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
<PageTitle>Restaurant POS | Rynzo</PageTitle>
<div class="pos-dashboard">
    <DashboardPageHeader Title="Restaurant POS" Description="Take orders, manage tables, and keep your kitchen moving." />
    <MudCard Outlined="true" Elevation="0" Class="pos-banner rynzo-widget-card"><MudIcon Icon="@RynzoIcons.Get("UtensilsCrossed")" Color="Color.Primary" /><div><strong>The Green Table</strong><p>Sample menu · USD · Orders stay in this page session</p></div><MudChip T="string" Color="Color.Primary" Size="Size.Small">Demo POS · No payment processed</MudChip></MudCard>
    <section class="pos-metrics" aria-label="Service overview">@foreach(var metric in Metrics){<MudCard Style="@($"--metric-tone:var({metric.Color})")" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get(metric.Icon)" /></span><div><p>@metric.Label</p><strong>@metric.Value</strong><small>@metric.Note</small></div></MudCard>}</section>
    <section class="pos-workspace"><MudCard Class="pos-catalog rynzo-widget-card" Elevation="0" Outlined="true"><div class="pos-menu-heading"><div><span class="pos-section-label">MENU &amp; ORDERING</span><h2>Explore menu</h2></div><MudTextField T="string" @bind-Value="_query" Immediate="true" Placeholder="Search dishes…" aria-label="Search menu" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" Class="pos-search" /></div><div class="pos-categories">@foreach(var category in MenuCategories){<MudButton Variant="@(_category==category?Variant.Filled:Variant.Outlined)" Color="@(_category==category?Color.Primary:Color.Default)" Size="Size.Small" aria-pressed="@(_category==category?"true":"false")" OnClick="@(() => _category=category)">@category</MudButton>}</div><div class="pos-menu-grid">@foreach(var item in _state.Filter(_category,_query)){<RestaurantMenuCard @key="item.Id" Item="item" Quantity="@_state.Count(item.Id)" Add="Add" />}</div>@if(_state.Filter(_category,_query).Length==0){<p class="pos-menu-empty">No dishes match your search.</p>}</MudCard>
        <MudCard Outlined="true" Elevation="0" Class="pos-current-order rynzo-widget-card"><header><div><h2>Current order</h2><p>@_state.Items.Sum(i=>_state.Count(i.Id)) items</p></div><MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(_state.Items.Length==0)" OnClick="@(() => _state.Cart.Clear())">Clear</MudButton></header><MudCardContent><div class="pos-order-types">@foreach(var type in OrderTypes){<MudButton Variant="Variant.Text" Size="Size.Small" aria-pressed="@(_state.OrderType==type?"true":"false")" OnClick="@(() => _state.OrderType=type)">@type</MudButton>}</div><MudSelect T="string" @bind-Value="_state.Table" Disabled="@(_state.OrderType!="Dine in")" Label="Table / order type" InputId="pos-table" Variant="Variant.Outlined" Class="pos-table">@foreach(var table in TableOptions){<MudSelectItem Value="@table">@table</MudSelectItem>}</MudSelect><div class="pos-cart">@foreach(var item in _state.Items){<div class="pos-cart-item"><div><img src="@item.Image" alt="" /><div><h3>@item.Name</h3><p>@Money(item.Price) each</p></div><MudIconButton Icon="@RynzoIcons.Get("Trash2")" Size="Size.Small" aria-label="@($"Remove {item.Name}")" OnClick="@(() => _state.Remove(item.Id))" /></div><footer><div><MudIconButton Icon="@RynzoIcons.Get("Minus")" Size="Size.Small" Variant="Variant.Outlined" aria-label="@($"Decrease {item.Name}")" OnClick="@(() => _state.Quantity(item.Id,-1))" /><b>@_state.Count(item.Id)</b><MudIconButton Icon="@RynzoIcons.Get("Plus")" Size="Size.Small" Variant="Variant.Outlined" Disabled="@(_state.Count(item.Id)==99)" aria-label="@($"Increase {item.Name}")" OnClick="@(() => _state.Quantity(item.Id,1))" /></div><strong>@Money(item.Price*_state.Count(item.Id))</strong></footer></div>}@if(_state.Items.Length==0){<div class="pos-cart-empty"><MudIcon Icon="@RynzoIcons.Get("ShoppingBag")" /><h3>Your order is empty</h3><p>Add a dish from the menu to begin.</p></div>}</div><MudTextField T="string" @bind-Value="_state.Notes" Immediate="true" Label="Kitchen notes" InputId="pos-notes" MaxLength="200" Placeholder="Special requests…" Variant="Variant.Outlined" Class="pos-notes" /><div class="pos-discount-row"><span>Sample discount</span><MudSelect T="int" @bind-Value="_state.Discount" InputId="pos-discount" Variant="Variant.Outlined" Class="pos-discount" aria-label="Sample discount">@foreach(var discount in DiscountOptions){<MudSelectItem Value="@discount">@discount%</MudSelectItem>}</MudSelect></div><div class="pos-totals"><div><span>Subtotal</span><b>@Money(_state.Subtotal)</b></div><div><span>Sample tax (8%)</span><b>@Money(_state.Tax)</b></div>@if(_state.DiscountAmount>0){<div class="pos-discount-total"><span>Discount (@_state.Discount%)</span><b>-@Money(_state.DiscountAmount)</b></div>}<div class="pos-grand-total"><span>Total</span><b>@Money(_state.Total)</b></div></div><MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@(_state.Items.Length==0)" StartIcon="@RynzoIcons.Get("ReceiptText")" Class="pos-checkout" OnClick="PlaceOrder">Place sample order</MudButton></MudCardContent></MudCard>
    </section>
    <MudCard Outlined="true" Elevation="0" Class="pos-kitchen rynzo-widget-card rynzo-widget-card--structured"><MudCardContent><header><div><span class="pos-section-label">LIVE PREPARATION</span><h2>Kitchen orders</h2></div><MudChip T="string" Size="Size.Small" Color="Color.Primary">@_state.Orders.Count orders</MudChip></header><div class="pos-kitchen-grid">@foreach(var order in _state.Orders){<article><header><h3>@order.Id</h3><MudChip T="string" Size="Size.Small" Color="@(order.Status=="Ready"?Color.Success:Color.Primary)">@order.Status</MudChip></header><b>@order.Table</b><p>@order.Items</p>@if(order.Notes.Length>0){<p class="pos-kitchen-note">Kitchen note: @order.Notes</p>}<footer><strong>@Money(order.Total)</strong><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@RynzoIcons.Get("Check")" Disabled="@(order.Status=="Ready")" OnClick="@(() => _state.MarkReady(order.Id))">Mark ready</MudButton></footer></article>}</div>@if(_state.Orders.Count==0){<p class="pos-kitchen-empty">Orders will appear here after checkout.</p>}</MudCardContent></MudCard>
</div>
@code{
    private static readonly string[] MenuCategories = ["All", "Pizza", "Salads", "Mains", "Drinks"];
    private static readonly string[] OrderTypes = ["Dine in", "Takeaway", "Delivery"];
    private static readonly string[] TableOptions = ["Table 01", "Table 02", "Table 03", "Table 04", "Takeaway"];
    private static readonly int[] DiscountOptions = [0, 5, 10, 15];
    private readonly RestaurantPosState _state=new();
    private string _category="All",_query="";
    private static readonly BreadcrumbItem[] Breadcrumbs=[new("Dashboards",null),new("Restaurant POS",null,true)];
    private static string Money(double value)=>RestaurantPosState.Money(value);
    private (string Label,string Value,string Icon,string Color,string Note)[] Metrics=>[("Orders placed",_state.Orders.Count.ToString(),"ReceiptText","--info","Orders created this session"),("Kitchen queue",_state.Orders.Count(o=>o.Status=="Preparing").ToString(),"UtensilsCrossed","--warning","Waiting for kitchen preparation"),("Sample order value",Money(_state.Orders.Sum(o=>o.Total)),"ShoppingBag","--success","Combined sample order totals")];
    private void Add(string id)=>_state.Quantity(id,1);
    private async Task PlaceOrder(){var order=_state.PlaceOrder();if(order is null)return;Snackbar.Add("Sample order sent to kitchen",Severity.Success);await Dialogs.ShowAsync<RestaurantReceiptDialog>("Sample order confirmed",new DialogParameters<RestaurantReceiptDialog>{{d=>d.Order,order}},new DialogOptions{CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small});}
}
