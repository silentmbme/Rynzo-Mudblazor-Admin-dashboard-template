@using Rynzo.Client.Features.Files.Models
@using Rynzo.Client.Theme
<MudDialog><TitleContent><div class="drive-preview-title"><span class="drive-preview-eyebrow">FILE PREVIEW</span><h2>@Item.Name</h2><p>@Item.Type <span>·</span> @Item.Size</p></div></TitleContent><DialogContent><div class="drive-preview-art" style="@($"--preview-tone:var(--{Item.Tone})")">@if(Item.Id=="photo"){<img src="assets/images/files/team-studio.png" alt="Sample team in a design studio" />}else{<MudIcon Icon="@RynzoIcons.Get(Item.Icon)" /><span>@Item.Type</span>}</div><div class="drive-preview-info"><span>Owner <b>@Item.Owner</b></span><span>Modified <b>@Item.Modified</b></span></div><p class="drive-preview-note">Sample preview · File contents are not stored in this demo.</p></DialogContent><DialogActions><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Dialog.Close())">Close preview</MudButton></DialogActions></MudDialog>
@code{[Parameter,EditorRequired]public DriveItem Item{get;set;}=null!;[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;}
