@using Rynzo.Client.Theme
<MudDialog>
    <TitleContent><div class="drive-dialog-title"><span><MudIcon Icon="@RynzoIcons.Get(CreateFolder?"FolderPlus":"Pencil")" /></span><div><small>WORKSPACE DRIVE</small><h2>@Title</h2></div></div></TitleContent>
    <DialogContent><p class="drive-dialog-description">@(CreateFolder?"Give your new folder a clear name to keep your workspace organized.":"Update the item name in your workspace.")</p><form @onsubmit="Save" @onsubmit:preventDefault="true"><label class="drive-input-label" for="drive-item-name">@(CreateFolder?"Folder name":"Item name")</label><MudTextField T="string" InputId="drive-item-name" @bind-Value="_name" @bind-Value:after="Remember" Immediate="true" aria-label="@(CreateFolder?"Folder name":"Item name")" Placeholder="@(CreateFolder?"e.g. Product assets":"Enter a name")" Variant="Variant.Outlined" /><div class="drive-dialog-actions"><MudButton Variant="Variant.Outlined" OnClick="@(() => Dialog.Cancel())">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">@(CreateFolder?"Create folder":"Save changes")</MudButton></div></form></DialogContent>
</MudDialog>
@code{[Parameter]public string Title{get;set;}="";[Parameter]public string Name{get;set;}="";[Parameter]public bool CreateFolder{get;set;}[Parameter]public Func<string,string?>? Validate{get;set;}[Parameter]public EventCallback<string> Changed{get;set;}[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;[Inject]public ISnackbar Snackbar{get;set;}=null!;private string _name="";protected override void OnInitialized()=>_name=Name;private async Task Save(){var error=Validate?.Invoke(_name);if(error is not null){Snackbar.Add(error,Severity.Error);return;}Dialog.Close(DialogResult.Ok(_name.Length==0?Name:_name));await Task.CompletedTask;}public async Task Remember()=>await Changed.InvokeAsync(_name);}


