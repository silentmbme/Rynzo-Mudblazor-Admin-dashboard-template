@using Rynzo.Client.Theme
@using Rynzo.Client.Features.Hrm.Models
@using Rynzo.Client.Features.Dashboard.Components
@using System.Globalization
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable
<div class="payroll-workspace">
<DashboardPageHeader Title="Payroll" Description="Review sample payroll records and earnings breakdowns."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export payroll</MudButton></Actions></DashboardPageHeader>
<section class="pr-overview" aria-label="Payroll overview"><MudCard Class="pr-total rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div class="pr-total-heading"><span><MudIcon Icon="@RynzoIcons.Get("Wallet")" />Net sample payroll</span><span class="pr-period">October 2026</span></div><strong>@HrmRegister.Money(State.Payroll.Sum(p=>p.Net))</strong><p>Total net pay across @State.Payroll.Count illustrative records</p><div class="pr-costs"><div><small>Base salaries</small><b>@HrmRegister.Money(State.Payroll.Sum(p=>p.Base))</b></div><div><small>Allowances</small><b>@HrmRegister.Money(State.Payroll.Sum(p=>p.Allowance))</b></div><div><small>Sample deductions</small><b>@HrmRegister.Money(State.Payroll.Sum(p=>p.Deduction))</b></div></div></MudCard><div class="pr-summary"><MudCard Style="--tone:var(--success)" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="pr-metric-icon"><MudIcon Icon="@RynzoIcons.Get("Check")" /></span><div><span>Processed</span><strong>@HrmRegister.Money(State.Payroll.Where(p=>p.Status=="Processed").Sum(p=>p.Net))</strong><small>@State.Payroll.Count(p=>p.Status=="Processed") records marked processed</small></div></MudCard><MudCard Style="--tone:var(--warning)" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="pr-metric-icon"><MudIcon Icon="@RynzoIcons.Get("Clock3")" /></span><div><span>Pending records</span><strong>@State.Payroll.Count(p=>p.Status=="Pending")</strong><small>@HrmRegister.Money(State.Payroll.Where(p=>p.Status=="Pending").Sum(p=>p.Net)) net pay awaiting review</small></div></MudCard><MudCard Style="--tone:var(--info)" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="pr-metric-icon"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" /></span><div><span>Pay period</span><strong class="pr-period-value">Oct 2026</strong><small>Monthly sample register</small></div></MudCard></div></section>
<div class="pr-demo"><span><MudIcon Icon="@RynzoIcons.Get("Info")" /></span><div><b>Sample payroll workspace</b><p>Amounts and deductions are illustrative. Edits apply to this page session; no payments are made.</p></div><span class="pr-demo-badge">Demo data</span></div>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" Class="mb-5" role="status">@Notice</MudAlert>}
<MudCard Class="pr-register rynzo-widget-card" aria-label="Payroll register" Elevation="0" Outlined="true" data-widget-element="section"><div class="pr-register-heading"><div><span class="pr-eyebrow">People &amp; compensation</span><h2>October payroll register <span>@Visible.Count()</span></h2><p>Review earnings, deductions, and the status of each sample record.</p></div><span class="pr-register-icon"><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" /></span></div><div class="pr-toolbar"><div class="pr-tabs" aria-label="Payroll status">@foreach(var status in new[]{"All","Pending","Processed"}){<button type="button" class="@(Status==status?"selected":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@(status=="All"?"All records":status)<span>@State.Payroll.Count(p=>status=="All"||p.Status==status)</span></button>}</div><div class="pr-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search HR records" Placeholder="Search employee or reference…" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="HR department" @bind="Department"><option value="All">All departments</option>@foreach(var team in HrmRegister.Departments){<option>@team</option>}</select></div></div>
<div class="pr-table-scroll"><table class="pr-table"><thead><tr><th>Employee</th><th class="pr-number">Base salary</th><th class="pr-number">Allowances</th><th class="pr-number">Deductions</th><th class="pr-number">Net pay</th><th>Status</th><th><span class="pr-sr-only">Actions</span></th></tr></thead><tbody>@foreach(var pay in Visible){var person=State.Person(pay.EmployeeId);<tr><td><div class="pr-person"><img src="@Photo(person.Id)" alt="@person.Name" loading="lazy" /><div><b>@person.Name</b><small>@person.Role</small><span>@pay.Id · @person.Department</span></div></div></td><td class="pr-number">@HrmRegister.Money(pay.Base)</td><td class="pr-number pr-allowance">+@HrmRegister.Money(pay.Allowance)</td><td class="pr-number pr-deduction">-@HrmRegister.Money(pay.Deduction)</td><td class="pr-number"><b class="pr-net">@HrmRegister.Money(pay.Net)</b></td><td><span class="pr-status @(pay.Status=="Processed"?"processed":"pending")"><i></i>@pay.Status</span></td><td><MudButton Variant="Variant.Text" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Payroll {pay.Id}")" OnClick="@(()=>PayDetail=pay)">View breakdown</MudButton></td></tr>}</tbody>@if(Visible.Any()){<tfoot><tr><td>Current view totals</td><td class="pr-number">@HrmRegister.Money(Visible.Sum(p=>p.Base))</td><td class="pr-number">@HrmRegister.Money(Visible.Sum(p=>p.Allowance))</td><td class="pr-number">@HrmRegister.Money(Visible.Sum(p=>p.Deduction))</td><td class="pr-number">@HrmRegister.Money(Visible.Sum(p=>p.Net))</td><td colspan="2">@Visible.Count() records</td></tr></tfoot>}</table></div>
@if(!Visible.Any()){<div class="pr-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No matching payroll records</h3><p>Try another employee, reference, department, or status.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}
<div class="pr-register-footer"><span>Showing <b>@Visible.Count()</b> of @State.Payroll.Count illustrative pay records</span><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /> Session-only register</span></div></MudCard>
<div class="pr-formula"><span><MudIcon Icon="@RynzoIcons.Get("Wallet")" /></span><p><b>How net pay is calculated</b> Base salary + allowances - sample deductions.</p><span>Illustrative amounts (USD)</span></div>
</div>
<MudDialog Visible="@(PayDetail is not null)" VisibleChanged="@(v=>{if(!v)PayDetail=null;})" Options="DetailOptions"><TitleContent><MudText Typo="Typo.h6">Payroll breakdown</MudText></TitleContent><DialogContent>@if(PayDetail is {} pay){var person=State.Person(pay.EmployeeId);<div class="pr-detail"><div class="pr-detail-person"><img src="@Photo(person.Id)" alt="@person.Name" /><div><span class="pr-eyebrow">@pay.Id · @pay.Period</span><h2>@person.Name</h2><p>@person.Role</p></div></div><div class="pr-detail-total"><small>Net pay — Illustrative amounts</small><strong>@HrmRegister.Money(pay.Net)</strong><span class="pr-status @(pay.Status=="Processed"?"processed":"pending")"><i></i>@pay.Status</span></div><div class="pr-breakdown"><h3>Earnings breakdown</h3><div><span>Base salary</span><b>@HrmRegister.Money(pay.Base)</b></div><div><span>Allowances</span><b class="pr-allowance">+@HrmRegister.Money(pay.Allowance)</b></div><div><span>Sample deductions</span><b class="pr-deduction">-@HrmRegister.Money(pay.Deduction)</b></div><div class="pr-breakdown-net"><span>Net pay</span><b>@HrmRegister.Money(pay.Net)</b></div><div><span>Status</span><b>@pay.Status</b></div></div><p class="pr-detail-note">Net pay = base + allowances - sample deductions. No tax calculation, banking connection, or payment is performed.</p></div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>PayDetail=null)">Close</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@RynzoIcons.Get("Check")" Disabled="@(PayDetail?.Status=="Processed")" OnClick="Process">Mark sample processed</MudButton></DialogActions></MudDialog>
@code {
    private readonly HrmRegister State=new();
    private string Query="",Department="All",Status="All",Notice="";
    private PayRecord? PayDetail;
    private IJSObjectReference? Download;
    private static readonly DialogOptions DetailOptions=new(){MaxWidth=MaxWidth.Small,FullWidth=true};
    private IEnumerable<PayRecord> Visible=>State.Payroll.Where(p=>State.Matches(p.EmployeeId,p.Id,p.Status,Query,Department,Status));
    private string Photo(string id)=>$"assets/images/users/user-{State.People.ToList().FindIndex(p=>p.Id==id)%4+1}.jpg";
    private void Reset(){Query="";Department=Status="All";}
    private void Process(){if(PayDetail is not {} pay)return;State.Process(pay.Id);PayDetail=State.Payroll.First(p=>p.Id==pay.Id);Notice=$"{pay.Id} marked processed in the sample register. No payment made.";}
    private async Task Export(){try{var rows=new[]{new[]{"ID","Employee","Period","Base","Allowances","Sample deductions","Net","Status"}}.Concat(Visible.Select(p=>new[]{p.Id,State.Person(p.EmployeeId).Name,p.Period,p.Base.ToString(CultureInfo.InvariantCulture),p.Allowance.ToString(CultureInfo.InvariantCulture),p.Deduction.ToString(CultureInfo.InvariantCulture),p.Net.ToString(CultureInfo.InvariantCulture),p.Status}));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await Download.InvokeVoidAsync("csv","sample-payroll.csv",HrmRegister.Csv(rows));Notice="Filtered sample records exported.";}catch(JSException){Snackbar.Add("The browser could not export these records.",Severity.Error);}}
    public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
