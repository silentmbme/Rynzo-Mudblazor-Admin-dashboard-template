@using Rynzo.Client.Theme
@using Rynzo.Client.Features.Hrm.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Assets
@using System.Globalization
@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="leave-workspace">
<DashboardPageHeader Title="Leave Requests" Description="Review time off, check team coverage, and record clear approval decisions."><Actions><div><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export requests</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(()=>{Create=true;Error="";})">New request</MudButton></div></Actions></DashboardPageHeader>
<section class="lv-stats" aria-label="Leave overview">@foreach(var stat in Stats){var tone=stat.Item1=="Awaiting review"?"warning":stat.Item1=="Approved requests"?"success":stat.Item1=="Approved calendar days"?"info":"primary";<MudCard Style="@($"--tone:var(--{tone})")" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div><span class="lv-stat-icon"><MudIcon Icon="@RynzoIcons.Get(stat.Item1=="Awaiting review"?"Clock3":stat.Item1=="Approved requests"?"Check":stat.Item1=="Approved calendar days"?"CalendarDays":"X")" /></span><span>@stat.Item1</span></div><strong>@stat.Item2</strong><small>@stat.Item3</small></MudCard>}</section>
<div class="lv-week-layout"><MudCard Class="lv-calendar-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="lv-panel-heading"><div><span class="lv-eyebrow">Team availability</span><h2>Time-off calendar</h2><p>Approved and pending requests in @(Department=="All"?"all departments":Department)</p></div><div class="lv-week-nav"><MudIconButton Icon="@RynzoIcons.Get("ChevronLeft")" aria-label="Previous leave week" OnClick="@(()=>Shift(-7))" /><span>@Label(Week) &ndash; @Label(Week.AddDays(6)), @Week.Year</span><MudIconButton Icon="@RynzoIcons.Get("ChevronRight")" aria-label="Next leave week" OnClick="@(()=>Shift(7))" /></div></div><div class="lv-calendar-scroll"><div class="lv-calendar">@foreach(var date in Enumerable.Range(0,7).Select(i=>Week.AddDays(i))){var day=date.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture);var scheduled=Scope.Where(r=>r.Status!="Rejected"&&r.Covers(day)).ToArray();<button type="button" class="lv-day @(DayFilter==day?"selected":"")" aria-label="@($"Leave day {day}")" aria-pressed="@(DayFilter==day)" @onclick="@(()=>DayFilter=DayFilter==day?null:day)"><span>@date.ToString("ddd",CultureInfo.InvariantCulture)</span><strong>@date.Day</strong><div class="lv-day-avatars">@foreach(var request in scheduled.Take(3)){var person=State.Register.Person(request.EmployeeId);<img src="@SourceUserImages.Get(person.Name)" alt="@person.Name" />}</div><small>@(scheduled.Length>0?$"{scheduled.Length} request{(scheduled.Length==1?"":"s")}":"No time off")</small></button>}</div></div><p class="lv-calendar-note"><MudIcon Icon="@RynzoIcons.Get("Info")" />Select a day to filter the queue. Pending requests are not confirmed absences. Calendar counts follow the department filter.</p></MudCard>
<section class="lv-priorities"><div class="lv-priority-heading"><span class="lv-eyebrow">Action center</span><h2>Review priorities</h2></div>@foreach(var request in Scope.Where(r=>r.Status=="Pending").OrderBy(r=>r.Start).Take(3)){var person=State.Register.Person(request.EmployeeId);<button type="button" class="lv-priority" aria-label="@($"Priority {request.Id}")" @onclick="@(()=>Open(request.Id))"><img src="@SourceUserImages.Get(person.Name)" alt="@person.Name" /><span><b>@person.Name</b><small>@request.Type &middot; @Label(DateOnly.Parse(request.Start))</small></span><MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></button>}@if(!Scope.Any(r=>r.Status=="Pending")){<div class="lv-priority-empty"><MudIcon Icon="@RynzoIcons.Get("Check")" /><p>No pending requests in this department.</p></div>}<p class="lv-priority-note">Sample records for 2026. Decisions and notes last for this page session.</p></section></div>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" Class="mb-5" role="status">@Notice</MudAlert>}
<section class="lv-queue" aria-label="Approval queue"><div class="lv-queue-heading"><div><span class="lv-eyebrow">Request management</span><h2>Approval queue <span>@Visible.Count()</span></h2><p>Review the context, check coverage, and record a clear decision.</p></div><span class="lv-queue-icon"><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" /></span></div>
<div class="lv-queue-tools"><div class="lv-tabs" aria-label="Leave status">@foreach(var status in new[]{"All","Pending","Approved","Rejected"}){<button type="button" class="@(Status==status?"selected":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@(status=="All"?"All requests":status)<span>@Scope.Count(r=>status=="All"||r.Status==status)</span></button>}</div><select aria-label="Sort leave requests" @bind="Sort"><option value="pending">Pending first</option><option value="date">Start date</option><option value="duration">Longest duration</option></select></div>
<div class="lv-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search HR records" Placeholder="Search employee, reference, or reason&#8230;" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="HR department" @bind="Department"><option value="All">All departments</option>@foreach(var team in HrmRegister.Departments){<option>@team</option>}</select><select aria-label="Leave type filter" @bind="Type"><option value="All">All leave types</option>@foreach(var type in LeaveQueue.Types){<option>@type</option>}</select></div>
@if(DayFilter is not null){<div class="lv-day-filter"><span><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />Requests covering @Label(DateOnly.Parse(DayFilter)), @DayFilter[..4]</span><MudButton Size="Size.Small" EndIcon="@RynzoIcons.Get("X")" OnClick="@(()=>DayFilter=null)">Clear day filter</MudButton></div>}
<div class="lv-table-scroll"><table class="lv-table"><thead><tr><th>Employee</th><th>Leave type</th><th>Dates</th><th>Duration</th><th>Status</th><th>Decision note</th><th><span class="lv-sr-only">Actions</span></th></tr></thead><tbody>@foreach(var request in Visible){var person=State.Register.Person(request.EmployeeId);<tr><td><div class="lv-person"><img src="@SourceUserImages.Get(person.Name)" alt="@person.Name" loading="lazy" /><div><b>@person.Name</b><small>@person.Department &middot; @request.Id</small></div></div></td><td><span class="lv-type"><MudIcon Icon="@RynzoIcons.Get(request.Type=="Sick leave"?"Heart":request.Type=="Annual leave"?"CalendarDays":"UserRound")" />@request.Type</span></td><td><span>@Label(DateOnly.Parse(request.Start)) &ndash; @Label(DateOnly.Parse(request.End))</span><small class="lv-year">@request.End[..4]</small></td><td><b class="lv-days">@request.Days</b><small class="lv-duration">calendar days</small></td><td><span class="lv-status @request.Status.ToLowerInvariant()"><i></i>@request.Status</span></td><td><span class="lv-latest-note" title="@(State.Decisions.GetValueOrDefault(request.Id)?.FirstOrDefault()?.Note)">@(State.Decisions.GetValueOrDefault(request.Id)?.FirstOrDefault()?.Note is {Length:>0} note?note:"No recorded note")</span></td><td><MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Leave {request.Id}")" OnClick="@(()=>Open(request.Id))">Review request</MudButton></td></tr>}</tbody></table></div>
@if(!Visible.Any()){<div class="lv-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No requests match these filters</h3><p>Try another employee, date, department, or leave type.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}
<div class="lv-queue-footer"><span>Showing <b>@Visible.Count()</b> of @Scope.Count() requests in scope</span><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /> Session-only decisions</span></div></section><p class="lv-duration-note">Durations include weekends and are not policy-adjusted working days or leave entitlement calculations.</p>
</div>
<MudDialog Visible="@(Active is not null)" VisibleChanged="@(v=>{if(!v)ReviewId=null;})" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">Leave request review</MudText></TitleContent><DialogContent>@if(Active is {} request){var person=State.Register.Person(request.EmployeeId);<div class="lv-review"><div class="lv-review-person"><img src="@SourceUserImages.Get(person.Name)" alt="@person.Name" /><div><span class="lv-eyebrow">@request.Id &middot; Sample approval workflow</span><h2>@person.Name</h2><p>@person.Role &middot; @person.Department</p></div></div><div class="lv-review-summary"><div><small>Leave type</small><b>@request.Type</b></div><span class="lv-status @request.Status.ToLowerInvariant()"><i></i>@request.Status</span><div><small>Date range</small><b>@Label(DateOnly.Parse(request.Start)) &ndash; @Label(DateOnly.Parse(request.End)), @request.End[..4]</b></div><div><small>Duration</small><b>@request.Days calendar days</b></div></div><div class="lv-reason"><h3>Employee reason</h3><p>@request.Reason</p></div><MudAlert Severity="@(State.Conflicts(request).Any()?Severity.Warning:Severity.Success)" Variant="Variant.Outlined" Class="my-4"><b>Team coverage check</b><p>@(State.Conflicts(request).Any()?$"{State.Conflicts(request).Count()} approved request(s) in this department overlap these dates: {string.Join(", ",State.Conflicts(request).Select(r=>State.Register.Person(r.EmployeeId).Name))}.":"No other approved leave requests in this department overlap these dates.") This sample check does not assess staffing requirements.</p></MudAlert>@if(request.Status=="Pending"){<label class="lv-field-label">Decision note</label><MudTextField T="string" @bind-Value="Note" Immediate="true" aria-label="Leave decision note" Placeholder="Explain your decision; required when rejecting&#8230;" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" MaxLength="500" />@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}}@if(State.Decisions.TryGetValue(request.Id,out var history)){<h3 class="lv-history-title">Decision history</h3><div class="lv-history">@foreach(var decision in history){<div><span><b>@decision.Status</b><small>@decision.Time.ToString("HH:mm")</small></span><p>@(decision.Note.Length>0?decision.Note:"No decision note added.")</p></div>}</div>}<p class="lv-dialog-note">Decisions update this local sample queue only. No notifications or leave balances are changed.</p></div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>ReviewId=null)">Close</MudButton>@if(Active?.Status=="Pending"){<MudButton Variant="Variant.Outlined" OnClick="@(()=>Decide("Rejected"))">Reject request</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@RynzoIcons.Get("Check")" OnClick="@(()=>Decide("Approved"))">Approve request</MudButton>}else{<MudButton Variant="Variant.Outlined" OnClick="@(()=>Decide("Pending"))">Reopen request</MudButton>}</DialogActions></MudDialog>
<MudDialog @bind-Visible="Create" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">New leave request</MudText></TitleContent><DialogContent><div class="lv-create"><p class="lv-dialog-note">Create a local sample request for review.</p><label class="lv-field-label" for="lv-employee">Employee</label><select id="lv-employee" aria-label="Record employee" @bind="EmployeeId">@foreach(var person in State.Register.People){<option value="@person.Id">@person.Name</option>}</select><label class="lv-field-label" for="lv-type">Leave type</label><select id="lv-type" aria-label="Leave type" @bind="NewType">@foreach(var type in LeaveQueue.Types){<option>@type</option>}</select><div class="lv-date-fields"><div><label class="lv-field-label" for="lv-start">Start date</label><input id="lv-start" type="date" aria-label="Start date" value="@Start" @onchange="@(e=>Start=e.Value?.ToString()??"")" /></div><div><label class="lv-field-label" for="lv-end">End date</label><input id="lv-end" type="date" aria-label="End date" value="@End" @onchange="@(e=>End=e.Value?.ToString()??"")" /></div></div><div class="lv-duration-preview"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" /><p><b>@DurationPreview</b><span>Weekends are included; no entitlement calculation is performed.</span></p></div><label class="lv-field-label">Leave reason</label><MudTextField T="string" @bind-Value="Reason" Immediate="true" aria-label="Leave reason" Placeholder="Provide context for your time off&#8230;" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" MaxLength="500" />@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}</div></DialogContent><DialogActions><MudButton OnClick="@(()=>Create=false)">Cancel</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Submit request</MudButton></DialogActions></MudDialog>
@code{
    private readonly LeaveQueue State=new();
    private string Query="",Department="All",Status="All",Type="All",Sort="pending",Note="",Error="",Notice="",EmployeeId="EMP-101",NewType="Annual leave",Start="2026-10-19",End="2026-10-20",Reason="";
    private string? DayFilter,ReviewId;
    private DateOnly Week=new(2026,10,12);
    private bool Create;
    private LeaveRecord? Active=>State.Requests.FirstOrDefault(r=>r.Id==ReviewId);
    private IEnumerable<LeaveRecord> Scope=>State.Scope(Department);
    private IEnumerable<LeaveRecord> Visible=>State.Filter(Query,Department,Status,Type,Sort,DayFilter);
    private static readonly DialogOptions DialogOptions=new(){MaxWidth=MaxWidth.Small,FullWidth=true};
    private (string,int,string)[] Stats=>[("Awaiting review",Scope.Count(r=>r.Status=="Pending"),"Requests requiring a decision"),("Approved requests",Scope.Count(r=>r.Status=="Approved"),"Approved in the sample workspace"),("Approved calendar days",Scope.Where(r=>r.Status=="Approved").Sum(r=>r.Days),"Inclusive days; not a leave balance"),("Rejected requests",Scope.Count(r=>r.Status=="Rejected"),"Reopen to reconsider a decision")];
    private static string Label(DateOnly d)=>d.ToString("MMM d",CultureInfo.GetCultureInfo("en-US"));
    private string DurationPreview=>DateOnly.TryParse(Start,out var s)&&DateOnly.TryParse(End,out var e)&&e>=s?$"{e.DayNumber-s.DayNumber+1} inclusive calendar days":"Select a valid date range";
    private void Shift(int n){Week=Week.AddDays(n);DayFilter=null;}
    private void Open(string id){ReviewId=id;Note=Error="";}
    private void Reset(){Query="";Department=Status=Type="All";DayFilter=null;}
    private void Decide(string status){if(ReviewId is null)return;Error=State.Decide(ReviewId,status,Note,DateTime.Now)??"";if(Error.Length>0)return;Notice=$"{ReviewId} {(status=="Pending"?"reopened":status.ToLowerInvariant())} locally. No employee notification sent.";Note="";}
    private void Submit(){Error=State.Create(new("",EmployeeId,NewType,Start,End,Reason,"Pending"))??"";if(Error.Length>0)return;Create=false;Notice=$"{State.Requests.Last().Id} added to the sample review queue.";Reason="";}
    private IJSObjectReference? Download;
    private async Task Export(){var rows=new[]{new[]{"Reference","Employee","Department","Type","Start","End","Calendar days","Status","Reason","Latest decision note"}}.Concat(Visible.Select(r=>new[]{r.Id,State.Register.Person(r.EmployeeId).Name,State.Register.Person(r.EmployeeId).Department,r.Type,r.Start,r.End,r.Days.ToString(CultureInfo.InvariantCulture),r.Status,r.Reason,State.Decisions.GetValueOrDefault(r.Id)?.FirstOrDefault()?.Note??""}));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await Download.InvokeVoidAsync("csv","leave-requests.csv",HrmRegister.Csv(rows));Notice=$"Exported {Visible.Count()} filtered leave requests.";}
    public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}




