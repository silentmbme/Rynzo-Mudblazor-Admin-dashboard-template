@using Rynzo.Client.Theme
@using Rynzo.Client.Features.Hrm.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Assets
@using System.Globalization
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable
<div class="reviews-workspace">
<DashboardPageHeader Title="Performance Reviews" Description="Plan feedback cycles and record performance reviews."><Actions><div><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export reviews</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenCreate">Create review</MudButton></div></Actions></DashboardPageHeader>
<MudCard Class="rv-summary rynzo-widget-card" aria-label="Review overview" Elevation="0" Outlined="true" data-widget-element="section"><div class="rv-summary-title"><span class="rv-summary-icon"><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" /></span><span class="rv-eyebrow">Feedback workspace</span><h2>People. Progress.<br />A clear conversation.</h2><p>Sample feedback cycles for your teams.</p></div><div class="rv-metrics">@foreach(var metric in Metrics){<MudCard Style="@($"--tone:var(--{metric.Tone})")" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get(metric.Icon)" />@metric.Label</span><strong>@metric.Value</strong><small>@metric.Caption</small></MudCard>}</div></MudCard>
<div class="rv-session"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>Sample HR workspace <span>&middot;</span> Records and edits apply to this page session.</p><span>Demo data</span></div>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" Class="mb-5" role="status">@Notice</MudAlert>}
<section aria-label="Review directory"><div class="rv-heading"><div><span class="rv-eyebrow">Development &amp; feedback</span><h2>Review directory <span>@Visible.Count()</span></h2><p>Keep feedback, ratings, and ownership together.</p></div><span class="rv-heading-icon"><MudIcon Icon="@RynzoIcons.Get("Users")" /></span></div><div class="rv-toolbar"><div class="rv-tabs" aria-label="Review status">@foreach(var status in new[]{"All","Draft","Completed"}){<button type="button" class="@(Status==status?"selected":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@(status=="All"?"All reviews":status=="Draft"?"Drafts":status)<span>@State.Reviews.Count(r=>status=="All"||r.Status==status)</span></button>}</div><div class="rv-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search HR records" Placeholder="Search employee or reference&#8230;" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="HR department" @bind="Department"><option value="All">All departments</option>@foreach(var department in HrmRegister.Departments){<option>@department</option>}</select></div></div>
<div class="rv-grid">@foreach(var review in Visible){var person=State.Person(review.EmployeeId);<MudCard Class="rv-card rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div class="rv-card-top"><span class="rv-reference">@review.Id <span>&middot;</span> @person.Department</span><span class="rv-status @review.Status.ToLowerInvariant()"><i></i>@review.Status</span></div><div class="rv-person"><img src="@SourceUserImages.Get(person.Name)" alt="@person.Name" loading="lazy" /><div><h3>@person.Name</h3><p>@person.Role</p><small>@person.Id</small></div></div><div class="rv-rating"><div><span>@(review.Status=="Draft"?"Draft rating":"Completed rating")</span><div class="rv-stars" aria-label="@($"{review.Rating} out of 5 stars")">@foreach(var star in Enumerable.Range(1,5)){<MudIcon Icon="@RynzoIcons.Get("Star")" Class="@(star<=review.Rating?"filled":"")" />}</div></div><strong>@review.Rating<small>/ 5</small></strong></div><div class="rv-feedback"><span class="rv-eyebrow">Feedback</span><p>@(review.Notes.Length>0?review.Notes:"No feedback added yet.")</p></div><div class="rv-meta"><div><span>Reviewer</span><b>@review.Reviewer</b></div><div><span><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />Due date</span><b>@review.Due</b></div></div><div class="rv-card-footer"><span><MudIcon Icon="@RynzoIcons.Get(review.Status=="Completed"?"Check":"Pencil")" />@(review.Status=="Completed"?"Feedback recorded":"Ready for your feedback")</span><MudButton Variant="Variant.Text" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Review {review.Id}")" OnClick="@(()=>OpenReview(review))">@(review.Status=="Completed"?"View review":"Edit review")</MudButton></div></MudCard>}</div>
@if(!Visible.Any()){<div class="rv-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No matching reviews</h3><p>Try another employee, reference, department, or status.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}
<div class="rv-results"><span>Showing <b>@Visible.Count()</b> of @State.Reviews.Count reviews</span><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /> Local sample feedback</span></div></section>
</div>
<MudDialog @bind-Visible="Create" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">Create performance review</MudText></TitleContent><DialogContent><div class="rv-create"><div class="rv-create-intro"><span><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" /></span><div><h2>Start a feedback conversation</h2><p>Create a sample review for this page session.</p></div></div><label for="rv-employee">Employee</label><select id="rv-employee" aria-label="Employee" @bind="EmployeeId">@foreach(var person in State.People){<option value="@person.Id">@person.Name</option>}</select><label for="rv-reviewer">Reviewer name</label><MudTextField T="string" @bind-Value="Reviewer" InputId="rv-reviewer" Immediate="true" aria-label="Reviewer name" Placeholder="Enter reviewer name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="80" /><label for="rv-due">Review due date</label><input id="rv-due" aria-label="Review due date" type="date" value="@Due" @onchange="@(e=>Due=e.Value?.ToString()??"")" /><p class="rv-dialog-note">New reviews start as drafts. Add feedback before completing a review.</p>@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}</div></DialogContent><DialogActions><MudButton OnClick="@(()=>Create=false)">Cancel</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@RynzoIcons.Get("Plus")" OnClick="CreateReview">Create draft</MudButton></DialogActions></MudDialog>
<MudDialog Visible="@(Draft is not null)" VisibleChanged="@(v=>{if(!v)Draft=null;})" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">Performance review</MudText></TitleContent><DialogContent>@if(Draft is {} draft){var person=State.Person(draft.EmployeeId);<div class="rv-editor"><div class="rv-editor-person"><img src="@SourceUserImages.Get(person.Name)" alt="@person.Name" /><div><span class="rv-eyebrow">@draft.Id &middot; Sample feedback record</span><h2>@person.Name</h2><p>@person.Role</p></div></div><div class="rv-editor-meta"><div><small>Reviewer</small><b>@draft.Reviewer</b></div><div><small>Due date</small><b>@draft.Due</b></div><span class="rv-status @draft.Status.ToLowerInvariant()"><i></i>@draft.Status</span></div><label for="rv-rating">Review rating</label><select id="rv-rating" aria-label="Review rating" value="@draft.Rating" @onchange="@(e=>Draft=draft with{Rating=int.Parse(e.Value!.ToString()!,CultureInfo.InvariantCulture)})" disabled="@(draft.Status=="Completed")">@foreach(var rating in Enumerable.Range(1,5)){<option value="@rating">@rating / 5</option>}</select><label for="rv-feedback">Review feedback</label><MudTextField T="string" InputId="rv-feedback" aria-label="Review feedback" Value="draft.Notes" ValueChanged="@(v=>Draft=draft with{Notes=v})" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(draft.Status=="Completed")" Placeholder="Record strengths, progress, and areas for development&#8230;" Lines="6" MaxLength="1500" /><small class="rv-feedback-count">@draft.Notes.Length/1500 characters</small>@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}<p class="rv-dialog-note">@(draft.Status=="Completed"?"This review is complete. Reopen it to update its rating or feedback.":"Save your progress as a draft, or complete the review when feedback is ready.") Changes apply to this page session.</p></div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>Draft=null)">Close</MudButton>@if(Draft?.Status=="Draft"){<MudButton Variant="Variant.Outlined" OnClick="@(()=>Save(false))">Save draft</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@RynzoIcons.Get("Check")" OnClick="@(()=>Save(true))">Complete review</MudButton>}else{<MudButton Variant="Variant.Outlined" OnClick="Reopen">Reopen review</MudButton>}</DialogActions></MudDialog>
@code {
    private readonly HrmRegister State=new();
    private string Query="",Department="All",Status="All",Notice="",Error="",EmployeeId="EMP-101",Reviewer="",Due="2026-10-23";
    private bool Create;
    private ReviewRecord? Draft;
    private IJSObjectReference? Download;
    private static readonly DialogOptions DialogOptions=new(){MaxWidth=MaxWidth.Small,FullWidth=true};
    private IEnumerable<ReviewRecord> Visible=>State.Reviews.Where(r=>State.Matches(r.EmployeeId,r.Id,r.Status,Query,Department,Status));
    private string AverageRating=>State.Reviews.Any(r=>r.Status=="Completed")?State.Reviews.Where(r=>r.Status=="Completed").Average(r=>r.Rating).ToString("F1",CultureInfo.InvariantCulture)+" / 5":"No ratings";
    private (string Label,string Value,string Caption,string Icon,string Tone)[] Metrics=>[("Review cycles",State.Reviews.Count.ToString(),"Sample feedback records","ClipboardList","primary"),("Completed",State.Reviews.Count(r=>r.Status=="Completed").ToString(),"Feedback recorded","Check","success"),("Drafts",State.Reviews.Count(r=>r.Status=="Draft").ToString(),"Open conversations","Pencil","warning"),("Average completed rating",AverageRating,"Completed reviews only","Star","info")];
    private void Reset(){Query="";Department=Status="All";}
    private void OpenCreate(){Error="";Create=true;}
    private void OpenReview(ReviewRecord review){Error="";Draft=review with{};}
    private void CreateReview(){Error=State.CreateReview(EmployeeId,Reviewer,Due)??"";if(Error.Length>0)return;Notice=$"{State.Reviews.Last().Id} created as a draft.";Create=false;}
    private void Save(bool complete){if(Draft is not {} draft)return;Error=State.SaveReview(draft,complete)??"";if(Error.Length>0)return;Notice=$"{draft.Id} "+(complete?"completed locally.":"draft saved.");Draft=null;}
    private void Reopen(){if(Draft is not {} draft)return;State.SaveReview(draft,false);Draft=draft with{Status="Draft"};Notice=$"{draft.Id} reopened as a draft.";}
    private async Task Export(){try{var rows=new[]{new[]{"ID","Employee","Reviewer","Due","Rating","Status","Notes"}}.Concat(Visible.Select(r=>new[]{r.Id,State.Person(r.EmployeeId).Name,r.Reviewer,r.Due,r.Rating.ToString(CultureInfo.InvariantCulture),r.Status,r.Notes}));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await Download.InvokeVoidAsync("csv","performance-reviews.csv",HrmRegister.Csv(rows));Notice="Filtered sample records exported.";}catch(JSException){Snackbar.Add("The browser could not export these records.",Severity.Error);}}
    public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
