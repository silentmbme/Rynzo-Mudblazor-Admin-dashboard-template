@using Rynzo.Client.Theme
@using Rynzo.Client.Features.Hrm.Models
@using Rynzo.Client.Features.Dashboard.Components
@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="employee-workspace">
<DashboardPageHeader Title="Employees" Description="A complete view of your people, teams, and work arrangements."><Actions><div><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export directory</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@RynzoIcons.Get("Plus")" OnClick="Add">Add employee</MudButton></div></Actions></DashboardPageHeader>
<section class="em-stats" aria-label="Workforce overview">@foreach(var stat in Stats){var tone=stat.Item1=="Active employees"?"success":stat.Item1=="On leave"?"warning":stat.Item1=="Departments"?"info":"primary";<MudCard Style="@($"--tone:var(--{tone})")" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="em-stat-icon"><MudIcon Icon="@RynzoIcons.Get(stat.Item1=="Total employees"?"Users":stat.Item1=="Active employees"?"UserCheck":stat.Item1=="On leave"?"CalendarDays":"Briefcase")" /></span><div><span>@stat.Item1</span><strong>@stat.Item2</strong><small>@stat.Item3</small></div></MudCard>}</section>
<div class="em-session"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>Sample people workspace <span>•</span> Directory edits apply to this page session.</p><span>Demo data</span></div>
@if(Notice.Length>0){<MudAlert Class="mb-5" Severity="Severity.Success" role="status">@Notice</MudAlert>}
<div class="em-layout"><aside class="em-sidebar"><MudCard Class="em-team-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="em-sidebar-heading"><span class="em-eyebrow">Your organization</span><h2>People by department</h2><p>Select a team to focus the directory.</p></div><button type="button" class="em-team @(Department=="All"?"selected":"")" aria-pressed="@(Department=="All")" @onclick="@(()=>Department="All")"><span class="em-team-symbol"><MudIcon Icon="@RynzoIcons.Get("Users")" /></span><span><b>All departments</b><small>Complete directory</small></span><strong>@State.Employees.Count</strong></button>@foreach(var team in HrmRegister.Departments){var count=State.Employees.Count(e=>e.Person.Department==team);<button type="button" class="em-team @(Department==team?"selected":"")" style="@($"--tone:var(--{TeamTone(team)})")" aria-label="@($"Team {team}")" aria-pressed="@(Department==team)" @onclick="@(()=>Department=Department==team?"All":team)"><i></i><span><b>@team</b><small>@Math.Round(count*100d/State.Employees.Count)% of sample headcount</small></span><strong>@count</strong></button>}</MudCard><MudCard Class="em-mode-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="em-sidebar-heading"><span class="em-eyebrow">Where we work</span><h2>Work arrangements</h2><p>Choose an arrangement to filter.</p></div>@foreach(var mode in EmployeeDirectory.Modes){<button type="button" class="em-mode @(Mode==mode?"selected":"")" aria-label="@($"Arrangement {mode}")" aria-pressed="@(Mode==mode)" @onclick="@(()=>Mode=Mode==mode?"All":mode)"><span><MudIcon Icon="@RynzoIcons.Get(mode=="Office"?"Building2":"Laptop")" />@mode</span><b>@State.Employees.Count(e=>e.Mode==mode)</b></button>}</MudCard><div class="em-sidebar-note"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /><p>Profile changes remain local. No employee notifications are sent.</p></div></aside>
<section class="em-directory" aria-label="Employee directory"><div class="em-directory-heading"><div><span class="em-eyebrow">People &amp; teams</span><h2>Employee directory <span>@Visible.Count()</span></h2><p>Find a colleague, explore a team, or manage employee details.</p></div><div class="em-view-toggle"><MudIconButton Icon="@RynzoIcons.Get("LayoutGrid")" Class="@(Grid?"selected":"")" aria-label="Employee grid view" aria-pressed="@Grid" OnClick="@(()=>Grid=true)" /><MudIconButton Icon="@RynzoIcons.Get("List")" Class="@(!Grid?"selected":"")" aria-label="Employee list view" aria-pressed="@(!Grid)" OnClick="@(()=>Grid=false)" /></div></div>
<div class="em-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search HR records" Placeholder="Search name, role, email, or location…" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Sort employees" @bind="Sort"><option value="name">Name A–Z</option><option value="newest">Newest join date</option><option value="department">Department</option></select><select aria-label="HR department" @bind="Department"><option value="All">All departments</option>@foreach(var team in HrmRegister.Departments){<option>@team</option>}</select><select aria-label="HR status" @bind="Status"><option value="All">All statuses</option><option>Active</option><option>On leave</option></select><select aria-label="Employee work arrangement" @bind="Mode"><option value="All">All arrangements</option>@foreach(var mode in EmployeeDirectory.Modes){<option>@mode</option>}</select></div>
@if(!Visible.Any()){<div class="em-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No matching employees</h3><p>Try another search or clear your filters.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}
else if(Grid){<div class="em-grid">@foreach(var employee in Visible){<MudCard Class="em-card rynzo-widget-card" Style="@($"--tone:var(--{TeamTone(employee.Person.Department)})")" Elevation="0" Outlined="true" data-widget-element="article"><div class="em-card-top"><span class="em-department"><i></i>@employee.Person.Department</span><MudButton Size="Size.Small" StartIcon="@RynzoIcons.Get("Pencil")" aria-label="@($"Edit {employee.Person.Id}")" OnClick="@(()=>Edit(employee))">Edit</MudButton></div><div class="em-card-person"><img src="@employee.Photo" alt="@employee.Person.Name" loading="lazy" /><h3>@employee.Person.Name</h3><p>@employee.Person.Role</p><span class="em-status @(employee.Person.Status=="Active"?"active":"leave")"><i></i>@employee.Person.Status</span></div><div class="em-card-info"><a href="@($"mailto:{employee.Person.Email}")"><MudIcon Icon="@RynzoIcons.Get("Mail")" /><span>@employee.Person.Email</span></a><div><MudIcon Icon="@RynzoIcons.Get("MapPin")" /><span>@employee.Location</span><small>@employee.Mode</small></div><div><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" /><span>Joined @employee.Person.Joined</span></div></div><div class="em-card-footer"><span>@employee.Person.Id</span><MudButton Variant="Variant.Text" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Employee {employee.Person.Id}")" OnClick="@(()=>ProfileId=employee.Person.Id)">View profile</MudButton></div></MudCard>}</div>}
else{<div class="em-table-scroll"><table class="em-table"><thead><tr><th>Employee</th><th>Department</th><th>Work arrangement</th><th>Joined</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var employee in Visible){<tr><td><div class="em-table-person"><img src="@employee.Photo" alt="@employee.Person.Name" /><div><b>@employee.Person.Name</b><small>@employee.Person.Id · @employee.Person.Role</small></div></div></td><td>@employee.Person.Department</td><td><b>@employee.Mode</b><small>@employee.Location</small></td><td>@employee.Person.Joined</td><td><span class="em-status @(employee.Person.Status=="Active"?"active":"leave")"><i></i>@employee.Person.Status</span></td><td><MudButton Size="Size.Small" aria-label="@($"Employee {employee.Person.Id}")" OnClick="@(()=>ProfileId=employee.Person.Id)">View profile</MudButton><MudButton Size="Size.Small" aria-label="@($"Edit {employee.Person.Id}")" OnClick="@(()=>Edit(employee))">Edit</MudButton></td></tr>}</tbody></table></div>}
<div class="em-results"><span>Showing <b>@Visible.Count()</b> of @State.Employees.Count people</span><span>Sample directory · Session-only edits</span></div></section></div>
</div>
<MudDialog Visible="@(Active is not null)" VisibleChanged="@(v=>{if(!v)ProfileId=null;})" Options="ProfileOptions"><TitleContent><MudText Typo="Typo.h6">Employee profile</MudText></TitleContent><DialogContent>@if(Active is {} employee){<div class="em-profile"><div class="em-profile-hero"><img src="@employee.Photo" alt="@employee.Person.Name" /><span class="em-eyebrow">@employee.Person.Id · Sample directory record</span><h2>@employee.Person.Name</h2><p>@employee.Person.Role</p><span class="em-status @(employee.Person.Status=="Active"?"active":"leave")"><i></i>@employee.Person.Status</span></div><div class="em-profile-fields">@foreach(var row in new[]{("Department",employee.Person.Department),("Manager",State.Manager(employee)),("Location",employee.Location),("Work arrangement",employee.Mode),("Email",employee.Person.Email),("Phone",employee.Phone.Length>0?employee.Phone:"Not provided"),("Joined",employee.Person.Joined),("Employment status",employee.Person.Status)}){<div><small>@row.Item1</small><b>@row.Item2</b></div>}</div><p class="em-dialog-note">Profile changes are local to this page session. No employee notifications are sent.</p></div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>ProfileId=null)">Close</MudButton><MudButton Variant="Variant.Outlined" OnClick="Toggle">@(Active?.Person.Status=="Active"?"Mark on leave":"Mark active")</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="EditActive">Edit employee</MudButton></DialogActions></MudDialog>
<MudDialog Options="EditorOptions" Visible="@(Draft is not null)" VisibleChanged="@(v=>{if(!v)Draft=null;})"><TitleContent><MudText Typo="Typo.h6">@(IsNew?"Add employee":"Edit employee")</MudText></TitleContent><DialogContent>@if(Draft is {} d){<div class="em-editor"><p class="em-dialog-note">Changes last for this page session.</p><MudGrid Class="mt-2"><MudItem xs="12" sm="6"><label class="em-field-label">Employee name</label><MudTextField T="string" Value="d.Person.Name" ValueChanged="@(v=>Draft=d with{Person=d.Person with{Name=v}})" Immediate="true" aria-label="Employee name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="120" Required="true" /></MudItem><MudItem xs="12" sm="6"><label class="em-field-label">Job role</label><MudTextField T="string" Value="d.Person.Role" ValueChanged="@(v=>Draft=d with{Person=d.Person with{Role=v}})" Immediate="true" aria-label="Job role" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="120" Required="true" /></MudItem><MudItem xs="12" sm="6"><label class="em-field-label">Email</label><MudTextField T="string" Value="d.Person.Email" ValueChanged="@(v=>Draft=d with{Person=d.Person with{Email=v}})" Immediate="true" aria-label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Email" MaxLength="120" Required="true" /></MudItem><MudItem xs="12" sm="6"><label class="em-field-label">Phone</label><MudTextField T="string" Value="d.Phone" ValueChanged="@(v=>Draft=d with{Phone=v})" Immediate="true" aria-label="Phone" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="120" /></MudItem><MudItem xs="12" sm="6"><label class="em-field-label">Location</label><MudTextField T="string" Value="d.Location" ValueChanged="@(v=>Draft=d with{Location=v})" Immediate="true" aria-label="Location" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="120" Required="true" /></MudItem><MudItem xs="12" sm="6"><label class="em-field-label">Join date</label><MudTextField T="string" Value="d.Person.Joined" ValueChanged="@(v=>Draft=d with{Person=d.Person with{Joined=v}})" aria-label="Join date" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Date" Required="true" /></MudItem><MudItem xs="12" sm="6"><label class="em-field-label">Employee department</label><MudSelect T="string" aria-label="Employee department" Variant="Variant.Outlined" Margin="Margin.Dense" Value="d.Person.Department" ValueChanged="@(v=>Draft=d with{Person=d.Person with{Department=v}})">@foreach(var x in HrmRegister.Departments){<MudSelectItem Value="@x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" sm="6"><label class="em-field-label">Work arrangement</label><MudSelect T="string" aria-label="Work arrangement" Variant="Variant.Outlined" Margin="Margin.Dense" Value="d.Mode" ValueChanged="@(v=>Draft=d with{Mode=v})">@foreach(var x in EmployeeDirectory.Modes){<MudSelectItem Value="@x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" sm="6"><label class="em-field-label">Employment status</label><MudSelect T="string" aria-label="Employment status" Variant="Variant.Outlined" Margin="Margin.Dense" Value="d.Person.Status" ValueChanged="@(v=>Draft=d with{Person=d.Person with{Status=v}})">@foreach(var x in new[]{"Active","On leave"}){<MudSelectItem Value="@x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" sm="6"><label class="em-field-label">Employee manager</label><MudSelect T="string" aria-label="Employee manager" Variant="Variant.Outlined" Margin="Margin.Dense" Value="d.ManagerId" ValueChanged="@(v=>Draft=d with{ManagerId=v})"><MudSelectItem Value="@string.Empty">Unassigned</MudSelectItem>@foreach(var p in State.Employees.Where(e=>e.Person.Id!=d.Person.Id)){<MudSelectItem Value="@p.Person.Id">@p.Person.Name</MudSelectItem>}</MudSelect></MudItem></MudGrid><label class="em-field-label">Employee photo</label><MudSelect T="string" aria-label="Employee photo" Variant="Variant.Outlined" Margin="Margin.Dense" Value="d.Photo" ValueChanged="@(v=>Draft=d with{Photo=v})">@foreach(var n in Enumerable.Range(1,4)){<MudSelectItem Value="@($"assets/images/users/user-{n}.jpg")">Sample user photo @n</MudSelectItem>}</MudSelect>@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert">@Error</MudAlert>}</div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>Draft=null)">Cancel</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save employee</MudButton></DialogActions></MudDialog>


@code{
    private readonly EmployeeDirectory State=new();
    private string Query="",Department="All",Status="All",Mode="All",Sort="name",Notice="",Error="";
    private bool Grid=true,IsNew;
    private string? ProfileId;
    private DirectoryEmployee? Draft;
    private DirectoryEmployee? Active=>State.Employees.FirstOrDefault(e=>e.Person.Id==ProfileId);
    private IEnumerable<DirectoryEmployee> Visible=>State.Filter(Query,Department,Status,Mode,Sort);
    private static readonly DialogOptions ProfileOptions=new(){MaxWidth=MaxWidth.Small,FullWidth=true}; private static readonly DialogOptions EditorOptions=new(){MaxWidth=MaxWidth.Medium,FullWidth=true}; private static string TeamTone(string team)=>team switch{"Design"=>"primary","Engineering"=>"info","People"=>"success",_=>"warning"};
    private (string,int,string)[] Stats=>[("Total employees",State.Employees.Count,"Sample directory headcount"),("Active employees",State.Employees.Count(e=>e.Person.Status=="Active"),"Active in the sample workspace"),("On leave",State.Employees.Count(e=>e.Person.Status=="On leave"),"Current sample availability"),("Departments",State.Employees.Select(e=>e.Person.Department).Distinct().Count(),"Teams represented in the directory")];
    private void Add(){IsNew=true;Error="";Draft=new(new("","","","Design","","Active","2026-10-09"),"","Office","","","assets/images/users/user-1.jpg");}
    private void Edit(DirectoryEmployee e){IsNew=false;Error="";Draft=e with{};}
    private void EditActive(){if(Active is {} a){ProfileId=null;Edit(a);}}
    private void Toggle(){if(Active is {} a){State.Toggle(a.Person.Id);Notice=$"{a.Person.Id} marked {Active!.Person.Status.ToLowerInvariant()} in the sample directory.";}}
    private void Save(){if(Draft is not {} d)return;Error=State.Save(d,IsNew)??"";if(Error.Length>0)return;Notice=$"{(IsNew?State.Employees.Last().Person.Id:d.Person.Id)} {(IsNew?"added":"updated")} in the sample directory.";Draft=null;}
    private void Reset(){Query="";Department=Status=Mode="All";}
    private IJSObjectReference? Download;
    private async Task Export(){var rows=new[]{new[]{"ID","Name","Role","Department","Email","Phone","Location","Work arrangement","Manager","Joined","Status"}}.Concat(Visible.Select(e=>new[]{e.Person.Id,e.Person.Name,e.Person.Role,e.Person.Department,e.Person.Email,e.Phone,e.Location,e.Mode,State.Manager(e),e.Person.Joined,e.Person.Status}));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await Download.InvokeVoidAsync("csv","employee-directory.csv",HrmRegister.Csv(rows));Notice=$"Exported {Visible.Count()} employees in the current view.";}
    public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}





