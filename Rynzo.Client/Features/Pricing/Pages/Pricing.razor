@page "/pages/pricing"
@using Rynzo.Client.Features.Pricing.Models
@using Rynzo.Client.Features.Pricing.Services
@using Rynzo.Client.Features.Pricing.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
<PageTitle>Pricing | Rynzo</PageTitle>
<div class="rynzo-pricing">
    <DashboardPageHeader Title="Pricing" Description="Find the right plan for your team's next chapter."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Headphones")" OnClick="Sales">Contact Sales</MudButton></Actions></DashboardPageHeader>
    <section class="pricing-hero"><div><span class="pricing-eyebrow"><i></i>Plans that grow with you</span><h2>One workspace.<br />The right level of possibility.</h2><p>Choose the plan that fits your workflow and scale as your team grows.</p><small>No hidden fees. Upgrade or cancel anytime.</small></div><MudCard Class="pricing-billing-panel rynzo-widget-card" Elevation="0" Outlined="true"><span class="pricing-eyebrow">Choose your billing cycle</span><div class="pricing-billing" role="group" aria-label="Billing cycle"><button type="button" class="@(_billing==BillingCycle.Monthly?"selected":"")" aria-pressed="@(_billing==BillingCycle.Monthly)" @onclick="@(()=>_billing=BillingCycle.Monthly)">Monthly</button><button type="button" class="@(_billing==BillingCycle.Yearly?"selected":"")" aria-pressed="@(_billing==BillingCycle.Yearly)" @onclick="@(()=>_billing=BillingCycle.Yearly)">Yearly <span class="pricing-savings">Save 20%</span></button></div><p><MudIcon Icon="@RynzoIcons.Get("CalendarCheck")" />@(_billing==BillingCycle.Yearly?"Annual billing / Lower monthly rate":"Monthly billing / Flexible commitment")</p><a href="#plan-comparison">Compare every feature <MudIcon Icon="@RynzoIcons.Get("ArrowDown")" /></a></MudCard></section>
    <section class="pricing-plans" aria-label="Plans">@foreach(var plan in PricingCatalog.Plans){<PlanCard Plan="plan" Billing="_billing" OnSelect="Select" />}</section>
    <div class="pricing-assurances">@for(var i=0;i<Assurances.Length;i++){<span><MudIcon Icon="@RynzoIcons.Get(new[]{"CalendarCheck","CreditCard","CircleCheck","ShieldCheck"}[i])" />@Assurances[i]</span>}</div>
    <section class="pricing-comparison" id="plan-comparison"><div class="pricing-section-heading"><div><span class="pricing-eyebrow">The details, side by side</span><h2>Make room for your next stage.</h2><p>Compare capacity, collaboration, security, and support.</p></div><span class="pricing-table-note"><MudIcon Icon="@RynzoIcons.Get("Check")" />Included in plan</span></div><div class="pricing-table-scroll"><table class="pricing-table" aria-label="Plan feature comparison"><thead><tr><th scope="col">Features &amp; capacity</th>@foreach(var plan in PricingCatalog.Plans){<th scope="col" class="@(plan.Featured?"highlight":"")"><span>@plan.Name</span><small>@(plan.Price(_billing) is int amount?$"${amount} / user / month":"Let's talk")</small></th>}</tr></thead><tbody>@foreach(var group in PricingCatalog.Comparison.GroupBy(r=>r.Group)){<tr class="pricing-group-row"><th colspan="5" scope="colgroup">@group.Key</th></tr>@foreach(var row in group){<tr><th scope="row">@row.Feature</th>@for(var i=0;i<row.Values.Count;i++){var value=row.Values[i];<td class="@(i==1?"highlight":"")">@if(value=="Included"){<span class="pricing-included" aria-label="Included"><MudIcon Icon="@RynzoIcons.Get("Check")" /></span>}else if(value.Length==0){<span class="pricing-excluded" aria-label="Not included"><MudIcon Icon="@RynzoIcons.Get("Minus")" /></span>}else{@value}</td>}</tr>}}</tbody></table></div></section>
    <section class="pricing-addons"><div class="pricing-section-heading"><div><span class="pricing-eyebrow">A little extra, when you need it</span><h2>Optional add-ons</h2><p>Extend any paid plan only when you need more capacity.</p></div></div><div class="pricing-addon-grid">@for(var i=0;i<Addons.Length;i++){var addon=Addons[i]; var widgetIndex=i;<MudCard Class="pricing-addon rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="pricing-addon-icon"><MudIcon Icon="@RynzoIcons.Get(new[]{"HardDrive","ChartNoAxesCombined","Headphones"}[widgetIndex])" /></span><h3>@addon.Name</h3><p>@addon.Description</p><strong>@addon.Price</strong><small>Optional / Paid plans</small></MudCard>}</div></section>
    <section class="pricing-faq-section"><div class="pricing-faq-intro"><span class="pricing-eyebrow">Good questions. Clear answers.</span><h2>Before you choose.</h2><p>Everything you need to know about plans, billing, and making a change.</p><div><span><MudIcon Icon="@RynzoIcons.Get("MessageSquare")" /></span><h3>Need a little guidance?</h3><p>Talk through your team's requirements with sales.</p><MudButton Variant="Variant.Outlined" EndIcon="@RynzoIcons.Get("ArrowUpRight")" OnClick="Sales">Contact Sales</MudButton></div></div><div class="pricing-faq-list" aria-label="Frequently asked questions">@for(var i=0;i<PricingCatalog.Faqs.Count;i++){var index=i;var faq=PricingCatalog.Faqs[i];<article class="pricing-faq @(_openFaq==index?"open":"")"><button type="button" @onclick="@(()=>_openFaq=_openFaq==index?null:index)" aria-expanded="@(_openFaq==index)" aria-controls="@($"pricing-answer-{index}")"><span class="pricing-faq-number">@((index+1).ToString("00"))</span><span>@faq.Question</span><MudIcon Icon="@RynzoIcons.Get(_openFaq==index?"Minus":"Plus")" /></button>@if(_openFaq==index){<p id="@($"pricing-answer-{index}")">@faq.Answer</p>}</article>}</div></section>
    <section class="pricing-cta"><span class="pricing-cta-icon"><MudIcon Icon="@RynzoIcons.Get("Rocket")" /></span><div><span class="pricing-eyebrow">Your next chapter starts here</span><h2>Build more. Move forward together.</h2><p>Start with Growth or choose the plan that fits your team.</p></div><div class="pricing-cta-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@RynzoIcons.Get("ArrowRight")" OnClick="@(()=>Select(PricingCatalog.Plans[1]))">Start Free Trial</MudButton><MudButton Variant="Variant.Outlined" OnClick="Sales">Contact Sales</MudButton></div></section>
</div>
@code {
    private BillingCycle _billing = BillingCycle.Yearly;
    private int? _openFaq = 0;
    private static readonly string[] Assurances = ["14-day free trial", "No credit card required", "Cancel anytime", "Secure billing"];
    private static readonly (string Name, string Price, string Description)[] Addons = [
        ("Extra storage", "+$10 / 100 GB", "Add room for files, recordings, and assets."),
        ("Advanced analytics", "+$20 / month", "Deeper cohort reports and scheduled insights."),
        ("Priority SLA", "Custom", "Response targets and support coverage for critical teams.")];
    private static readonly DialogOptions Options = new() { CloseButton = true, CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small, BackgroundClass = "rynzo-source-backdrop" };
    private static bool ShowGroup(PricingComparison row) { var rows = PricingCatalog.Comparison; var index = rows.ToList().IndexOf(row); return index == 0 || rows[index - 1].Group != row.Group; }
    private async Task Select(PricingPlan plan) {
        if (plan.Id == "enterprise") { await Sales(); return; }
        await Dialogs.ShowAsync<PlanSelectionDialog>($"Choose {plan.Name}", new DialogParameters { [nameof(PlanSelectionDialog.Plan)] = plan, [nameof(PlanSelectionDialog.Billing)] = _billing }, Options);
    }
    private async Task Sales() => await Dialogs.ShowAsync<SalesDialog>("Contact Sales", Options);
}

