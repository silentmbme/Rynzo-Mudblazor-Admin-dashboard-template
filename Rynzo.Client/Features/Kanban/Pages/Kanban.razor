@page "/apps/kanban"
@using Rynzo.Client.Features.Kanban.Models
@using Rynzo.Client.Features.Kanban.Services
@using Rynzo.Client.Features.Kanban.Components
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
<PageTitle>Kanban Board | Rynzo</PageTitle>
<PageHeader Title="Kanban Board" Description="Plan and track tasks across your workflow."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Columns3")" OnClick="@(() => Column(new()))">Add column</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(() => TaskForm(new(){Column=_state.Columns[0].Id}))">Add task</MudButton></Actions></PageHeader>
<div class="kanban-app"><header class="board-heading"><div class="board-filters"><MudTextField T="string" @bind-Value="_state.Search" Immediate="true" Placeholder="Search board" aria-label="Search board" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><MudSelect T="string" @bind-Value="_state.Priority" aria-label="Board priority" Variant="Variant.Outlined" Margin="Margin.Dense" Class="board-priority-filter">@foreach(var priority in new[]{"All","Critical","High","Medium","Low"}){<MudSelectItem Value="@priority">@priority</MudSelectItem>}</MudSelect></div><p class="board-summary"><b>@_state.Cards.Count(c=>c.Column!="done") active tasks</b><span>@_state.Cards.Count(c=>c.Column=="progress") in progress</span>Drag a card to move it, or use its Move action.</p></header><div class="board-scroll"><div class="board-columns">@foreach(var column in _state.Columns){var items=_state.Filtered.Where(c=>c.Column==column.Id).ToArray();<section class="@(_state.Drag is not null?"board-dragging":"")" data-column="@column.Id" @ondragover:preventDefault="true" @ondrop="@(() => Drop(column.Id))"><header><b>@column.Name</b><span>@items.Length</span><MudIconButton Icon="@RynzoIcons.Get("Pencil")" Size="Size.Small" aria-label="@($"Rename {column.Name}")" OnClick="@(() => Column(column with{}))" /><MudIconButton Icon="@RynzoIcons.Get("Plus")" Size="Size.Small" aria-label="@($"Add task to {column.Name}")" OnClick="@(() => TaskForm(new(){Column=column.Id}))" /></header><div class="board-cards">@foreach(var card in items){<BoardCard @key="card.Id" Task="card" Open="@(() => _detail=card)" Drag="@(() => _state.Drag=card.Id)" />}</div><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Plus")" Class="board-column-add" OnClick="@(() => TaskForm(new(){Column=column.Id}))">Add task</MudButton></section>}<MudButton Variant="Variant.Outlined" Class="board-add-column" OnClick="@(() => Column(new()))">+ Add column</MudButton></div></div></div>
<MudOverlay Visible="@(_detail is not null)" AutoClose="true" DarkBackground="true" LockScroll="true" ZIndex="1399" OnClosed="@(() => _detail=null)" /><MudDrawer Open="@(_detail is not null)" OpenChanged="@((bool open) => {if(!open)_detail=null;})" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Overlay="false" Elevation="0" Width="448px" Style="z-index:1400;max-width:100vw;overflow-y:auto;background:var(--card)" Class="board-detail-drawer"><MudFocusTrap>@if(_detail is not null){<BoardTaskDetails Task="_detail" Columns="_state.Columns" Close="@(() => _detail=null)" Edit="Edit" Move="Move" Duplicate="Duplicate" Delete="Delete" />}</MudFocusTrap></MudDrawer>
@code{
    private readonly KanbanState _state=new();
    private BoardTask? _detail;
    private static DialogOptions Options=>new(){CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small};
    private void Drop(string column){if(_state.Drop(column))Snackbar.Add("Task moved",Severity.Success);}
    private void Move(string column){if(_detail is not null&&_state.Move(_detail.Id,column)){_detail=null;Snackbar.Add("Task moved",Severity.Success);}}
    private Task Edit(){if(_detail is null)return Task.CompletedTask;var draft=_detail with{};_detail=null;return TaskForm(draft);}
    private void Duplicate(){if(_detail is null)return;_state.Duplicate(_detail);Snackbar.Add("Task duplicated",Severity.Success);}
    private async Task Delete(){if(_detail is null)return;var result=await Dialogs.ShowMessageBoxAsync("Delete task?","This task will be removed from the board.",yesText:"Delete",cancelText:"Cancel");if(result==true){_state.Delete(_detail.Id);_detail=null;Snackbar.Add("Task deleted",Severity.Success);}}
    private async Task TaskForm(BoardTask draft){var isNew=draft.Id.Length==0;var dialog=await Dialogs.ShowAsync<BoardTaskDialog>(isNew?"Add task":"Edit task",new DialogParameters<BoardTaskDialog>{{d=>d.Draft,draft},{d=>d.State,_state}},Options);var result=await dialog.Result;if(result is {Canceled:false})Snackbar.Add(isNew?"Task created":"Task updated",Severity.Success);}
    private async Task Column(BoardColumn draft){var dialog=await Dialogs.ShowAsync<BoardColumnDialog>(draft.Id.Length==0?"Add column":"Rename column",new DialogParameters<BoardColumnDialog>{{d=>d.Draft,draft},{d=>d.State,_state}},Options);var result=await dialog.Result;if(result is {Canceled:false})Snackbar.Add("Column saved",Severity.Success);}
}

