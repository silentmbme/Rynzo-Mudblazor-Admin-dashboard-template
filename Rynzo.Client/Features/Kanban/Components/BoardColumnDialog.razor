@using Rynzo.Client.Features.Kanban.Models
@using Rynzo.Client.Features.Kanban.Services
<MudDialog Class="board-column-form"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">@(Draft.Id.Length==0?"Add column":"Rename column")</MudText></TitleContent><DialogContent><MudTextField T="string" @bind-Value="Draft.Name" Immediate="true" Placeholder="Column name" aria-label="Column name" Variant="Variant.Outlined" /></DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(() => Dialog.Cancel())">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save column</MudButton></DialogActions></MudDialog>
@code{[Parameter,EditorRequired]public BoardColumn Draft{get;set;}=null!;[Parameter,EditorRequired]public KanbanState State{get;set;}=null!;[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private void Save(){if(State.SaveColumn(Draft))Dialog.Close(DialogResult.Ok(true));}}
