@using Rynzo.Client.Features.Kanban.Models
@using Rynzo.Client.Theme
<div class="board-task-details"><header><div><h2>@Task.Title</h2><p>@Task.Description</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close task details" OnClick="@(() => Close.InvokeAsync())" /></header><div><p><b>Priority:</b> @Task.Priority <span><b>Due:</b> @Task.Due</span></p><section><h3>Move task</h3><select class="board-move-native" value="@Task.Column" aria-label="Move task" @onchange="@((ChangeEventArgs args) => Move.InvokeAsync(args.Value?.ToString()??Task.Column))">@foreach(var column in Columns){<option value="@column.Id">@column.Name</option>}</select></section><section><h3>Subtasks</h3>@foreach(var subtask in Task.Subtasks){<MudCheckBox T="bool" Value="subtask.Done" ReadOnly="true" Label="@subtask.Title" Size="Size.Small" Color="Color.Primary" />}</section><section><h3>Comments</h3>@foreach(var comment in Task.Comments){<p class="board-comment">@comment</p>}@if(Task.Comments.Length==0){<p class="board-no-comments">No comments.</p>}</section><section><h3>Attachments</h3>@foreach(var attachment in Task.Attachments){<p class="board-attachment"><MudIcon Icon="@RynzoIcons.Get("File")" Color="Color.Primary" />@attachment</p>}</section><footer><MudButton Variant="Variant.Outlined" OnClick="@(() => Edit.InvokeAsync())">Edit</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Duplicate.InvokeAsync())">Duplicate</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => Delete.InvokeAsync())">Delete</MudButton></footer></div></div>
@code{[Parameter,EditorRequired]public BoardTask Task{get;set;}=null!;[Parameter,EditorRequired]public List<BoardColumn> Columns{get;set;}=[];[Parameter]public EventCallback Close{get;set;}[Parameter]public EventCallback Edit{get;set;}[Parameter]public EventCallback Duplicate{get;set;}[Parameter]public EventCallback Delete{get;set;}[Parameter]public EventCallback<string> Move{get;set;}}


