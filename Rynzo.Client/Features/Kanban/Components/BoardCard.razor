@using Rynzo.Client.Features.Kanban.Models
@using Rynzo.Client.Theme
<div class="rynzo-widget-host"><MudCard Class="board-card rynzo-widget-card" draggable="true" tabindex="0" @ondragstart="@(() => Drag.InvokeAsync())" @onclick="@(() => Open.InvokeAsync())" @onkeydown="Key" Elevation="0" Outlined="true" data-widget-element="article"><b>@Task.Title</b><p>@Task.Description</p><div class="board-card-labels">@foreach(var label in Task.Labels){<span>@label</span>}<span class="board-priority" style="@($"--priority-tone:var(--{Task.Tone})")">@Task.Priority</span></div><div class="board-card-assignees"><span>@string.Join(", ",Task.Assignees)</span><span>@Task.Due</span></div><footer><span><MudIcon Icon="@RynzoIcons.Get("CheckSquare")" />@Task.Subtasks.Count(s=>s.Done)/@Task.Subtasks.Length</span><span><MudIcon Icon="@RynzoIcons.Get("MessageSquare")" />@Task.Comments.Length</span><span><MudIcon Icon="@RynzoIcons.Get("Paperclip")" />@Task.Attachments.Length</span></footer></MudCard></div>
@code{[Parameter,EditorRequired]public BoardTask Task{get;set;}=null!;[Parameter]public EventCallback Open{get;set;}[Parameter]public EventCallback Drag{get;set;}private async System.Threading.Tasks.Task Key(KeyboardEventArgs args){if(args.Key=="Enter")await Open.InvokeAsync();}}
