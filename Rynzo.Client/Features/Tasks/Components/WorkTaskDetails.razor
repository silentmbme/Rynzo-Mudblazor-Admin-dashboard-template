@using Rynzo.Client.Features.Tasks.Models
@using Rynzo.Client.Features.Tasks.Services
@using Rynzo.Client.Theme
<div class="work-task-details"><header><div><h2>@Task.Title</h2><p>@Task.Project</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close task details" OnClick="@(() => Close.InvokeAsync())" /></header><div><p class="work-task-description">@Task.Description</p><div class="work-detail-badges"><span style="@($"--badge-tone:var(--{Task.StatusTone})")">@Task.Status</span><span style="@($"--badge-tone:var(--{Task.PriorityTone})")">@Task.Priority</span><span>Due @Task.Due</span></div><section><h3>Subtasks (@Task.Subtasks.Count(s=>s.Done)/@Task.Subtasks.Length)</h3>@for(var index=0;index<Task.Subtasks.Length;index++){var subtask=Task.Subtasks[index];var selected=index;<MudCheckBox T="bool" Value="subtask.Done" ValueChanged="@((bool _) => Subtask.InvokeAsync(selected))" Label="@subtask.Title" Color="Color.Primary" Class="@(subtask.Done?"work-subtask-done":"")" Size="Size.Small" />}@if(Task.Subtasks.Length==0){<p>No subtasks yet.</p>}</section><section><h3>Assignees</h3><p>@(Task.Assignees.Length==0?"Unassigned":string.Join(", ",Task.Assignees))</p></section><section><h3>Attachments (@Task.Attachments.Length)</h3>@foreach(var attachment in Task.Attachments){<div class="work-attachment"><MudIcon Icon="@RynzoIcons.Get("File")" Color="Color.Primary" />@attachment</div>}@if(Task.Attachments.Length==0){<p>No attachments.</p>}</section><section><h3>Comments (@Task.Comments.Length)</h3>@foreach(var comment in Task.Comments){<div class="work-comment"><b>@comment.Author</b><p>@comment.Text</p></div>}<div class="work-comment-input"><MudTextField T="string" @bind-Value="State.CommentDraft" Immediate="true" Placeholder="Write a comment" aria-label="Write a comment" Variant="Variant.Outlined" Margin="Margin.Dense" /><MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Comment.InvokeAsync())">Add</MudButton></div></section><footer><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Pencil")" OnClick="@(() => Edit.InvokeAsync())">Edit</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Copy")" OnClick="@(() => Duplicate.InvokeAsync())">Duplicate</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Check")" OnClick="@(() => Complete.InvokeAsync())">Complete</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@RynzoIcons.Get("Trash2")" OnClick="@(() => Delete.InvokeAsync())">Delete</MudButton></footer></div></div>
@code{protected override void OnInitialized()=>State.CommentDraft="";[Parameter,EditorRequired]public WorkTask Task{get;set;}=null!;[Parameter,EditorRequired]public TasksState State{get;set;}=null!;[Parameter]public EventCallback Close{get;set;}[Parameter]public EventCallback Edit{get;set;}[Parameter]public EventCallback Duplicate{get;set;}[Parameter]public EventCallback Complete{get;set;}[Parameter]public EventCallback Delete{get;set;}[Parameter]public EventCallback<int> Subtask{get;set;}[Parameter]public EventCallback Comment{get;set;}}

