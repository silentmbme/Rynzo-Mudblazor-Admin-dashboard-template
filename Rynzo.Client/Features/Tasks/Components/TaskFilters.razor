@using Rynzo.Client.Features.Tasks.Services
@using Rynzo.Client.Theme
<div class="task-filters"><section><header><h2>Views</h2><span>@State.Tasks.Count</span></header>@foreach(var view in Views){<MudButton Variant="Variant.Text" StartIcon="@RynzoIcons.Get(view.Icon)" Class="@(State.View==view.Name?"task-view-active":"")" OnClick="@(() => ChangeView(view.Name))"><span>@view.Name</span><b>@State.ViewCount(view.Name)</b></MudButton>}</section><section class="task-status-filter"><h2>Status</h2><div>@foreach(var status in new[]{"All"}.Concat(State.Source.Statuses)){<MudButton Variant="Variant.Outlined" Size="Size.Small" Class="@(State.Status==status?"task-status-active":"")" OnClick="@(() => ChangeStatus(status))">@status</MudButton>}</div></section><section><h2>Priority</h2>@foreach(var priority in new[]{"All"}.Concat(State.Source.Priorities)){<MudButton Variant="Variant.Text" Class="@(State.Priority==priority?"task-priority-active":"")" OnClick="@(() => ChangePriority(priority))"><i style="@($"background:var(--{(priority=="Critical"?"destructive":priority=="High"?"warning":priority=="Medium"?"info":priority=="Low"?"muted-foreground":"primary")})")"></i><span>@priority</span>@if(priority!="All"){<b>@State.Tasks.Count(t=>t.Priority==priority)</b>}</MudButton>}</section><section class="task-assignee-filter"><header><h2>Assignees</h2><MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ChangeAssignee("All"))">Clear</MudButton></header>@foreach(var person in State.Source.People.Take(5)){<MudButton Variant="Variant.Text" Class="@(State.Assignee==person?"task-assignee-active":"")" OnClick="@(() => ChangeAssignee(State.Assignee==person?"All":person))"><img src="@TasksState.Portrait(person)" alt="" /><span>@person</span><b>@State.Tasks.Count(t=>t.Assignees.Contains(person))</b></MudButton>}</section></div>
@code{[Parameter,EditorRequired]public TasksState State{get;set;}=null!;[Parameter]public EventCallback Changed{get;set;}private static readonly (string Name,string Icon)[] Views=[("All Tasks","ListTodo"),("Today","CalendarDays"),("Upcoming","ArrowUpRight"),("Overdue","CircleAlert"),("Completed","CircleCheck")];private async Task ChangeView(string value){State.View=value;await Changed.InvokeAsync();}private async Task ChangeStatus(string value){State.Status=value;await Changed.InvokeAsync();}private async Task ChangePriority(string value){State.Priority=value;await Changed.InvokeAsync();}private async Task ChangeAssignee(string value){State.Assignee=value;await Changed.InvokeAsync();}}
