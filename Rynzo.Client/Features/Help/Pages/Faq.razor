@page "/pages/faq"
@using Rynzo.Client.Features.Help.Models
@using Rynzo.Client.Features.Help.Services
@using Rynzo.Client.Features.Help.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
<PageTitle>FAQ | Rynzo</PageTitle>
<div class="rynzo-faq">
    <DashboardPageHeader Title="FAQ" Description="Answers, guidance, and a clear next step."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Headphones")" OnClick="OpenSupport">Contact Support</MudButton></Actions></DashboardPageHeader>
    <section class="faq-hero"><div class="faq-hero-copy"><span class="faq-eyebrow"><i></i>Rynzo Help Center</span><h2>A little guidance.<br />A lot more possibility.</h2><p>Find answers to common questions about your account, projects, billing, security and integrations.</p><div class="faq-hero-meta"><span><b>@FaqCatalog.Articles.Count</b> helpful answers</span><i></i><span><b>@(FaqCatalog.Categories.Count-1)</b> topics to explore</span></div></div><MudCard Class="faq-search-panel rynzo-widget-card" Elevation="0" Outlined="true"><span class="faq-search-icon"><MudIcon Icon="@RynzoIcons.Get("Search")" /></span><h3>What can we help you find?</h3><label for="faq-search">Search the help center</label><div class="faq-search-box"><MudIcon Icon="@RynzoIcons.Get("Search")" /><input id="faq-search" aria-label="Search help articles and FAQs" placeholder="Try billing, projects, or security..." value="@_query" @oninput="@(e=>QueryChanged(e.Value?.ToString()??""))" />@if(_query.Length>0){<button type="button" aria-label="Clear search" @onclick='@(()=>_query="")'><MudIcon Icon="@RynzoIcons.Get("X")" /></button>}</div><small>Search questions, answers, and keywords.</small></MudCard></section>
    <section class="faq-popular"><div class="faq-section-heading"><div><span class="faq-eyebrow">A good place to start</span><h2>Popular questions</h2></div><span class="faq-muted">Quick answers to common tasks</span></div><div class="faq-popular-list">@foreach(var id in Popular){var article=FaqCatalog.Articles.Single(a=>a.Id==id);<button type="button" class="faq-popular-question" @onclick="@(()=>Choose(article))"><span class="faq-popular-icon"><MudIcon Icon="@RynzoIcons.Get(TopicIcon(article.Category))" /></span><small>@article.Category</small><b>@article.Question</b><MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></button>}</div></section>
    <div class="faq-columns"><aside class="faq-sidebar"><MudCard Class="faq-topics rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="faq-topic-heading"><span class="faq-eyebrow">Knowledge library</span><h2>Browse by topic</h2><p>Choose a category or search across all support content.</p></div><nav class="faq-category-buttons" aria-label="Browse by topic">@foreach(var category in FaqCatalog.Categories){<button type="button" class="faq-category @(_category==category?"active":"")" aria-pressed="@(_category==category?"true":"false")" @onclick="@(()=>_category=category)"><MudIcon Icon="@RynzoIcons.Get(TopicIcon(category))" /><span>@(category=="All"?"All topics":category)</span><small class="faq-count">@(category=="All"?FaqCatalog.Articles.Count:FaqCatalog.Articles.Count(a=>a.Category==category))</small></button>}</nav>@if(_category!="All"){<MudButton Class="faq-clear" OnClick="Clear" StartIcon="@RynzoIcons.Get("RotateCcw")">Clear filter</MudButton>}</MudCard><MudCard Class="faq-specific rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span><MudIcon Icon="@RynzoIcons.Get("MessageSquare")" /></span><h3>Something more specific?</h3><p>Search the help center or send a request to the support team.</p><MudButton Variant="Variant.Outlined" EndIcon="@RynzoIcons.Get("ArrowUpRight")" OnClick="OpenSupport">Contact Support</MudButton></MudCard></aside>
    <section class="faq-results" aria-label="FAQ answers"><header class="faq-results-heading"><div><span class="faq-eyebrow">@(_category=="All"?"Explore the answers":_category)</span><h2>@Results.Count @(Results.Count==1?"answer":"answers") found</h2><p>@(_query.Length>0?$"Search results for \"{_query}\"":_category=="All"?"All help-center topics":"Questions in this topic")</p></div><span class="faq-result-icon"><MudIcon Icon="@RynzoIcons.Get("BookOpen")" /></span></header><div class="faq-result-list" aria-live="polite">@foreach(var article in Results){<article class="faq-article @(_open==article.Id?"open":"")" @key="article.Id"><button type="button" class="faq-question" @onclick="@(()=>_open=_open==article.Id?null:article.Id)" aria-expanded="@(_open==article.Id?"true":"false")" aria-controls="@($"faq-answer-{article.Id}")"><span class="faq-question-icon"><MudIcon Icon="@RynzoIcons.Get(TopicIcon(article.Category))" /></span><span><small class="faq-topic-badge">@article.Category</small><strong>@article.Question</strong></span><span class="faq-expand"><MudIcon Icon="@RynzoIcons.Get(_open==article.Id?"Minus":"Plus")" /></span></button>@if(_open==article.Id){<div id="@($"faq-answer-{article.Id}")" class="faq-answer"><p>@article.Answer</p><div class="faq-feedback"><span>Was this helpful?</span><MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Check")" OnClick="Yes">Yes</MudButton><MudButton Size="Size.Small" StartIcon="@RynzoIcons.Get("X")" OnClick="No">No</MudButton></div></div>}</article>}@if(Results.Count==0){<div class="faq-empty"><span><MudIcon Icon="@RynzoIcons.Get("Search")" /></span><h3>No matching answers found</h3><p>Try a different search term or browse by category.</p><MudButton Variant="Variant.Outlined" OnClick="Clear">Browse all questions</MudButton></div>}</div><footer class="faq-results-footer"><MudIcon Icon="@RynzoIcons.Get("CircleHelp")" /><span>Can't find your answer? Our support team can help.</span><MudButton OnClick="OpenSupport">Get in touch</MudButton></footer></section></div>
    <MudCard Class="faq-contact rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div><span class="faq-eyebrow">Keep moving forward</span><h2>Still need help?</h2><p>Our support team can help with account, billing, or product questions.</p></div><div class="faq-contact-actions"><button type="button" @onclick="OpenSupport"><span><MudIcon Icon="@RynzoIcons.Get("Headphones")" /></span><div><b>Contact Support</b><small>Share your question with the team</small></div><MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></button><a href="/documentation/index.html" target="_blank" rel="noreferrer"><span><MudIcon Icon="@RynzoIcons.Get("FileText")" /></span><div><b>View Documentation</b><small>Explore guides and product details</small></div><MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></a></div></MudCard>
</div>
@code {
    private static string TopicIcon(string category)=>category switch{"Getting Started"=>"Rocket","Account & Profile"=>"User","Projects & Tasks"=>"Folder","Billing & Invoices"=>"CreditCard","Security & Privacy"=>"ShieldCheck","Integrations"=>"Link2","Notifications"=>"Bell","Troubleshooting"=>"Wrench",_=>"BookOpen"};
    private string _query = "", _category = "All";
    private string? _open;
    private static readonly string[] Popular = ["invite", "plan", "invoice", "two-factor", "upload"];
    private IReadOnlyList<FaqArticle> Results => FaqCatalog.Filter(_query, _category);
    private void QueryChanged(string value) => _query = value;
    private void Clear() { _query = ""; _category = "All"; }
    private void Choose(FaqArticle article) { _category = article.Category; _query = article.Question; _open = article.Id; }
    private void Yes() => Snackbar.Add("Thanks for your feedback.", Severity.Success);
    private void No() => Snackbar.Add("Thanks  we will use your feedback to improve this answer.", Severity.Normal);
    private Task OpenSupport() => Dialogs.ShowAsync<SupportDialog>("Contact Support", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true, BackgroundClass = "rynzo-source-backdrop" });
}

