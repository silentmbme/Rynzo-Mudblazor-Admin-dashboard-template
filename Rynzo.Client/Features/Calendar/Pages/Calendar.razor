@page "/apps/calendar"
@implements IAsyncDisposable
@using Rynzo.Client.Features.Calendar.Models
@using Rynzo.Client.Features.Calendar.Services
@using Rynzo.Client.Features.Calendar.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
<PageTitle>Calendar | Rynzo</PageTitle>
@if(_state is null){@if(_loadError){<MudAlert Severity="Severity.Error">Calendar browser initialization failed. <MudButton OnClick="Load">Retry</MudButton></MudAlert>}else{<MudProgressLinear Indeterminate="true" aria-label="Loading calendar" />}}
else{
<div class="calendar-app">
    <PageHeader Title="Calendar" Description="Make room for focused work, meetings, and everything in between."><Actions><div class="calendar-heading-actions"><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" Disabled="@(_state.Period.Length==0)" OnClick="Export">Export calendar</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(() => Create(_state.Current))">New event</MudButton></div></Actions></PageHeader>
    <section class="calendar-stats">@foreach(var stat in Stats){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><span style="@($"--stat-tone:var(--{stat.Tone})")"><MudIcon Icon="@RynzoIcons.Get(stat.Icon)" /></span><div><p>@stat.Label</p><b>@stat.Value</b><small>@stat.Caption</small></div></MudCard>}</section>
    <MudCard Class="calendar-workspace rynzo-widget-card" Elevation="0" Outlined="true"><div class="calendar-desktop-sidebar"><CalendarSidebar State="_state" Date="SetDate" Event="OpenDetails" Create="@(() => Create(_state.Current))" Changed="FiltersChanged" /></div><section aria-label="Calendar workspace"><div class="calendar-toolbar"><div><div class="calendar-toolbar-title"><MudIconButton Icon="@RynzoIcons.Get("PanelLeft")" Variant="Variant.Outlined" Size="Size.Small" Class="calendar-open-filters" aria-label="Open calendar filters" OnClick="@(() => _sidebarOpen=true)" /><h2>@PeriodTitle</h2></div><div class="calendar-date-navigation"><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => _state.Current=_state.Today)">Today</MudButton><MudIconButton Icon="@RynzoIcons.Get("ChevronLeft")" Size="Size.Small" aria-label="Previous calendar period" OnClick="@(() => _state.Navigate(-1))" /><MudIconButton Icon="@RynzoIcons.Get("ChevronRight")" Size="Size.Small" aria-label="Next calendar period" OnClick="@(() => _state.Navigate(1))" /></div></div><div><div class="calendar-view-buttons" aria-label="Calendar view">@foreach(var view in new[]{"Month","Week","Day","Agenda"}){<MudButton Variant="Variant.Text" Size="Size.Small" aria-pressed="@(_state.View==view?"true":"false")" OnClick="@(() => _state.View=view)">@view</MudButton>}</div><MudTextField T="string" @bind-Value="_state.Search" Immediate="true" aria-label="Search calendar events" Placeholder="Search events, people…" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" Clearable="true" Class="calendar-search" /></div></div><CalendarGrid State="_state" Event="OpenDetails" Create="CreateSlot" ShowDay="ShowDay" /><footer class="calendar-footer"><span><MudIcon Icon="@RynzoIcons.Get("CircleCheck")" Color="Color.Success" />@(_storageBlocked?"Changes are available for this session":"Changes are saved on this device")</span><span>@_state.Period.Length @(_state.Period.Length==1?"event":"events") in view · Local time</span></footer></section></MudCard>
</div>
<MudOverlay Visible="@(_sidebarOpen||_detail is not null)" AutoClose="true" DarkBackground="true" LockScroll="true" ZIndex="1399" OnClosed="CloseDrawers" />
<MudDrawer Open="_sidebarOpen" OpenChanged="SidebarChanged" Anchor="Anchor.Left" Variant="DrawerVariant.Temporary" Overlay="false" Elevation="0" Width="320px" Style="z-index:1400;max-width:100vw;overflow-y:auto;background:var(--card);color:var(--foreground)" Class="calendar-filter-drawer"><MudFocusTrap><div @onkeydown="DrawerKey"><header class="calendar-drawer-heading"><div><h2>Your calendars</h2><p>Choose dates and filter your schedule.</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close calendar filters" OnClick="CloseDrawers" /></header><CalendarSidebar State="_state" Date="SetDate" Event="OpenDetails" Create="@(() => Create(_state.Current))" Changed="FiltersChanged" /></div></MudFocusTrap></MudDrawer>
<MudDrawer Open="@(_detail is not null)" OpenChanged="DetailsChanged" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Overlay="false" Elevation="0" Width="448px" Style="z-index:1400;max-width:100vw;overflow-y:auto;background:var(--card);color:var(--foreground)" Class="calendar-detail-drawer"><MudFocusTrap><div @onkeydown="DrawerKey" class="calendar-detail-content"><header class="calendar-drawer-heading"><div><h2>Event details</h2><p>View and manage this calendar event.</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close event details" OnClick="CloseDrawers" /></header>@if(_detail is not null){<CalendarEventDetails Event="_detail" Edit="Edit" Duplicate="Duplicate" Delete="Delete" />}</div></MudFocusTrap></MudDrawer>
}
@code{
    private CalendarState? _state;
    private CalendarEntry? _detail;
    private bool _sidebarOpen,_storageBlocked,_loadError;
    private IJSObjectReference? _module;
    private static readonly BreadcrumbItem[] Breadcrumbs=[new("Apps",null),new("Calendar",null,true)];
    private sealed record BrowserData(string Today,bool Mobile,string? Saved);
    protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender)await Load();}
    private async Task Load(){try{_module??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/calendar-browser.js");var data=await _module.InvokeAsync<BrowserData>("load");_state=new(CalendarState.Parse(data.Today));if(data.Mobile)_state.View="Agenda";_state.Restore(data.Saved);await Persist();_loadError=false;}catch(JSException){_loadError=true;}StateHasChanged();}
    private async Task Persist(){if(_state is not null&&_module is not null)_storageBlocked=!await _module.InvokeAsync<bool>("save",_state.Serialize());}
    private (string Label,string Value,string Caption,string Icon,string Tone)[] Stats=>[("Events in view",_state!.Period.Length.ToString(),$"{_state.Days[0].ToString("MMM d",CalendarState.English)} – {_state.Days[^1].ToString("MMM d",CalendarState.English)}","CalendarDays","primary"),("Meetings",_state.Period.Count(e=>e.Category=="Meetings").ToString(),"Time to connect and collaborate","Users","chart-3"),("Scheduled time",$"{_state.Hours.ToString("0.#",CalendarState.English)}h","Timed events in this view","Clock3","chart-4")];
    private string PeriodTitle=>_state!.View=="Month"?_state.Current.ToString("MMMM yyyy",CalendarState.English):_state.View=="Day"?_state.Current.ToString("ddd, MMM d",CalendarState.English):$"{CalendarState.WeekStart(_state.Current).ToString("MMM d",CalendarState.English)} – {CalendarState.WeekStart(_state.Current).AddDays(6).ToString("MMM d, yyyy",CalendarState.English)}";
    private void SetDate(DateOnly date){_state!.Current=date;_sidebarOpen=false;}
    private void ShowDay(DateOnly date){_state!.Current=date;_state.View="Day";}
    private void FiltersChanged()=>StateHasChanged();
    private void OpenDetails(CalendarEntry item){_detail=item;_sidebarOpen=false;}
    private void SidebarChanged(bool open)=>_sidebarOpen=open;
    private void DetailsChanged(bool open){if(!open)_detail=null;}
    private void CloseDrawers(){_sidebarOpen=false;_detail=null;}
    private void DrawerKey(KeyboardEventArgs args){if(args.Key=="Escape")CloseDrawers();}
    private Task Create(DateOnly date)=>OpenForm(_state!.Create(date));
    private Task CreateSlot((DateOnly Date,string Start) slot)=>OpenForm(_state!.Create(slot.Date,slot.Start));
    private Task Edit()=>_detail is null?Task.CompletedTask:OpenForm(_detail with{});
    private Task Duplicate()=>_detail is null?Task.CompletedTask:OpenForm(_detail with{Id="",Title=_detail.Title+" copy"});
    private async Task OpenForm(CalendarEntry draft){_detail=null;_sidebarOpen=false;var isNew=draft.Id.Length==0;var dialog=await Dialogs.ShowAsync<CalendarEventForm>(isNew?"Create event":"Edit event",new DialogParameters<CalendarEventForm>{{d=>d.Draft,draft}},new DialogOptions{CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small});var result=await dialog.Result;if(result is {Canceled:false,Data:CalendarEntry entry}){var saved=_state!.Save(entry);_detail=saved.Saved;await Persist();Snackbar.Add(isNew?"Event created":"Event updated",Severity.Success);if(saved.Collision)Snackbar.Add("This event overlaps with another item in your schedule.",Severity.Info);}}
    private async Task Delete(){if(_detail is null)return;var confirmed=await Dialogs.ShowMessageBoxAsync("Delete this event?","This removes the event from your saved calendar.",yesText:"Delete event",cancelText:"Keep event");if(confirmed==true){_state!.Delete(_detail.Id);_detail=null;await Persist();Snackbar.Add("Event deleted",Severity.Success);}}
    private async Task Export(){if(_module is not null&&_state is not null){await _module.InvokeVoidAsync("download",$"rynzo-calendar-{CalendarState.Iso(_state.Days[0])}.ics",CalendarState.Ics(_state.Period));Snackbar.Add("Calendar exported",Severity.Success);}}
    public async ValueTask DisposeAsync(){if(_module is not null)try{await _module.DisposeAsync();}catch(JSDisconnectedException){}}
}

