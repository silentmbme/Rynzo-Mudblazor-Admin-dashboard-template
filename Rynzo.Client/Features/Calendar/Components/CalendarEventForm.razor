@using Rynzo.Client.Features.Calendar.Models
@using Rynzo.Client.Features.Calendar.Services
@inject ISnackbar Snackbar
<MudDialog Style="width:min(576px,calc(100vw - 32px));max-width:576px;max-height:90vh;overflow-y:auto"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">@(Draft.Id.Length==0?"Create event":"Edit event")</MudText></TitleContent><DialogContent><MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Add the details for this calendar event.</MudText><MudTextField T="string" @bind-Value="Draft.Title" Immediate="true" aria-label="Event title" Placeholder="Event title" Variant="Variant.Outlined" Class="mb-3" /><MudGrid Spacing="3"><MudItem xs="6"><MudTextField T="string" @bind-Value="Draft.Date" Immediate="true" InputType="InputType.Date" aria-label="Event date" Variant="Variant.Outlined" /></MudItem><MudItem xs="6"><MudSelect T="string" @bind-Value="Draft.Category" aria-label="Event category" Variant="Variant.Outlined" Class="calendar-form-category">@foreach(var category in CalendarState.Categories){<MudSelectItem Value="@category">@category</MudSelectItem>}</MudSelect></MudItem><MudItem xs="6"><MudTextField T="string" @bind-Value="Start" Immediate="true" InputType="InputType.Time" Disabled="Draft.AllDay" aria-label="Start time" Variant="Variant.Outlined" /></MudItem><MudItem xs="6"><MudTextField T="string" @bind-Value="End" Immediate="true" InputType="InputType.Time" Disabled="Draft.AllDay" aria-label="End time" Variant="Variant.Outlined" /></MudItem></MudGrid><MudTextField T="string" @bind-Value="Draft.Location" Immediate="true" aria-label="Event location" Placeholder="Location" Variant="Variant.Outlined" Class="mt-3" /><MudTextField T="string" @bind-Value="Draft.Description" Immediate="true" aria-label="Event description" Placeholder="Description" Lines="3" Variant="Variant.Outlined" Class="mt-3" /><div style="border-top:1px solid var(--border);padding-top:16px;margin-top:16px"><MudTextField T="string" @bind-Value="AttendeeInput" Immediate="true" Label="Attendees" aria-label="Attendees" Placeholder="Names separated by commas" Variant="Variant.Outlined" /><MudTextField T="string" @bind-Value="Draft.Link" Immediate="true" Label="Meeting link (optional)" aria-label="Meeting link" Placeholder="https://…" InputType="InputType.Url" Variant="Variant.Outlined" Class="mt-3" /></div><MudCheckBox T="bool" @bind-Value="Draft.AllDay" Label="All day event" Color="Color.Primary" Class="mt-3" /></DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(() => Dialog.Cancel())">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save event</MudButton></DialogActions></MudDialog>
@code{[Parameter,EditorRequired]public CalendarEntry Draft{get;set;}=null!;[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private string _attendees="";private string AttendeeInput{get=>_attendees;set{_attendees=value;Draft.Attendees=value.Split(',').Select(v=>v.Trim()).Where(v=>v.Length>0).ToArray();}}private string Start{get=>Draft.Start;set=>Draft.Start=CalendarState.NormalizeTime(value);}private string End{get=>Draft.End;set=>Draft.End=CalendarState.NormalizeTime(value);}protected override void OnInitialized()=>_attendees=string.Join(", ",Draft.Attendees);private void Save(){var error=CalendarState.Validate(Draft);if(error is not null){Snackbar.Add(error,Severity.Error);return;}Dialog.Close(DialogResult.Ok(Draft));}}
