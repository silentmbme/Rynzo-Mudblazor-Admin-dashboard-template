@using Rynzo.Client.Features.Calendar.Models
@using Rynzo.Client.Features.Calendar.Services
@using Rynzo.Client.Theme
<aside class="calendar-sidebar"><MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(() => Create.InvokeAsync())">Create event</MudButton><div><header><strong>@State.Current.ToString("MMMM yyyy",CalendarState.English)</strong><div><MudIconButton Icon="@RynzoIcons.Get("ChevronLeft")" Size="Size.Small" aria-label="Mini calendar previous month" OnClick="@(() => Date.InvokeAsync(State.Current.AddMonths(-1)))" /><MudIconButton Icon="@RynzoIcons.Get("ChevronRight")" Size="Size.Small" aria-label="Mini calendar next month" OnClick="@(() => Date.InvokeAsync(State.Current.AddMonths(1)))" /></div></header><div class="calendar-mini">@foreach(var day in new[]{"M","T","W","T","F","S","S"}){<span>@day</span>}@foreach(var day in MiniDays){<button type="button" class="@(day==State.Current?"selected":day==State.Today?"today":"") @(day.Month!=State.Current.Month?"outside":"")" aria-label="@day.ToString("MMMM d, yyyy",CalendarState.English)" aria-pressed="@(day==State.Current?"true":"false")" @onclick="@(() => Date.InvokeAsync(day))">@day.Day@if(day!=State.Current&&State.Filtered.Any(e=>e.Date==CalendarState.Iso(day))){<i></i>}</button>}</div></div><section><header><h2>My calendars</h2><MudButton Color="Color.Primary" Size="Size.Small" OnClick="ShowAll">Show all</MudButton></header><div class="calendar-categories">@foreach(var category in CalendarState.Categories){<div><MudCheckBox T="bool" Value="@State.Visible[category]" ValueChanged="@((bool value) => Toggle(category,value))" Color="Color.Primary" Size="Size.Small" aria-label="@category" /><i style="@($"background:var(--{CalendarState.Tone(category)})")"></i><span>@category</span><small>@State.Events.Count(e=>e.Category==category)</small></div>}</div></section><section class="calendar-coming-up"><header><h2>Coming up</h2><span class="upcoming-count">@Upcoming.Length</span></header><p class="upcoming-description">Your next moments, at a glance.</p><div class="calendar-upcoming">
    @foreach(var item in Upcoming){var date=CalendarState.Parse(item.Date);
        <button type="button" class="upcoming-event" style="@($"--event-tone:var(--{CalendarState.Tone(item.Category)})")" @onclick="@(() => Event.InvokeAsync(item))">
            <span class="upcoming-date"><small>@date.ToString("MMM",CalendarState.English)</small><b>@date.Day</b></span>
            <span class="upcoming-detail"><strong>@item.Title</strong><span class="upcoming-time"><MudIcon Icon="@RynzoIcons.Get("Clock3")" Size="Size.Small" />@(item.AllDay?"All day":item.Start)</span><span class="upcoming-category"><i></i>@item.Category</span></span>
        </button>
    }
    @if(Upcoming.Length==0){<div class="upcoming-empty"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" /><b>You're all caught up</b><p>No upcoming events match your filters.</p></div>}
</div></section></aside>
@code{[Parameter,EditorRequired]public CalendarState State{get;set;}=null!;[Parameter]public EventCallback<DateOnly> Date{get;set;}[Parameter]public EventCallback<CalendarEntry> Event{get;set;}[Parameter]public EventCallback Create{get;set;}[Parameter]public EventCallback Changed{get;set;}private DateOnly[] MiniDays=>Enumerable.Range(0,42).Select(CalendarState.WeekStart(new DateOnly(State.Current.Year,State.Current.Month,1)).AddDays).ToArray();private CalendarEntry[] Upcoming=>State.Filtered.Where(e=>string.CompareOrdinal(e.Date,CalendarState.Iso(State.Today))>=0).Take(3).ToArray();private async Task Toggle(string category,bool value){State.Visible[category]=value;await Changed.InvokeAsync();}private async Task ShowAll(){State.ShowAll();await Changed.InvokeAsync();}}

