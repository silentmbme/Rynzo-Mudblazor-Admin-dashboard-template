@using Rynzo.Client.Features.Calendar.Models
@using Rynzo.Client.Features.Calendar.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="calendar-timeline" @ref="_viewport"><div class="@(State.View=="Week"?"calendar-week":"calendar-day")"><header class="calendar-timeline-heading" style="@Columns"><div></div>@foreach(var day in State.Days){<div><p>@day.ToString("ddd",CalendarState.English)</p><b class="@(day==State.Today?"today":"")">@day.Day</b></div>}</header><div class="calendar-all-day" style="@Columns"><div>All day</div>@foreach(var day in State.Days){<div>@foreach(var item in State.Filtered.Where(e=>e.AllDay&&e.Date==CalendarState.Iso(day))){<button type="button" class="@($"calendar-all-day-event cat-{item.Category}")" style="@Tone(item)" @onclick="@(() => Event.InvokeAsync(item))">@item.Title</button>}</div>}</div><div class="calendar-time-grid" style="@Columns"><div class="calendar-hours">@for(var hour=0;hour<24;hour++){<div>@($"{hour:00}:00")</div>}</div>@foreach(var day in State.Days){<div class="calendar-time-column">@for(var hour=0;hour<24;hour++){var slot=hour;<button type="button" class="calendar-hour-slot" aria-label="@($"Create event {day.ToString("ddd, MMM d",CalendarState.English)} at {slot}:00")" @onclick="@(() => Create.InvokeAsync((day,$"{slot:00}:00")))"></button>}@foreach(var lane in CalendarState.Layout(State.Filtered.Where(e=>e.Date==CalendarState.Iso(day)))){var item=lane.Event;<button type="button" class="@($"calendar-time-event cat-{item.Category}")" style="@Tile(lane)" title="@($"{item.Title} · {item.Start} – {item.End}")" @onclick="@(() => Event.InvokeAsync(item))"><b>@item.Title</b><p>@item.Start – @item.End</p>@if(State.View=="Day"&&item.Location.Length>0){<small>@item.Location</small>}</button>}</div>}</div></div></div>
@code{[Parameter,EditorRequired]public CalendarState State{get;set;}=null!;[Parameter]public EventCallback<CalendarEntry> Event{get;set;}[Parameter]public EventCallback<(DateOnly Date,string Start)> Create{get;set;}private ElementReference _viewport;private IJSObjectReference? _module;private string Columns=>$"grid-template-columns:64px repeat({State.Days.Length},minmax(0,1fr))";private static string Tone(CalendarEntry item)=>$"--event-tone:var(--{CalendarState.Tone(item.Category)})";private static string N(double value)=>value.ToString(System.Globalization.CultureInfo.InvariantCulture);private static string Tile(CalendarLane lane)=>$"{Tone(lane.Event)};top:{N(CalendarState.Minutes(lane.Event.Start)*.8)}px;height:{N(Math.Max((CalendarState.Minutes(lane.Event.End)-CalendarState.Minutes(lane.Event.Start))*.8,24))}px;inset-inline-start:calc({N(lane.Lane/(double)lane.Lanes*100)}% + 2px);width:calc({N(100d/lane.Lanes)}% - 4px)";protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender){_module=await JS.InvokeAsync<IJSObjectReference>("import","./theme/calendar-browser.js");await _module.InvokeVoidAsync("scrollTimeline",_viewport);}}public async ValueTask DisposeAsync(){if(_module is not null)try{await _module.DisposeAsync();}catch(JSDisconnectedException){}}}
