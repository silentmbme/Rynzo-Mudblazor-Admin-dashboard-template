@using Rynzo.Client.Features.Calendar.Models
@using Rynzo.Client.Features.Calendar.Services
@using Rynzo.Client.Theme
@if(State.View=="Agenda"){
<div class="calendar-agenda">@foreach(var day in State.Days){var items=State.Filtered.Where(e=>e.Date==CalendarState.Iso(day)).ToArray();<section><div class="@(day==State.Today?"today":"")"><b>@day.ToString("ddd, d",CalendarState.English)</b><small>@day.ToString("MMMM",CalendarState.English)</small></div><div class="calendar-agenda-events">@foreach(var item in items){<button type="button" class="calendar-agenda-event" @onclick="@(() => Event.InvokeAsync(item))"><i style="@($"background:var(--{CalendarState.Tone(item.Category)})")"></i><time>@(item.AllDay?"All day":$"{item.Start} – {item.End}")</time><div><p>@item.Title</p>@if(item.Location.Length>0){<small><MudIcon Icon="@RynzoIcons.Get("MapPin")" />@item.Location</small>}</div><span class="@($"calendar-category cat-{item.Category}")" style="@($"--event-tone:var(--{CalendarState.Tone(item.Category)})")">@item.Category</span></button>}@if(items.Length==0){<button type="button" class="calendar-agenda-add" @onclick="@(() => Create.InvokeAsync((day,"09:00")))"><MudIcon Icon="@RynzoIcons.Get("Plus")" />No events · Add to your day</button>}</div></section>}</div>
}else if(State.View!="Month"){
<CalendarTimeline @key="State.View" State="State" Event="Event" Create="Create" />
}else{
<div class="calendar-month-scroll"><div class="calendar-month">@foreach(var day in new[]{"MON","TUE","WED","THU","FRI","SAT","SUN"}){<header>@day</header>}@foreach(var day in MonthDays){var items=State.Filtered.Where(e=>e.Date==CalendarState.Iso(day)).ToArray();<section class="@(day.Month!=State.Current.Month?"outside":day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday?"weekend":"")"><div class="calendar-month-date"><button type="button" class="@(day==State.Today?"today":"")" aria-label="@($"View {day.ToString("MMMM d",CalendarState.English)}")" @onclick="@(() => ShowDay.InvokeAsync(day))">@day.Day</button><button type="button" class="calendar-month-add" aria-label="@($"Create event on {day.ToString("MMMM d",CalendarState.English)}")" @onclick="@(() => Create.InvokeAsync((day,"09:00")))"><MudIcon Icon="@RynzoIcons.Get("Plus")" /></button></div><div class="calendar-month-events">@foreach(var item in items.Take(3)){<button type="button" class="@($"calendar-month-event cat-{item.Category}")" style="@($"--event-tone:var(--{CalendarState.Tone(item.Category)})")" title="@($"{item.Title} · {(item.AllDay?"All day":item.Start)}")" @onclick="@(() => Event.InvokeAsync(item))"><i></i><span>@(item.AllDay?"":item.Start+" ")@item.Title</span></button>}@if(items.Length>3){<button type="button" class="calendar-more" @onclick="@(() => ShowDay.InvokeAsync(day))">+@(items.Length-3) more events</button>}</div></section>}</div></div>
}
@code{[Parameter,EditorRequired]public CalendarState State{get;set;}=null!;[Parameter]public EventCallback<CalendarEntry> Event{get;set;}[Parameter]public EventCallback<(DateOnly Date,string Start)> Create{get;set;}[Parameter]public EventCallback<DateOnly> ShowDay{get;set;}private DateOnly[] MonthDays=>Enumerable.Range(0,42).Select(CalendarState.WeekStart(new DateOnly(State.Current.Year,State.Current.Month,1)).AddDays).ToArray();}
