@using Rynzo.Client.Features.Calendar.Models
@using Rynzo.Client.Features.Calendar.Services
@using Rynzo.Client.Theme
<div class="calendar-details"><header><div><span class="calendar-category" style="@($"--event-tone:var(--{CalendarState.Tone(Event.Category)})")">@Event.Category</span><h2>@Event.Title</h2></div><MudIconButton Icon="@RynzoIcons.Get("Pencil")" aria-label="Edit event" OnClick="@(() => Edit.InvokeAsync())" /></header><div class="calendar-detail-fields"><p><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />@CalendarState.Parse(Event.Date).ToString("dddd, MMMM d, yyyy",CalendarState.English) @(Event.AllDay?"All day":$"{Event.Start} - {Event.End}")</p>@if(Event.Location.Length>0){<p><MudIcon Icon="@RynzoIcons.Get("MapPin")" />@Event.Location</p>}@if(Event.Description.Length>0){<p class="calendar-description">@Event.Description</p>}@if(Event.Attendees.Length>0){<p><MudIcon Icon="@RynzoIcons.Get("Users")" />@string.Join(", ",Event.Attendees)</p>}@if(!string.IsNullOrEmpty(Event.Link)&&CalendarState.IsMeetingLink(Event.Link)){<MudButton Href="@Event.Link" Target="_blank" rel="noopener noreferrer" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Link")" EndIcon="@RynzoIcons.Get("ExternalLink")">Open meeting link</MudButton>}</div><footer><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Copy")" OnClick="@(() => Duplicate.InvokeAsync())">Duplicate</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@RynzoIcons.Get("Trash2")" OnClick="@(() => Delete.InvokeAsync())">Delete</MudButton></footer></div>
@code{[Parameter,EditorRequired]public CalendarEntry Event{get;set;}=null!;[Parameter]public EventCallback Edit{get;set;}[Parameter]public EventCallback Duplicate{get;set;}[Parameter]public EventCallback Delete{get;set;}}
