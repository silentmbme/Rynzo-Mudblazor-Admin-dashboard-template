@using Rynzo.Client.Features.School.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="students-workspace">
    <DashboardPageHeader Title="Students" Description="Manage your student directory and guardian contacts.">
        <Actions><div><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export directory</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenCreate">Add student</MudButton></div></Actions>
    </DashboardPageHeader>
    <section class="student-overview" aria-label="Student overview">
        <MudCard Class="student-total rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div class="student-total-heading"><span class="student-symbol"><MudIcon Icon="@RynzoIcons.Get("GraduationCap")" /></span><div><span>Student community</span><span class="student-year">2026&#8211;27</span></div></div><div class="student-total-count"><strong>@State.Data.Students.Count</strong><span>students</span></div><div class="student-total-footer"><span>Students in your directory</span><span class="student-live"><i></i>Sample records</span></div></MudCard>
        <MudCard Class="student-metric rynzo-widget-card" Style="--tone:var(--success)" Elevation="0" Outlined="true" data-widget-element="article"><span class="student-metric-icon"><MudIcon Icon="@RynzoIcons.Get("UserCheck")" /></span><div><span>Active students</span><strong>@ActiveCount</strong><small>Currently enrolled</small></div></MudCard>
        <MudCard Class="student-metric rynzo-widget-card" Style="--tone:var(--warning)" Elevation="0" Outlined="true" data-widget-element="article"><span class="student-metric-icon"><MudIcon Icon="@RynzoIcons.Get("Clock3")" /></span><div><span>On leave</span><strong>@(State.Data.Students.Count-ActiveCount)</strong><small>Temporary absence</small></div></MudCard>
        <MudCard Class="student-metric rynzo-widget-card" Style="--tone:var(--info)" Elevation="0" Outlined="true" data-widget-element="article"><span class="student-metric-icon"><MudIcon Icon="@RynzoIcons.Get("BookOpen")" /></span><div><span>Class groups</span><strong>@State.Data.Classes.Length</strong><small>Across the school</small></div></MudCard>
    </section>
    <div class="student-session"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>Sample academic workspace <span>·</span> Records and edits apply to this page session.</p><span class="student-demo">Demo data</span></div>
    @if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mb-4">@Notice</MudAlert>}
    <section class="student-directory" aria-label="Student directory">
        <div class="student-directory-heading"><div><span class="student-eyebrow">School management</span><h2>Student directory <span>@Visible.Count()</span></h2><p>Student profiles, class placements, and guardian contacts in one place.</p></div><span class="student-directory-mark"><MudIcon Icon="@RynzoIcons.Get("Users")" /></span></div>
        <div class="student-controls">
            <div class="student-tabs" aria-label="Enrollment status">@foreach(var status in new[]{"All","Active","On leave"}){<button type="button" class="@(StatusFilter==status?"is-active":"")" aria-pressed="@(StatusFilter==status)" @onclick="@(()=>StatusFilter=status)">@(status=="All"?"All students":status)<span>@State.Data.Students.Count(s=>status=="All"||s.Status==status)</span></button>}</div>
            <div class="student-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search students" Placeholder="Search name, ID, or guardian&#8230;" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Filter class" @bind="ClassFilter"><option value="All">All classes</option>@foreach(var c in State.Data.Classes){<option value="@c.Id">@c.Title</option>}</select></div>
        </div>
        <div class="student-table-scroll"><table class="student-table"><thead><tr><th>Student</th><th>Class placement</th><th>Guardian contact</th><th>Enrollment</th><th><span class="student-sr-only">Actions</span></th></tr></thead><tbody>@foreach(var student in Visible){var group=State.Data.Classes.First(c=>c.Id==student.ClassId);<tr><td><div class="student-person"><img src="@student.Photo" alt="@student.Name" loading="lazy" /><div><b>@student.Name</b><span>@student.Id</span></div></div></td><td><span class="student-class"><MudIcon Icon="@RynzoIcons.Get("BookOpen")" />@group.Title</span><small class="student-subline">@group.Room</small></td><td><div class="student-guardian"><b>@student.Guardian</b><a href="@($"mailto:{student.Email}")">@student.Email</a></div></td><td><span class="student-status @(student.Status=="Active"?"active":"leave")"><i></i>@student.Status</span></td><td><MudButton Variant="Variant.Text" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"View {student.Id}")" OnClick="@(()=>StudentId=student.Id)">View profile</MudButton></td></tr>}</tbody></table></div>
        @if(!Visible.Any()){<div class="student-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No students found</h3><p>No students match these filters. Try another name or class.</p><MudButton Variant="Variant.Outlined" OnClick="ResetFilters">Reset filters</MudButton></div>}
        <div class="student-table-footer"><span>Showing <b>@Visible.Count()</b> of @State.Data.Students.Count students</span><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /> Session directory</span></div>
    </section>
    <div class="student-class-strip"><div><span class="student-eyebrow">Class overview</span><h2>Your learning groups</h2></div><div class="student-class-list">@foreach(var group in State.Data.Classes){<button type="button" class="@(ClassFilter==group.Id?"selected":"")" style="@($"--tone:var(--{group.Color})")" @onclick="@(()=>ClassFilter=ClassFilter==group.Id?"All":group.Id)" aria-pressed="@(ClassFilter==group.Id)"><span class="student-class-icon"><MudIcon Icon="@RynzoIcons.Get("BookOpen")" /></span><span><b>@group.Title</b><small>@State.Data.Students.Count(s=>s.ClassId==group.Id) students · @group.Teacher</small></span><MudIcon Icon="@RynzoIcons.Get("ChevronRight")" /></button>}</div></div>
</div>
<MudDialog Visible="@(StudentDetail is not null)" VisibleChanged="@(v=>{if(!v)StudentId=null;})" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">Student profile</MudText></TitleContent><DialogContent>@if(StudentDetail is {} student){var group=State.Data.Classes.First(c=>c.Id==student.ClassId);<div class="student-profile"><div class="student-profile-hero"><img src="@student.Photo" alt="@student.Name" /><span class="student-eyebrow">@student.Id</span><h2>@student.Name</h2><span class="student-status @(student.Status=="Active"?"active":"leave")"><i></i>@student.Status</span></div><div class="student-profile-section"><h3>Class placement</h3><div class="student-profile-grid"><div><small>Class</small><b>@group.Title</b></div><div><small>Room</small><b>@group.Room</b></div></div></div><div class="student-profile-section"><h3>Guardian contact</h3><div class="student-contact-line"><span><MudIcon Icon="@RynzoIcons.Get("UserRound")" /></span><div><small>Guardian</small><b>@student.Guardian</b></div></div><div class="student-contact-line"><span><MudIcon Icon="@RynzoIcons.Get("Mail")" /></span><div><small>Email</small><a href="@($"mailto:{student.Email}")">@student.Email</a></div></div></div><p class="student-dialog-note">Sample directory record. Enrollment changes apply to this session.</p></div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>StudentId=null)">Close</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("ArrowLeftRight")" OnClick="ToggleStudent">@(StudentDetail?.Status=="Active"?"Mark on leave":"Mark active")</MudButton></DialogActions></MudDialog>
<MudDialog @bind-Visible="Create" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">Add student</MudText></TitleContent><DialogContent><div class="student-create"><p class="student-dialog-note">Create a sample student record and connect their guardian contact.</p><div class="student-create-heading"><span><MudIcon Icon="@RynzoIcons.Get("GraduationCap")" /></span><div><h3>Student information</h3><p>Basic details and class placement</p></div></div><label for="student-name">Student name</label><MudTextField T="string" @bind-Value="Name" InputId="student-name" Immediate="true" aria-label="Student name" Placeholder="Enter full name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="80" /><label for="student-class">Student class</label><select id="student-class" aria-label="Student class" @bind="NewClass">@foreach(var group in State.Data.Classes){<option value="@group.Id">@group.Title</option>}</select><div class="student-create-heading guardian"><span><MudIcon Icon="@RynzoIcons.Get("Users")" /></span><div><h3>Guardian information</h3><p>Primary contact for this student</p></div></div><label for="student-guardian">Guardian name</label><MudTextField T="string" @bind-Value="Guardian" InputId="student-guardian" Immediate="true" aria-label="Guardian name" Placeholder="Enter guardian name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="80" /><label for="student-email">Guardian email</label><MudTextField T="string" @bind-Value="Email" InputId="student-email" Immediate="true" aria-label="Guardian email" Placeholder="name@example.com" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Email" MaxLength="120" />@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}</div></DialogContent><DialogActions><MudButton OnClick="@(()=>Create=false)">Close</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="Save">Add student</MudButton></DialogActions></MudDialog>
@code {
    private readonly SchoolState State=new();
    private string Query="", ClassFilter="All", StatusFilter="All", Notice="", Error="", Name="", Guardian="", Email="", NewClass="8-A";
    private bool Create;
    private string? StudentId;
    private IJSObjectReference? Download;
    private static readonly DialogOptions DialogOptions=new(){MaxWidth=MaxWidth.Small,FullWidth=true};
    private int ActiveCount=>State.Data.Students.Count(s=>s.Status=="Active");
    private Student? StudentDetail=>State.Data.Students.FirstOrDefault(s=>s.Id==StudentId);
    private IEnumerable<Student> Visible=>State.Data.Students.Where(s=>(ClassFilter=="All"||s.ClassId==ClassFilter)&&(StatusFilter=="All"||s.Status==StatusFilter)&&$"{s.Name} {s.Id} {s.Guardian}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase));
    private void OpenCreate(){Create=true;Error="";}
    private void ResetFilters(){Query="";ClassFilter=StatusFilter="All";}
    private void ToggleStudent(){if(StudentId is null)return;State.ToggleStudent(StudentId);Notice=$"{StudentId} enrollment status updated.";}
    private void Save(){Error=State.AddStudent(Name,NewClass,Guardian,Email)??"";if(Error.Length>0)return;Notice=$"{State.Data.Students.Last().Id} added to the sample directory.";Create=false;Name=Guardian=Email="";NewClass="8-A";}
    private async Task Export(){IEnumerable<IEnumerable<string>> rows=new[]{new[]{"ID","Name","Class","Guardian","Email","Status"}}.Concat(Visible.Select(s=>new[]{s.Id,s.Name,s.ClassId,s.Guardian,s.Email,s.Status}));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await Download.InvokeVoidAsync("csv","students.csv",SchoolState.Csv(rows));Notice="Filtered sample records exported.";}
    public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
