@using Rynzo.Client.Features.School.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="attendance-page">
<DashboardPageHeader Title="Attendance" Description="A focused daily register for class attendance, exceptions, and review notes."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" Disabled="@(!ValidDate)" OnClick="Export">Export register</MudButton></Actions></DashboardPageHeader>
<section class="at-daily" aria-label="Daily attendance overview">
    <div class="at-date"><span class="at-date-icon"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" /></span><div><span class="at-eyebrow">Daily attendance</span><h2>@(DateOnly.TryParse(Date,out var selectedDay)?selectedDay.ToString("dddd, dd MMM yyyy",System.Globalization.CultureInfo.InvariantCulture):"Choose a date")</h2><p>Sample academic year 2026&#8211;27</p></div><div class="at-date-controls"><MudIconButton Icon="@RynzoIcons.Get("ChevronLeft")" aria-label="Previous attendance day" Disabled="@(!ValidDate)" OnClick="@(()=>Move(-1))" /><input type="date" aria-label="Attendance date" value="@Date" @onchange="@(e=>ChangeDate(e.Value?.ToString()??""))" /><MudIconButton Icon="@RynzoIcons.Get("ChevronRight")" aria-label="Next attendance day" Disabled="@(!ValidDate)" OnClick="@(()=>Move(1))" /></div></div>
    <div class="at-metrics">
        <MudCard Style="--tone:var(--primary)" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Users")" /></span><div><small>Students in scope</small><strong>@Scope.Count()</strong><p>@(ClassFilter=="All"?"All five class groups":ClassFilter)</p></div></MudCard>
        <MudCard Style="--tone:var(--success)" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("UserCheck")" /></span><div><small>Present / late</small><strong>@(Count("Present")+Count("Late"))</strong><p>@Count("Late") late arrivals</p></div></MudCard>
        <MudCard Style="--tone:var(--destructive)" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("UserX")" /></span><div><small>Absent</small><strong>@Count("Absent")</strong><p>@Count("Excused") excused separately</p></div></MudCard>
        <MudCard Style="--tone:var(--warning)" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" /></span><div><small>Unmarked</small><strong>@Count("Unmarked")</strong><p>@(Scope.Count()-Count("Unmarked")) of @Scope.Count() recorded</p></div></MudCard>
    </div>
</section>
<div class="at-session"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>Demo data <span>·</span> Attendance edits and review notes last for this page session.</p></div>
<div class="at-overview">
    <MudCard Class="at-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="at-panel-heading"><div><span class="at-eyebrow">Daily snapshot</span><h2>Attendance distribution</h2></div><span class="at-scope-badge">@(ClassFilter=="All"?"All classes":ClassFilter)</span></div><div class="at-distribution"><div class="at-chart"><DashboardChart OptionsModule="./school-attendance-options.js" Data="ChartData" Height="220" Label="Daily attendance distribution" /></div><div class="at-legend">@foreach(var status in SchoolState.Statuses){<button type="button" class="@(Filter==status?"selected":"")" style="@($"--tone:var(--{Tone(status)})")" aria-pressed="@(Filter==status)" @onclick="@(()=>{Filter=Filter==status?"All":status;Selected.Clear();})"><span><i></i>@status</span><b>@Count(status)</b></button>}</div></div><div class="at-rate"><div><span>Attendance rate</span><strong>@(State.Rate(Date,Scope) is {} rate?$"{rate}%":"Not available")</strong></div><p>Attendance totals include present, late, and absent records. Excused and unmarked records are excluded.</p></div></MudCard>
    <MudCard Class="at-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="at-panel-heading"><div><span class="at-eyebrow">Register coverage</span><h2>Class completion</h2></div><span class="at-panel-icon"><MudIcon Icon="@RynzoIcons.Get("BookOpen")" /></span></div><div class="at-completion-list">@foreach(var group in State.Data.Classes){var roster=State.Data.Students.Where(s=>s.ClassId==group.Id).ToArray();<button type="button" class="at-completion @(ClassFilter==group.Id?"selected":"")" aria-label="@($"Focus {group.Id}")" aria-pressed="@(ClassFilter==group.Id)" @onclick="@(()=>{ClassFilter=ClassFilter==group.Id?"All":group.Id;Selected.Clear();})"><span class="at-class-name"><b>@group.Title</b><small>@group.Teacher</small></span><span class="at-completion-detail"><span>@roster.Count(s=>Entry(s.Id).Status!="Unmarked")<small> / @roster.Length recorded</small></span><span class="at-completion-bar">@foreach(var status in SchoolState.Statuses){<i style="@($"width:{(roster.Length==0?0:roster.Count(s=>Entry(s.Id).Status==status)*100d/roster.Length).ToString(System.Globalization.CultureInfo.InvariantCulture)}%;background:var(--{Tone(status)})")"></i>}</span></span><MudIcon Icon="@RynzoIcons.Get("ChevronRight")" /></button>}</div><p class="at-panel-note">Select a class to focus the register and daily snapshot.</p></MudCard>
</div>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="at-notice">@Notice @if(State.CanUndo(Date)){<MudButton Size="Size.Small" OnClick="Undo">Undo last change</MudButton>}</MudAlert>}
<MudCard Class="at-register rynzo-widget-card" aria-label="Student register" Elevation="0" Outlined="true" data-widget-element="section"><div class="at-register-heading"><div><span class="at-eyebrow">Daily register</span><h2>Student attendance <span>@Visible.Count()</span></h2><p>Record attendance and keep important context with each student.</p></div><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@RynzoIcons.Get("Check")" Disabled="@(!ValidDate||!Visible.Any(s=>Entry(s.Id).Status=="Unmarked"))" OnClick="MarkUnmarked">Mark unmarked present</MudButton></div>
<div class="at-filters"><MudTextField T="string" @bind-Value="Query" @bind-Value:after="ClearSelection" Immediate="true" aria-label="Search school records" Placeholder="Search student, ID, or guardian&#8230;" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Filter class" @bind="ClassFilter" @bind:after="ClearSelection"><option value="All">All classes</option>@foreach(var group in State.Data.Classes){<option value="@group.Id">@group.Title</option>}</select><select aria-label="Filter school status" @bind="Filter" @bind:after="ClearSelection"><option value="All">All statuses</option>@foreach(var status in SchoolState.Statuses){<option>@status</option>}</select></div>
@if(Selected.Count>0){<div class="at-bulk"><b>@Selected.Count selected</b><select aria-label="Bulk attendance status" @bind="Bulk">@foreach(var status in SchoolState.Statuses){<option>@status</option>}</select><MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@(!ValidDate)" OnClick="@(()=>Apply(Selected.ToArray(),Bulk))">Apply to selected</MudButton><MudButton Size="Size.Small" OnClick="ClearSelection">Clear selection</MudButton></div>}
<div class="at-table-scroll"><table class="at-table"><thead><tr><th><input type="checkbox" checked="@(Visible.Any()&&Visible.All(s=>Selected.Contains(s.Id)))" @onchange="@(e=>SelectAll(e.Value is true))" aria-label="Select visible students" /></th><th>Student</th><th>Class</th><th>Attendance</th><th>Review notes</th><th><span class="at-sr-only">Actions</span></th></tr></thead><tbody>@foreach(var student in Visible){<tr class="@(Selected.Contains(student.Id)?"selected":"")"><td><input type="checkbox" checked="@Selected.Contains(student.Id)" @onchange="@(e=>Select(student.Id,e.Value is true))" aria-label="@($"Select {student.Id}")" /></td><td><div class="at-person"><img src="@student.Photo" alt="@student.Name" loading="lazy" /><div><b>@student.Name</b><small>@student.Id</small></div></div></td><td><span class="at-class-pill">@student.ClassId</span></td><td><div class="at-status-select" style="@($"--tone:var(--{Tone(Entry(student.Id).Status)})")"><i></i><select aria-label="@($"Attendance {student.Id}")" value="@Entry(student.Id).Status" @onchange="@(e=>Apply([student.Id],e.Value?.ToString()??"Unmarked"))" disabled="@(!ValidDate)">@foreach(var status in SchoolState.Statuses){<option>@status</option>}</select></div></td><td><span class="at-note" title="@Entry(student.Id).Note">@(Entry(student.Id).Note.Length>0?Entry(student.Id).Note:"No review note")</span>@if(Entry(student.Id).Status=="Late"&&Entry(student.Id).Minutes>0){<small class="at-late">@Entry(student.Id).Minutes minutes late</small>}</td><td><MudButton Variant="Variant.Text" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Review {student.Id}")" Disabled="@(!ValidDate)" OnClick="@(()=>Review(student))">Review</MudButton></td></tr>}</tbody></table></div>
@if(!Visible.Any()){<div class="at-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No students match your filters</h3><p>Try another student, class, or attendance status.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}
<div class="at-table-footer"><span>Showing <b>@Visible.Count()</b> of @Scope.Count() students in scope</span><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /> Session register</span></div></MudCard>
<section class="at-attention"><div class="at-attention-heading"><div><span class="at-eyebrow">Follow-up queue</span><h2>Needs attention <span>@Scope.Count(s=>Entry(s.Id).Status is "Absent" or "Late")</span></h2><p>Absent students and late arrivals in the selected class scope.</p></div><span class="at-panel-icon"><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" /></span></div><div class="at-attention-grid">@foreach(var student in Scope.Where(s=>Entry(s.Id).Status is "Absent" or "Late")){<button type="button" class="at-attention-card" aria-label="@($"Review attention {student.Id}")" disabled="@(!ValidDate)" @onclick="@(()=>Review(student))"><img src="@student.Photo" alt="@student.Name" /><span><b>@student.Name</b><small>@student.ClassId <span>·</span> @Entry(student.Id).Status @(Entry(student.Id).Minutes>0?$"· {Entry(student.Id).Minutes} min":"")</small></span><span class="at-attention-dot" style="@($"background:var(--{Tone(Entry(student.Id).Status)})")"></span><MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></button>}</div>@if(!Scope.Any(s=>Entry(s.Id).Status is "Absent" or "Late")){<div class="at-attention-empty"><MudIcon Icon="@RynzoIcons.Get("Check")" /> No marked absences or late arrivals.</div>}<p class="at-panel-note">Review notes remain local. No guardian notifications are sent.</p></section>
</div>
<MudDialog Visible="@(Editing is not null)" VisibleChanged="@(v=>{if(!v)Editing=null;})" Options="ReviewOptions"><TitleContent><MudText Typo="Typo.h6">Attendance review</MudText></TitleContent><DialogContent>@if(Editing is {} student){<div class="at-review"><div class="at-review-person"><img src="@student.Photo" alt="@student.Name" /><div><span class="at-eyebrow">@student.Id · @student.ClassId</span><h2>@student.Name</h2><p>Guardian: @student.Guardian</p></div></div><p class="at-review-date"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />@Date <span>Local sample record</span></p><label for="at-review-status">Attendance status</label><select id="at-review-status" aria-label="Review attendance status" value="@Draft.Status" @onchange="@(e=>Draft=Draft with{Status=e.Value?.ToString()??"Unmarked"})">@foreach(var status in SchoolState.Statuses){<option>@status</option>}</select>@if(Draft.Status=="Late"){<label for="at-late-minutes">Minutes late</label><MudNumericField T="int" Value="Draft.Minutes" ValueChanged="@(v=>Draft=Draft with{Minutes=v})" InputId="at-late-minutes" aria-label="Minutes late" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="240" />}<label for="at-review-note">Attendance note</label><MudTextField T="string" Value="Draft.Note" ValueChanged="@(v=>Draft=Draft with{Note=v})" InputId="at-review-note" Immediate="true" aria-label="Attendance note" Placeholder="Add context for this attendance record&#8230;" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" MaxLength="500" /><small class="at-review-hint">@Draft.Note.Length/500 characters · Session-only record</small>@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}</div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>Editing=null)">Close</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Check")" OnClick="SaveReview">Save attendance review</MudButton></DialogActions></MudDialog>
@code{
 private readonly SchoolState State=new();private string Date="2026-10-09",Query="",ClassFilter="All",Filter="All",Bulk="Present",Notice="",Error="";private readonly HashSet<string> Selected=[];private Student? Editing;private AttendanceEntry Draft=new();private IJSObjectReference? Download;
 private static readonly DialogOptions ReviewOptions=new(){MaxWidth=MaxWidth.Small,FullWidth=true};
 private bool ValidDate=>DateOnly.TryParse(Date,out _);private AttendanceEntry Entry(string id)=>State.Entry(Date,id);private IEnumerable<Student> Scope=>State.Data.Students.Where(s=>ClassFilter=="All"||s.ClassId==ClassFilter);private int Count(string status)=>Scope.Count(s=>Entry(s.Id).Status==status);private IEnumerable<Student> Visible=>Scope.Where(s=>$"{s.Name} {s.Id} {s.Guardian}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Filter=="All"||Entry(s.Id).Status==Filter));private object ChartData=>new{counts=SchoolState.Statuses.Select(Count).ToArray(),marked=Scope.Count()-Count("Unmarked"),total=Scope.Count()};
 private static string Tone(string status)=>status switch{"Present"=>"success","Late"=>"warning","Absent"=>"destructive","Excused"=>"info",_=>"muted"};
 private void ChangeDate(string value){Date=value;Selected.Clear();Notice="";}private void Move(int n){if(DateOnly.TryParse(Date,out var day))ChangeDate(day.AddDays(n).ToString("yyyy-MM-dd"));}private void ClearSelection()=>Selected.Clear();private void Select(string id,bool value){if(value)Selected.Add(id);else Selected.Remove(id);}private void SelectAll(bool value){Selected.Clear();if(value)foreach(var s in Visible)Selected.Add(s.Id);}private void Reset(){Query="";ClassFilter=Filter="All";Selected.Clear();}
 private void Apply(string[] ids,string value){State.Apply(Date,ids,value);Notice=$"Marked {ids.Length} student{(ids.Length==1?"":"s")} {value.ToLowerInvariant()} for {Date}.";Selected.Clear();}private void MarkUnmarked()=>Apply(Visible.Where(s=>Entry(s.Id).Status=="Unmarked").Select(s=>s.Id).ToArray(),"Present");private void Undo(){State.Undo(Date);Notice="Last attendance change undone.";Selected.Clear();}private void Review(Student s){Editing=s;Draft=Entry(s.Id) with{};Error="";}private void SaveReview(){if(Editing is null)return;Error=State.Review(Date,Editing.Id,Draft)??"";if(Error.Length>0)return;Notice=$"Attendance review saved for {Editing.Name}.";Editing=null;}
 private async Task Export(){var rows=new[]{new[]{"Date","ID","Student","Class","Status","Late minutes","Note"}}.Concat(Visible.Select(s=>new[]{Date,s.Id,s.Name,s.ClassId,Entry(s.Id).Status,Entry(s.Id).Minutes.ToString(),Entry(s.Id).Note}));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await Download.InvokeVoidAsync("csv",$"attendance-{Date}.csv",SchoolState.Csv(rows));Notice=$"Exported {Visible.Count()} visible attendance records.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}



