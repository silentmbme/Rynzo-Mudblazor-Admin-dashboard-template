@using Rynzo.Client.Features.School.Models
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@implements IAsyncDisposable
<SchoolSurface><div class="school-page">
<div class="school-heading"><PageHeader Title="@Title" Description="@Description" Breadcrumbs="Crumbs" /><MudStack Row="true"><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export</MudButton>@if(Kind is "students" or "exams"){<MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(()=>{Create=true;Error="";})">@(Kind=="students"?"Add student":"Schedule exam")</MudButton>}</MudStack></div>
<div class="school-stats">@for(var i=0;i<Stats.Length;i++){var stat=Stats[i];<SchoolMetric Label="@stat.Item1" Value="@stat.Item2.ToString()" Icon="@(new[]{"Users","CheckCheck","BookOpen","CalendarDays"}[i])" Tone="@(new[]{"primary","info","success","warning"}[i])" />}</div>
<div class="sample-notice"><span>Sample academic workspace / 2026-27. Records and edits apply to this page session.</span><MudChip T="string" Color="Color.Info" Size="Size.Small">Demo data</MudChip></div>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status">@Notice</MudAlert>}
<div class="school-toolbar"><MudTextField T="string" @bind-Value="Query" Immediate="true" Label="Search school records" Placeholder="Search records..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><MudSelect T="string" @bind-Value="ClassFilter" Label="Filter class" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("All")">All classes</MudSelectItem>@foreach(var c in State.Data.Classes){<MudSelectItem Value="@c.Id">@c.Title</MudSelectItem>}</MudSelect>@if(Kind!="classes"){<MudSelect T="string" @bind-Value="StatusFilter" Label="Filter school status" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("All")">All statuses</MudSelectItem>@foreach(var s in Kind=="students"?new[]{"Active","On leave"}:new[]{"Scheduled","Cancelled"}){<MudSelectItem Value="@s">@s</MudSelectItem>}</MudSelect>}</div>
@if(Kind=="students"){
<MudCard Outlined="true" Class="rynzo-widget-card" Elevation="0"><div class="school-card-header"><MudText Typo="Typo.h6">Student directory</MudText><small>@VisibleStudents.Count() students in the current view</small></div><MudTable Breakpoint="Breakpoint.None" Items="VisibleStudents" Hover="true" Elevation="0"><HeaderContent><MudTh>Student</MudTh><MudTh>Class</MudTh><MudTh>Guardian</MudTh><MudTh>Status</MudTh><MudTh>Actions</MudTh></HeaderContent><RowTemplate><MudTd DataLabel="Student"><StudentLabel Student="context" /></MudTd><MudTd DataLabel="Class">@context.ClassId</MudTd><MudTd DataLabel="Guardian">@context.Guardian<small class="muted block">@context.Email</small></MudTd><MudTd DataLabel="Status"><MudChip T="string" Color="@(context.Status=="Active"?Color.Success:Color.Warning)" Size="Size.Small">@context.Status</MudChip></MudTd><MudTd><MudButton Size="Size.Small" Variant="Variant.Outlined" aria-label="@($"View {context.Id}")" OnClick="@(()=>StudentId=context.Id)">View profile</MudButton></MudTd></RowTemplate><NoRecordsContent>No students match these filters.</NoRecordsContent></MudTable></MudCard>
}else if(Kind=="classes"){
<div class="school-grid">@foreach(var c in VisibleClasses){var count=State.Data.Students.Count(s=>s.ClassId==c.Id);<MudCard Outlined="true" Class="rynzo-widget-card" Elevation="0"><div class="card-top"><span class="school-icon" style="@($"--tone:var(--{c.Color})")"><MudIcon Icon="@RynzoIcons.Get("GraduationCap")" /></span><MudChip T="string" Color="Color.Success" Size="Size.Small">Active class</MudChip></div><MudText Typo="Typo.h5" Class="mt-4">@c.Title</MudText><small class="muted">Class teacher: @c.Teacher</small><div class="class-metrics">@foreach(var m in new[]{("Students",count),("Capacity",c.Capacity),("Subjects",c.Subjects)}){<div><small>@m.Item1</small><b>@m.Item2</b></div>}</div><div class="enrollment"><span>Sample enrollment</span><span>@Math.Round(count*100d/c.Capacity)%</span></div><MudProgressLinear Color="Color.Primary" Value="@(count*100d/c.Capacity)" Class="mt-2" /><div class="detail-line mt-4"><MudIcon Icon="@RynzoIcons.Get("MapPin")" />@c.Room</div><MudButton FullWidth="true" Class="mt-5" Variant="Variant.Outlined" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Roster {c.Id}")" OnClick="@(()=>ClassDetail=c)">Open class roster</MudButton></MudCard>}@if(!VisibleClasses.Any()){<MudCard Outlined="true" Class="rynzo-widget-card" Elevation="0">No matching classes.</MudCard>}</div>
}else{
<div class="school-grid">@foreach(var e in VisibleExams){<MudCard Outlined="true" Class="rynzo-widget-card" Elevation="0"><div class="card-top"><span class="school-icon"><MudIcon Icon="@RynzoIcons.Get("BookOpen")" /></span><MudChip T="string" Color="@(e.Status=="Scheduled"?Color.Success:Color.Default)" Size="Size.Small">@e.Status</MudChip></div><small class="muted block mt-4">@e.Id / @e.ClassId</small><MudText Typo="Typo.h5" Class="mt-1">@e.Subject</MudText><div class="exam-details"><div class="detail-line"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />@e.Date</div><div class="detail-line"><MudIcon Icon="@RynzoIcons.Get("Clock3")" />@e.Time / @e.Duration minutes</div><div class="detail-line"><MudIcon Icon="@RynzoIcons.Get("MapPin")" />@e.Room</div></div><MudButton FullWidth="true" Variant="Variant.Outlined" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Exam {e.Id}")" OnClick="@(()=>ExamId=e.Id)">Exam details</MudButton></MudCard>}@if(!VisibleExams.Any()){<MudCard Outlined="true" Class="rynzo-widget-card" Elevation="0">No exams match these filters.</MudCard>}</div>
}
</div>
<MudDialog Visible="@(StudentDetail is not null)" VisibleChanged="@(v=>{if(!v)StudentId=null;})"><TitleContent><MudText Typo="Typo.h6">Student profile</MudText></TitleContent><DialogContent>@if(StudentDetail is {} s){<small>@s.Id / Sample directory record</small><div class="my-4"><StudentLabel Student="s" /></div><MudChip T="string" Color="Color.Info">@s.ClassId</MudChip><MudPaper Class="pa-4 my-4" Outlined="true"><small>Guardian</small><p>@s.Guardian</p><small>Email</small><p>@s.Email</p><small>Enrollment</small><p>@s.Status</p></MudPaper>}</DialogContent><DialogActions><MudButton OnClick="@(()=>StudentId=null)">Close</MudButton><MudButton Variant="Variant.Outlined" OnClick="ToggleStudent">@(StudentDetail?.Status=="Active"?"Mark on leave":"Mark active")</MudButton></DialogActions></MudDialog>
<MudDialog Visible="@(ClassDetail is not null)" VisibleChanged="@(v=>{if(!v)ClassDetail=null;})"><TitleContent><MudText Typo="Typo.h6">@ClassDetail?.Title roster</MudText></TitleContent><DialogContent>@if(ClassDetail is {} c){<small>@c.Teacher / @c.Room</small><div class="roster">@foreach(var s in State.Data.Students.Where(s=>s.ClassId==c.Id)){<MudPaper Outlined="true" Class="pa-3 mt-3"><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><StudentLabel Student="s" /><MudChip T="string" Color="Color.Info" Size="Size.Small">@s.Status</MudChip></MudStack></MudPaper>}</div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>ClassDetail=null)">Close</MudButton></DialogActions></MudDialog>
<MudDialog Visible="@(ExamDetail is not null)" VisibleChanged="@(v=>{if(!v)ExamId=null;})"><TitleContent><MudText Typo="Typo.h6">@ExamDetail?.Subject exam</MudText></TitleContent><DialogContent>@if(ExamDetail is {} e){<small>@e.Id / Sample schedule</small><div class="exam-detail-grid">@foreach(var row in new[]{("Class",e.ClassId),("Date",e.Date),("Time",e.Time),("Duration",$"{e.Duration} min"),("Venue",e.Room),("Status",e.Status)}){<div><small>@row.Item1</small><p>@row.Item2</p></div>}</div>@if(e.Status=="Cancelled"){<p>This sample exam is cancelled. Create a new schedule to plan it again.</p>}}</DialogContent><DialogActions><MudButton OnClick="@(()=>ExamId=null)">Close</MudButton>@if(ExamDetail?.Status=="Scheduled"){<MudButton Variant="Variant.Outlined" OnClick="CancelExam">Cancel sample exam</MudButton>}</DialogActions></MudDialog>
<MudDialog @bind-Visible="Create"><TitleContent><MudText Typo="Typo.h6">@(Kind=="students"?"Add student":"Schedule exam")</MudText></TitleContent><DialogContent><MudText Typo="Typo.caption">Creates a sample record for this page session.</MudText>@if(Kind=="students"){<MudTextField T="string" @bind-Value="Name" Immediate="true" Label="Student name" MaxLength="80" Required="true" />}else{<MudTextField T="string" @bind-Value="Subject" Immediate="true" Label="Exam subject" MaxLength="80" Required="true" />}<MudSelect T="string" @bind-Value="NewClass" Label="@(Kind=="students"?"Student class":"Exam class")">@foreach(var c in State.Data.Classes){<MudSelectItem Value="@c.Id">@c.Title</MudSelectItem>}</MudSelect>@if(Kind=="students"){<MudTextField T="string" @bind-Value="Guardian" Immediate="true" Label="Guardian name" MaxLength="80" Required="true" /><MudTextField T="string" @bind-Value="Email" Immediate="true" Label="Guardian email" InputType="InputType.Email" MaxLength="120" Required="true" />}else{<MudTextField T="string" @bind-Value="Date" Label="Exam date" InputType="InputType.Date" Required="true" /><MudTextField T="string" @bind-Value="Time" Label="Exam time" InputType="InputType.Time" Required="true" /><MudNumericField T="int" @bind-Value="Duration" Label="Exam duration" Min="30" Max="180" Required="true" /><MudTextField T="string" @bind-Value="Room" Immediate="true" Label="Exam venue" MaxLength="60" Required="true" />}@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert">@Error</MudAlert>}</DialogContent><DialogActions><MudButton OnClick="@(()=>Create=false)">Close</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@(Kind=="students"?"Add student":"Schedule exam")</MudButton></DialogActions></MudDialog>
</SchoolSurface>
@code{
 [Parameter]public string Kind{get;set;}="students";
 private readonly SchoolState State=new();
 private string Query="",ClassFilter="All",StatusFilter="All",Notice="",Error="",Name="",Guardian="",Email="",NewClass="8-A",Subject="",Date="2026-10-19",Time="09:00",Room="Hall A";
 private int Duration=60;private bool Create;private string? StudentId,ExamId;private SchoolClass? ClassDetail;
 private Student? StudentDetail=>State.Data.Students.FirstOrDefault(s=>s.Id==StudentId);private Exam? ExamDetail=>State.Data.Exams.FirstOrDefault(e=>e.Id==ExamId);
 private string Title=>Kind=="classes"?"Classes":Kind=="exams"?"Exams":"Students";
 private string Description=>Kind=="classes"?"Explore class groups, teachers, and student rosters.":Kind=="exams"?"Plan exam schedules, venues, and class assignments.":"Manage your student directory and guardian contacts.";
 private IReadOnlyList<BreadcrumbItem> Crumbs=>[new("Management",null),new("School Management",null),new(Title,null,true)];
 private (string,int)[] Stats=>Kind=="classes"?[("Class groups",State.Data.Classes.Length),("Enrolled sample students",State.Data.Students.Count),("Teachers",State.Data.Classes.Length),("Total capacity",State.Data.Classes.Sum(c=>c.Capacity))]:Kind=="exams"?[("Planned exams",State.Data.Exams.Count(e=>e.Status=="Scheduled")),("Subjects",State.Data.Exams.Select(e=>e.Subject).Distinct().Count()),("Exam venues",State.Data.Exams.Select(e=>e.Room).Distinct().Count()),("Cancelled",State.Data.Exams.Count(e=>e.Status=="Cancelled"))]:[("Sample students",State.Data.Students.Count),("Active students",State.Data.Students.Count(s=>s.Status=="Active")),("On leave",State.Data.Students.Count(s=>s.Status=="On leave")),("Classes",State.Data.Classes.Length)];
 private IEnumerable<Student> VisibleStudents=>State.Data.Students.Where(s=>(ClassFilter=="All"||s.ClassId==ClassFilter)&&(StatusFilter=="All"||s.Status==StatusFilter)&&$"{s.Name} {s.Id} {s.Guardian}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase));
 private IEnumerable<SchoolClass> VisibleClasses=>State.Data.Classes.Where(c=>(ClassFilter=="All"||c.Id==ClassFilter)&&$"{c.Title} {c.Teacher}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase));
 private IEnumerable<Exam> VisibleExams=>State.Data.Exams.Where(e=>(ClassFilter=="All"||e.ClassId==ClassFilter)&&(StatusFilter=="All"||e.Status==StatusFilter)&&$"{e.Id} {e.Subject} {e.Room}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)).OrderBy(e=>e.Date+e.Time);
 private void ToggleStudent(){if(StudentId is null)return;State.ToggleStudent(StudentId);Notice=$"{StudentId} enrollment status updated.";}
 private void CancelExam(){if(ExamId is null)return;State.Cancel(ExamId);Notice=$"{ExamId} cancelled in this session.";}
 private void Save(){Error=(Kind=="students"?State.AddStudent(Name,NewClass,Guardian,Email):State.Schedule(new("",Subject,NewClass,Date,Time,Duration,Room,"Scheduled")))??"";if(Error.Length>0)return;Notice=Kind=="students"?$"{State.Data.Students.Last().Id} added to the sample directory.":$"{State.Data.Exams.Last().Id} scheduled in the sample planner.";Create=false;if(Kind=="students"){Name=Guardian=Email="";NewClass="8-A";}}
 private IJSObjectReference? Download;
 private async Task Export(){IEnumerable<IEnumerable<string>> rows=Kind=="students"?new[]{new[]{"ID","Name","Class","Guardian","Email","Status"}}.Concat(VisibleStudents.Select(s=>new[]{s.Id,s.Name,s.ClassId,s.Guardian,s.Email,s.Status})):Kind=="classes"?new[]{new[]{"Class","Teacher","Room","Enrolled","Capacity"}}.Concat(VisibleClasses.Select(c=>new[]{c.Title,c.Teacher,c.Room,State.Data.Students.Count(s=>s.ClassId==c.Id).ToString(),c.Capacity.ToString()})):new[]{new[]{"ID","Subject","Class","Date","Time","Duration minutes","Room","Status"}}.Concat(VisibleExams.Select(e=>new[]{e.Id,e.Subject,e.ClassId,e.Date,e.Time,e.Duration.ToString(),e.Room,e.Status}));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await Download.InvokeVoidAsync("csv",Kind+".csv",SchoolState.Csv(rows));Notice="Filtered sample records exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}

