@page "/hospital/pharmacy"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Theme
@using System.Globalization
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Pharmacy | Rynzo</PageTitle>
<div class="pharmacy-page"><DashboardPageHeader Title="Pharmacy" Description="Review hospital supply inventory, stock levels, and replenishment priorities."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export inventory</MudButton></Actions></DashboardPageHeader>
<section class="ph-summary"><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Package")" />Supply items</span><strong>@Source.Supplies.Length</strong><small>Sample inventory lines</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Activity")" />Below 30% of target</span><strong>@Source.Supplies.Count(s=>Ratio(s)<30)</strong><small>Priority for stock review</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" />Below target</span><strong>@Source.Supplies.Count(s=>s.Remaining<s.Target)</strong><small>Items with a replenishment gap</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Check")" />At target</span><strong>@Source.Supplies.Count(s=>s.Remaining>=s.Target)</strong><small>Stock target met</small></MudCard></section>
<p class="ph-notice"><MudIcon Icon="@RynzoIcons.Get("Info")" />Fictional hospital supply snapshot. No medication, dispensing, purchasing, or live inventory records are connected.</p>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mb-5">@Notice</MudAlert>}
<div class="ph-layout"><section class="ph-inventory"><div class="ph-heading"><span class="ph-eyebrow">Stock workspace</span><h2>Supply inventory <small>@Visible.Count()</small></h2><p>Available quantities and target stock, clearly organized.</p></div><div class="ph-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search supplies" Placeholder="Search supply item..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Supply stock filter" @bind="Filter"><option value="All">All stock levels</option><option value="low">Below 30% of target</option><option value="target">At target</option></select></div>
<div class="ph-items">@foreach(var supply in Visible){<MudCard Class="ph-item rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div class="ph-item-heading"><span class="ph-item-icon"><MudIcon Icon="@RynzoIcons.Get("Package")" /></span><div><h3>@supply.Name</h3><small>Stock unit: @supply.Unit</small></div><span class="ph-status @(Ratio(supply)<30?"low":"")">@(Ratio(supply)<30?"Low stock":supply.Remaining>=supply.Target?"At target":"Below target")</span></div><div class="ph-quantities"><div><small>Remaining</small><strong>@supply.Remaining.ToString("N0")<span>@supply.Unit</span></strong></div><div><small>Target stock</small><b>@supply.Target.ToString("N0") @supply.Unit</b></div><div><small>Replenishment gap</small><b>@Math.Max(0,supply.Target-supply.Remaining).ToString("N0") @supply.Unit</b></div></div><div class="ph-item-footer"><span><b>@Ratio(supply).ToString("0.#",CultureInfo.InvariantCulture)%</b> of target available</span><MudButton Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Supply {supply.Name}")" OnClick="@(()=>Selected=supply)">View item</MudButton></div></MudCard>}</div>
@if(!Visible.Any()){<div class="ph-empty"><h3>No matching supplies</h3><p>Try another item or stock filter.</p><MudButton OnClick="Reset">Reset filters</MudButton></div>}<div class="ph-footer">Showing @Visible.Count() of @Source.Supplies.Length inventory items</div></section>
<aside class="ph-sidebar"><section><span class="ph-eyebrow">Replenishment focus</span><h2>Review low stock</h2><p>Items below 30% of their sample target.</p>@foreach(var supply in Source.Supplies.Where(s=>Ratio(s)<30).OrderBy(Ratio)){<button type="button" class="ph-priority" @onclick="@(()=>Selected=supply)"><span><b>@supply.Name</b><small>@supply.Remaining @supply.Unit remaining</small></span><MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></button>}</section><section class="ph-guide"><span class="ph-eyebrow">Inventory context</span><h2>Read the stock snapshot</h2><p>Targets are sample reference quantities. Replenishment gap is the difference between target and remaining stock.</p><p>Quantities use different units and are shown separately for each item.</p><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" />Read-only sample inventory</span></section></aside></div></div>
<MudDialog Visible="@(Selected is not null)" VisibleChanged="@(v=>{if(!v)Selected=null;})" Options="Options"><TitleContent><MudText Typo="Typo.h6">Supply details</MudText></TitleContent><DialogContent>@if(Selected is {} supply){<div class="ph-detail"><span class="ph-eyebrow">Sample supply record</span><h2>@supply.Name</h2><dl>@foreach(var field in new[]{("Remaining",$"{supply.Remaining:N0} {supply.Unit}"),("Target stock",$"{supply.Target:N0} {supply.Unit}"),("Replenishment gap",$"{Math.Max(0,supply.Target-supply.Remaining):N0} {supply.Unit}"),("Stock coverage",Ratio(supply).ToString("0.#",CultureInfo.InvariantCulture)+"%")}){<div><dt>@field.Item1</dt><dd>@field.Item2</dd></div>}</dl><p>Fictional inventory snapshot. Viewing this item does not place an order or change stock.</p></div>}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>Selected=null)">Close</MudButton></DialogActions></MudDialog>
@code {
 private readonly HospitalSourceData Source=HospitalSourceData.Load();private string Query="",Filter="All",Notice="";private HospitalSupply? Selected;private IJSObjectReference? Download;private static readonly DialogOptions Options=new(){MaxWidth=MaxWidth.Small,FullWidth=true};private static double Ratio(HospitalSupply supply)=>supply.Target==0?0:supply.Remaining*100d/supply.Target;
 private IEnumerable<HospitalSupply> Visible=>Source.Supplies.Where(s=>s.Name.Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Filter=="All"||(Filter=="low"?Ratio(s)<30:s.Remaining>=s.Target)));private void Reset(){Query="";Filter="All";}
 private async Task Export(){static string Quote(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new[]{new[]{"Supply","Remaining","Target","Unit","Replenishment gap","Coverage percent"}}.Concat(Visible.Select(s=>new[]{s.Name,s.Remaining.ToString(),s.Target.ToString(),s.Unit,Math.Max(0,s.Target-s.Remaining).ToString(),Ratio(s).ToString("0.#",CultureInfo.InvariantCulture)}));var csv=string.Join("\r\n",rows.Select(r=>string.Join(",",r.Select(Quote))));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","hospital-pharmacy.csv",csv,"text/csv;charset=utf-8");Notice="Filtered sample inventory exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
