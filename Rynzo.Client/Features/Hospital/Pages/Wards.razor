@page "/hospital/wards"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Theme
@using System.Globalization
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Wards | Rynzo</PageTitle>
<div class="wards-page">
<DashboardPageHeader Title="Wards" Description="Review ward capacity, occupied beds, and available space across care departments."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export wards</MudButton></Actions></DashboardPageHeader>
<section class="wd-summary"><MudCard Class="wd-capacity rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="wd-eyebrow">Hospital capacity</span><strong>@Source.Departments.Sum(d=>d.Beds)<small>total beds</small></strong><p>Across @Source.Departments.Length care departments</p><span class="wd-capacity-icon"><MudIcon Icon="@RynzoIcons.Get("BedDouble")" /></span></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Hospital")" />Occupied beds</span><strong>@Source.Departments.Sum(d=>d.Occupied)</strong><small>Sample occupancy snapshot</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("BedDouble")" />Available beds</span><strong>@Source.Departments.Sum(d=>d.Beds-d.Occupied)</strong><small>Total beds minus occupied beds</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get("Activity")" />Occupancy</span><strong>@Percent(Source.Departments.Sum(d=>d.Occupied),Source.Departments.Sum(d=>d.Beds))%</strong><small>Across the hospital</small></MudCard></section>
<p class="wd-notice"><MudIcon Icon="@RynzoIcons.Get("Info")" />Fictional hospital capacity snapshot. Department totals are sample data, not live bed availability.</p>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mb-5">@Notice</MudAlert>}
<div class="wd-heading"><div><span class="wd-eyebrow">Spaces for care</span><h2>Ward directory <small>@Visible.Count()</small></h2><p>Explore capacity and occupancy by department.</p></div><div class="wd-key"><span><i></i>Occupied</span><span><i></i>Available</span></div></div>
<div class="wd-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search wards" Placeholder="Search department..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Ward capacity filter" @bind="Capacity"><option value="All">All wards</option><option value="available">Beds available</option><option value="full">At capacity</option></select><select aria-label="Sort wards" @bind="Sort"><option value="source">Department order</option><option value="occupancy">Highest occupancy</option><option value="available">Most available beds</option></select></div>
<div class="wd-grid">@foreach(var ward in Visible){<MudCard Class="wd-card rynzo-widget-card" Style="@($"--tone:var({ward.Color})")" Elevation="0" Outlined="true" data-widget-element="article"><div class="wd-card-heading"><span class="wd-icon"><MudIcon Icon="@RynzoIcons.Get("Hospital")" /></span><span class="wd-availability">@(ward.Beds-ward.Occupied) beds available</span></div><h3>@ward.Name</h3><p class="wd-card-subtitle">Department capacity</p><div class="wd-numbers"><div><strong>@ward.Beds</strong><span>Total beds</span></div><div><strong>@ward.Occupied</strong><span>Occupied</span></div><div><strong>@(ward.Beds-ward.Occupied)</strong><span>Available</span></div></div><div class="wd-bed-map" aria-label="@($"{ward.Occupied} of {ward.Beds} beds occupied")">@foreach(var bed in Enumerable.Range(0,ward.Beds)){<i class="@(bed<ward.Occupied?"occupied":"")" aria-hidden="true"></i>}</div><div class="wd-occupancy"><span>Occupancy</span><b>@Percent(ward.Occupied,ward.Beds)%</b></div><div class="wd-card-footer"><span><MudIcon Icon="@RynzoIcons.Get("Activity")" />@ward.Visits sample visits</span><MudButton Variant="Variant.Text" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Ward {ward.Name}")" OnClick="@(()=>Selected=ward)">View details</MudButton></div></MudCard>}</div>
@if(!Visible.Any()){<div class="wd-empty"><h3>No matching wards</h3><p>Try another department or capacity filter.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}
<div class="wd-footer"><span>Showing @Visible.Count() of @Source.Departments.Length departments</span><span>Each block represents one bed in the sample totals.</span></div></div>
<MudDialog Visible="@(Selected is not null)" VisibleChanged="@(v=>{if(!v)Selected=null;})" Options="Options"><TitleContent><MudText Typo="Typo.h6">Ward details</MudText></TitleContent><DialogContent>@if(Selected is {} ward){<div class="wd-detail"><span class="wd-eyebrow">Department capacity snapshot</span><h2>@ward.Name</h2><dl>@foreach(var field in new[]{("Total beds",ward.Beds.ToString()),("Occupied beds",ward.Occupied.ToString()),("Available beds",(ward.Beds-ward.Occupied).ToString()),("Occupancy",Percent(ward.Occupied,ward.Beds)+"%"),("Sample visits",ward.Visits.ToString())}){<div><dt>@field.Item1</dt><dd>@field.Item2</dd></div>}</dl><h3>Care team</h3>@foreach(var doctor in Source.Doctors.Where(d=>d.Department==ward.Name)){<div class="wd-doctor"><HospitalDoctorPortrait Doctor="doctor" Small="true" /><div><b>@doctor.Name</b><small>@doctor.Role</small></div></div>}@if(!Source.Doctors.Any(d=>d.Department==ward.Name)){<p>No doctors are listed for this department in the sample roster.</p>}<p class="wd-detail-note">Aggregate sample counts only. Individual bed assignments and patient placements are not provided.</p></div>}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>Selected=null)">Close</MudButton></DialogActions></MudDialog>
@code {
 private readonly HospitalSourceData Source=HospitalSourceData.Load();private string Query="",Capacity="All",Sort="source",Notice="";private HospitalDepartment? Selected;private IJSObjectReference? Download;private static readonly DialogOptions Options=new(){MaxWidth=MaxWidth.Small,FullWidth=true};
 private IEnumerable<HospitalDepartment> Visible{get{var wards=Source.Departments.Where(d=>d.Name.Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Capacity=="All"||(Capacity=="available"?d.Beds>d.Occupied:d.Beds==d.Occupied)));return Sort=="occupancy"?wards.OrderByDescending(d=>d.Beds==0?0:d.Occupied/(double)d.Beds):Sort=="available"?wards.OrderByDescending(d=>d.Beds-d.Occupied):wards;}}
 private static string Percent(int occupied,int beds)=>(beds==0?0:occupied*100d/beds).ToString("0.#",CultureInfo.InvariantCulture);private void Reset(){Query="";Capacity="All";Sort="source";}
 private async Task Export(){static string Quote(string s)=>"\""+s.Replace("\"","\"\"")+"\"";var rows=new[]{new[]{"Department","Total beds","Occupied beds","Available beds","Occupancy percent","Sample visits"}}.Concat(Visible.Select(d=>new[]{d.Name,d.Beds.ToString(),d.Occupied.ToString(),(d.Beds-d.Occupied).ToString(),Percent(d.Occupied,d.Beds),d.Visits.ToString()}));var csv=string.Join("\r\n",rows.Select(r=>string.Join(",",r.Select(Quote))));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","hospital-wards.csv",csv,"text/csv;charset=utf-8");Notice="Filtered ward capacity exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
