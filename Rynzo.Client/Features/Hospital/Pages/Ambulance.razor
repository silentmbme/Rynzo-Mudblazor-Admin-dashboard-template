@page "/hospital/ambulance"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Ambulance | Rynzo</PageTitle>
<div class="ambulance-page"><DashboardPageHeader Title="Ambulance" Description="Explore the sample transport fleet, vehicle availability, and service assignments."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export fleet</MudButton></Actions></DashboardPageHeader>
<section class="am-summary"><MudCard Class="am-total rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="am-eyebrow">Transport workspace</span><h2>Fleet overview</h2><strong>@Fleet.Length<small>sample vehicles</small></strong><p>A clear view of transport readiness.</p></MudCard>@foreach(var status in Statuses){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get(status=="Available"?"Check":status=="On assignment"?"Truck":"Wrench")" />@status</span><strong>@Fleet.Count(v=>v.Status==status)</strong><small>@(status=="Available"?"Ready in the demo roster":status=="On assignment"?"Illustrative transport activity":"Not available in the demo roster")</small></MudCard>}</section>
<div class="am-notice"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>Fictional fleet records for interface demonstration. Vehicle status and assignments are sample data; this page does not dispatch vehicles or track live locations.</p><span>Demo fleet</span></div>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mb-5">@Notice</MudAlert>}
<div class="am-layout"><section class="am-directory"><div class="am-heading"><span class="am-eyebrow">Vehicles &amp; readiness</span><h2>Ambulance directory <small>@Visible.Count()</small></h2><p>Review vehicle details and service status.</p></div><div class="am-tabs">@foreach(var status in new[]{"All"}.Concat(Statuses)){<button type="button" class="@(Status==status?"selected":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@(status=="All"?"All vehicles":status)<span>@Fleet.Count(v=>status=="All"||v.Status==status)</span></button>}</div><div class="am-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search fleet" Placeholder="Search vehicle, crew, or station..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Vehicle type" @bind="Type"><option value="All">All vehicle types</option>@foreach(var type in Fleet.Select(v=>v.Type).Distinct()){<option>@type</option>}</select></div>
<div class="am-grid">@foreach(var vehicle in Visible){<MudCard Class="am-card rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div class="am-card-top"><span class="am-vehicle-icon"><MudIcon Icon="@RynzoIcons.Get("Truck")" /></span><span class="am-status @StatusClass(vehicle.Status)"><i></i>@vehicle.Status</span></div><span class="am-eyebrow">@vehicle.Id</span><h3>@vehicle.Name</h3><p class="am-type">@vehicle.Type</p><dl><div><dt><MudIcon Icon="@RynzoIcons.Get("MapPin")" />Base station</dt><dd>@vehicle.Station</dd></div><div><dt><MudIcon Icon="@RynzoIcons.Get("Users")" />Crew lead</dt><dd>@vehicle.Crew</dd></div></dl><div class="am-card-footer"><span>@vehicle.Plate</span><MudButton Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Vehicle {vehicle.Id}")" OnClick="@(()=>Selected=vehicle)">View details</MudButton></div></MudCard>}</div>
@if(!Visible.Any()){<div class="am-empty"><h3>No matching vehicles</h3><p>Try another station, crew, status, or vehicle type.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}<div class="am-footer">Showing @Visible.Count() of @Fleet.Length sample vehicles</div></section>
<aside class="am-sidebar"><section><span class="am-eyebrow">Demo activity</span><h2>Service assignments</h2>@foreach(var vehicle in Fleet.Where(v=>v.Status=="On assignment")){<button type="button" class="am-assignment" @onclick="@(()=>Selected=vehicle)"><span class="am-assignment-dot"></span><span><b>@vehicle.Name</b><small>@vehicle.Assignment</small><small>@vehicle.Station</small></span><MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></button>}</section><section class="am-context"><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /></span><h2>Fleet information</h2><p>Assignments and stations are fictional examples. No patient transport records, telemetry, or emergency service connection is available.</p><div><small>Data source</small><b>Local demonstration records</b></div><div><small>Operations</small><b>Read-only fleet preview</b></div></section></aside></div></div>
<MudDialog Visible="@(Selected is not null)" VisibleChanged="@(v=>{if(!v)Selected=null;})" Options="Options"><TitleContent><MudText Typo="Typo.h6">Vehicle details</MudText></TitleContent><DialogContent>@if(Selected is {} vehicle){<div class="am-detail"><span class="am-eyebrow">@vehicle.Id / Fictional fleet record</span><h2>@vehicle.Name</h2><span class="am-status @StatusClass(vehicle.Status)"><i></i>@vehicle.Status</span><dl>@foreach(var field in new[]{("Vehicle type",vehicle.Type),("Registration",vehicle.Plate),("Base station",vehicle.Station),("Crew lead",vehicle.Crew),("Assignment",vehicle.Assignment)}){<div><dt>@field.Item1</dt><dd>@field.Item2</dd></div>}</dl><p>Sample vehicle information only. No live locations or dispatch actions are connected.</p></div>}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>Selected=null)">Close</MudButton></DialogActions></MudDialog>
@code {
 private sealed record Vehicle(string Id,string Name,string Plate,string Type,string Station,string Crew,string Status,string Assignment);
 private static readonly Vehicle[] Fleet=[new("AMB-101","Response unit 01","DEMO-101","Advanced support","Central campus","Alex Morgan","Available","No current assignment"),new("AMB-102","Response unit 02","DEMO-102","Basic support","North station","Jordan Lee","On assignment","Sample inter-facility transfer"),new("AMB-103","Transport unit 03","DEMO-103","Patient transport","Central campus","Casey Taylor","Available","No current assignment"),new("AMB-104","Response unit 04","DEMO-104","Advanced support","East station","Riley Parker","Maintenance","Scheduled service inspection"),new("AMB-105","Transport unit 05","DEMO-105","Patient transport","North station","Sam Rivera","On assignment","Sample scheduled transport"),new("AMB-106","Response unit 06","DEMO-106","Basic support","East station","Jamie Brooks","Available","No current assignment")];
 private static readonly string[] Statuses=["Available","On assignment","Maintenance"];private string Query="",Status="All",Type="All",Notice="";private Vehicle? Selected;private IJSObjectReference? Download;private static readonly DialogOptions Options=new(){MaxWidth=MaxWidth.Small,FullWidth=true};
 private IEnumerable<Vehicle> Visible=>Fleet.Where(v=>$"{v.Id} {v.Name} {v.Plate} {v.Crew} {v.Station}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Status=="All"||v.Status==Status)&&(Type=="All"||v.Type==Type));private static string StatusClass(string status)=>status=="Available"?"available":status=="On assignment"?"assigned":"maintenance";private void Reset(){Query="";Status=Type="All";}
 private async Task Export(){static string Quote(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new[]{new[]{"Reference","Vehicle","Registration","Type","Station","Crew lead","Status","Sample assignment"}}.Concat(Visible.Select(v=>new[]{v.Id,v.Name,v.Plate,v.Type,v.Station,v.Crew,v.Status,v.Assignment}));var csv=string.Join("\r\n",rows.Select(r=>string.Join(",",r.Select(Quote))));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","sample-ambulance-fleet.csv",csv,"text/csv;charset=utf-8");Notice="Filtered sample fleet exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
