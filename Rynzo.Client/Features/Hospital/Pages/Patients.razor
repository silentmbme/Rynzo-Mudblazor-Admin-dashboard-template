@page "/hospital/patients"
@using Rynzo.Client.Features.Hospital.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Patients | Rynzo</PageTitle>
<div class="patients-workspace">
<DashboardPageHeader Title="Patients" Description="Manage fictional patient directory records and visit details."><Actions><div><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export patients</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenAdd">Add patient</MudButton></div></Actions></DashboardPageHeader>
<section class="pt-overview" aria-label="Patient overview"><MudCard Class="pt-total rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="pt-overview-icon"><MudIcon Icon="@RynzoIcons.Get("Users")" /></span><div><span>Total records</span><strong>@State.Patients.Count</strong><small>Fictional patient directory</small></div><span class="pt-year">2026</span></MudCard><MudCard Style="--tone:var(--success)" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="pt-overview-icon"><MudIcon Icon="@RynzoIcons.Get("Activity")" /></span><div><span>Outpatient</span><strong>@State.Patients.Count(p=>p.Status=="Outpatient")</strong><small>Outpatient records</small></div></MudCard><MudCard Style="--tone:var(--info)" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="pt-overview-icon"><MudIcon Icon="@RynzoIcons.Get("BedDouble")" /></span><div><span>Inpatient</span><strong>@State.Patients.Count(p=>p.Status=="Inpatient")</strong><small>Inpatient records</small></div></MudCard><MudCard Style="--tone:var(--warning)" Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="pt-overview-icon"><MudIcon Icon="@RynzoIcons.Get("Hospital")" /></span><div><span>Departments</span><strong>@Departments.Count</strong><small>Care specialties represented</small></div></MudCard></section>
<div class="pt-notice"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>Fictional hospital workspace <span>•</span> 2026 sample records. Edits last for this page session.</p><span>Demo data</span></div>
<section class="pt-departments" aria-label="Care departments"><div class="pt-departments-heading"><span class="pt-eyebrow">Care departments</span><span>Select a specialty to focus the register</span></div><div class="pt-department-grid">@foreach(var department in Departments){<button type="button" class="@(Department==department?"selected":"")" style="@($"--tone:var(--{DepartmentTone(department)})")" aria-label="@($"Department {department}")" aria-pressed="@(Department==department)" @onclick="@(()=>Department=Department==department?"All":department)"><span class="pt-department-icon"><MudIcon Icon="@RynzoIcons.Get(department=="Cardiology"?"Heart":department=="Orthopedics"?"Activity":department=="Pediatrics"?"Users":"Hospital")" /></span><span><b>@department</b><small>@State.Patients.Count(p=>p.Department==department) patient records</small></span><MudIcon Icon="@RynzoIcons.Get("ChevronRight")" /></button>}</div></section>
@if(!string.IsNullOrWhiteSpace(Notice)){<MudAlert Severity="Severity.Success" Class="mb-5" role="status">@Notice</MudAlert>}
<section class="pt-directory" aria-label="Patients register"><div class="pt-directory-heading"><div><span class="pt-eyebrow">Patient management</span><h2>Patients register <span>@Visible.Count()</span></h2><p>Find a record and review patient details in one place.</p></div><span class="pt-heading-icon"><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" /></span></div><div class="pt-toolbar"><div class="pt-tabs" aria-label="Patient status">@foreach(var status in new[]{"All","Outpatient","Inpatient"}){<button type="button" class="@(Status==status?"selected":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@(status=="All"?"All patients":status)<span>@State.Patients.Count(p=>status=="All"||p.Status==status)</span></button>}</div><div class="pt-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search patients" Placeholder="Search name, specialty, or reference…" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Filter patient department" @bind="Department"><option value="All">All departments</option>@foreach(var department in Departments){<option>@department</option>}</select></div></div>
<div class="pt-table-scroll"><table class="pt-table"><thead><tr><th>Patient record</th><th>Department</th><th>Age</th><th>Contact</th><th>Status</th><th><span class="pt-sr-only">Actions</span></th></tr></thead><tbody>@foreach(var patient in Visible){<tr><td><div class="pt-person"><img src="@patient.Image" alt="@patient.Name" loading="lazy" /><div><b>@patient.Name</b><small>@patient.Id</small></div></div></td><td><span class="pt-department-label" style="@($"--tone:var(--{DepartmentTone(patient.Department)})")"><i></i>@patient.Department</span></td><td><span class="pt-age">@patient.Age <small>years</small></span></td><td><a class="pt-contact" href="@($"tel:{patient.Contact}")"><MudIcon Icon="@RynzoIcons.Get("Phone")" />@patient.Contact</a></td><td><span class="pt-status @patient.Status.ToLowerInvariant()"><i></i>@patient.Status</span></td><td><MudButton Variant="Variant.Text" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Patient {patient.Id}")" OnClick="@(()=>Selected=patient)">View profile</MudButton></td></tr>}</tbody></table></div>
@if(!Visible.Any()){<div class="pt-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No records match these filters</h3><p>Try another name, specialty, reference, or contact.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Clear filters</MudButton></div>}
<div class="pt-directory-footer"><span>Showing <b>@Visible.Count()</b> of @State.Patients.Count fictional patient records</span><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /> Session directory</span></div></section>
</div>
<MudDialog @bind-Visible="ProfileVisible" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">Patient profile</MudText></TitleContent><DialogContent>@if(Selected is {} profilePatient){<div class="pt-profile"><div class="pt-profile-hero"><img src="@profilePatient.Image" alt="@profilePatient.Name" /><span class="pt-eyebrow">@profilePatient.Id · Fictional sample record</span><h2>@profilePatient.Name</h2><span class="pt-status @profilePatient.Status.ToLowerInvariant()"><i></i>@profilePatient.Status</span></div><h3>Patient details</h3><dl class="pt-details"><div><dt><MudIcon Icon="@RynzoIcons.Get("Hospital")" />Department</dt><dd>@profilePatient.Department</dd></div><div><dt><MudIcon Icon="@RynzoIcons.Get("Activity")" />Status</dt><dd>@profilePatient.Status</dd></div><div><dt><MudIcon Icon="@RynzoIcons.Get("UserRound")" />Age</dt><dd>@profilePatient.Age years</dd></div><div><dt><MudIcon Icon="@RynzoIcons.Get("Phone")" />Contact</dt><dd><a href="@($"tel:{profilePatient.Contact}")">@profilePatient.Contact</a></dd></div></dl><p class="pt-dialog-note">Fictional patient record for this sample workspace. Changes apply to this page session.</p></div>}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>Selected=null)">Close</MudButton></DialogActions></MudDialog>
<MudDialog @bind-Visible="AddOpen" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">Add patient</MudText></TitleContent><DialogContent><div class="pt-create"><div class="pt-create-intro"><span><MudIcon Icon="@RynzoIcons.Get("Hospital")" /></span><div><h2>New patient record</h2><p>Create a fictional record for this page session.</p></div></div><label for="pt-name">Patient name</label><MudTextField T="string" @bind-Value="DraftName" InputId="pt-name" Immediate="true" aria-label="Patient name" Placeholder="Enter full name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="80" /><label for="pt-age">Age</label><MudNumericField T="int" @bind-Value="DraftAge" InputId="pt-age" Immediate="true" aria-label="Age" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="120" /><label for="pt-department">Department</label><select id="pt-department" aria-label="Department" @bind="DraftDepartment">@foreach(var department in Departments){<option>@department</option>}</select><label for="pt-contact">Contact</label><MudTextField T="string" @bind-Value="DraftContact" InputId="pt-contact" Immediate="true" aria-label="Contact" Placeholder="Enter contact number" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="80" /><p class="pt-dialog-note">New records are added as outpatients using the sample patient portrait.</p>@if(!string.IsNullOrWhiteSpace(Error)){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}</div></DialogContent><DialogActions><MudButton OnClick="@(()=>AddOpen=false)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="Add">Save patient</MudButton></DialogActions></MudDialog>
@code {
    private readonly PatientDirectoryState State=new(); private string Query="",Status="All",Department="All",DraftName="",DraftContact="",DraftDepartment="General Medicine",Notice="",Error=""; private int DraftAge=30; private bool AddOpen; private PatientRecord? Selected; private IJSObjectReference? Download;
    private static readonly DialogOptions DialogOptions=new(){MaxWidth=MaxWidth.Small,FullWidth=true}; private static string DepartmentTone(string department)=>department switch{"Cardiology"=>"destructive","General Medicine"=>"primary","Orthopedics"=>"info",_=>"warning"};
    private IReadOnlyList<string> Departments=>State.Patients.Select(patient=>patient.Department).Distinct().Order().ToArray();
    private IEnumerable<PatientRecord> Visible=>State.Patients.Where(patient=>$"{patient.Name} {patient.Id} {patient.Department} {patient.Contact}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Status=="All"||patient.Status==Status)&&(Department=="All"||patient.Department==Department));
    private bool ProfileVisible {get=>Selected is not null;set{if(!value)Selected=null;}}
    private void OpenAdd(){DraftName="";DraftContact="";DraftAge=30;DraftDepartment="General Medicine";Error="";AddOpen=true;} private void Reset(){Query="";Status=Department="All";}
    private void Add(){Error=State.Add(DraftName,DraftAge,DraftContact,DraftDepartment)??"";if(Error.Length>0)return;Notice=$"PAT-{State.Patients.Max(patient=>int.Parse(patient.Id[4..]))} added to the fictional directory.";AddOpen=false;}
    private async Task Export(){var rows=Visible.ToArray();Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","hospital-patients.csv",State.Csv(rows),"text/csv;charset=utf-8");Notice=$"Exported {rows.Length} filtered sample records.";}
    public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}


