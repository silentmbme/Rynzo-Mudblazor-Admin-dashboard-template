@page "/hospital/billing"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@using System.Globalization
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Hospital Billing | Rynzo</PageTitle>
<div class="billing-page"><DashboardPageHeader Title="Billing" Description="Review sample patient invoices, charge breakdowns, and outstanding balances."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export billing</MudButton></Actions></DashboardPageHeader>
<section class="bl-summary">@foreach(var metric in new[]{("Total billed",Money(Bills.Sum(b=>b.Total)),"ClipboardList"),("Recorded payments",Money(Bills.Sum(b=>b.Paid)),"Check"),("Outstanding balance",Money(Bills.Sum(b=>b.Balance)),"Wallet"),("Invoices",Bills.Length.ToString(),"Hospital")}){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get(metric.Item3)" />@metric.Item1</span><strong>@metric.Item2</strong><small>Fictional billing records / USD</small></MudCard>}</section>
<div class="bl-notice"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p>Demonstration invoices only. Charges and payment amounts are fictional; no billing, payment, or insurance service is connected.</p><span>Demo data</span></div>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mb-5">@Notice</MudAlert>}
<div class="bl-layout"><MudCard Class="bl-register rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="bl-heading"><span class="bl-eyebrow">Patient accounts</span><h2>Billing register <small>@Visible.Count()</small></h2><p>Review itemized charges and sample account balances.</p></div><div class="bl-tabs">@foreach(var status in new[]{"All","Unpaid","Part paid","Paid"}){<button type="button" class="@(Status==status?"selected":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@(status=="All"?"All invoices":status)<span>@Bills.Count(b=>status=="All"||b.Status==status)</span></button>}</div><div class="bl-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search billing" Placeholder="Search patient or invoice..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Billing department" @bind="Department"><option value="All">All departments</option>@foreach(var department in Bills.Select(b=>b.Department).Distinct()){<option>@department</option>}</select></div>
<div class="bl-table-scroll"><table><thead><tr><th>Patient / Invoice</th><th>Department</th><th>Due date</th><th class="number">Total</th><th class="number">Balance</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var bill in Visible){<tr><td><b>@bill.Patient</b><small>@bill.Id</small></td><td>@bill.Department</td><td>@bill.Due</td><td class="number">@Money(bill.Total)</td><td class="number"><b>@Money(bill.Balance)</b></td><td><span class="bl-status @StatusClass(bill.Status)"><i></i>@bill.Status</span></td><td><MudButton Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Invoice {bill.Id}")" OnClick="@(()=>Selected=bill)">View invoice</MudButton></td></tr>}</tbody>@if(Visible.Any()){<tfoot><tr><td colspan="3">Current view totals</td><td class="number">@Money(Visible.Sum(b=>b.Total))</td><td class="number">@Money(Visible.Sum(b=>b.Balance))</td><td colspan="2">@Visible.Count() invoices</td></tr></tfoot>}</table></div>
@if(!Visible.Any()){<div class="bl-empty"><h3>No matching invoices</h3><p>Try another patient, department, or status.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}<div class="bl-footer">Showing @Visible.Count() of @Bills.Length sample invoices</div></MudCard>
<aside class="bl-sidebar"><section><span class="bl-eyebrow">Balance overview</span><h2>Outstanding accounts</h2><p>Sample invoices with a remaining balance.</p>@foreach(var bill in Bills.Where(b=>b.Balance>0).OrderByDescending(b=>b.Balance).Take(3)){<button type="button" @onclick="@(()=>Selected=bill)"><span><b>@bill.Patient</b><small>@bill.Id / @bill.Status</small></span><strong>@Money(bill.Balance)</strong></button>}</section><section class="bl-context"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /><h2>Billing context</h2><p>Balances equal total charges minus recorded sample payments. These records do not calculate taxes, insurance coverage, or patient responsibility.</p><span>Read-only demonstration</span></section></aside></div></div>
<MudDialog Visible="@(Selected is not null)" VisibleChanged="@(v=>{if(!v)Selected=null;})" Options="Options"><TitleContent><MudText Typo="Typo.h6">Invoice details</MudText></TitleContent><DialogContent>@if(Selected is {} bill){<div class="bl-detail"><div class="bl-detail-header"><div><span class="bl-eyebrow">@bill.Id / Sample invoice</span><h2>@bill.Patient</h2><p>@bill.Department</p></div><span class="bl-status @StatusClass(bill.Status)"><i></i>@bill.Status</span></div><div class="bl-dates"><div><small>Issued</small><b>@bill.Issued</b></div><div><small>Due date</small><b>@bill.Due</b></div></div><h3>Charge breakdown</h3>@foreach(var charge in bill.Charges){<div class="bl-charge"><span>@charge.Label</span><b>@Money(charge.Amount)</b></div>}<div class="bl-charge total"><span>Total charges</span><b>@Money(bill.Total)</b></div><div class="bl-charge"><span>Recorded sample payments</span><b>@Money(bill.Paid)</b></div><div class="bl-balance"><span>Outstanding balance</span><strong>@Money(bill.Balance)</strong></div><p class="bl-detail-note">Fictional amounts for interface demonstration. No payment is requested or processed.</p></div>}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>Selected=null)">Close</MudButton></DialogActions></MudDialog>
@code {
 private sealed record Charge(string Label,int Amount);private sealed record Bill(string Id,string Patient,string Department,string Issued,string Due,int Paid,Charge[] Charges){public int Total=>Charges.Sum(c=>c.Amount);public int Balance=>Total-Paid;public string Status=>Balance==0?"Paid":Paid>0?"Part paid":"Unpaid";}
 private static readonly Bill[] Bills=[new("BIL-101","Olivia Bennett","General Medicine","2026-10-09","2026-10-23",100,[new("Consultation",120),new("Sample diagnostics",180)]),new("BIL-102","Liam Carter","Cardiology","2026-10-09","2026-10-23",450,[new("Specialist consultation",200),new("Sample diagnostics",250)]),new("BIL-103","Emma Davis","Pediatrics","2026-10-10","2026-10-24",0,[new("Consultation",100),new("Sample diagnostics",80)]),new("BIL-104","Noah Williams","Orthopedics","2026-10-10","2026-10-24",200,[new("Specialist consultation",180),new("Sample imaging",320)]),new("BIL-105","Sophia Miller","General Medicine","2026-10-11","2026-10-25",150,[new("Consultation",100),new("Sample diagnostics",50)]),new("BIL-106","Ethan Reed","Cardiology","2026-10-11","2026-10-25",0,[new("Specialist consultation",200),new("Sample diagnostics",150)])];
 private string Query="",Status="All",Department="All",Notice="";private Bill? Selected;private IJSObjectReference? Download;private static readonly DialogOptions Options=new(){MaxWidth=MaxWidth.Small,FullWidth=true};private static string Money(int value)=>value.ToString("C0",CultureInfo.GetCultureInfo("en-US"));private static string StatusClass(string status)=>status=="Paid"?"paid":status=="Part paid"?"partial":"unpaid";
 private IEnumerable<Bill> Visible=>Bills.Where(b=>$"{b.Patient} {b.Id}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Status=="All"||b.Status==Status)&&(Department=="All"||b.Department==Department));private void Reset(){Query="";Status=Department="All";}
 private async Task Export(){static string Quote(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new[]{new[]{"Invoice","Patient","Department","Issued","Due","Total USD","Paid USD","Balance USD","Status"}}.Concat(Visible.Select(b=>new[]{b.Id,b.Patient,b.Department,b.Issued,b.Due,b.Total.ToString(),b.Paid.ToString(),b.Balance.ToString(),b.Status}));var csv=string.Join("\r\n",rows.Select(r=>string.Join(",",r.Select(Quote))));Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","sample-hospital-billing.csv",csv,"text/csv;charset=utf-8");Notice="Filtered sample invoices exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
