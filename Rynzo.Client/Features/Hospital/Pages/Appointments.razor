@page "/hospital/appointments"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Features.Dashboard.Services
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Appointments | Rynzo</PageTitle>
<div class="appointments-page">
<DashboardPageHeader Title="Appointments" Description="Coordinate patient visits, review the schedule, and manage arrivals."><Actions><div><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export appointments</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenBooking">New appointment</MudButton></div></Actions></DashboardPageHeader>
<section class="ap-metrics">@foreach(var item in new[]{("Appointments",State.Appointments.Count,"CalendarDays"),("Scheduled",State.Appointments.Count(a=>a.Status=="Scheduled"),"Clock3"),("Checked in",State.Appointments.Count(a=>a.Status=="Checked in"),"UserCheck"),("Completed",State.Appointments.Count(a=>a.Status=="Completed"),"Check")}){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span><MudIcon Icon="@RynzoIcons.Get(item.Item3)" />@item.Item1</span><strong>@item.Item2</strong><small>Sample appointment records</small></MudCard>}</section>
<p class="ap-notice"><MudIcon Icon="@RynzoIcons.Get("Info")" />Fictional hospital workspace. Bookings and check-ins apply to this page session; no notifications are sent.</p>
@if(Notice.Length>0){<MudAlert Severity="Severity.Success" role="status" Class="mb-5">@Notice</MudAlert>}
<MudCard Class="ap-register rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="ap-heading"><span class="ap-eyebrow">Visits &amp; arrivals</span><h2>Appointment schedule <small>@Visible.Count()</small></h2><p>Patient details, care teams, and visit status in one place.</p></div><div class="ap-tabs">@foreach(var status in new[]{"All"}.Concat(State.Appointments.Select(a=>a.Status).Distinct())){<button type="button" class="@(Status==status?"selected":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@status <span>@State.Appointments.Count(a=>status=="All"||a.Status==status)</span></button>}</div><div class="ap-filters"><MudTextField T="string" @bind-Value="Query" Immediate="true" aria-label="Search appointments" Placeholder="Search patient, reference, or department..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Appointment department" @bind="Department"><option value="All">All departments</option>@foreach(var department in State.Source.Departments){<option>@department.Name</option>}</select><input type="date" aria-label="Filter appointment date" value="@Date" @onchange="@(e=>Date=e.Value?.ToString()??"")" />@if(Date.Length>0){<MudButton Size="Size.Small" OnClick="@(()=>Date="")">Clear date</MudButton>}</div>
<div class="ap-table-scroll"><table><thead><tr><th>Patient</th><th>Care team</th><th>Visit date</th><th>Visit type</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var appointment in Visible){var doctor=Doctor(appointment.DoctorId);<tr><td><b>@appointment.Patient</b><small>@appointment.Id @(appointment.Age is {} age?$" / {age} years":"")</small></td><td><div class="ap-doctor"><HospitalDoctorPortrait Doctor="doctor" Small="true" /><span><b>@doctor.Name</b><small>@appointment.Department</small></span></div></td><td><b>@appointment.Time</b><small>@appointment.Date</small></td><td>@appointment.Type</td><td><span class="ap-status @StatusClass(appointment.Status)"><i></i>@appointment.Status</span></td><td><div class="ap-row-actions"><MudButton Size="Size.Small" aria-label="@($"Details {appointment.Id}")" OnClick="@(()=>SelectedId=appointment.Id)">Details</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(appointment.Status!="Scheduled")" aria-label="@($"Check in {appointment.Id}")" OnClick="@(()=>CheckIn(appointment.Id))">Check in</MudButton></div></td></tr>}</tbody></table></div>
@if(!Visible.Any()){<div class="ap-empty"><h3>No matching appointments</h3><p>Try another patient, date, department, or status.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}
<div class="ap-footer">Showing @Visible.Count() of @State.Appointments.Count appointments <span>Demo data / Session register</span></div></MudCard></div>
<MudDialog Visible="@(Selected is not null)" VisibleChanged="@(v=>{if(!v)SelectedId=null;})" Options="Options"><TitleContent><MudText Typo="Typo.h6">Appointment details</MudText></TitleContent><DialogContent>@if(Selected is {} appointment){<div class="ap-detail"><span class="ap-eyebrow">@appointment.Id / Fictional visit record</span><h2>@appointment.Patient</h2><span class="ap-status @StatusClass(appointment.Status)"><i></i>@appointment.Status</span><dl>@foreach(var field in new[]{("Doctor",Doctor(appointment.DoctorId).Name),("Department",appointment.Department),("Date",appointment.Date),("Time",appointment.Time),("Visit type",appointment.Type),("Age",appointment.Age?.ToString()??"Not provided")}){<div><dt>@field.Item1</dt><dd>@field.Item2</dd></div>}</dl><p>Sample patient visit information. Changes remain in this page session.</p></div>}</DialogContent><DialogActions><MudButton OnClick="@(()=>SelectedId=null)">Close</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Selected?.Status!="Scheduled")" OnClick="@(()=>CheckIn(SelectedId!))">Check in</MudButton></DialogActions></MudDialog>
<MudDialog @bind-Visible="Booking" Options="Options"><TitleContent><MudText Typo="Typo.h6">New appointment</MudText></TitleContent><DialogContent><div class="ap-form"><p>Sample booking. Changes last for this page session.</p><label>Patient name</label><MudTextField T="string" @bind-Value="State.Booking.Patient" Immediate="true" aria-label="Patient name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="80" /><label>Doctor</label><select aria-label="Appointment doctor" @bind="State.Booking.DoctorId">@foreach(var doctor in State.Source.Doctors.Where(d=>d.Available)){<option value="@doctor.Id">@doctor.Name  -  @doctor.Department</option>}</select><label>Date</label><input type="date" aria-label="Appointment date" min="2026-10-09" value="@State.Booking.Date" @onchange="@(e=>State.Booking.Date=e.Value?.ToString()??"")" /><label>Time</label><input type="time" aria-label="Appointment time" value="@State.Booking.Time" @onchange="@(e=>State.Booking.Time=NormalizeTime(e.Value?.ToString()??""))" /><label>Visit type</label><select aria-label="Visit type" @bind="State.Booking.Type"><option>Consultation</option><option>Follow-up</option></select>@if(Error.Length>0){<MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@Error</MudAlert>}</div></DialogContent><DialogActions><MudButton OnClick="@(()=>Booking=false)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save appointment</MudButton></DialogActions></MudDialog>
@code {
 private readonly HospitalDashboardState State=new();private string Query="",Department="All",Status="All",Date="",Notice="",Error="";private string? SelectedId;private bool Booking;private IJSObjectReference? Download;private static readonly DialogOptions Options=new(){MaxWidth=MaxWidth.Small,FullWidth=true};
 private HospitalAppointment? Selected=>State.Appointments.FirstOrDefault(a=>a.Id==SelectedId);private HospitalDoctor Doctor(string id)=>State.Source.Doctors.Single(d=>d.Id==id);
 private IEnumerable<HospitalAppointment> Visible=>State.Appointments.Where(a=>$"{a.Patient} {a.Id} {a.Department}".Contains(Query.Trim(),StringComparison.OrdinalIgnoreCase)&&(Department=="All"||a.Department==Department)&&(Status=="All"||a.Status==Status)&&(Date.Length==0||a.Date==Date)).OrderBy(a=>a.Date).ThenBy(a=>a.Time);
 private static string StatusClass(string status)=>status=="Scheduled"?"scheduled":status=="Checked in"?"checked":"completed";
 private static string NormalizeTime(string value)=>value.Length>=5?value[..5]:value;
 private void Reset(){Query=Date="";Department=Status="All";}private void OpenBooking(){State.OpenBooking();Booking=true;Error="";}private void Save(){Error=State.Book()??"";if(Error.Length>0)return;Booking=false;Notice="Sample appointment added. No notifications are sent.";}private void CheckIn(string id){if(State.CheckIn(id))Notice=$"{id} checked in locally.";}
 private async Task Export(){Download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await Download.InvokeVoidAsync("download","hospital-appointments.csv",State.Csv(Visible),"text/csv;charset=utf-8");Notice="Filtered appointments exported.";}
 public async ValueTask DisposeAsync(){if(Download is not null){try{await Download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
