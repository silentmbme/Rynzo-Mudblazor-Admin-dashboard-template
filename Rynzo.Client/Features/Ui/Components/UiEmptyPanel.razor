@using Rynzo.Client.Theme
<div class="ui-empty-panel @(Compact?"is-compact":"") @Class" style="@($"--empty-tone:{Tone}")">
    <div class="ui-empty-art" aria-hidden="true"><i></i><span><MudIcon Icon="@RynzoIcons.Get(Icon)" /></span><i></i></div>
    <div class="ui-empty-copy"><h3>@Title</h3><p>@Description</p>@if(Hint is not null){<small>@Hint</small>}</div>
    @if(Actions is not null){<div class="ui-empty-actions">@Actions</div>}
</div>
@code {
    [Parameter] public string Title {get;set;}="";
    [Parameter] public string Description {get;set;}="";
    [Parameter] public string Icon {get;set;}="Folder";
    [Parameter] public string Tone {get;set;}="var(--primary)";
    [Parameter] public string? Hint {get;set;}
    [Parameter] public string? Class {get;set;}
    [Parameter] public bool Compact {get;set;}
    [Parameter] public RenderFragment? Actions {get;set;}
}
