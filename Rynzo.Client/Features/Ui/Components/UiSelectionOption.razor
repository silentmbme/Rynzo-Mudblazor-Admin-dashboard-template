@using Rynzo.Client.Theme
<label class="ui-selection-option @Style @(Disabled?"is-disabled":"") @(Checked?"is-checked":"")" style="@($"--selection-tone:{Tone};--selection-contrast:{Contrast}")">
    <input type="@Kind" name="@Name" value="@Value" checked="@Checked" disabled="@Disabled" aria-label="@Label" @onchange="Change" />
    @if(Icon is not null){<span class="ui-selection-icon"><MudIcon Icon="@RynzoIcons.Get(Icon)" /></span>}
    <span class="ui-selection-label">@Label</span>
</label>
@code {
    [Parameter] public string Label {get;set;}="";
    [Parameter] public string Kind {get;set;}="checkbox";
    [Parameter] public string? Name {get;set;}
    [Parameter] public string? Value {get;set;}
    [Parameter] public string Style {get;set;}="";
    [Parameter] public string Tone {get;set;}="var(--primary)";
    [Parameter] public string Contrast {get;set;}="var(--primary-foreground)";
    [Parameter] public bool Checked {get;set;}
    [Parameter] public bool Disabled {get;set;}
    [Parameter] public string? Icon {get;set;}
    [Parameter] public EventCallback<bool> CheckedChanged {get;set;}
    private Task Change(ChangeEventArgs args)=>CheckedChanged.InvokeAsync(args.Value is true);
}
