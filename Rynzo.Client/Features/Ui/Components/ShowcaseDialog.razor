@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
<MudDialog Class="@(Mode=="sheet"?"sample-side-sheet":null)" Style="@(Mode=="sheet"?"position:fixed;inset-block:0;inset-inline-end:0;margin:0;height:100dvh;max-height:100dvh;max-width:min(480px,100vw);width:100%;border-radius:0":null)"><TitleContent><div class="sample-dialog-heading"><span class="sample-dialog-icon @(Danger?"danger":"")"><MudIcon Icon="@RynzoIcons.Get(Icon)" /></span><div><small>Dialog / Workspace example</small><MudText Typo="Typo.h6">@Title</MudText></div></div></TitleContent><DialogContent><div class="sample-dialog-body">
@if(Mode=="basic"){<p>This is a normal dialog with simple text and actions.</p>}
else if(Mode=="confirm"){<p>Are you sure you want to archive this project? You can restore it later.</p>}
else if(Mode=="delete"){<div class="sample-callout danger">This item will be removed permanently. This demo does not modify real data.</div>}
else if(Mode=="confirm-delete"){<p>Website Redesign and its local demo data will be removed. This cannot be undone.</p><div class="sample-callout">This is a component demonstration. No real project is deleted.</div>}
else if(Mode=="confirm-publish"){<p>Your latest workspace changes will become visible to the team.</p>}
else if(Mode=="controlled"){<p>This dialog is opened from external component state.</p>}
else if(Mode=="form"){<div class="sample-fields"><label>Project name<input placeholder="Website Redesign" @bind="ProjectName" /></label><label>Owner<select @bind="Owner"><option>Sophia Carter</option><option>Daniel Lee</option></select></label></div>}
else if(Mode=="invite-form"){<div class="sample-fields"><label>Email address<input type="email" placeholder="teammate@company.com" @bind="Email" /></label><label>Role<select @bind="Role"><option>Member</option><option>Admin</option><option>Viewer</option></select></label><label>Personal message<textarea rows="3" placeholder="Welcome to the team!" @bind="Message"></textarea></label></div>}
else if(Mode=="wizard"){<div class="sample-steps">@for(var i=1;i<=3;i++){<span class="@(Step>=i?"active":"")"><b>@i</b>@(i==1?"Workspace":i==2?"Invite":"Ready")</span>}</div>@if(Step==1){<div class="sample-fields"><label>Workspace name<input placeholder="Rynzo workspace" @bind="Workspace" /></label><label>Team size<select @bind="TeamSize"><option>110 people</option><option>1150 people</option><option>51+ people</option></select></label></div>}else if(Step==2){<div class="sample-callout"><h3>Invite your first teammate</h3><p>You can always invite more people later.</p><div class="sample-fields"><label>Teammate email<input placeholder="name@company.com" @bind="Email" /></label></div></div>}else{<div class="sample-callout success"><MudIcon Icon="@RynzoIcons.Get("CheckCircle2")" /><h3>You are ready to go</h3><p>Your workspace is ready for projects and collaboration.</p></div>}}
else if(Mode=="command"){<div class="sample-fields"><label>Search commands<input aria-label="Search commands" placeholder="Type a command or search" @bind="Query" @bind:event="oninput" /></label></div><div class="sample-commands">@foreach(var command in Commands.Where(c=>c.Label.Contains(Query,StringComparison.OrdinalIgnoreCase))){<MudButton Variant="Variant.Text" StartIcon="@RynzoIcons.Get(command.Icon)" OnClick="@(()=>Complete(command.Label+" selected"))">@command.Label</MudButton>}@if(!Commands.Any(c=>c.Label.Contains(Query,StringComparison.OrdinalIgnoreCase))){<p>No matching commands.</p>}</div>}
else if(Mode=="details"||Mode=="sheet"){<div class="sample-project"><span>PRJ-1048</span><h3>Website Redesign</h3><UiStatusChip Color="Color.Success">Active</UiStatusChip></div><div class="sample-detail-grid">@foreach(var field in Mode=="sheet"?new[]{("Progress","82%"),("Tasks","48 / 62"),("Owner","Sophia"),("Budget","$68K")}:new[]{("Status","Active"),("Owner","Sophia Carter"),("Due date","Sep 10, 2026")}){<div><small>@field.Item1</small><b>@field.Item2</b></div>}</div>@if(Mode=="details"){<p>A focused project detail dialog for reviewing key information without leaving the current workspace.</p><div class="sample-chips"><UiStatusChip Color="Color.Success">Healthy</UiStatusChip><UiStatusChip Color="Color.Info">48 tasks</UiStatusChip><UiStatusChip>Design</UiStatusChip></div>}}
else if(Mode=="task"){<div class="sample-chips"><UiStatusChip Color="Color.Warning">High priority</UiStatusChip><UiStatusChip Color="Color.Info">In progress</UiStatusChip></div><p>Complete the responsive checkout review and document the remaining validation rules before QA handoff.</p><div class="sample-detail-grid">@foreach(var field in new[]{("Assignee","Daniel Lee"),("Due date","Aug 27"),("Project","Website Redesign")}){<div><small>@field.Item1</small><b>@field.Item2</b></div>}</div><div class="sample-callout"><h3>Activity</h3><p><b>Sophia Carter</b> added a review note 24 min ago</p><p><b>Daniel Lee</b> moved task to In progress 1 hour ago</p></div>}
else if(Mode=="scroll"){<div class="sample-releases">@for(var i=0;i<10;i++){<article><small>Release @((i+1).ToString("00"))</small><h3>v2.@(4-i).0 / @(new[]{"Custom fields","Improved filters","Workspace settings","New analytics","Performance updates"}[i%5])</h3><p>A concise summary of the improvements, fixes and refinements included in this release.</p></article>}</div>}
else if(Mode=="full"){<div class="sample-full-layout"><aside><h3>Navigation</h3>@foreach(var link in new[]{"Overview","Tasks","Files","Settings"}){<p class="@(link=="Tasks"?"active":"")">@link</p>}</aside><section><h3>Workspace tasks</h3><p>Use a full surface when users need uninterrupted focus.</p><div class="sample-detail-grid">@foreach(var field in new[]{("In progress","8"),("Ready for review","4"),("Completed","19")}){<div><small>@field.Item1</small><b>@field.Item2</b></div>}</div></section></div>}
else if(Mode=="warp"){<div class="sample-focus"><UiStatusChip Color="Color.Primary">Focus mode</UiStatusChip><h2>Welcome to your workspace</h2><p>A full-screen surface for a focused, high-impact action.</p></div><div class="sample-detail-grid">@foreach(var field in new[]{("Active projects","12"),("Team members","28"),("Tasks completed","84%")}){<div><small>@field.Item1</small><b>@field.Item2</b></div>}</div>}
else if(Mode.StartsWith("size-")){<p>This is the @Mode[5..].ToUpperInvariant() size for content with the appropriate amount of space.</p>}
</div></DialogContent><DialogActions>
@if(Mode=="wizard"){<MudButton Variant="Variant.Outlined" OnClick="Back">@(Step==1?"Cancel":"Back")</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Next">@(Step==3?"Finish":"Continue")</MudButton>}
else if(Mode=="command"||Mode=="scroll"||Mode=="details"||Mode=="full"||Mode=="warp"||Mode=="controlled"||Mode.StartsWith("size-")){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">@(Mode=="full"?"Exit workspace":Mode=="details"||Mode.StartsWith("size-")?"Done":Mode=="controlled"?"Close dialog":"Close")</MudButton>}
else{<MudButton Variant="Variant.Outlined" OnClick="Close">@(Mode=="task"||Mode=="sheet"?"Close":"Cancel")</MudButton><MudButton Variant="Variant.Filled" Color="@(Danger?Color.Error:Mode=="confirm-publish"?Color.Success:Color.Primary)" OnClick="Submit">@ActionLabel</MudButton>}
</DialogActions></MudDialog>
@code {
 [CascadingParameter] private IMudDialogInstance Dialog {get;set;}=null!;
 [Parameter] public string Mode {get;set;}="basic";
 private int Step=1;private string ProjectName="",Owner="Sophia Carter",Email="",Role="Member",Message="",Workspace="Rynzo",TeamSize="110 people",Query="";
 private bool Danger=>Mode is "delete" or "confirm-delete";
 private string Icon=>Danger?"Trash2":Mode switch{"wizard"=>"Sparkles","command"=>"Search","form"=>"Folder","invite-form"=>"UserPlus","task"=>"ListTodo","scroll"=>"FileText",_=>"PanelTop"};
 private string Title=>Mode switch{"basic"=>"Welcome back","confirm"=>"Confirm action","delete"=>"Delete item?","confirm-delete"=>"Delete project?","confirm-publish"=>"Publish changes?","form"=>"Add project","invite-form"=>"Invite teammate","wizard"=>"Workspace setup","command"=>"Command menu","task"=>"Finalize checkout flow","details"=>"Website Redesign","sheet"=>"Project details","scroll"=>"Changelog","full"=>"Workspace","warp"=>"Focus workspace","controlled"=>"Controlled dialog",_=>Mode.StartsWith("size-")?$"{Mode[5..].ToUpperInvariant()} dialog":"Dialog"};
 private string ActionLabel=>Mode switch{"basic"=>"Continue","confirm"=>"Confirm","delete"=>"Delete","confirm-delete"=>"Delete project","confirm-publish"=>"Publish","form"=>"Create project","invite-form"=>"Send invitation","task"=>"Mark complete","sheet"=>"Open project",_=>"Continue"};
 private static readonly (string Label,string Icon)[] Commands=[("Create project","Plus"),("Go to settings","Settings"),("Invite teammate","UserPlus"),("Open analytics","ChartNoAxesCombined")];
 private void Close()=>Dialog.Cancel();
 private void Complete(string message){Dialog.Close();Snackbar.Add(message,Severity.Success);}
 private void Submit()=>Complete(Mode switch{"basic"=>"Action completed","confirm"=>"Project archived","delete"=>"Item deleted","confirm-delete"=>"Project deleted","confirm-publish"=>"Changes published","form"=>"Project created","invite-form"=>"Invitation sent","task"=>"Task marked complete","sheet"=>"Project opened",_=>"Action completed"});
 private void Back(){if(Step==1)Close();else Step--;}
 private void Next(){if(Step==3)Complete("Workspace setup complete");else Step++;}
}
