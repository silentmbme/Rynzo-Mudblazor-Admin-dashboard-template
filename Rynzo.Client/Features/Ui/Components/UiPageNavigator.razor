@using Rynzo.Client.Theme
<nav class="ui-page-navigator" aria-label="@Label">
    <MudPagination Count="Count" Selected="Selected" SelectedChanged="SelectedChanged" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" BoundaryCount="1" MiddleCount="@(Compact?0:1)" BeforeIcon="@RynzoIcons.Get("ChevronLeft")" NextIcon="@RynzoIcons.Get("ChevronRight")" />
</nav>
@code {
    [Parameter] public int Count { get; set; } = 8;
    [Parameter] public int Selected { get; set; } = 1;
    [Parameter] public EventCallback<int> SelectedChanged { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string Label { get; set; } = "Pagination";
}
