@page "/forms/select-components"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Select components | Rynzo</PageTitle>
<div class="select-components-page">
    <DashboardPageHeader Title="Select components" Description="Single, grouped, searchable, and multi-value selection patterns."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Save")" OnClick="@(()=>Notify("Select preferences saved"))">Save settings</MudButton></Actions></DashboardPageHeader>
    <section class="select-section"><header class="select-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("ListFilter")" /></span><div><h2>Single selection</h2><p>Pick one value from a focused set of choices.</p></div></header><div class="select-grid">
        <FormElementCard Id="workspace" Title="Basic select" Description="A simple list for one workspace"><UiFormField Id="select-workspace" Label="Workspace" Hint="Select the workspace for this report."><MudSelect T="string" @bind-Value="Workspace" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("product")">Product</MudSelectItem><MudSelectItem Value="@("marketing")">Marketing</MudSelectItem><MudSelectItem Value="@("operations")">Operations</MudSelectItem></MudSelect></UiFormField><div class="select-workspace-preview"><span><MudIcon Icon="@RynzoIcons.Get("Layers")" /></span><div><small>Selected workspace</small><strong aria-live="polite">@Workspace</strong></div><UiStatusChip Color="Color.Primary">Selected</UiStatusChip></div></FormElementCard>
        <FormElementCard Id="grouped" Title="Grouped select" Description="Organize longer lists into recognizable groups"><UiFormField Id="select-location" Label="Location"><MudSelect T="string" @bind-Value="Location" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("sf")">San Francisco · United States</MudSelectItem><MudSelectItem Value="@("ny")">New York · United States</MudSelectItem><MudSelectItem Value="@("ldn")">London · Europe</MudSelectItem><MudSelectItem Value="@("ber")">Berlin · Europe</MudSelectItem></MudSelect></UiFormField><div class="select-location-note"><MudIcon Icon="@RynzoIcons.Get("MapPin")" /><div><b>Grouped by region</b><p>Groups reduce visual scanning time when options grow.</p></div></div></FormElementCard>
    </div></section>
    <section class="select-section"><header class="select-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("Search")" /></span><div><h2>Searchable &amp; rich selects</h2><p>Find a person or choose an option with more context.</p></div></header><div class="select-grid select-rich-grid">
        <FormElementCard Id="assignee" Title="Searchable assignee" Description="Filter people, then select an assignee"><UiFormField Id="select-people-search" Label="Search team members"><MudAutocomplete T="string" @bind-Value="Assignee" SearchFunc="SearchPeople" ToStringFunc="@(name=>name)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search people..." /></UiFormField><p class="select-caption" aria-live="polite">Assignee: <b>@Assignee</b></p></FormElementCard>
        <FormElementCard Id="details" Title="Select with details" Description="Supporting information clarifies each option"><UiFormField Id="select-country" Label="Billing country"><MudSelect T="string" @bind-Value="Country" Variant="Variant.Outlined" Margin="Margin.Dense">@foreach(var item in Countries){<MudSelectItem Value="@item.Value">@item.Name @item.Currency</MudSelectItem>}</MudSelect></UiFormField><div class="select-destination"><span class="select-destination-icon"><MudIcon Icon="@RynzoIcons.Get("MapPin")" /></span><small>Billing destination</small><h3 aria-live="polite">@CurrentCountry.Name</h3><UiStatusChip Color="Color.Primary">@CurrentCountry.Currency</UiStatusChip><p>Taxes and available payment methods update automatically.</p></div></FormElementCard>
    </div></section>
    <section class="select-section"><header class="select-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("Tags")" /></span><div><h2>Multi-select &amp; states</h2><p>Keep selected values visible and feedback easy to interpret.</p></div></header><div class="select-grid">
        <FormElementCard Id="tags" Title="Multi-select tags" Description="Add or remove the categories on this project"><div class="select-tags-heading"><span>Project categories</span><span aria-live="polite">@Tags.Count selected</span></div><div class="select-tag-values" role="group" aria-label="Selected project tags">@foreach(var tag in Tags.ToArray()){<MudChip T="string" Color="Color.Primary" Variant="Variant.Text" OnClose="@((MudChip<string> _)=>Tags.Remove(tag))" CloseIcon="@RynzoIcons.Get("X")">@tag</MudChip>}@if(Tags.Count==0){<span class="select-caption">No categories selected.</span>}</div><div class="select-tag-suggestions"><span>Suggested categories</span><div>@foreach(var tag in Suggestions.Where(tag=>!Tags.Contains(tag))){<MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(()=>Tags.Add(tag))">@tag</MudButton>}</div></div><p class="select-caption">Click a suggested tag to add it; use the close control to remove it.</p></FormElementCard>
        <FormElementCard Id="states" Title="Select states" Description="Disabled, error, and loading treatments"><div class="select-state-stack"><UiFormField Id="select-disabled" Label="Disabled select"><MudSelect T="string" Value="@("Not available")" Disabled="true" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("Not available")">Not available</MudSelectItem></MudSelect></UiFormField><UiFormField Id="select-required" Label="Required category"><MudSelect T="string" Error="true" ErrorText="Please choose a category." Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("Choose a category")">Choose a category</MudSelectItem></MudSelect></UiFormField><UiFormField Id="select-loading" Label="Loading options"><MudTextField T="string" Value="@("Loading teams...")" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@RynzoIcons.Get("LoaderCircle")" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField></div></FormElementCard>
    </div></section>
</div>
@code {
    private string Workspace="product",Location="sf",Assignee="Elena Marquez",Country="us";
    private readonly List<string> Tags=["Design","Product"];
    private static readonly string[] Suggestions=["Research","Engineering","Marketing"];
    private static readonly (string Name,string Photo)[] People=[("Elena Marquez","assets/images/users/user-1.jpg"),("Noah Bennett","assets/images/users/user-4.jpg"),("Sophie Turner","assets/images/users/user-3.jpg"),("Liam Walker","assets/images/users/user-2.jpg"),("Emma Brooks","assets/images/users/user-5.jpg")];
    private static readonly (string Value,string Name,string Currency)[] Countries=[("us","United States","USD"),("gb","United Kingdom","GBP"),("in","India","INR"),("de","Germany","EUR")];
    private Task<IEnumerable<string>> SearchPeople(string value,CancellationToken _)=>Task.FromResult(People.Where(person=>person.Name.Contains(value??"",StringComparison.OrdinalIgnoreCase)).Select(person=>person.Name));
    private (string Value,string Name,string Currency) CurrentCountry=>Countries.First(item=>item.Value==Country);
    private void ChoosePerson(string name){Assignee=name;Notify($"{name} selected");}
    private void Notify(string message)=>Snackbar.Add(message,Severity.Success);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
}
