@page "/forms/multi-step-wizard"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
<PageTitle>Multi-step wizard | Rynzo</PageTitle>
<div class="wizard-page">
<DashboardPageHeader Title="Multi-step wizard" Description="A focused setup flow with visible progress and review before completion."><Actions><MudButton Variant="Variant.Outlined" OnClick="Restart">Restart</MudButton></Actions></DashboardPageHeader>
<div class="wizard-layout"><aside class="wizard-steps">@for(var i=0;i<4;i++){var index=i;<button type="button" class="@(Step==index?"is-active":Step>index?"is-complete":"")" @onclick="@(()=>Step=index)"><span>@(index+1)</span><div><b>@StepTitles[index]</b><small>@StepCopy[index]</small></div></button>}</aside>
<FormElementCard Id="wizard" Title="@StepTitles[Step]" Description="@StepCopy[Step]"><div class="wizard-progress"><span>Step @(Step+1) of 4</span><MudProgressLinear Value="@((Step+1)*25)" Color="Color.Primary" /></div>
@if(Step==0){<div class="wizard-fields"><UiFormField Id="wizard-name" Label="Workspace name"><MudTextField T="string" @bind-Value="Workspace" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="wizard-url" Label="Workspace URL"><MudTextField T="string" @bind-Value="WorkspaceUrl" Adornment="Adornment.Start" AdornmentText="rynzo.com/" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField></div>}
else if(Step==1){<div class="wizard-fields"><UiFormField Id="wizard-size" Label="Team size"><MudSelect T="string" @bind-Value="TeamSize" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("1–10")">1–10 people</MudSelectItem><MudSelectItem Value="@("11–50")">11–50 people</MudSelectItem></MudSelect></UiFormField><UiFormField Id="wizard-plan" Label="Plan"><MudSelect T="string" @bind-Value="Plan" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("Starter")">Starter</MudSelectItem><MudSelectItem Value="@("Pro")">Pro</MudSelectItem></MudSelect></UiFormField></div>}
else if(Step==2){<div class="wizard-invite"><MudIcon Icon="@RynzoIcons.Get("UserRoundPlus")" /><div><b>Invite teammates</b><p>Invite now or add teammates later.</p></div></div><UiFormField Id="wizard-email" Label="Email address"><MudTextField T="string" @bind-Value="InviteEmail" InputType="InputType.Email" Placeholder="name@company.com" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField>}
else{<div class="wizard-review"><div><span>Workspace</span><b>@Workspace</b></div><div><span>Team size</span><b>@TeamSize</b></div><div><span>Plan</span><b>@Plan</b></div><div><span>Invite</span><b>@(string.IsNullOrWhiteSpace(InviteEmail)?"Add later":InviteEmail)</b></div></div>}
<div class="wizard-actions"><MudButton Variant="Variant.Text" Disabled="@(Step==0)" OnClick="Back">Back</MudButton>@if(Step<3){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Next">Continue</MudButton>}else{<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Complete">Create workspace</MudButton>}</div></FormElementCard></div></div>
@code {private int Step;private string Workspace="Northstar",WorkspaceUrl="northstar",TeamSize="1–10",Plan="Pro",InviteEmail="";private static readonly string[] StepTitles=["Workspace","Configuration","Invite","Review"];private static readonly string[] StepCopy=["Name your new workspace","Set team size and plan","Bring in your teammates","Confirm before creating"];private void Next(){if(Step==0&&string.IsNullOrWhiteSpace(Workspace)){Snackbar.Add("Enter a workspace name",Severity.Warning);return;}Step++;}private void Back()=>Step=Math.Max(0,Step-1);private void Restart()=>Step=0;private void Complete()=>Snackbar.Add("Workspace created",Severity.Success);}
