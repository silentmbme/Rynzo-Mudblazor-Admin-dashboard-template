@page "/ui/progress"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
<PageTitle>Progress | Rynzo</PageTitle>
<div class="progress-page"><DashboardPageHeader Title="Progress" Description="Completion, capacity, loading, and workflow status with clear visual feedback."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
<section class="progress-intro"><span><MudIcon Icon="@RynzoIcons.Get("ChartNoAxesCombined")" /></span><div><small>Component library / Progress &amp; loading</small><h2>Make every step visible.</h2><p>Communicate what is complete, what is in motion, and what comes next.</p></div><div class="progress-intro-preview" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><span>Moving forward</span></div></section>
<div class="progress-grid">
<ButtonShowcaseCard Id="linear" Title="Linear progress" Description="Clear labels and values for measurable completion." Code="@LinearCode"><div class="progress-stack"><UiProgressMeter Label="Project completion" Value="64" /><UiProgressMeter Label="Profile setup" Value="88" Color="Color.Success" /><UiProgressMeter Label="Storage used" Value="42" Color="Color.Info" /></div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="interactive" Title="Interactive value" Description="Component state updates a task's reported completion." Code="@InteractiveCode"><div class="progress-export"><span><MudIcon Icon="@RynzoIcons.Get("Download")" /></span><div><h3>Exporting data</h3><p>Adjust the example to explore progress states.</p></div><strong aria-live="polite">@Value%</strong></div><UiProgressMeter Label="Exporting data" Value="Value" ShowValue="false" /><div class="progress-controls"><MudIconButton Variant="Variant.Outlined" Icon="@RynzoIcons.Get("Minus")" Size="Size.Small" aria-label="Decrease progress" OnClick="@(()=>Value=Math.Max(0,Value-10))" /><MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(()=>Value=Math.Min(100,Value+10))">Increase</MudButton><MudButton Size="Size.Small" OnClick="@(()=>Value=0)">Reset</MudButton></div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="status" Title="Status progress" Description="Semantic colors call attention to health, warning, and risk." Code="@StatusCode"><div class="progress-stack"><UiProgressMeter Label="Healthy delivery" Value="76" Color="Color.Success" /><UiProgressMeter Label="Review required" Value="58" Color="Color.Warning" /><UiProgressMeter Label="Storage almost full" Value="92" Color="Color.Error" /></div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="circular" Title="Circular progress" Description="Compact percentage indicators for summaries and cards." Code="@CircularCode"><div class="progress-circles">@foreach(var item in new[]{(38,Color.Info,"Draft"),(72,Color.Primary,"Active"),(94,Color.Success,"Complete")}){<div><span class="progress-circle"><MudProgressCircular Value="item.Item1" Color="item.Item2" Size="Size.Large" StrokeWidth="4" Style="width:82px;height:82px" aria-label="@($"{item.Item3}: {item.Item1}%")" /><b>@item.Item1%</b></span><small>@item.Item3</small></div>}</div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="steps" Title="Stepped progress" Description="Show the current stage in a short ordered workflow." Code="@StepsCode"><div class="progress-steps">@for(var i=0;i<3;i++){var step=i+1;var label=Steps[i];<div class="@(step<=ActiveStep?"reached":"")"><MudButton Variant="Variant.Text" aria-current="@(step==ActiveStep?"step":null)" aria-label="@($"Step {step}: {label}")" OnClick="@(()=>ActiveStep=step)"><span class="progress-step-number">@step</span><b>@label</b><small>@(step==ActiveStep?"Current step":step<ActiveStep?"Complete":"Next")</small></MudButton></div>}</div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="capacity" Title="Segmented capacity" Description="Category usage and remaining space in one compact view." Code="@CapacityCode"><div class="progress-capacity-heading"><span>Storage allocation</span><b>82% used</b></div><div class="progress-segments" role="img" aria-label="Design files 40%, documents 24%, media 18%, remaining 18%"><i style="width:40%;background:var(--primary)"></i><i style="width:24%;background:var(--info)"></i><i style="width:18%;background:var(--warning)"></i></div><div class="progress-capacity-legend">@foreach(var item in new[]{("Design files","40%","primary"),("Documents","24%","info"),("Media","18%","warning")}){<div><span><i style="@($"background:var(--{item.Item3})")"></i><b>@item.Item2</b></span><small>@item.Item1</small></div>}</div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="loading" Title="Indeterminate loading" Description="Use activity feedback when the duration is unknown." Code="@LoadingCode"><div class="progress-loading"><span><MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" /></span><div><h3>Preparing analytics report</h3><p>Loading / Duration unknown</p></div></div><UiProgressMeter Label="Loading reports" Indeterminate="true" /></ButtonShowcaseCard>
<ButtonShowcaseCard Id="context" Title="In context" Description="Combine progress with a clear value and supporting status." Code="@ContextCode"><div class="progress-project"><div><span><h3>Q3 product launch</h3><p>34 of 42 tasks completed</p></span><UiStatusChip Color="Color.Success">On track</UiStatusChip></div><UiProgressMeter Value="82" Label="Project completion" ShowValue="false" Color="Color.Success" /><footer><span>Aug 8</span><b>82% complete</b><span>Sep 10</span></footer></div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="striped" Title="Striped and indeterminate" Description="Distinct feedback for active, successful, warning, and blocked processes." Code="@StripedCode"><div class="progress-stack">@foreach(var item in new[]{("Uploading assets",68,Color.Primary),("Publishing release",82,Color.Success),("Reviewing import",46,Color.Warning),("Retrying backup",28,Color.Error)}){<UiProgressMeter Label="@item.Item1" Value="item.Item2" Color="item.Item3" Striped="true" />}</div><div class="progress-process-grid">@foreach(var item in Processes){<article><span><MudIcon Icon="@RynzoIcons.Get(item.Icon)" />@item.Label</span><UiProgressMeter Label="@item.Label" ShowValue="false" Indeterminate="true" Color="item.Color" /></article>}</div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="skeleton" Title="Skeleton loaders" Description="Reserve the content's shape while real data is loading." Code="@SkeletonCode"><div class="progress-skeleton" aria-label="Loading content preview"><div class="progress-skeleton-person"><MudSkeleton SkeletonType="SkeletonType.Circle" Width="44px" Height="44px" /><div><MudSkeleton Width="128px" Height="16px" /><MudSkeleton Width="190px" Height="14px" /></div></div><MudCard Class="progress-skeleton-card rynzo-widget-card" Elevation="0" Outlined="true"><div><MudSkeleton Width="112px" Height="20px" /><MudSkeleton Width="64px" Height="25px" /></div><MudSkeleton Width="100%" Height="15px" /><MudSkeleton Width="80%" Height="15px" /><div class="progress-skeleton-tiles">@for(var i=0;i<3;i++){<MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="64px" />}</div></MudCard><div class="progress-skeleton-four">@for(var i=0;i<4;i++){<MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="80px" />}</div></div></ButtonShowcaseCard>
</div></div>
@code {
 private int Value=64,ActiveStep=2;
 private static readonly string[] Steps=["Details","Review","Publish"];
 private static readonly (string Label,string Icon,Color Color)[] Processes=[("Syncing project updates","RefreshCw",Color.Primary),("Generating report","ChartNoAxesCombined",Color.Info),("Checking deployment","CheckCircle2",Color.Success),("Processing payment","CreditCard",Color.Warning)];
 private async Task Print()=>await JS.InvokeVoidAsync("print");
 private const string LinearCode="<UiProgressMeter Label=\"Project completion\" Value=\"64\" />";
 private const string InteractiveCode="<UiProgressMeter Label=\"Exporting data\" Value=\"Value\" />\n<MudButton OnClick=\"@(() => Value = Math.Min(100, Value + 10))\">Increase</MudButton>";
 private const string StatusCode="<UiProgressMeter Label=\"Review required\" Value=\"58\" Color=\"Color.Warning\" />";
 private const string CircularCode="<MudProgressCircular Value=\"72\" Color=\"Color.Primary\"\n    Size=\"Size.Large\" StrokeWidth=\"4\" />";
 private const string StepsCode="<MudButton aria-current=\"@(ActiveStep == 2 ? \"step\" : null)\"\n    OnClick=\"@(() => ActiveStep = 2)\">Review</MudButton>";
 private const string CapacityCode="<div class=\"progress-segments\" role=\"img\"\n    aria-label=\"Design files 40%, documents 24%, media 18%\">\n    <!-- Category segments with 18% remaining -->\n</div>";
 private const string LoadingCode="<UiProgressMeter Label=\"Loading reports\" Indeterminate=\"true\" />";
 private const string ContextCode="<UiProgressMeter Value=\"82\" Color=\"Color.Success\" />\n<UiStatusChip Color=\"Color.Success\">On track</UiStatusChip>";
 private const string StripedCode="<UiProgressMeter Label=\"Uploading assets\" Value=\"68\" Striped=\"true\" />\n<UiProgressMeter Label=\"Syncing updates\" Indeterminate=\"true\" />";
 private const string SkeletonCode="<MudSkeleton SkeletonType=\"SkeletonType.Circle\" Width=\"44px\" Height=\"44px\" />\n<MudSkeleton Width=\"128px\" Height=\"16px\" />";
}
