@page "/ui/avatars"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
<PageTitle>Avatars | Rynzo</PageTitle>
<div class="avatars-page">
    <DashboardPageHeader Title="Avatars" Description="Profile images, fallbacks, presence signals, and team grouping patterns."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <section class="avatars-intro"><span class="avatars-intro-icon"><MudIcon Icon="@RynzoIcons.Get("Users")" /></span><div><span class="avatars-eyebrow">Component library / Identity</span><h2>Put people at the center.</h2><p>Recognizable portraits, reliable fallbacks, and presence at a glance.</p></div><div class="avatars-intro-people">@foreach(var person in People){<UiPersonAvatar Name="@person.Name" Src="@person.Photo" Pixels="36" />}</div></section>
    <div class="avatars-grid">
        <ButtonShowcaseCard Id="images" Title="Image avatars" Description="Portraits with fallback initials at five sizes." Code="@ImagesCode"><div class="avatars-size-row">@for(var i=0;i<Sizes.Length;i++){var person=People[i%People.Length];var size=Sizes[i];<div><span class="avatars-size-stage"><UiPersonAvatar Name="@person.Name" Src="@person.Photo" Initials="@person.Initials" Pixels="size.Pixels" /></span><span class="avatars-size-label">@size.Label</span><small>@size.Pixels px</small></div>}</div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="presence" Title="Presence status" Description="Online, away, busy, and offline with explicit text labels." Code="@PresenceCode"><div class="avatars-presence-grid">@for(var i=0;i<People.Length;i++){var person=People[i];var status=Statuses[i];<div><UiPersonAvatar Name="@person.Name" Src="@person.Photo" Status="@status" /><span><b>@person.Name</b><small><i class="@status.ToLowerInvariant()"></i>@status</small></span></div>}</div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="fallbacks" Title="Fallback initials" Description="A reliable identity when a portrait is missing or unavailable." Code="@FallbackCode"><div class="avatars-fallback-row">@foreach(var item in new[]{("JC",36),("OH",44),("AM",56),("+8",64)}){<div><span class="avatars-size-stage"><UiPersonAvatar Name="@(item.Item1=="+8"?"8 more people":item.Item1)" Initials="@item.Item1" Pixels="item.Item2" /></span><small>@(item.Item1=="JC"?"User fallback":"Initials")</small></div>}</div><p class="avatars-note"><MudIcon Icon="@RynzoIcons.Get("Info")" />Initials also appear automatically if an image fails to load.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="groups" Title="Avatar groups" Description="Stacked collaborators with a clear overflow count." Code="@GroupsCode"><MudCard Class="avatars-team-card rynzo-widget-card" Elevation="0" Outlined="true"><span class="avatars-label">Workspace collaborators</span><div class="avatars-team-stack">@foreach(var person in People){<UiPersonAvatar Name="@person.Name" Src="@person.Photo" Pixels="44" />}<UiPersonAvatar Name="3 more members" Initials="+3" Pixels="44" /></div><div class="avatars-team-summary"><span><b>4</b> visible collaborators</span><i></i><span><b>3</b> more members</span></div></MudCard></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="context" Title="In context" Description="Compact identity rows for members, owners, and reviewers." Code="@ContextCode"><div class="avatars-member-list">@for(var i=0;i<Members.Length;i++){var person=People[i];var member=Members[i];<div><span class="avatars-member-person"><UiPersonAvatar Name="@person.Name" Src="@person.Photo" Status="@member.Presence" /><span><b>@person.Name</b><small>@member.Role</small></span></span><UiStatusChip Dot="true" Color="member.Color">@member.Status</UiStatusChip></div>}</div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="actions" Title="Avatar actions" Description="An accessible avatar action with a local presence toggle." Code="@ActionsCode"><MudCard Class="avatars-action-card rynzo-widget-card" Elevation="0" Outlined="true"><span class="avatars-label">Interactive profile</span><div class="avatars-action-person"><MudButton Variant="Variant.Text" OnClick="Toggle" aria-label="Toggle Sophie presence" aria-pressed="@(Online?"true":"false")" Class="avatar-profile-button"><UiPersonAvatar Name="@People[0].Name" Src="@People[0].Photo" Pixels="64" Status="@(Online?"Online":"Offline")" /></MudButton><div><h3>Sophie Turner</h3><p>Product Designer</p><span class="avatars-action-state" aria-live="polite"><i class="@(Online?"online":"offline")"></i>@(Online?"Available":"Offline")</span></div></div><div class="avatars-action-footer"><span>Page-local presence demo</span><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@RynzoIcons.Get(Online?"Moon":"Sun")" OnClick="Toggle">@(Online?"Set away":"Set online")</MudButton></div></MudCard></ButtonShowcaseCard>
    </div>
</div>
@code {
    private bool Online=true;
    private static readonly (string Name,string Photo,string Initials)[] People=[("Sophie Turner","assets/images/users/user-3.jpg","ST"),("Liam Walker","assets/images/users/user-4.jpg","LW"),("Noah Bennett","assets/images/users/user-1.jpg","NB"),("Emma Brooks","assets/images/users/user-3.jpg","EB")];
    private static readonly (string Label,int Pixels)[] Sizes=[("XS",28),("SM",36),("MD",44),("LG",56),("XL",64)];
    private static readonly string[] Statuses=["Online","Away","Busy","Offline"];
    private static readonly (string Role,string Status,string Presence,Color Color)[] Members=[("Product Designer","Online","Online",Color.Success),("Frontend Engineer","In a meeting","Away",Color.Warning),("QA Engineer","Reviewing a pull request","Reviewing",Color.Info)];
    private void Toggle()=>Online=!Online;
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private const string ImagesCode="<UiPersonAvatar Name=\"Sophie Turner\"\n    Src=\"assets/images/users/user-3.jpg\" Initials=\"ST\" Pixels=\"44\" />";
    private const string PresenceCode="<UiPersonAvatar Name=\"Sophie Turner\"\n    Src=\"assets/images/users/user-3.jpg\" Status=\"Online\" />";
    private const string FallbackCode="<UiPersonAvatar Name=\"JC\" Initials=\"JC\" Pixels=\"36\" />\n<UiPersonAvatar Name=\"8 more people\" Initials=\"+8\" Pixels=\"64\" />";
    private const string GroupsCode="<div class=\"avatars-team-stack\">\n    @foreach (var person in People)\n    {\n        <UiPersonAvatar Name=\"@person.Name\" Src=\"@person.Photo\" Pixels=\"44\" />\n    }\n    <UiPersonAvatar Name=\"3 more members\" Initials=\"+3\" Pixels=\"44\" />\n</div>";
    private const string ContextCode="<UiPersonAvatar Name=\"Sophie Turner\"\n    Src=\"assets/images/users/user-3.jpg\" Status=\"Online\" />\n<UiStatusChip Dot=\"true\" Color=\"Color.Success\">Online</UiStatusChip>";
    private const string ActionsCode="<MudButton OnClick=\"Toggle\" aria-label=\"Toggle Sophie presence\">\n    <UiPersonAvatar Name=\"Sophie Turner\"\n        Src=\"assets/images/users/user-3.jpg\"\n        Status=\"@(Online ? \"Online\" : \"Offline\")\" Pixels=\"64\" />\n</MudButton>";
}
