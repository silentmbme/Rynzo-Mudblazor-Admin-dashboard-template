@page "/ui/typography"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Typography | Rynzo</PageTitle>
<div class="typography-page">
    <DashboardPageHeader Title="Typography" Description="A consistent text system for hierarchy, reading, metadata, and interactive content."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <MudCard Class="type-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span class="type-intro-monogram" aria-hidden="true">Aa</span><div><small>Component library / Foundations</small><h2>Clarity starts with the written word.</h2><p>A shared hierarchy for interface labels, everyday reading, and the details that matter.</p></div><div class="type-font-note"><b>Inter <span>UI system</span></b><small>Headings &amp; interface text</small></div></MudCard>
    <div class="type-grid">
        <div class="type-full"><ButtonShowcaseCard Id="headings" Title="Display and headings" Description="Create hierarchy with the established heading scale and semantic elements." Code="@HeadingsCode"><div class="type-heading-specimens"><div><span>Display <small>H1 · @RynzoThemeSettings.H1FontSize</small></span><MudText Typo="Typo.h1" Style="font-size:var(--rynzo-font-h1)">Make work visible</MudText></div><div><span>Section <small>H2 · @RynzoThemeSettings.H2FontSize</small></span><MudText Typo="Typo.h2" Style="font-size:var(--rynzo-font-h2)">Project performance</MudText></div><div><span>Subsection <small>H5 · @RynzoThemeSettings.H5FontSize</small></span><MudText Typo="Typo.h5" HtmlTag="h3" Style="font-size:var(--rynzo-font-h5)">This weeks priorities</MudText></div><div><span>Detail <small>H6 · @RynzoThemeSettings.H6FontSize</small></span><MudText Typo="Typo.h6" HtmlTag="h4" Style="font-size:var(--rynzo-font-h6)">Delivery checklist</MudText></div></div></ButtonShowcaseCard></div>
        <ButtonShowcaseCard Id="scale" Title="Text scale" Description="Consistent supporting copy, helper text, and compact metadata." Code="@ScaleCode"><div class="type-scale"><div><small>Lead · @RynzoThemeSettings.H6FontSize</small><p class="type-lead">Large supporting message for key summaries.</p></div><div><small>Body · @RynzoThemeSettings.Body1FontSize</small><MudText Typo="Typo.body1">Base text for regular interface content and readable descriptions.</MudText></div><div><small>Supporting · @RynzoThemeSettings.Body2FontSize</small><MudText Typo="Typo.body2">Small text works well for helper copy, rows and secondary information.</MudText></div><div><small>Metadata · @RynzoThemeSettings.CaptionFontSize</small><MudText Typo="Typo.caption">Extra-small text is reserved for compact timestamps and metadata.</MudText></div></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="body" Title="Body and lead" Description="Introduce an idea, then give it room to be read comfortably." Code="@BodyCode"><div class="type-reading-preview"><span class="type-eyebrow">Writing for the interface</span><p class="type-lead">Create a shared view of work so every team can make decisions with confidence.</p><p>Good interface copy is direct and useful. It gives people enough context to take the next action without interrupting their flow.</p></div><div class="type-reading-note"><MudIcon Icon="@RynzoIcons.Get("List")" /><span>Comfortable line height. Clear reading rhythm.</span></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="emphasis" Title="Text emphasis" Description="Use weight and tone to highlight meaning without adding clutter." Code="@EmphasisCode"><div class="type-emphasis"><p><strong>Strong text</strong> highlights an important value or action.</p><p><em>Emphasized text</em> adds a subtle change in tone.</p><p><mark>Highlighted text</mark> draws attention to a key phrase.</p><p><s>Completed task</s><span class="type-underlined">Linked reference</span></p></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="links" Title="Links and actions" Description="Recognizable links with distinct hover and keyboard-focus states." Code="@LinksCode"><div class="type-link-list"><div><span>Documentation</span><a href="#typography-link" @onclick:preventDefault="true" @onclick="@(()=>Notify("Documentation opened",Severity.Success))">View documentation <MudIcon Icon="@RynzoIcons.Get("ArrowRight")" /></a></div><div><span>External reference</span><a href="#typography-external" @onclick:preventDefault="true" @onclick="@(()=>Notify("External link selected"))">Open reference <MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></a></div><div><span>Contextual action</span><MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(()=>Notify("Inline action selected"))">Inline action</MudButton></div></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="metadata" Title="Labels and metadata" Description="Compact labels and stronger values make details easy to scan." Code="@MetadataCode"><dl class="type-metadata"><div><dt>Project</dt><dd>Website Redesign</dd></div><div><dt>Status</dt><dd class="type-success"><i></i>On track</dd></div><div><dt>Owner</dt><dd>Sophia Carter</dd></div><div><dt>Updated</dt><dd>12 minutes ago</dd></div></dl></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="quotes" Title="Quotes and callouts" Description="Give notes and editorial content a clear supporting voice." Code="@QuotesCode"><blockquote><span aria-hidden="true">“</span><p>A calm interface starts with calm, clear language.</p></blockquote><aside class="type-note"><MudIcon Icon="@RynzoIcons.Get("Info")" /><p><b>Note:</b> Keep supporting messages short and close to the decision they support.</p></aside></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="lists" Title="Lists" Description="Use bullets for related details and numbers for an ordered sequence." Code="@ListsCode"><div class="type-list-columns"><div><h3>Included in this release</h3><ul><li>Improved dashboard filtering</li><li>Saved workspace views</li><li>New project health signals</li></ul></div><div><h3>Publish checklist</h3><ol><li>Review changes</li><li>Confirm settings</li><li>Publish to workspace</li></ol></div></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="code" Title="Inline code and keyboard" Description="Monospace identifiers, commands, and familiar keyboard shortcuts." Code="@InlineCode"><div class="type-code-list"><div><span>Project identifier</span><code>PRJ-1048</code></div><div><span>Build command</span><code>npm run build</code></div><div><span>Open command menu</span><kbd>Ctrl K</kbd></div></div></ButtonShowcaseCard>
        <div class="type-full"><ButtonShowcaseCard Id="article" Title="Article composition" Description="A complete reading layout for help content, release notes, and detail pages." Code="@ArticleCode"><article class="type-article"><div class="type-article-margin"><span class="type-eyebrow">Product update</span><span class="type-article-edition">Delivery workspace</span></div><div class="type-article-copy"><h1>A clearer way to run delivery reviews</h1><p class="type-lead">The updated project view turns progress, risk and next actions into one concise team conversation.</p><hr /><h2>What changed</h2><p>We simplified the review flow, added ownership context, and made it easier to spot projects that need attention before they become delayed.</p><aside class="type-article-tip"><span><MudIcon Icon="@RynzoIcons.Get("Info")" /></span><div><b>Tip</b><p>Start each review with the delivery signal, then discuss the next action and owner.</p></div></aside></div></article></ButtonShowcaseCard></div>
    </div>
</div>
@code {
    private void Notify(string message,Severity severity=Severity.Normal)=>Snackbar.Add(message,severity);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private const string HeadingsCode="<MudText Typo=\"Typo.h1\">Make work visible</MudText>\n<MudText Typo=\"Typo.h2\">Project performance</MudText>\n<MudText Typo=\"Typo.h5\" HtmlTag=\"h3\">This weeks priorities</MudText>";
    private const string ScaleCode="<MudText Typo=\"Typo.body1\">Body text</MudText>\n<MudText Typo=\"Typo.body2\">Supporting text</MudText>\n<MudText Typo=\"Typo.caption\">Metadata</MudText>";
    private const string BodyCode="<p class=\"type-lead\">Lead paragraph</p>\n<p>Body paragraph</p>\n/* Font sizes use the shared design tokens. */";
    private const string EmphasisCode="<strong>Strong text</strong>\n<em>Emphasized text</em>\n<mark>Highlighted text</mark>\n<s>Completed task</s>";
    private const string LinksCode="<a href=\"#typography-link\" @onclick:preventDefault=\"true\"\n    @onclick=\"OpenDocumentation\">View documentation</a>";
    private const string MetadataCode="<dl><div><dt>Project</dt><dd>Website Redesign</dd></div></dl>";
    private const string QuotesCode="<blockquote><p>A calm interface starts with calm, clear language.</p></blockquote>";
    private const string ListsCode="<ul><li>Saved workspace views</li></ul>\n<ol><li>Review changes</li><li>Confirm settings</li></ol>";
    private const string InlineCode="<code>PRJ-1048</code>\n<code>npm run build</code>\n<kbd>Ctrl K</kbd>";
    private const string ArticleCode="<article>\n    <h1>A clearer way to run delivery reviews</h1>\n    <p class=\"type-lead\">...</p>\n    <h2>What changed</h2>\n    <p>...</p>\n</article>";
}
