@page "/forms/elements"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Form elements | Rynzo</PageTitle>
<div class="form-elements-page">
    <DashboardPageHeader Title="Form elements" Description="Core inputs, selection controls, and feedback states for every workflow."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Save")" OnClick="@(()=>Notify("Form configuration saved",Severity.Success))">Save configuration</MudButton></Actions></DashboardPageHeader>
    <section class="form-elements-section"><header class="form-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("TextCursorInput")" /></span><div><h2>Text inputs</h2><p>Standard fields, input groups, sizes, and states.</p></div></header><div class="form-elements-grid">
        <FormElementCard Id="basic-inputs" Title="Basic inputs" Description="Clear labels, helper text, and predictable dimensions"><div class="form-fields-grid"><UiFormField Id="element-name" Label="Full name" Required="true"><MudTextField T="string" Placeholder="Elena Marquez" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-email" Label="Email address" Required="true"><MudTextField T="string" InputType="InputType.Email" Placeholder="elena@company.com" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-phone" Label="Phone"><MudTextField T="string" InputType="InputType.Telephone" Placeholder="+1 (415) 555-0136" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-website" Label="Website"><MudTextField T="string" InputType="InputType.Url" Placeholder="https://company.com" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-readonly" Label="Read only"><MudTextField T="string" Value="@("PRJ-1048")" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-disabled" Label="Disabled"><MudTextField T="string" Value="@("Unavailable")" Disabled="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField></div></FormElementCard>
        <FormElementCard Id="input-variations" Title="Input variations" Description="Choose dimensions that match the context"><div class="form-fields-stack"><UiFormField Id="element-search" Label="Search"><MudTextField T="string" Placeholder="Search workspace" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-password" Label="Password" Hint="Use the icon to reveal the current value."><MudTextField T="string" @bind-Value="Password" InputType="@(PasswordVisible?InputType.Text:InputType.Password)" Adornment="Adornment.End" AdornmentIcon="@RynzoIcons.Get(PasswordVisible?"EyeOff":"Eye")" OnAdornmentClick="@(()=>PasswordVisible=!PasswordVisible)" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><div class="form-size-grid"><UiFormField Id="element-small" Label="Small"><MudTextField T="string" Placeholder="Small" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-default" Label="Default"><MudTextField T="string" Placeholder="Default" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-large" Label="Large"><MudTextField T="string" Placeholder="Large" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField></div></div></FormElementCard>
        <FormElementCard Id="input-groups" Title="Input groups" Description="Combine useful context with a familiar text field"><div class="form-fields-stack"><UiFormField Id="element-profile" Label="Profile URL"><MudTextField T="string" Placeholder="elena" Adornment="Adornment.Start" AdornmentText="rynzo.com/" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-budget" Label="Budget"><MudNumericField T="decimal?" Placeholder="0.00" Adornment="Adornment.Start" AdornmentText="$" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-report-search" Label="Search reports"><div class="form-input-group"><MudTextField T="string" Placeholder="Search reports" Variant="Variant.Outlined" Margin="Margin.Dense" /><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(()=>Notify("Search submitted"))">Search</MudButton></div></UiFormField></div></FormElementCard>
        <FormElementCard Id="textarea" Title="Textarea &amp; character count" Description="Long-form input with a visible maximum"><UiFormField Id="element-notes" Label="Project notes" Hint="@($"{Note.Length} / 240 characters")"><MudTextField T="string" @bind-Value="Note" Lines="4" MaxLength="240" Counter="240" Placeholder="Add useful delivery context for the team..." Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><div class="form-clear-notes"><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ClearNotes">Clear notes</MudButton></div></FormElementCard>
    </div></section>
    <section class="form-elements-section"><header class="form-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("ListChecks")" /></span><div><h2>Choices &amp; toggles</h2><p>Single, multiple, and binary selection patterns.</p></div></header><div class="form-elements-grid form-choices-grid">
        <FormElementCard Id="radio-cards" Title="Radio cards" Description="A visual single-selection control"><fieldset class="form-plan-options"><legend class="form-visually-hidden">Choose a plan</legend>@foreach(var item in Plans){<label class="@(Plan==item.Value?"is-selected":"")"><span><input type="radio" name="element-plan" value="@item.Value" checked="@(Plan==item.Value)" @onchange="@(()=>Plan=item.Value)" aria-label="@item.Title" /><b>@item.Price</b></span><strong>@item.Title</strong><small>@item.Description</small></label>}</fieldset><div class="form-selected-plan"><span>Selected plan</span><strong aria-live="polite">@Plan</strong></div></FormElementCard>
        <FormElementCard Id="toggles" Title="Checkboxes &amp; switches" Description="Multiple selections and binary preferences"><div class="form-checks"><MudCheckBox T="bool" @bind-Value="Usage" Label="Share usage analytics" Color="Color.Primary" /><MudCheckBox T="bool" @bind-Value="Guests" Label="Include guest users in reports" Color="Color.Primary" /><MudCheckBox T="bool" Value="false" Disabled="true" Label="Restricted setting" /></div><div class="form-switches"><div><span><b>Product alerts</b><small>Feature and release messages</small></span><MudSwitch T="bool" @bind-Value="Alerts" Color="Color.Primary" aria-label="Product alerts" /></div><div><span><b>Private workspace</b><small>Only invited teammates can view it</small></span><MudSwitch T="bool" @bind-Value="Access" Color="Color.Primary" aria-label="Private workspace" /></div></div></FormElementCard>
    </div></section>
    <section class="form-elements-section"><header class="form-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("SlidersHorizontal")" /></span><div><h2>Special controls</h2><p>Range, upload, and native controls for complete data capture.</p></div></header><div class="form-elements-grid form-three-columns">
        <FormElementCard Id="range" Title="Range slider" Description="Set a notification volume"><div class="form-volume-icon"><MudIcon Icon="@RynzoIcons.Get("Volume2")" /></div><MudSlider T="int" @bind-Value="Volume" Min="0" Max="100" Step="1" Color="Color.Primary" /><div class="form-volume-labels"><span>Silent</span><output>@Volume%</output><span>Loud</span></div></FormElementCard>
        <FormElementCard Id="upload" Title="File upload" Description="Browse or drop a file"><label class="form-upload" for="element-file"><InputFile id="element-file" OnChange="FileChanged" aria-label="Upload an attachment" /><MudIcon Icon="@RynzoIcons.Get("CloudUpload")" /><b>@(FileName??"Upload an attachment")</b><small>PDF, PNG, or JPG up to 10 MB</small></label><p class="form-upload-caption" aria-live="polite">@(FileName is null?"Choose a file or drop it in the upload area.":$"Selected: {FileName}")</p></FormElementCard>
        <FormElementCard Id="native" Title="Date &amp; time controls" Description="MudBlazor picker components with plain external labels"><div class="form-fields-stack"><UiFormField Id="element-color" Label="Accent color"><MudTextField T="string" @bind-Value="Accent" Adornment="Adornment.Start" AdornmentText="#" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><div class="form-native-grid"><UiFormField Id="element-date" Label="Start date"><MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="element-time" Label="Review time"><MudTimePicker Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField></div></div></FormElementCard>
    </div></section>
    <section class="form-elements-section"><header class="form-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("CircleAlert")" /></span><div><h2>Field feedback</h2><p>Make each state easy to identify and resolve.</p></div></header><div class="form-elements-grid form-three-columns">
        <FormElementCard Id="success" Title="Success" Description="A verified input"><UiFormField Id="element-verified" Label="Verified email"><MudTextField T="string" Value="@("elena@northstar.com")" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@RynzoIcons.Get("CircleCheck")" Variant="Variant.Outlined" Margin="Margin.Dense" /><p class="form-feedback-message is-success">Email is verified.</p></UiFormField></FormElementCard>
        <FormElementCard Id="error" Title="Error" Description="Explain what needs to change"><UiFormField Id="element-slug" Label="Project slug"><MudTextField T="string" Value="@("North Star!")" Error="true" ErrorText="Use lowercase letters, numbers, and hyphens only." Adornment="Adornment.End" AdornmentIcon="@RynzoIcons.Get("CircleAlert")" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField></FormElementCard>
        <FormElementCard Id="loading" Title="Loading" Description="Tell users when a check is running"><UiFormField Id="element-availability" Label="Workspace URL"><MudTextField T="string" Value="@("Checking availability...")" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@RynzoIcons.Get("LoaderCircle")" Variant="Variant.Outlined" Margin="Margin.Dense" /><p class="form-feedback-message">Checking this value in the background.</p></UiFormField></FormElementCard>
    </div></section>
</div>
@code {
    private bool PasswordVisible,Usage=true,Guests,Alerts=true,Access=true;
    private string Password="Rynzo2026",Note="",Plan="pro",Accent="#0e7974";
    private int Volume=64;
    private string? FileName;
    private void FileChanged(InputFileChangeEventArgs args)=>FileName=args.File.Name;
    private void UpdateNote(ChangeEventArgs args){var value=args.Value?.ToString()??"";Note=value[..Math.Min(value.Length,240)];}
    private void ClearNotes(){Note="";Notify("Notes cleared");}
    private void Notify(string message,Severity severity=Severity.Normal)=>Snackbar.Add(message,severity);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private static readonly (string Value,string Title,string Price,string Description)[] Plans=[("starter","Starter","$0","For personal work"),("pro","Pro","$24","For small teams"),("scale","Scale","$79","For growing teams")];
}
