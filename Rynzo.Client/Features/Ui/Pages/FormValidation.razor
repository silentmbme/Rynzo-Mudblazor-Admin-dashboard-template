@page "/forms/validation"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
<PageTitle>Form validation | Rynzo</PageTitle>
<style>.validation-availability{display:flex;align-items:center;gap:9px;margin:18px 0;color:var(--muted-foreground);font-size:var(--rynzo-font-caption)}.validation-availability .mud-icon-root,.validation-rules .mud-icon-root{width:17px;height:17px;color:var(--muted-foreground)}.validation-availability.is-available{color:var(--success)}.validation-availability.is-available .mud-icon-root,.validation-rules .is-met .mud-icon-root{color:var(--success)}.validation-availability.is-taken{color:var(--destructive)}.validation-availability.is-taken .mud-icon-root{color:var(--destructive)}.validation-rules{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin-top:20px}.validation-rules>div{display:flex;align-items:center;gap:8px;color:var(--muted-foreground);font-size:var(--rynzo-font-caption)}.validation-rules .is-met{color:var(--foreground)}</style>

<div class="validation-page">
    <DashboardPageHeader Title="Form validation" Description="Clear inline feedback, useful recovery guidance, and confident submit states."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("RefreshCw")" OnClick="Reset">Reset</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("CircleCheck")" OnClick="Submit">Validate form</MudButton></Actions></DashboardPageHeader>
    <section class="validation-section"><header class="validation-heading"><span><MudIcon Icon="@RynzoIcons.Get("CircleAlert")" /></span><div><h2>Inline validation</h2><p>Show exactly what needs attention at the point of entry.</p></div></header><div class="validation-grid">
        <FormElementCard Id="required" Title="Required fields" Description="Required state with explicit recovery guidance."><div class="validation-stack"><UiFormField Id="validation-name" Label="Full name" Required="true"><MudTextField T="string" @bind-Value="Name" Error="@NameError" ErrorText="Enter your full name." Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="validation-email" Label="Work email" Required="true"><MudTextField T="string" @bind-Value="Email" InputType="InputType.Email" Error="@EmailError" ErrorText="Enter a valid work email." Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField></div></FormElementCard>
        <FormElementCard Id="success" Title="Verified field" Description="Confirm when a field is valid and ready."><UiFormField Id="validation-verified" Label="Company email"><MudTextField T="string" Value="@("elena@rynzoadmin.com")" ReadOnly="true" Adornment="Adornment.End" AdornmentIcon="@RynzoIcons.Get("CircleCheck")" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><div class="validation-success"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /><div><b>Email verified</b><p>This address is approved for your workspace.</p></div></div></FormElementCard>
    </div></section>
    <section class="validation-section"><header class="validation-heading"><span><MudIcon Icon="@RynzoIcons.Get("UserRoundCheck")" /></span><div><h2>Submission feedback</h2><p>Bring form-wide issues and successful completion into view.</p></div></header><div class="validation-grid">
        <FormElementCard Id="account" Title="Account setup" Description="A focused mini-form with live validation.">
            <div class="validation-stack">
                <UiFormField Id="validation-password" Label="Password" Required="true"><MudTextField T="string" @bind-Value="Password" InputType="InputType.Password" Error="@PasswordError" ErrorText="Use at least 8 characters." Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField>
                <UiFormField Id="validation-role" Label="Workspace role"><MudSelect T="string" @bind-Value="Role" Error="@RoleError" ErrorText="Choose a role to continue." Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("Viewer")">Viewer</MudSelectItem><MudSelectItem Value="@("Editor")">Editor</MudSelectItem><MudSelectItem Value="@("Admin")">Admin</MudSelectItem></MudSelect></UiFormField>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Submit">Create account</MudButton>
        </FormElementCard>
        <FormElementCard Id="summary" Title="Validation summary" Description="Use a summary for longer forms or multi-step flows.">@if(HasValidated){if(IsValid){<div class="validation-summary is-valid"><MudIcon Icon="@RynzoIcons.Get("CircleCheck")" /><div><b>Everything looks good</b><p>Your account details are ready to save.</p></div></div>}else{<div class="validation-summary is-invalid"><MudIcon Icon="@RynzoIcons.Get("CircleAlert")" /><div><b>Review the highlighted fields</b><p>Complete the required fields, then validate again.</p></div></div>}}else{<div class="validation-empty"><MudIcon Icon="@RynzoIcons.Get("CircleCheck")" /><p>Validate the form to see a submission summary.</p></div>}</FormElementCard>
    </div></section>
    <section class="validation-section"><header class="validation-heading"><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /></span><div><h2>Helpful checks</h2><p>Show progress and availability before someone submits the form.</p></div></header><div class="validation-grid">
        <FormElementCard Id="availability" Title="Username availability" Description="Instant feedback for an identifier that must be unique."><UiFormField Id="validation-username" Label="Workspace URL"><MudTextField T="string" @bind-Value="Username" Placeholder="northstar" Adornment="Adornment.Start" AdornmentText="rynzo.com/" Error="@(!UsernameAvailable)" ErrorText="This workspace URL is already in use." Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><div class="validation-availability @(UsernameAvailable?"is-available":"is-taken")"><MudIcon Icon="@RynzoIcons.Get(UsernameAvailable?"CircleCheck":"CircleAlert")" /><span>@(UsernameAvailable?"This workspace URL is available.":"Try another workspace URL.")</span></div><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ToggleUsername">Check another state</MudButton></FormElementCard>
        <FormElementCard Id="rules" Title="Password rules" Description="A live checklist keeps password requirements understandable."><UiFormField Id="validation-password-rules" Label="Create a password"><MudTextField T="string" @bind-Value="RulePassword" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><div class="validation-rules"><div class="@(RulePassword.Length>=8?"is-met":"")"><MudIcon Icon="@RynzoIcons.Get(RulePassword.Length>=8?"CircleCheck":"CircleAlert")" /><span>At least 8 characters</span></div><div class="@(RulePassword.Any(char.IsUpper)?"is-met":"")"><MudIcon Icon="@RynzoIcons.Get(RulePassword.Any(char.IsUpper)?"CircleCheck":"CircleAlert")" /><span>One uppercase letter</span></div><div class="@(RulePassword.Any(char.IsDigit)?"is-met":"")"><MudIcon Icon="@RynzoIcons.Get(RulePassword.Any(char.IsDigit)?"CircleCheck":"CircleAlert")" /><span>One number</span></div><div class="@(RulePassword.Any(c=>!char.IsLetterOrDigit(c))?"is-met":"")"><MudIcon Icon="@RynzoIcons.Get(RulePassword.Any(c=>!char.IsLetterOrDigit(c))?"CircleCheck":"CircleAlert")" /><span>One symbol</span></div></div></FormElementCard>
    </div></section>
</div>

@code {
    private string Name="",Email="",Password="",Role="",Username="northstar",RulePassword=""; private bool HasValidated,NameError,EmailError,PasswordError,RoleError,UsernameAvailable=true;
    private bool IsValid=>!NameError&&!EmailError&&!PasswordError&&!RoleError;
    private void Submit(){NameError=string.IsNullOrWhiteSpace(Name);EmailError=string.IsNullOrWhiteSpace(Email)||!Email.Contains('@');PasswordError=Password.Length<8;RoleError=string.IsNullOrWhiteSpace(Role);HasValidated=true;Snackbar.Add(IsValid?"Validation passed":"Fix the highlighted fields",IsValid?Severity.Success:Severity.Warning);}
    private void Reset(){Name=Email=Password=Role="";HasValidated=NameError=EmailError=PasswordError=RoleError=false;}
    private void ToggleUsername()=>UsernameAvailable=!UsernameAvailable;
}
