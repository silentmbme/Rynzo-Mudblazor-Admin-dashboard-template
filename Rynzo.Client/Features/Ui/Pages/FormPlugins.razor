<div class="form-plugins-page">
    <DashboardPageHeader Title="Form plugins" Description="Enhanced inputs for dates, uploads, colors, ranges, and rich content.">
        <Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Save")" OnClick="Save">Save settings</MudButton></Actions>
    </DashboardPageHeader>

    <section class="plugin-section"><header class="plugin-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("Calendar")" /></span><div><h2>Date &amp; time</h2><p>Make time-based decisions easier to scan and confirm.</p></div></header><div class="plugin-grid">
        <FormElementCard Id="date-range" Title="Date range" Description="A paired range with a clear duration summary."><div class="plugin-date-grid"><UiFormField Id="plugin-start" Label="Start date"><MudDatePicker @bind-Date="StartDate" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="plugin-end" Label="End date"><MudDatePicker @bind-Date="EndDate" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField></div><div class="plugin-date-summary"><span><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" /></span><div><small>Selected range</small><b>@StartDate?.ToString("dd MMM") – @EndDate?.ToString("dd MMM yyyy")</b></div><UiStatusChip Color="Color.Primary">@DurationDays days</UiStatusChip></div></FormElementCard>
        <FormElementCard Id="schedule" Title="Time schedule" Description="A focused schedule with a timezone reminder."><div class="plugin-time-grid"><UiFormField Id="plugin-time" Label="Start time"><MudTimePicker @bind-Time="MeetingTime" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="plugin-zone" Label="Timezone"><MudSelect T="string" @bind-Value="Timezone" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("UTC −08:00")">UTC −08:00</MudSelectItem><MudSelectItem Value="@("UTC +00:00")">UTC +00:00</MudSelectItem><MudSelectItem Value="@("UTC +05:30")">UTC +05:30</MudSelectItem></MudSelect></UiFormField></div><div class="plugin-time-note"><MudIcon Icon="@RynzoIcons.Get("Clock3")" /><span>Attendees see this in their local timezone.</span></div></FormElementCard>
    </div></section>

    <section class="plugin-section"><header class="plugin-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("SlidersHorizontal")" /></span><div><h2>Value controls</h2><p>Choose values visually while retaining an exact outcome.</p></div></header><div class="plugin-grid">
        <FormElementCard Id="range" Title="Budget range" Description="A live range control with a visible numeric value."><UiFormField Id="plugin-budget" Label="Monthly budget"><div class="plugin-range"><MudSlider T="decimal" @bind-Value="Budget" Min="1000" Max="25000" Step="500" Color="Color.Primary" /><output>$@Budget.ToString("N0")</output></div></UiFormField><div class="plugin-range-scale"><span>$1k</span><span>$25k</span></div><p class="plugin-caption">Set a sensible monthly limit for this workspace.</p></FormElementCard>
        <FormElementCard Id="color" Title="Brand color" Description="Use a native picker with a dependable hexadecimal value."><div class="plugin-color-layout"><label class="plugin-color-swatch" style="@($"--plugin-color:{BrandColor}")"><input aria-label="Brand color" type="color" @bind="BrandColor" /><span></span></label><div><UiFormField Id="plugin-color-code" Label="Hex value"><MudTextField T="string" @bind-Value="BrandColor" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><p class="plugin-caption">Used for workspace accents and shared templates.</p></div></div></FormElementCard>
    </div></section>

    <section class="plugin-section"><header class="plugin-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("Paperclip")" /></span><div><h2>Files &amp; content</h2><p>Offer richer entry patterns without hiding the primary task.</p></div></header><div class="plugin-grid plugin-content-grid">
        <FormElementCard Id="upload" Title="File upload" Description="A compact drop zone with file feedback."><label class="plugin-upload"><InputFile style="position:absolute;opacity:0;width:1px;height:1px" accept=".pdf,.doc,.docx,.png,.jpg" OnChange="ChooseFile" /><span><MudIcon Icon="@RynzoIcons.Get("Upload")" /></span><b>@(SelectedFile ?? "Choose a file or drop it here")</b><small>PDF, DOCX, PNG or JPG · up to 10 MB</small></label>@if(SelectedFile is not null){<div class="plugin-file-row"><MudIcon Icon="@RynzoIcons.Get("FileText")" /><span>@SelectedFile</span><button type="button" aria-label="Remove selected file" @onclick="ClearFile"><MudIcon Icon="@RynzoIcons.Get("X")" /></button></div>}</FormElementCard>
        <FormElementCard Id="editor" Title="Rich text area" Description="A familiar writing surface with compact formatting cues."><div class="plugin-editor"><div class="plugin-editor-toolbar" aria-label="Formatting tools"><MudIconButton Icon="@RynzoIcons.Get("Bold")" OnClick="ToggleBold" /><MudIconButton Icon="@RynzoIcons.Get("Italic")" OnClick="ToggleItalic" /><span></span><MudIconButton Icon="@RynzoIcons.Get("List")" /><MudIconButton Icon="@RynzoIcons.Get("Link")" /></div><MudTextField T="string" @bind-Value="Content" Lines="5" Placeholder="Write an update for your team..." Variant="Variant.Text" Margin="Margin.Dense" /></div><div class="plugin-editor-footer"><span>@Content.Length characters</span><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearContent">Clear</MudButton></div></FormElementCard>
    </div></section>

    <section class="plugin-section"><header class="plugin-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("KeyRound")" /></span><div><h2>Input enhancements</h2><p>Give sensitive and high-intent inputs clear, useful feedback.</p></div></header><div class="plugin-grid">
        <FormElementCard Id="password" Title="Password strength" Description="Reveal, hide, and assess password quality without leaving the field."><UiFormField Id="plugin-password" Label="New password"><MudTextField T="string" @bind-Value="Password" InputType="@(ShowPassword?InputType.Text:InputType.Password)" Adornment="Adornment.End" AdornmentIcon="@RynzoIcons.Get(ShowPassword?"EyeOff":"Eye")" OnAdornmentClick="TogglePassword" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><div class="plugin-strength" aria-live="polite"><div><i class="@(PasswordScore>=1?"is-active":"")"></i><i class="@(PasswordScore>=2?"is-active":"")"></i><i class="@(PasswordScore>=3?"is-active":"")"></i><i class="@(PasswordScore>=4?"is-active":"")"></i></div><span>@PasswordStrength</span></div><p class="plugin-caption">Use eight or more characters with a number and symbol.</p></FormElementCard>
        <FormElementCard Id="search" Title="Search suggestions" Description="Surface a small set of useful choices as someone types."><UiFormField Id="plugin-city-search" Label="Office location"><MudAutocomplete T="string" @bind-Value="SelectedCity" SearchFunc="SearchCities" ToStringFunc="@(city=>city)" Placeholder="Search a city..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /></UiFormField><p class="plugin-caption">Selected location: <b>@SelectedCity</b></p></FormElementCard>
    </div></section>

    <section class="plugin-section"><header class="plugin-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("Star")" /></span><div><h2>Quick selections</h2><p>Use visual controls for feedback and lightweight categorization.</p></div></header><div class="plugin-grid">
        <FormElementCard Id="rating" Title="Rating input" Description="A direct five-point feedback control with a clear outcome."><div class="plugin-rating" role="radiogroup" aria-label="Product rating">@for(var score=1;score<=5;score++){var value=score;<button type="button" class="@(Rating>=value?"is-active":"")" role="radio" aria-checked="@(Rating==value)" aria-label="@value stars" @onclick="@(()=>Rating=value)"><MudIcon Icon="@RynzoIcons.Get("Star")" /></button>}</div><div class="plugin-rating-summary"><span>Your rating</span><b aria-live="polite">@Rating of 5 · @RatingLabel</b></div><p class="plugin-caption">Your feedback helps prioritize future improvements.</p></FormElementCard>
        <FormElementCard Id="tags" Title="Token input" Description="Add, remove, and review compact categories in one place."><div class="plugin-token-entry"><MudTextField T="string" @bind-Value="NewTag" Placeholder="Add a category" Variant="Variant.Outlined" Margin="Margin.Dense" /><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@RynzoIcons.Get("Plus")" OnClick="AddTag">Add</MudButton></div><div class="plugin-token-list" aria-label="Selected categories">@foreach(var tag in Tags.ToArray()){<MudChip T="string" Color="Color.Primary" Variant="Variant.Text" CloseIcon="@RynzoIcons.Get("X")" OnClose="@((MudChip<string> _)=>Tags.Remove(tag))">@tag</MudChip>}@if(!Tags.Any()){<span>No categories selected.</span>}</div><p class="plugin-caption">Press Add to save the current category.</p></FormElementCard>
    </div></section>
</div>

@code {
    private DateTime? StartDate=new(2026,10,9), EndDate=new(2026,10,16);
    private TimeSpan? MeetingTime=new(10,30,0); private string Timezone="UTC −08:00", BrandColor="#5546E8", Content="Share a concise update with everyone working on this project."; private string? SelectedFile;
    private decimal Budget=12000;
    private string Password="", SelectedCity="San Francisco", NewTag=""; private bool ShowPassword; private int Rating=4;
    private readonly List<string> Tags=["Product","Research"];
    private static readonly string[] Cities=["San Francisco","New York","London","Berlin","Singapore"];
    private int DurationDays=>StartDate is not null&&EndDate is not null?Math.Max(0,(EndDate.Value-StartDate.Value).Days):0;
    private Task<IEnumerable<string>> SearchCities(string value,CancellationToken _)=>Task.FromResult(Cities.Where(city=>city.Contains(value??"",StringComparison.OrdinalIgnoreCase)));
    private int PasswordScore=>(Password.Length>=8?1:0)+(Password.Any(char.IsDigit)?1:0)+(Password.Any(char.IsUpper)?1:0)+(Password.Any(ch=>!char.IsLetterOrDigit(ch))?1:0);
    private string PasswordStrength=>PasswordScore switch {0=>"Enter a password",1=>"Weak",2=>"Fair",3=>"Good",_=>"Strong"};
    private string RatingLabel=>Rating switch {1=>"Needs work",2=>"Could improve",3=>"Good",4=>"Great",_=>"Excellent"};
    private void TogglePassword()=>ShowPassword=!ShowPassword;
    private void AddTag(){var tag=NewTag.Trim();if(tag.Length>0&&!Tags.Contains(tag,StringComparer.OrdinalIgnoreCase)){Tags.Add(tag);NewTag="";}}
    private void ChooseFile(InputFileChangeEventArgs args)=>SelectedFile=args.File.Name;
    private void ClearFile()=>SelectedFile=null;
    private void ClearContent()=>Content="";
    private void ToggleBold()=>Snackbar.Add("Bold formatting is ready for your editor integration",Severity.Normal);
    private void ToggleItalic()=>Snackbar.Add("Italic formatting is ready for your editor integration",Severity.Normal);
    private void Save()=>Snackbar.Add("Plugin preferences saved",Severity.Success);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
}
