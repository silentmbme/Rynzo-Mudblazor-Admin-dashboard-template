@page "/forms/plugins"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Form plugins | Rynzo</PageTitle>
