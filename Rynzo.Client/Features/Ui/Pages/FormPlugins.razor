1}.form-plugins-page .plugin-suggestions svg{width:16px;height:16px;color:var(--primary)}.form-plugins-page .plugin-suggestions p{margin:0;padding:20px;text-align:center;color:var(--muted-foreground);font-size:var(--rynzo-font-caption)}.form-plugins-page .plugin-rating{display:flex;gap:8px}.form-plugins-page .plugin-rating button{display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--border);border-radius:9px;background:var(--card);color:var(--muted-foreground);cursor:pointer}.form-plugins-page .plugin-rating button.is-active{border-color:color-mix(in srgb,var(--warning) 45%,var(--border));background:color-mix(in srgb,var(--warning) 10%,var(--card));color:var(--warning)}.form-plugins-page .plugin-rating svg{width:21px;height:21px}.form-plugins-page .plugin-rating-summary{display:flex;justify-content:space-between;gap:12px;margin-top:22px;padding-top:17px;border-top:1px solid var(--border);font-size:var(--rynzo-font-caption)}.form-plugins-page .plugin-rating-summary span{color:var(--muted-foreground)}.form-plugins-page .plugin-rating-summary b{font-weight:600}.form-plugins-page .plugin-token-entry{gap:10px}.form-plugins-page .plugin-token-entry input{padding-right:12px}.form-plugins-page .plugin-token-list{display:flex;min-height:72px;align-items:center;gap:8px;flex-wrap:wrap;margin-top:16px;padding:14px;border:1px solid var(--border);border-radius:10px;background:var(--background)}.form-plugins-page .plugin-token-list .mud-chip{margin:0;background:color-mix(in srgb,var(--primary) 8%,var(--card));color:var(--primary);font-size:var(--rynzo-font-caption)}.form-plugins-page .plugin-token-list>span{font-size:var(--rynzo-font-caption);color:var(--muted-foreground)}@media(max-width:540px){.form-plugins-page .plugin-strength span{min-width:auto}.form-plugins-page .plugin-rating{gap:6px}.form-plugins-page .plugin-rating button{width:38px;height:38px}}
