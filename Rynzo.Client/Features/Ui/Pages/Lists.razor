@page "/ui/lists"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Lists | Rynzo</PageTitle>
<div class="lists-page">
    <DashboardPageHeader Title="Lists" Description="Structured rows for activity, people, files, tasks, and operational records."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <MudCard Class="lists-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span><MudIcon Icon="@RynzoIcons.Get("List")" /></span><div><small>Component library / Collections</small><h2>Every row, a clearer picture.</h2><p>Bring people, activity, and operational details into a consistent, scannable rhythm.</p></div><span class="lists-intro-note">Organized for everyday work</span></MudCard>
    <div class="lists-grid">
        <ButtonShowcaseCard Id="activity" Title="Activity list" Description="A chronological stream of meaningful workspace updates." Code="@ActivityCode"><div class="lists-section-heading"><span>Workspace activity</span><UiStatusChip Color="Color.Default">Today</UiStatusChip></div><ul class="lists-records lists-activity">@foreach(var item in Activity){<UiRecordRow Title="@item.Title" Description="@item.Meta" Icon="@item.Icon" Tone="@item.Tone" />}</ul></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="contacts" Title="Contact list" Description="Pair real portraits with role context and a quick action." Code="@ContactsCode"><div class="lists-section-heading"><span>Your collaborators</span><span>3 people</span></div><ul class="lists-records">@foreach(var person in Contacts){<UiRecordRow Title="@person.Name" Description="@person.Role"><Leading><UiPersonAvatar Name="@person.Name" Src="@person.Photo" Status="@(person.Online?"Online":"Away")" Pixels="40" /></Leading><Actions><MudIconButton Size="Size.Small" Icon="@RynzoIcons.Get("MessageSquare")" aria-label="@($"Message {person.Name}")" title="@person.Status" OnClick="@(()=>Notify($"Messaging {person.Name}"))" /></Actions></UiRecordRow>}</ul><p class="lists-caption"><i></i> Presence is shown beside each portrait.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="selection" Title="Selectable rows" Description="Select projects for bulk work while keeping status in view." Code="@SelectionCode"><div class="lists-section-heading"><span>Project selection</span><span aria-live="polite">@Selected.Count selected</span></div><ul class="lists-selectable">@foreach(var project in Projects){<li><button type="button" class="lists-selection-row @(Selected.Contains(project.Name)?"is-selected":"")" aria-pressed="@(Selected.Contains(project.Name)?"true":"false")" aria-label="@($"Select {project.Name}")" @onclick="@(()=>Toggle(project.Name))"><span class="lists-check" aria-hidden="true">@if(Selected.Contains(project.Name)){<MudIcon Icon="@RynzoIcons.Get("Check")" />}</span><span class="lists-row-copy"><b>@project.Name</b><small>@project.Id</small></span><UiStatusChip Color="@(project.Risk?Color.Warning:Color.Success)" Dot="true">@(project.Risk?"At risk":"On track")</UiStatusChip></button></li>}</ul><p class="lists-caption" aria-live="polite">@Selected.Count project@(Selected.Count==1?"":"s") selected</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="files" Title="File list" Description="Clear file types, useful metadata, and contextual actions." Code="@FilesCode"><div class="lists-section-heading"><span>Project resources</span><span>3 files</span></div><ul class="lists-records">@foreach(var file in Files){<UiRecordRow Title="@file.Name" Description="@file.Meta" Icon="@file.Icon" Tone="@file.Tone"><Actions><MudIconButton Size="Size.Small" Icon="@RynzoIcons.Get("Download")" aria-label="@($"Download {file.Name}")" OnClick="@(()=>Notify($"{file.Name} downloaded"))" /><MudIconButton Size="Size.Small" Icon="@RynzoIcons.Get("Ellipsis")" aria-label="@($"More options for {file.Name}")" /></Actions></UiRecordRow>}</ul></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="tasks" Title="Task list" Description="Checks, ownership, and priority keep active work easy to scan." Code="@TasksCode"><div class="lists-section-heading"><span>Delivery checklist</span><span aria-live="polite">@Completed.Count(value=>value) of 4 complete</span></div><ul class="lists-tasks">@for(var i=0;i<TaskItems.Length;i++){var index=i;var task=TaskItems[index];<li class="@(Completed[index]?"is-complete":"")"><MudCheckBox T="bool" Value="Completed[index]" ValueChanged="@(value=>Completed[index]=value)" Color="Color.Primary" Size="Size.Small" aria-label="@task.Title" /><span class="lists-row-copy"><b>@task.Title</b><small>Assigned to @task.Owner</small></span><UiStatusChip Color="@(task.Priority=="High"?Color.Error:task.Priority=="Medium"?Color.Warning:Color.Default)">@task.Priority</UiStatusChip></li>}</ul></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="invoices" Title="Invoice list" Description="Aligned amounts and status pills for financial records." Code="@InvoicesCode"><div class="lists-section-heading"><span>Recent invoices</span><span>3 records</span></div><ul class="lists-records">@foreach(var invoice in Invoices){<UiRecordRow Title="@invoice.Id" Description="@invoice.Customer" Icon="ReceiptText"><Actions><span class="lists-invoice-total"><b>@invoice.Amount</b><UiStatusChip Color="@(invoice.Status=="Paid"?Color.Success:invoice.Status=="Overdue"?Color.Error:Color.Info)">@invoice.Status</UiStatusChip></span></Actions></UiRecordRow>}</ul></ButtonShowcaseCard>
        <div class="lists-notifications-section"><ButtonShowcaseCard Id="notifications" Title="Notification list" Description="Unread indicators and clear actions help important updates stand out." Code="@NotificationsCode"><div class="lists-section-heading"><span>Workspace notifications</span><UiStatusChip Color="Color.Primary">2 unread</UiStatusChip></div><ul class="lists-notifications">@foreach(var item in Notifications){<li><button type="button" class="@(item.Unread?"is-unread":"")" @onclick="@(()=>Notify($"{item.Title} opened"))"><span class="lists-notification-icon"><MudIcon Icon="@RynzoIcons.Get(item.Icon)" /></span><span class="lists-row-copy"><b>@item.Title</b><small>@item.Meta</small></span>@if(item.Unread){<span class="lists-unread-dot" aria-label="Unread"></span>}<MudIcon Icon="@RynzoIcons.Get("ChevronRight")" /></button></li>}</ul></ButtonShowcaseCard></div>
    </div>
</div>
@code {
    private readonly HashSet<string> Selected=["Website Redesign"];
    private readonly bool[] Completed=[true,true,false,false];
    private void Toggle(string name){if(!Selected.Add(name))Selected.Remove(name);}
    private void Notify(string message)=>Snackbar.Add(message,Severity.Success);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private static readonly (string Title,string Meta,string Icon,string Tone)[] Activity=[("Sophia completed Design review","Website Redesign - 12 min ago","CheckCircle2","var(--success)"),("Daniel added checkout-spec.pdf","Files - 45 min ago","FilePlus2","var(--primary)"),("Emma left a review comment","Mobile App - 2 hours ago","MessageSquare","var(--info)"),("Budget review is due","Marketing Automation - Today","CircleAlert","var(--warning)")];
    private static readonly (string Name,string Role,string Photo,string Status,bool Online)[] Contacts=[("Sophia Carter","Project Manager","assets/images/users/sophia-carter.jpg","Online",true),("Daniel Lee","Frontend Developer","assets/images/users/user-2.jpg","In a meeting",false),("Emma Wilson","Product Designer","assets/images/users/user-3.jpg","Online",true)];
    private static readonly (string Name,string Id,bool Risk)[] Projects=[("Website Redesign","PRJ-1048",false),("Mobile App v2","PRJ-1052",true),("CRM Migration","PRJ-1061",false)];
    private static readonly (string Name,string Meta,string Icon,string Tone)[] Files=[("checkout-spec.pdf","PDF - 2.4 MB","File","var(--destructive)"),("Q3-budget.xlsx","Spreadsheet - 846 KB","Sheet","var(--success)"),("design-assets.zip","Archive - 16.8 MB","Archive","var(--info)")];
    private static readonly (string Title,string Owner,string Priority)[] TaskItems=[("Review desktop layout","Sophia","High"),("Validate payment states","Daniel","Medium"),("Write mobile test cases","Emma","High"),("Prepare QA handoff","Noah","Low")];
    private static readonly (string Id,string Customer,string Amount,string Status)[] Invoices=[("INV-2048","CloudAxis","$8,420","Paid"),("INV-2049","Vertex Labs","$4,860","Sent"),("INV-2050","Rynzo Systems","$12,640","Overdue")];
    private static readonly (string Title,string Meta,string Icon,bool Unread)[] Notifications=[("AI summary is ready","Design review meeting - 8 min ago","Sparkles",true),("Mia joined your workspace","Invite accepted - 2 hours ago","UserPlus",true),("Planning session tomorrow","Aug 28 at 10:00 AM","CalendarClock",false)];
    private const string ActivityCode="<ul><UiRecordRow Title=\"Sophia completed Design review\"\n    Description=\"Website Redesign - 12 min ago\" Icon=\"CheckCircle2\" /></ul>";
    private const string ContactsCode="<UiRecordRow Title=\"Sophia Carter\" Description=\"Project Manager\">\n    <Leading><UiPersonAvatar Name=\"Sophia Carter\" Src=\"assets/images/users/user-1.jpg\" /></Leading>\n</UiRecordRow>";
    private const string SelectionCode="<button aria-pressed=\"@Selected.Contains(name)\"\n    @onclick=\"@(() => Toggle(name))\">...</button>";
    private const string FilesCode="<UiRecordRow Title=\"checkout-spec.pdf\" Description=\"PDF - 2.4 MB\" Icon=\"File\">\n    <Actions><MudIconButton Icon=\"@RynzoIcons.Get(\"Download\")\" /></Actions>\n</UiRecordRow>";
    private const string TasksCode="<MudCheckBox T=\"bool\" @bind-Value=\"Completed[index]\" Color=\"Color.Primary\" />";
    private const string InvoicesCode="<UiRecordRow Title=\"INV-2048\" Description=\"CloudAxis\" Icon=\"ReceiptText\">\n    <Actions><UiStatusChip Color=\"Color.Success\">Paid</UiStatusChip></Actions>\n</UiRecordRow>";
    private const string NotificationsCode="<button @onclick=\"OpenNotification\">\n    <!-- Icon, title, context, and unread indicator -->\n</button>";
}
