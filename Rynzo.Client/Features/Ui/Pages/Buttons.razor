@page "/ui/buttons"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Buttons | Rynzo</PageTitle>
<div class="buttons-page">
    <DashboardPageHeader Title="Buttons" Description="Core variants, sizes, states, and action patterns for your workspace."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <section class="buttons-intro"><span class="buttons-intro-icon"><MudIcon Icon="@RynzoIcons.Get("MousePointer2")" /></span><div><span class="buttons-eyebrow">Component library / Actions</span><h2>Small controls. Clear intent.</h2><p>Consistent buttons for primary actions, quiet alternatives, and everything in between.</p></div><div class="buttons-intro-meta"><span><MudIcon Icon="@RynzoIcons.Get("Check")" />MudBlazor components</span><span><MudIcon Icon="@RynzoIcons.Get("Code2")" />Reusable Razor examples</span></div></section>
    <div class="buttons-layout"><main class="buttons-examples">
    <ButtonShowcaseCard Id="variants" Title="Core variants" Description="Seven treatments with a consistent shape and interaction model." Code="@CoreCode"><div class="buttons-row"><MudButton Variant="Variant.Filled" Color="Color.Primary">Primary</MudButton><MudButton Variant="Variant.Filled" Color="Color.Secondary">Secondary</MudButton><MudButton Variant="Variant.Outlined">Outline</MudButton><MudButton Variant="Variant.Text">Ghost</MudButton><UiActionButton Soft="true">Soft</UiActionButton><UiActionButton Gradient="true">Gradient</UiActionButton><MudButton Variant="Variant.Filled" Color="Color.Error">Danger</MudButton></div><p class="buttons-note">Filled for emphasis, outlined for alternatives, and text for low-priority actions.</p></ButtonShowcaseCard>
    <ButtonShowcaseCard Id="sizes" Title="Sizes &amp; icon-only" Description="Three sizes for text actions and compact icon controls." Code="@SizesCode"><div class="buttons-size-layout"><div><span class="buttons-label">Text buttons</span><div class="buttons-row"><MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Small</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary">Medium</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">Large</MudButton></div></div><div><span class="buttons-label">Icon buttons</span><div class="buttons-row"><MudIconButton Icon="@RynzoIcons.Get("Settings")" Variant="Variant.Outlined" Size="Size.Small" aria-label="Settings" /><MudIconButton Icon="@RynzoIcons.Get("Plus")" Color="Color.Primary" Size="Size.Medium" aria-label="Add" /><MudIconButton Icon="@RynzoIcons.Get("MoreHorizontal")" Size="Size.Large" aria-label="More" /></div></div></div></ButtonShowcaseCard>
    <div class="buttons-pair"><ButtonShowcaseCard Id="pill" Title="Pill shape" Description="Capsule actions for softer visual emphasis." Code="@PillCode"><div class="buttons-row"><UiActionButton Pill="true">Get started</UiActionButton><UiActionButton Pill="true" Variant="Variant.Outlined">Learn more</UiActionButton><UiActionButton Pill="true" Soft="true" StartIcon="@RynzoIcons.Get("UserPlus")">Follow</UiActionButton><UiActionButton Pill="true" Gradient="true">Upgrade to Pro</UiActionButton></div></ButtonShowcaseCard>
    <ButtonShowcaseCard Id="icons" Title="With icons" Description="Leading and trailing icons communicate intent." Code="@IconsCode"><div class="buttons-row"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")">New item</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")">Export</MudButton><UiActionButton Soft="true" EndIcon="@RynzoIcons.Get("ArrowRight")">Continue</UiActionButton><MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@RynzoIcons.Get("Trash2")">Delete</MudButton></div></ButtonShowcaseCard></div>
    <ButtonShowcaseCard Id="states" Title="Loading &amp; states" Description="Responsive feedback, disabled actions, and full-width controls." Code="@StatesCode"><div class="buttons-state-layout"><div><span class="buttons-label">Interactive states</span><div class="buttons-row"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Send message</MudButton><UiActionButton Variant="Variant.Outlined" Loading="Busy" aria-busy="@(Busy?"true":"false")" OnClick="Save">@(Busy?"Saving":"Save changes")</UiActionButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true">Disabled</MudButton><MudButton Variant="Variant.Outlined" Disabled="true">Disabled</MudButton></div></div><div class="buttons-full"><span class="buttons-label">Full width</span><MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick='@(()=>Snackbar.Add("Message sent",Severity.Success))'>Send message</MudButton></div></div><p class="buttons-note"><MudIcon Icon="@RynzoIcons.Get("Info")" />Tab onto any button to inspect the token-driven focus ring.</p></ButtonShowcaseCard>
    <ButtonShowcaseCard Id="status" Title="Status buttons" Description="Semantic colors for feedback and decisions." Code="@StatusCode"><div class="buttons-status-layout"><div><span class="buttons-label">Solid emphasis</span><div class="buttons-row"><MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@RynzoIcons.Get("Check")">Approve</MudButton><MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@RynzoIcons.Get("Eye")">Review</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@RynzoIcons.Get("X")">Reject</MudButton><MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@RynzoIcons.Get("Info")">Details</MudButton></div></div><div><span class="buttons-label">Soft emphasis</span><div class="buttons-row"><UiActionButton Soft="true" Color="Color.Success">Success</UiActionButton><UiActionButton Soft="true" Color="Color.Warning">Warning</UiActionButton><UiActionButton Soft="true" Color="Color.Error">Danger</UiActionButton><UiActionButton Soft="true" Color="Color.Info">Info</UiActionButton></div></div></div></ButtonShowcaseCard>
    <ButtonShowcaseCard Id="groups" Title="Button groups" Description="Joined controls for related choices and split actions." Code="@GroupsCode"><div class="buttons-group-layout"><div><span class="buttons-label">Segmented control</span><MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary">@foreach(var item in new[]{"Day","Week","Month"}){<MudButton Class="@(Period==item?"period-selected":"")" aria-pressed="@(Period==item?"true":"false")" OnClick="@(()=>Period=item)">@item</MudButton>}</MudButtonGroup><p class="buttons-note" role="status">Selected period: @Period</p></div><div><span class="buttons-label">Split action</span><div class="buttons-split"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick='@(()=>Snackbar.Add("Changes saved",Severity.Success))'>Save changes</MudButton><MudMenu Icon="@RynzoIcons.Get("ChevronDown")" Variant="Variant.Filled" Color="Color.Primary" aria-label="More save actions" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"><MudMenuItem OnClick='@(()=>Snackbar.Add("Saved as draft",Severity.Normal))'>Save as draft</MudMenuItem><MudMenuItem OnClick='@(()=>Snackbar.Add("Saved and published",Severity.Success))'>Save &amp; publish</MudMenuItem></MudMenu></div></div></div></ButtonShowcaseCard>
    </main></div>
</div>
@code {
    private bool Busy;private string Period="Week";
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private async Task Save(){if(Busy)return;Busy=true;await Task.Delay(900);Busy=false;Snackbar.Add("Changes saved",Severity.Success);}
    private const string CoreCode="<MudButton Variant=\"Variant.Filled\" Color=\"Color.Primary\">Primary</MudButton>\n<MudButton Variant=\"Variant.Outlined\">Outline</MudButton>\n<MudButton Variant=\"Variant.Text\">Ghost</MudButton>\n<UiActionButton Soft=\"true\">Soft</UiActionButton>\n<UiActionButton Gradient=\"true\">Gradient</UiActionButton>\n<MudButton Variant=\"Variant.Filled\" Color=\"Color.Error\">Danger</MudButton>";
    private const string SizesCode="<MudButton Size=\"Size.Small\">Small</MudButton>\n<MudButton Size=\"Size.Medium\">Medium</MudButton>\n<MudButton Size=\"Size.Large\">Large</MudButton>\n<MudIconButton Icon=\"@RynzoIcons.Get(\"Plus\")\" aria-label=\"Add\" />";
    private const string PillCode="<UiActionButton Pill=\"true\">Get started</UiActionButton>\n<UiActionButton Pill=\"true\" Variant=\"Variant.Outlined\">Learn more</UiActionButton>";
    private const string IconsCode="<MudButton StartIcon=\"@RynzoIcons.Get(\"Plus\")\">New item</MudButton>\n<UiActionButton Soft=\"true\" EndIcon=\"@RynzoIcons.Get(\"ArrowRight\")\">Continue</UiActionButton>";
    private const string StatesCode="<UiActionButton Loading=\"Busy\" OnClick=\"Save\">\n    @(Busy ? \"Saving\" : \"Save changes\")\n</UiActionButton>\n<MudButton Disabled=\"true\">Disabled</MudButton>\n<MudButton FullWidth=\"true\">Send message</MudButton>";
    private const string StatusCode="<MudButton Variant=\"Variant.Filled\" Color=\"Color.Success\">Approve</MudButton>\n<MudButton Variant=\"Variant.Filled\" Color=\"Color.Warning\">Review</MudButton>\n<UiActionButton Soft=\"true\" Color=\"Color.Info\">Info</UiActionButton>";
    private const string GroupsCode="<MudButtonGroup Variant=\"Variant.Outlined\" Color=\"Color.Primary\">\n    <MudButton OnClick=\"@(() => Period = \"Day\")\">Day</MudButton>\n    <MudButton OnClick=\"@(() => Period = \"Week\")\">Week</MudButton>\n</MudButtonGroup>\n<MudMenu Icon=\"@RynzoIcons.Get(\"ChevronDown\")\" aria-label=\"More save actions\">\n    <MudMenuItem>Save as draft</MudMenuItem>\n    <MudMenuItem>Save &amp; publish</MudMenuItem>\n</MudMenu>";
}
