@page "/ui/modals"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IDialogService DialogService
@inject IJSRuntime JS
<PageTitle>Dialog | Rynzo</PageTitle>
<div class="dialogs-page"><DashboardPageHeader Title="Dialog" Description="Focused overlays for forms, confirmations, actions, and detailed content."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
<MudCard Class="dialogs-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span><MudIcon Icon="@RynzoIcons.Get("PanelTop")" /></span><div><small>Component library / Dialog</small><h2>A focused space for the next step.</h2><p>From quick confirmations to guided workflows, keep the task clear and close.</p></div></MudCard>
<div class="dialogs-grid">@foreach(var example in Examples){<ButtonShowcaseCard Id="@example.Id" Title="@example.Title" Description="@example.Description" Code="@Code(example.Id)"><div class="dialog-example-preview"><span class="dialog-example-icon"><MudIcon Icon="@RynzoIcons.Get(example.Icon)" /></span><div><span class="dialog-example-label">@example.Caption</span>@if(example.Id=="sizes"){<div class="dialog-size-buttons">@foreach(var size in new[]{"sm","md","lg","xl"}){<MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>Open("size-"+size))">@size.ToUpperInvariant()</MudButton>}</div>}else if(example.Id=="confirmations"){<div class="dialog-size-buttons"><MudButton Variant="Variant.Filled" Color="Color.Error" OnClick='@(()=>Open("confirm-delete"))'>Delete project</MudButton><MudButton Variant="Variant.Filled" Color="Color.Success" OnClick='@(()=>Open("confirm-publish"))'>Publish</MudButton></div>}else{<MudButton Variant="@(example.Id is "confirm" or "details" or "task" or "scroll" or "sheet"?Variant.Outlined:Variant.Filled)" Color="@(example.Id=="delete"?Color.Error:Color.Primary)" OnClick="@(()=>Open(example.Id))">@example.Button</MudButton>}@if(example.Id=="controlled"){<small role="status">State: @(ControlledOpen?"open":"closed")</small>}</div></div>@if(example.Id=="sheet"){<p class="dialog-example-note">On mobile, dialogs remain easy to dismiss and fit the viewport.</p>}</ButtonShowcaseCard>}</div><p class="dialog-example-note">Examples use local feedback. No real records, invitations, or workspace settings are changed.</p></div>
@code {
 private bool ControlledOpen;
 private record Example(string Id,string Title,string Description,string Button,string Icon,string Caption);
 private static readonly Example[] Examples=[new("basic","Basic dialog","A focused message with primary and secondary actions.","Open dialog","MessageSquare","Simple feedback"),new("confirm","Confirmation","Confirm an important, reversible action.","Confirm action","CircleCheck","Review before continuing"),new("form","Project form","A compact form for creating a focused record.","Add project","Folder","Plain inputs / Project details"),new("delete","Destructive dialog","A clear warning before removing an item.","Delete item","Trash2","Destructive action"),new("details","Large details dialog","Review a complete record without leaving the page.","View details","PanelTop","Project overview"),new("controlled","Controlled state","Open and close a dialog using external state.","Open controlled dialog","SlidersHorizontal","External state"),new("wizard","Setup wizard","A three-step workspace setup experience.","Start setup","Sparkles","Workspace / Invite / Ready"),new("command","Command palette","Search for common actions in a focused menu.","Open command menu","Search","Find an action"),new("task","Task workspace","Review status, assignee, and recent activity.","Open task details","ListTodo","Task context"),new("sizes","Sizes","Small, medium, large, and extra-large dialog widths.","","PanelTop","Choose a dialog size"),new("confirmations","Confirm dialogs","Destructive and success confirmation layouts.","","ShieldCheck","Delete or publish"),new("invite-form","Invitation form","Plain fields and clear footer actions for data entry.","Invite teammate","UserPlus","Email / Role / Message"),new("scroll","Scrollable","Long content scrolls inside the dialog body.","Open changelog","FileText","Release history"),new("full","Fullscreen","A full viewport workspace for uninterrupted focus.","Open workspace","PanelTop","Focused work surface"),new("sheet","Side sheet","A right-hand drawer for contextual details.","Open details drawer","PanelLeft","Project context"),new("warp","Focus overlay","A spacious overlay for a high-impact action.","Open warp overlay","Sparkles","Workspace at a glance")];
 private async Task Open(string mode){var size=mode switch{"size-sm"=>MaxWidth.ExtraSmall,"size-md"=>MaxWidth.Small,"size-lg"=>MaxWidth.Medium,"size-xl"=>MaxWidth.Large,"details" or "task" or "warp"=>MaxWidth.Medium,_=>MaxWidth.Small};var options=new DialogOptions{FullWidth=true,MaxWidth=size,FullScreen=mode=="full",CloseButton=true,CloseOnEscapeKey=true,BackgroundClass="rynzo-source-backdrop",Position=mode=="sheet"?DialogPosition.CenterRight:null};if(mode=="controlled")ControlledOpen=true;var dialog=await DialogService.ShowAsync<ShowcaseDialog>("",new DialogParameters{{nameof(ShowcaseDialog.Mode),mode}},options);await dialog.Result;if(mode=="controlled")ControlledOpen=false;}
 private async Task Print()=>await JS.InvokeVoidAsync("print");
 private static string Code(string mode)=>$"var options = new DialogOptions\n{{\n    FullWidth = true, CloseButton = true, CloseOnEscapeKey = true,\n    MaxWidth = MaxWidth.{(mode=="details"||mode=="task"?"Medium":"Small")}\n}};\nawait DialogService.ShowAsync<ShowcaseDialog>(\"\",\n    new DialogParameters {{ [nameof(ShowcaseDialog.Mode)] = \"{mode}\" }}, options);";
}
