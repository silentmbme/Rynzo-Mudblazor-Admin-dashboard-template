@page "/ui/icons"
@namespace Rynzo.Client.Features.Ui.Pages.IconLibrary
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Icons | Rynzo</PageTitle>
<style>.icons-filter{width:210px}.icons-filter .mud-input-control{margin:0}</style>
<div class="icons-page"><DashboardPageHeader Title="Icons" Description="A consistent Lucide icon system for navigation, actions, status, and content."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Copy")" OnClick="CopyImport">Copy import</MudButton></Actions></DashboardPageHeader><section class="icons-toolbar"><MudTextField T="string" @bind-Value="Search" @bind-Value:event="oninput" Placeholder="Search icons..." Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" Variant="Variant.Outlined" Margin="Margin.Dense" /><div class="icons-filter"><MudSelect T="string" @bind-Value="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Icon category"><MudSelectItem Value="@("All")">All categories</MudSelectItem>@foreach(var category in Categories){<MudSelectItem Value="@category">@category</MudSelectItem>}</MudSelect></div></section><div class="icons-summary"><span><b>@Filtered.Count()</b> icons available</span><span>Click any icon to copy its name.</span></div><section class="icons-grid">@foreach(var icon in Filtered){<button type="button" class="icon-card" title="Copy @icon.Name" @onclick="@(()=>Copy(icon.Name))"><span><MudIcon Icon="@RynzoIcons.Get(icon.Name)" /></span><b>@icon.Name</b><small>@icon.Category</small></button>}</section></div>
@code {private string Search="",Category="All";private static readonly string[] Categories=["Navigation","Actions","Status","Content","People","Commerce","Communication","Security","Charts","Devices"];private static readonly IconItem[] Items=[new("Home","Navigation"),new("Menu","Navigation"),new("PanelLeft","Navigation"),new("ArrowLeft","Navigation"),new("ArrowRight","Navigation"),new("ChevronDown","Navigation"),new("Plus","Actions"),new("Pencil","Actions"),new("Save","Actions"),new("Trash2","Actions"),new("Download","Actions"),new("Upload","Actions"),new("Copy","Actions"),new("Check","Status"),new("CircleCheck","Status"),new("CircleAlert","Status"),new("Info","Status"),new("TriangleAlert","Status"),new("FileText","Content"),new("Mail","Content"),new("Calendar","Content"),new("Link","Content"),new("Image","Content"),new("UserRound","People"),new("Users","People"),new("UserRoundPlus","People"),new("UserCheck","People"),new("ShoppingCart","Commerce"),new("CreditCard","Commerce"),new("Package","Commerce"),new("ReceiptText","Commerce"),new("Wallet","Commerce"),new("CircleDollarSign","Commerce"),new("MessageSquare","Communication"),new("Phone","Communication"),new("Bell","Communication"),new("Send","Communication"),new("MailPlus","Communication"),new("Video","Communication"),new("ShieldCheck","Security"),new("LockKeyhole","Security"),new("KeyRound","Security"),new("Lock","Security"),new("EyeOff","Security"),new("ChartNoAxesCombined","Charts"),new("PieChart","Charts"),new("BarChart3","Charts"),new("TrendingUp","Charts"),new("Activity","Charts"),new("Monitor","Devices"),new("Laptop","Devices"),new("Smartphone","Devices"),new("AppWindow","Devices"),new("PanelsTopLeft","Devices")];private IEnumerable<IconItem> Filtered=>Items.Where(item=>(Category=="All"||item.Category==Category)&&item.Name.Contains(Search,StringComparison.OrdinalIgnoreCase));private async Task Copy(string name){await JS.InvokeVoidAsync("navigator.clipboard.writeText",name);Snackbar.Add($"{name} copied",Severity.Success);}private async Task CopyImport(){await JS.InvokeVoidAsync("navigator.clipboard.writeText","@using Rynzo.Client.Theme");Snackbar.Add("Import copied",Severity.Success);}private sealed record IconItem(string Name,string Category);}
