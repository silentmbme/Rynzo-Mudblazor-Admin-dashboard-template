@page "/ui/dropdowns"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Dropdowns | Rynzo</PageTitle>
<div class="dropdowns-page">
    <DashboardPageHeader Title="Dropdowns" Description="Accessible menus, selections, and contextual actions for your workspace."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <MudCard Class="dropdowns-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span class="dropdowns-intro-icon"><MudIcon Icon="@RynzoIcons.Get("ListFilter")" /></span><div><span class="dropdowns-eyebrow">Component library / Menus</span><h2>More options. Less clutter.</h2><p>Keep related actions close, with clear choices and predictable interaction.</p></div><div class="dropdowns-intro-meta"><span><MudIcon Icon="@RynzoIcons.Get("MousePointer2")" />Click to explore</span><span><MudIcon Icon="@RynzoIcons.Get("Code2")" />Keyboard accessible</span></div></MudCard>
    <div class="dropdowns-grid">
        <ButtonShowcaseCard Id="basic" Title="Basic actions" Description="A contextual menu with icons, a shortcut hint, and a destructive action." Code="@BasicCode"><div class="dropdowns-demo"><span class="dropdowns-label">Project workspace</span><div class="dropdowns-project"><span><MudIcon Icon="@RynzoIcons.Get("Folder")" /></span><div><h3>Website Redesign</h3><p>Actions for the current project</p></div></div><UiDropdown Label="Project actions" Heading="Website Redesign" Description="Project management" Variant="Variant.Filled"><MudMenuItem Icon="@RynzoIcons.Get("Pencil")" OnClick='@(()=>Action("Edit project"))'><span class="dropdowns-menu-text">Edit<kbd>E</kbd></span></MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Copy")" OnClick='@(()=>Action("Project duplicated"))'>Duplicate</MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Archive")" OnClick='@(()=>Action("Project archived"))'>Archive</MudMenuItem><MudDivider /><MudMenuItem Class="dropdown-danger" Icon="@RynzoIcons.Get("Trash2")" OnClick='@(()=>Action("Delete confirmation opened"))'>Delete project</MudMenuItem></UiDropdown></div><p class="dropdowns-note">Open the trigger to explore the available actions.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="icon" Title="Icon menu" Description="A compact trigger for actions attached to a list row." Code="@IconCode"><div class="dropdowns-file"><span class="dropdowns-file-icon"><MudIcon Icon="@RynzoIcons.Get("FolderOpen")" /></span><div><h3>Design assets</h3><p>Updated 12 minutes ago</p></div><UiDropdown Icon="@RynzoIcons.Get("MoreHorizontal")" AccessibleLabel="More actions" AlignEnd="true" Variant="Variant.Text" Color="Color.Default" Heading="Design assets"><MudMenuItem Icon="@RynzoIcons.Get("Pencil")" OnClick='@(()=>Action("File renamed"))'>Rename</MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Download")" OnClick='@(()=>Action("Download started"))'>Download</MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Link")" OnClick='@(()=>Action("Link copied"))'>Copy link</MudMenuItem></UiDropdown></div><div class="dropdowns-pattern-note"><MudIcon Icon="@RynzoIcons.Get("Info")" /><span>An icon trigger keeps row-level actions within reach without competing with the content.</span></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="checkbox" Title="Checkbox menu" Description="Independent display preferences with persistent check indicators." Code="@CheckboxCode"><div class="dropdowns-option-header"><span class="dropdowns-label">Visible panels</span><UiDropdown Label="Display options" StartIcon="@RynzoIcons.Get("SlidersHorizontal")" Heading="Visible panels" Description="Choose what to show"><MudMenuItem AutoClose="false" role="menuitemcheckbox" aria-checked="@(ShowSidebar?"true":"false")" Icon="@(ShowSidebar?RynzoIcons.Get("CheckSquare"):Icons.Material.Outlined.CheckBoxOutlineBlank)" OnClick="@(()=>ShowSidebar=!ShowSidebar)">Show sidebar</MudMenuItem><MudMenuItem AutoClose="false" role="menuitemcheckbox" aria-checked="@(ShowActivity?"true":"false")" Icon="@(ShowActivity?RynzoIcons.Get("CheckSquare"):Icons.Material.Outlined.CheckBoxOutlineBlank)" OnClick="@(()=>ShowActivity=!ShowActivity)">Show activity feed</MudMenuItem><MudMenuItem AutoClose="false" role="menuitemcheckbox" aria-checked="true" Icon="@RynzoIcons.Get("CheckSquare")">Show project health</MudMenuItem></UiDropdown></div><div class="dropdowns-preview" aria-live="polite"><div class="dropdowns-panel-state"><span><MudIcon Icon="@RynzoIcons.Get("PanelLeft")" />Sidebar</span><UiStatusChip Color="@(ShowSidebar?Color.Success:Color.Default)" Dot="true">@(ShowSidebar?"visible":"hidden")</UiStatusChip></div><div class="dropdowns-panel-state"><span><MudIcon Icon="@RynzoIcons.Get("Activity")" />Activity</span><UiStatusChip Color="@(ShowActivity?Color.Success:Color.Default)" Dot="true">@(ShowActivity?"visible":"hidden")</UiStatusChip></div></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="radio" Title="Radio selection" Description="One selected view, with a clear menu indicator." Code="@RadioCode"><div class="dropdowns-option-header"><span class="dropdowns-label">Project view</span><UiDropdown Label="@($"View: {View}")" StartIcon="@RynzoIcons.Get(ViewIcon(View))" Heading="Project view" Description="Select one view">@foreach(var item in new[]{"Board","List","Timeline"}){<MudMenuItem role="menuitemradio" aria-checked="@(View==item?"true":"false")" OnClick="@(()=>View=item)"><span class="dropdowns-radio-item"><i class="@(View==item?"selected":"")"></i>@item<MudIcon Icon="@RynzoIcons.Get(ViewIcon(item))" /></span></MudMenuItem>}</UiDropdown></div><div class="dropdowns-view-preview"><span><MudIcon Icon="@RynzoIcons.Get(ViewIcon(View))" /></span><div><b>@View view</b><p role="status">Selected project view: @View</p></div></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="nested" Title="Nested actions" Description="Native MudBlazor submenus keep grouped actions organized." Code="@NestedCode"><div class="dropdowns-demo"><span class="dropdowns-label">Task workspace</span><div class="dropdowns-task"><span><MudIcon Icon="@RynzoIcons.Get("CheckSquare")" /></span><div><h3>Task actions</h3><p>Inspect, move, or duplicate a task.</p></div></div><UiDropdown Label="Task menu" Heading="Task actions" StartIcon="@RynzoIcons.Get("ListChecks")"><MudMenuItem Icon="@RynzoIcons.Get("Eye")" OnClick='@(()=>Action("Task opened"))'>View task</MudMenuItem><MudMenu Label="Move to" StartIcon="@RynzoIcons.Get("ArrowRightLeft")" Dense="true"><MudMenuItem OnClick='@(()=>Action("Moved to To do"))'>To do</MudMenuItem><MudMenuItem OnClick='@(()=>Action("Moved to In progress"))'>In progress</MudMenuItem><MudMenuItem OnClick='@(()=>Action("Moved to Done"))'>Done</MudMenuItem></MudMenu><MudDivider /><MudMenuItem Icon="@RynzoIcons.Get("Copy")" OnClick='@(()=>Action("Task duplicated"))'>Duplicate task</MudMenuItem></UiDropdown></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="split" Title="Split action" Description="A primary action paired with a menu of related options." Code="@SplitCode"><div class="dropdowns-save-preview"><span class="dropdowns-save-icon"><MudIcon Icon="@RynzoIcons.Get("FileText")" /></span><div><h3>Save your work</h3><p>Choose the main action or open the menu for another option.</p></div></div><div class="dropdowns-split"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Check")" OnClick='@(()=>Snackbar.Add("Changes saved",Severity.Success))'>Save changes</MudButton><UiDropdown Icon="@RynzoIcons.Get("ChevronDown")" AccessibleLabel="More save actions" Variant="Variant.Filled" AlignEnd="true" Heading="Save options"><MudMenuItem OnClick='@(()=>Action("Saved as draft"))'>Save as draft</MudMenuItem><MudMenuItem OnClick='@(()=>Snackbar.Add("Saved and published",Severity.Success))'>Save &amp; publish</MudMenuItem></UiDropdown></div><p class="dropdowns-note">The primary action stays one click away.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="colored" Title="Colored dropdowns" Description="Solid triggers in six semantic colors for stronger emphasis." Code="@ColoredCode"><div class="dropdowns-variant-row">@foreach(var tone in ColorOptions){<UiDropdown Label="@tone.Name" Color="tone.Color" Variant="Variant.Filled" Heading="@($"{tone.Name} actions")"><MudMenuItem Icon="@RynzoIcons.Get("Eye")" OnClick="@(()=>Action($"{tone.Name}: details opened"))">View details</MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Pencil")" OnClick="@(()=>Action($"{tone.Name}: edit opened"))">Edit item</MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Archive")" OnClick="@(()=>Action($"{tone.Name}: item archived"))">Archive item</MudMenuItem></UiDropdown>}</div><p class="dropdowns-note">Primary, secondary, success, warning, danger, and info use the established theme colors.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="light-colors" Title="Light color dropdowns" Description="Soft-tint triggers keep the color while reducing visual weight." Code="@LightCode"><div class="dropdowns-variant-row">@foreach(var tone in ColorOptions){<UiDropdown Label="@($"Light {tone.Name.ToLowerInvariant()}")" Color="tone.Color" Soft="true" Heading="@($"{tone.Name} actions")"><MudMenuItem Icon="@RynzoIcons.Get("Eye")" OnClick="@(()=>Action($"Light {tone.Name}: details opened"))">View details</MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Pencil")" OnClick="@(()=>Action($"Light {tone.Name}: edit opened"))">Edit item</MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Archive")" OnClick="@(()=>Action($"Light {tone.Name}: item archived"))">Archive item</MudMenuItem></UiDropdown>}</div><p class="dropdowns-note">The reusable Soft option adapts its background to the active light or dark theme.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="tinted-menus" Title="Tinted menu surfaces" Description="Color-coordinated triggers, headings, icons, and light menu panels." Code="@TintedCode"><div class="dropdowns-variant-row">@foreach(var tone in ColorOptions.Where(t=>t.Color is Color.Primary or Color.Success or Color.Info)){<UiDropdown Label="@($"{tone.Name} menu")" Color="tone.Color" Soft="true" TintedMenu="true" Heading="@($"{tone.Name} workspace")" Description="A coordinated light menu"><MudMenuItem Icon="@RynzoIcons.Get("Folder")" OnClick="@(()=>Action($"{tone.Name}: projects opened"))">View projects</MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Users")" OnClick="@(()=>Action($"{tone.Name}: team opened"))">Manage team</MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Settings")" OnClick="@(()=>Action($"{tone.Name}: settings opened"))">Workspace settings</MudMenuItem></UiDropdown>}</div><p class="dropdowns-note">Open a menu to see the light color treatment on its surface.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="pill-sizes" Title="Rounded &amp; sized triggers" Description="Capsule menus in small, medium, and large sizes." Code="@PillCode"><div class="dropdowns-variant-row dropdowns-sized-row">@foreach(var size in new[]{Size.Small,Size.Medium,Size.Large}){<UiDropdown Label="@($"{size} menu")" Size="size" Pill="true" Color="@(size==Size.Large?Color.Success:Color.Primary)" Soft="@(size==Size.Medium)" Variant="Variant.Filled" Heading="@($"{size} actions")"><MudMenuItem Icon="@RynzoIcons.Get("Plus")" OnClick="@(()=>Action($"{size}: new item opened"))">New item</MudMenuItem><MudMenuItem Icon="@RynzoIcons.Get("Download")" OnClick="@(()=>Action($"{size}: export started"))">Export items</MudMenuItem></UiDropdown>}</div><p class="dropdowns-note">Combine native MudBlazor Size with the reusable Pill and Soft options.</p></ButtonShowcaseCard>
    </div><p class="dropdowns-demo-note"><MudIcon Icon="@RynzoIcons.Get("Info")" />These examples use local display preferences and feedback messages.</p>
</div>
@code {
    private static readonly (string Name,Color Color)[] ColorOptions=[("Primary",Color.Primary),("Secondary",Color.Secondary),("Success",Color.Success),("Warning",Color.Warning),("Danger",Color.Error),("Info",Color.Info)];
    private const string ColoredCode="<UiDropdown Label=\"Success\" Color=\"Color.Success\" Variant=\"Variant.Filled\">\n    <MudMenuItem OnClick=\"ViewDetails\">View details</MudMenuItem>\n</UiDropdown>";
    private const string LightCode="<UiDropdown Label=\"Light primary\" Color=\"Color.Primary\" Soft=\"true\">\n    <MudMenuItem OnClick=\"ViewDetails\">View details</MudMenuItem>\n</UiDropdown>";
    private const string TintedCode="<UiDropdown Label=\"Success menu\" Color=\"Color.Success\"\n    Soft=\"true\" TintedMenu=\"true\" Heading=\"Success workspace\">\n    <MudMenuItem Icon=\"@RynzoIcons.Get(\"Folder\")\">View projects</MudMenuItem>\n</UiDropdown>";
    private const string PillCode="<UiDropdown Label=\"Small menu\" Size=\"Size.Small\" Pill=\"true\">\n    <MudMenuItem>New item</MudMenuItem>\n</UiDropdown>\n<UiDropdown Label=\"Medium menu\" Pill=\"true\" Soft=\"true\">\n    <MudMenuItem>Export items</MudMenuItem>\n</UiDropdown>";
    private bool ShowSidebar=true,ShowActivity;private string View="Board";
    private void Action(string message)=>Snackbar.Add(message,Severity.Normal);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private static string ViewIcon(string view)=>view switch{"List"=>"List","Timeline"=>"CalendarDays",_=>"LayoutGrid"};
    private const string BasicCode="<UiDropdown Label=\"Project actions\" Heading=\"Website Redesign\">\n    <MudMenuItem Icon=\"@RynzoIcons.Get(\"Pencil\")\" OnClick=\"Edit\">Edit</MudMenuItem>\n    <MudMenuItem OnClick=\"Duplicate\">Duplicate</MudMenuItem>\n</UiDropdown>";
    private const string IconCode="<UiDropdown Icon=\"@RynzoIcons.Get(\"MoreHorizontal\")\"\n    AccessibleLabel=\"More actions\" AlignEnd=\"true\">\n    <MudMenuItem OnClick=\"Rename\">Rename</MudMenuItem>\n</UiDropdown>";
    private const string CheckboxCode="<UiDropdown Label=\"Display options\">\n    <MudMenuItem AutoClose=\"false\" role=\"menuitemcheckbox\"\n        aria-checked=\"@(ShowSidebar ? \"true\" : \"false\")\"\n        OnClick=\"@(() => ShowSidebar = !ShowSidebar)\">\n        Show sidebar\n    </MudMenuItem>\n</UiDropdown>";
    private const string RadioCode="<UiDropdown Label=\"@($\"View: {View}\")\">\n    <MudMenuItem role=\"menuitemradio\"\n        aria-checked=\"@(View == \"Board\" ? \"true\" : \"false\")\"\n        OnClick=\"@(() => View = \"Board\")\">Board</MudMenuItem>\n</UiDropdown>";
    private const string NestedCode="<UiDropdown Label=\"Task menu\">\n    <MudMenu Label=\"Move to\">\n        <MudMenuItem OnClick=\"MoveToDo\">To do</MudMenuItem>\n        <MudMenuItem OnClick=\"MoveDone\">Done</MudMenuItem>\n    </MudMenu>\n</UiDropdown>";
    private const string SplitCode="<MudButton Variant=\"Variant.Filled\" OnClick=\"Save\">Save changes</MudButton>\n<UiDropdown Icon=\"@RynzoIcons.Get(\"ChevronDown\")\"\n    AccessibleLabel=\"More save actions\" AlignEnd=\"true\">\n    <MudMenuItem OnClick=\"SaveDraft\">Save as draft</MudMenuItem>\n</UiDropdown>";
}
