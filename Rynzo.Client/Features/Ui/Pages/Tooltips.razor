@page "/ui/tooltips"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
<PageTitle>Tooltips | Rynzo</PageTitle>
<div class="tooltips-page"><DashboardPageHeader Title="Tooltips" Description="Compact contextual guidance for controls, data, and unfamiliar actions."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
<MudCard Class="tooltips-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span><MudIcon Icon="@RynzoIcons.Get("MessageSquare")" /></span><div><small>Component library / Contextual guidance</small><h2>A helpful detail. Right where it belongs.</h2><p>Clear labels and concise explanations without interrupting the task.</p></div><div class="tooltips-intro-note"><MudIcon Icon="@RynzoIcons.Get("MousePointer2")" /><span>Hover, focus, or tap<br /><b>to explore an example</b></span></div></MudCard>
<div class="tooltips-grid">
<ButtonShowcaseCard Id="basic" Title="Basic tooltip" Description="Give every icon-only action a concise, accessible label." Code="@BasicCode"><div class="tooltip-example-surface"><div><span class="tooltip-example-label">Website Redesign</span><p>Project actions</p></div><div class="tooltip-icon-row">@foreach(var item in new[]{("Edit project","Pencil"),("Duplicate project","Copy"),("Delete project","Trash2")}){<UiHint Text="@item.Item1" Delay="Delay"><MudIconButton Icon="@RynzoIcons.Get(item.Item2)" Variant="Variant.Outlined" aria-label="@item.Item1" /></UiHint>}</div></div><p class="tooltip-note">Labels remain available to assistive technology without relying on the tooltip.</p></ButtonShowcaseCard>
<ButtonShowcaseCard Id="positions" Title="Positions" Description="Four placements keep guidance close to its trigger." Code="@PositionsCode"><div class="tooltip-position-grid"><span></span><UiHint Text="Top" Placement="Placement.Top" Delay="Delay"><MudIconButton Icon="@RynzoIcons.Get("ArrowUp")" Variant="Variant.Outlined" aria-label="Top tooltip" /></UiHint><span></span><UiHint Text="Left" Placement="Placement.Left" Delay="Delay"><MudIconButton Icon="@RynzoIcons.Get("ArrowLeft")" Variant="Variant.Outlined" aria-label="Left tooltip" /></UiHint><span class="tooltip-position-center"><MudIcon Icon="@RynzoIcons.Get("MousePointer2")" /></span><UiHint Text="Right" Placement="Placement.Right" Delay="Delay"><MudIconButton Icon="@RynzoIcons.Get("ArrowRight")" Variant="Variant.Outlined" aria-label="Right tooltip" /></UiHint><span></span><UiHint Text="Bottom" Placement="Placement.Bottom" Delay="Delay"><MudIconButton Icon="@RynzoIcons.Get("ArrowDown")" Variant="Variant.Outlined" aria-label="Bottom tooltip" /></UiHint><span></span></div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="toolbar" Title="Toolbar actions" Description="Keep familiar command labels near compact controls." Code="@ToolbarCode"><span class="tooltip-example-label">Document toolbar</span><div class="tooltip-toolbar" role="toolbar" aria-label="Document actions">@foreach(var item in Toolbar){<UiHint Text="@item.Label" Delay="Delay"><MudIconButton Icon="@RynzoIcons.Get(item.Icon)" aria-label="@item.Label" /></UiHint>@if(item.Label=="Redo"){<span class="tooltip-toolbar-divider"></span>}}</div><p class="tooltip-note">Use the keyboard to focus any action, or hover to see its label.</p></ButtonShowcaseCard>
<ButtonShowcaseCard Id="status" Title="Status explanation" Description="Add a useful explanation to a compact status indicator." Code="@StatusCode"><div class="tooltip-status-list"><div><span><MudIcon Icon="@RynzoIcons.Get("Globe")" />Production API</span><UiHint Text="Deployment is healthy and all checks passed." Delay="Delay"><span tabindex="0" class="tooltip-status-target" aria-label="Operational: deployment is healthy and all checks passed"><UiStatusChip Color="Color.Success" Dot="true">Operational</UiStatusChip></span></UiHint></div><div><span><MudIcon Icon="@RynzoIcons.Get("Clock3")" />Background jobs</span><UiHint Text="Queue delay is above the target of 5 minutes." Delay="Delay"><span tabindex="0" class="tooltip-status-target" aria-label="Delayed: queue delay is above the target of 5 minutes"><UiStatusChip Color="Color.Warning" Dot="true">Delayed</UiStatusChip></span></UiHint></div></div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="rich" Title="Rich tooltip" Description="A compact explanation with a keyboard-shortcut hint." Code="@RichCode"><div class="tooltip-rich-preview"><span><MudIcon Icon="@RynzoIcons.Get("Command")" /></span><h3>Find your next action</h3><p>Hover or focus the trigger for more context.</p><UiHint Delay="Delay"><Content><b>Command palette</b><p>Search pages, projects and actions from anywhere.</p><kbd>Ctrl K</kbd></Content><ChildContent><UiActionButton Soft="true" StartIcon="@RynzoIcons.Get("Command")">Open command palette</UiActionButton></ChildContent></UiHint></div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="delay" Title="Delay and focus" Description="Adjust the opening delay and try keyboard focus." Code="@DelayCode"><div class="tooltip-delay-controls"><span class="tooltip-example-label">Opening delay</span><div>@foreach(var value in new[]{0,250,700}){<MudButton Size="Size.Small" Variant="@(Delay==value?Variant.Filled:Variant.Outlined)" Color="Color.Primary" aria-pressed="@(Delay==value?"true":"false")" OnClick="@(()=>Delay=value)">@value ms</MudButton>}</div></div><div class="tooltip-focus-preview"><UiHint Text="Use Tab to focus this button." Delay="Delay"><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("MousePointer2")">Keyboard focus</MudButton></UiHint><span role="status">Current delay: @Delay ms</span></div><p class="tooltip-note">The selected delay applies to every example on this page.</p></ButtonShowcaseCard>
<ButtonShowcaseCard Id="colored" Title="Colored tooltips" Description="Six solid semantic colors with clear, readable labels." Code="@ColoredCode"><div class="tooltip-color-grid">@foreach(var tone in Colors){<UiHint Text="@($"{tone.Label} tooltip - contextual guidance.")" Color="tone.Color" Delay="Delay"><MudButton Variant="Variant.Filled" Color="tone.Color" aria-label="@($"Show {tone.Label.ToLowerInvariant()} tooltip")">@tone.Label</MudButton></UiHint>}</div><p class="tooltip-note">Hover, focus, or tap a trigger to see its matching colored tooltip.</p></ButtonShowcaseCard>
<ButtonShowcaseCard Id="light-colored" Title="Light color tooltips" Description="Soft tinted surfaces, subtle borders, and color-matched text." Code="@LightCode"><div class="tooltip-color-grid">@foreach(var tone in Colors){<UiHint Text="@($"Light {tone.Label.ToLowerInvariant()} tooltip - a softer emphasis.")" Color="tone.Color" Light="true" Delay="Delay"><UiActionButton Soft="true" Color="tone.Color" aria-label="@($"Show light {tone.Label.ToLowerInvariant()} tooltip")">Light @tone.Label.ToLowerInvariant()</UiActionButton></UiHint>}</div><p class="tooltip-note">Light backgrounds adapt to both light and dark workspace themes.</p></ButtonShowcaseCard>
<ButtonShowcaseCard Id="profile-preview" Title="Profile preview" Description="A compact identity widget with a richer contextual surface." Code="@ProfileCode"><div class="tooltip-person-widget"><UiPersonAvatar Name="Sophia Carter" Src="assets/images/users/sophia-carter.jpg" Pixels="44" Status="Online" /><div><b>Sophia Carter</b><small>Project owner</small></div><UiHint Light="true" Delay="Delay"><Content><div class="hint-profile-heading"><UiPersonAvatar Name="Sophia Carter" Src="assets/images/users/sophia-carter.jpg" Pixels="40" /><div><b>Sophia Carter</b><small>Project Manager</small></div></div><p>Coordinates project delivery and keeps the team aligned.</p><UiStatusChip Color="Color.Success" Dot="true">Available for collaboration</UiStatusChip></Content><ChildContent><MudIconButton Icon="@RynzoIcons.Get("User")" Variant="Variant.Outlined" aria-label="Preview Sophia Carter" /></ChildContent></UiHint></div><p class="tooltip-note">Supplementary profile information appears on focus without opening a drawer.</p></ButtonShowcaseCard>
<ButtonShowcaseCard Id="metric-insights" Title="Metric insights" Description="Small dashboard widgets with clear definitions on demand." Code="@MetricCode"><div class="tooltip-metric-grid">@foreach(var item in Metrics){<UiHint Color="item.Color" Light="true" Delay="Delay"><Content><b>@item.Label</b><p>@item.Definition</p><small>Illustrative dashboard metric</small></Content><ChildContent><MudButton Variant="Variant.Text" Class="tooltip-metric" aria-label="@($"Explain {item.Label.ToLowerInvariant()}")"><span><MudIcon Icon="@RynzoIcons.Get(item.Icon)" /><small>@item.Label</small></span><strong>@item.Value</strong><span class="tooltip-metric-hint">View definition<MudIcon Icon="@RynzoIcons.Get("Info")" /></span></MudButton></ChildContent></UiHint>}</div></ButtonShowcaseCard>
</div></div>
@code {
 private static readonly (string Label,Color Color)[] Colors=[("Primary",Color.Primary),("Secondary",Color.Secondary),("Success",Color.Success),("Warning",Color.Warning),("Danger",Color.Error),("Info",Color.Info)];
 private static readonly (string Label,string Value,string Definition,string Icon,Color Color)[] Metrics=[("Conversion","4.8%","The percentage of visitors who completed the selected goal.","ChartNoAxesCombined",Color.Primary),("Availability","99.9%","The percentage of monitored time that the service was available.","ShieldCheck",Color.Success),("Response","240 ms","The illustrative average time taken to respond to a request.","Clock3",Color.Info)];
 private const string ColoredCode="<UiHint Text=\"Changes saved successfully.\" Color=\"Color.Success\">\n    <MudButton Color=\"Color.Success\">Success</MudButton>\n</UiHint>";
 private const string LightCode="<UiHint Text=\"A softer contextual hint.\" Color=\"Color.Primary\" Light=\"true\">\n    <UiActionButton Soft=\"true\">Light primary</UiActionButton>\n</UiHint>";
 private const string ProfileCode="<UiHint Light=\"true\">\n    <Content><b>Sophia Carter</b><p>Project Manager</p></Content>\n    <ChildContent><MudIconButton aria-label=\"Preview Sophia Carter\" /></ChildContent>\n</UiHint>";
 private const string MetricCode="<UiHint Color=\"Color.Info\" Light=\"true\">\n    <Content><b>Response</b><p>Average request response time.</p></Content>\n    <ChildContent><MudButton>240 ms</MudButton></ChildContent>\n</UiHint>";
 private int Delay=250;
 private static readonly (string Label,string Icon)[] Toolbar=[("Undo","Undo2"),("Redo","Redo2"),("Download export","Download"),("Share","Share2"),("More options","MoreHorizontal")];
 private async Task Print()=>await JS.InvokeVoidAsync("print");
 private const string BasicCode="<UiHint Text=\"Edit project\">\n    <MudIconButton Icon=\"@RynzoIcons.Get(\"Pencil\")\" aria-label=\"Edit project\" />\n</UiHint>";
 private const string PositionsCode="<UiHint Text=\"Right\" Placement=\"Placement.Right\">\n    <MudIconButton Icon=\"@RynzoIcons.Get(\"ArrowRight\")\" aria-label=\"Right tooltip\" />\n</UiHint>";
 private const string ToolbarCode="<UiHint Text=\"Undo\">\n    <MudIconButton Icon=\"@RynzoIcons.Get(\"Undo2\")\" aria-label=\"Undo\" />\n</UiHint>";
 private const string StatusCode="<UiHint Text=\"Deployment is healthy and all checks passed.\">\n    <span tabindex=\"0\">\n        <UiStatusChip Color=\"Color.Success\" Dot=\"true\">Operational</UiStatusChip>\n    </span>\n</UiHint>";
 private const string RichCode="<UiHint>\n    <Content><b>Command palette</b><p>Search pages and actions.</p><kbd>Ctrl K</kbd></Content>\n    <ChildContent><MudButton>Open command palette</MudButton></ChildContent>\n</UiHint>";
 private const string DelayCode="<UiHint Text=\"Use Tab to focus this button.\" Delay=\"700\">\n    <MudButton>Keyboard focus</MudButton>\n</UiHint>";
}
