@page "/ui/timelines"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Timelines | Rynzo</PageTitle>
<div class="timelines-page">
    <DashboardPageHeader Title="Timelines" Description="Chronological patterns for activity, milestones, delivery plans, and system history."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <MudCard Class="timeline-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span><MudIcon Icon="@RynzoIcons.Get("Route")" /></span><div><small>Component library / Chronology</small><h2>Connect the moments that move work forward.</h2><p>Give activity, milestones, and delivery history a clear sequence and a shared context.</p></div><div class="timeline-intro-track" aria-hidden="true"><i></i><b></b><i></i><b></b><i></i></div></MudCard>
    <div class="timeline-grid">
        <ButtonShowcaseCard Id="activity" Title="Activity timeline" Description="A vertical stream of recent workspace events." Code="@ActivityCode"><div class="timeline-section-heading"><span>Workspace activity</span><UiStatusChip Color="Color.Default">Today</UiStatusChip></div><ol class="timeline-events">@foreach(var item in Activity){<UiTimelineEvent Title="@item.Title" Description="@item.Copy" Time="@item.Time" Icon="@item.Icon" Tone="@item.Tone" />}</ol></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="milestones" Title="Milestone timeline" Description="Project milestones with completed, current, and upcoming states." Code="@MilestonesCode"><div class="timeline-section-heading"><span>Website Redesign</span><span>2 of 4 complete</span></div><ol class="timeline-events timeline-milestones">@for(var i=0;i<Milestones.Length;i++){var item=Milestones[i];var current=i==2;<UiTimelineEvent Title="@item.Label" Time="@item.Date" Icon="Check" Pending="@(!item.Done)" Current="current" Tone="@(item.Done?"var(--success)":"var(--primary)")">@if(current){<span class="timeline-current-phase">Current phase</span>}</UiTimelineEvent>}</ol></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="status" Title="Status timeline" Description="Distinguish completed, active, waiting, and blocked events." Code="@StatusCode"><div class="timeline-section-heading"><span>Import workflow</span><span>4 events</span></div><ol class="timeline-events timeline-status">@foreach(var item in StatusItems){<UiTimelineEvent Title="@item.Title" Icon="@item.Icon" Tone="@item.Tone" Loading="item.Loading"><Status><UiStatusChip Color="item.Color">@item.Status</UiStatusChip></Status></UiTimelineEvent>}</ol></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="history" Title="Compact history" Description="A narrow format for detail panels, cards, and drawers." Code="@HistoryCode"><div class="timeline-history-surface"><div class="timeline-history-header"><MudIcon Icon="@RynzoIcons.Get("History")" /><b>Recent changes</b></div><ol class="timeline-history">@foreach(var item in History){<li><small>@item.Time</small><i aria-hidden="true"></i><span>@item.Event</span></li>}</ol></div></ButtonShowcaseCard>
        <div class="timeline-full"><ButtonShowcaseCard Id="horizontal" Title="Horizontal timeline" Description="A clearly ordered sequence with the current stage in view." Code="@HorizontalCode"><div class="timeline-section-heading"><span>Delivery stages</span><UiStatusChip Color="Color.Primary">Build in progress</UiStatusChip></div><ol class="timeline-horizontal">@for(var i=0;i<Stages.Length;i++){var step=i+1;var item=Stages[i];<li class="@(item.Status=="Complete"?"is-complete":item.Status=="Current"?"is-current":"")" aria-current="@(item.Status=="Current"?"step":null)"><span class="timeline-stage-marker">@if(item.Status=="Complete"){<MudIcon Icon="@RynzoIcons.Get("Check")" />}else{@step}</span><b>@item.Label</b><small>@item.Status</small></li>}</ol></ButtonShowcaseCard></div>
        <ButtonShowcaseCard Id="releases" Title="Release timeline" Description="Version markers, release context, and quick access to notes." Code="@ReleasesCode"><div class="timeline-section-heading"><span>Product changelog</span><span>3 releases</span></div><ol class="timeline-events timeline-releases">@foreach(var release in Releases){<UiTimelineEvent Title="@release.Version" Time="@release.Date" Description="@release.Copy" Icon="@(release.Current?"Sparkles":"Tag")" Current="release.Current" Tone="@(release.Current?"var(--primary)":"var(--muted-foreground)")">@if(release.Current){<MudButton Variant="Variant.Outlined" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" OnClick="OpenReleaseNotes">View release notes</MudButton>}</UiTimelineEvent>}</ol></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="expandable" Title="Expandable activity" Description="Reveal event details only when more context is needed." Code="@ExpandableCode"><div class="timeline-section-heading"><span>Development activity</span><UiStatusChip Color="Color.Success">Merged</UiStatusChip></div><ol class="timeline-events timeline-expandable"><UiTimelineEvent Title="Pull request merged" Description="Daniel merged checkout validation updates." Icon="GitPullRequest" Current="true">@if(Expanded){<div id="timeline-change-details" class="timeline-details"><b>Included changes</b><ul><li>Updated payment error messages</li><li>Added mobile layout tests</li><li>Refined checkout summary</li></ul></div>}<MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@RynzoIcons.Get(Expanded?"ChevronUp":"ChevronDown")" aria-expanded="@(Expanded?"true":"false")" aria-controls="timeline-change-details" OnClick="@(()=>Expanded=!Expanded)">@(Expanded?"Hide details":"View details")</MudButton></UiTimelineEvent></ol><div class="timeline-expandable-note"><MudIcon Icon="@RynzoIcons.Get("Info")" /><span>Keep the main event concise; place supporting details behind an explicit action.</span></div></ButtonShowcaseCard>
    </div>
</div>
@code {
    private bool Expanded;
    private void OpenReleaseNotes()=>Snackbar.Add("Release notes opened",Severity.Success);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private static readonly (string Title,string Copy,string Time,string Icon,string Tone)[] Activity=[("Design review completed","Sophia approved the latest homepage direction.","12 min ago","CheckCircle2","var(--success)"),("New review comment","Emma asked for feedback on the mobile layout.","45 min ago","MessageSquare","var(--info)"),("File uploaded","Daniel added checkout-spec.pdf to the project.","2 hours ago","FilePlus2","var(--primary)")];
    private static readonly (string Label,string Date,bool Done)[] Milestones=[("Discovery","Aug 02",true),("Design direction","Aug 12",true),("Build and QA","Aug 28",false),("Launch","Sep 10",false)];
    private static readonly (string Title,string Icon,string Tone,Color Color,string Status,bool Loading)[] StatusItems=[("Data import completed","CheckCircle2","var(--success)",Color.Success,"Completed",false),("Validating records","LoaderCircle","var(--primary)",Color.Primary,"In progress",true),("Waiting for approval","Clock3","var(--warning)",Color.Warning,"Waiting",false),("Payment verification","CircleAlert","var(--destructive)",Color.Error,"Blocked",false)];
    private static readonly (string Time,string Event)[] History=[("Today, 10:26 AM","Published delivery plan"),("Today, 09:40 AM","Assigned Daniel to checkout review"),("Yesterday, 04:18 PM","Added responsive design notes")];
    private static readonly (string Label,string Status)[] Stages=[("Brief","Complete"),("Design","Complete"),("Build","Current"),("QA","Next"),("Launch","Next")];
    private static readonly (string Version,string Date,string Copy,bool Current)[] Releases=[("v2.4.0","Today","Custom fields, saved views and performance improvements.",true),("v2.3.0","Aug 12","New project health signals and updated filters.",false),("v2.2.0","Jul 28","Improved notification preferences and faster search.",false)];
    private const string ActivityCode="<ol><UiTimelineEvent Title=\"Design review completed\" Time=\"12 min ago\"\n    Icon=\"CheckCircle2\" Tone=\"var(--success)\" /></ol>";
    private const string MilestonesCode="<UiTimelineEvent Title=\"Discovery\" Time=\"Aug 02\" Icon=\"Check\" />\n<UiTimelineEvent Title=\"Build and QA\" Current=\"true\" Pending=\"true\" />";
    private const string StatusCode="<UiTimelineEvent Title=\"Validating records\" Loading=\"true\">\n    <Status><UiStatusChip Color=\"Color.Primary\">In progress</UiStatusChip></Status>\n</UiTimelineEvent>";
    private const string HistoryCode="<ol class=\"timeline-history\">\n    <li><small>Today, 10:26 AM</small><span>Published delivery plan</span></li>\n</ol>";
    private const string HorizontalCode="<ol class=\"timeline-horizontal\">\n    <!-- Brief, Design, Build, QA, Launch -->\n    <li aria-current=\"step\">Build</li>\n</ol>";
    private const string ReleasesCode="<UiTimelineEvent Title=\"v2.4.0\" Time=\"Today\" Current=\"true\">\n    <MudButton OnClick=\"OpenReleaseNotes\">View release notes</MudButton>\n</UiTimelineEvent>";
    private const string ExpandableCode="<MudButton aria-expanded=\"@Expanded\"\n    OnClick=\"@(() => Expanded = !Expanded)\">View details</MudButton>";
}
