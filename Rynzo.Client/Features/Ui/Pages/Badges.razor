@page "/ui/badges"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
<PageTitle>Badges | Rynzo</PageTitle>
<div class="badges-page">
    <DashboardPageHeader Title="Badges" Description="Status labels, chips, counts, and identity patterns for your workspace."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <section class="badges-intro"><span class="badges-intro-icon"><MudIcon Icon="@RynzoIcons.Get("Tags")" /></span><div><span class="badges-eyebrow">Component library / Labels &amp; identity</span><h2>A little context goes a long way.</h2><p>Communicate status, highlight a count, or put a face to the work.</p></div><div class="badges-intro-preview"><UiStatusChip Color="Color.Success" Dot="true">Operational</UiStatusChip><UiStatusChip Color="Color.Primary">PRO</UiStatusChip><MudBadge Content="6" Color="Color.Error" Overlap="true"><MudIcon Icon="@RynzoIcons.Get("Bell")" /></MudBadge></div></section>
    <div class="badges-grid">
        <ButtonShowcaseCard Id="soft" Title="Soft" Description="Subtle tinted surfaces in six semantic tones." Code="@SoftCode"><div class="badges-row">@foreach(var tone in Tones){<UiStatusChip Color="tone.Color">@tone.Label</UiStatusChip>}</div><p class="badges-note">A quiet default for categories, metadata, and everyday status labels.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="solid" Title="Solid" Description="High-contrast fills for stronger visual emphasis." Code="@SolidCode"><div class="badges-row">@foreach(var tone in Tones){<UiStatusChip Color="tone.Color" Solid="true">@tone.Label</UiStatusChip>}</div><p class="badges-note">Use selectively to bring attention to an important label.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="outline" Title="Outline" Description="Bordered chips with a clean, open surface." Code="@OutlineCode"><div class="badges-row">@foreach(var tone in Tones){<UiStatusChip Color="tone.Color" Outline="true">@tone.Label</UiStatusChip>}</div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="status-dots" Title="Status dot" Description="A small color signal with an explicit status label." Code="@DotCode"><div class="badges-row"><UiStatusChip Color="Color.Success" Dot="true">Operational</UiStatusChip><UiStatusChip Color="Color.Warning" Dot="true">Degraded</UiStatusChip><UiStatusChip Color="Color.Error" Dot="true">Outage</UiStatusChip><UiStatusChip Color="Color.Info" Dot="true">Deploying</UiStatusChip><UiStatusChip Dot="true">Offline</UiStatusChip></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="sizes" Title="Sizes" Description="Three sizes across badge styles and contexts." Code="@SizesCode"><div class="badges-size-row"><div><span class="badges-label">Small</span><UiStatusChip Size="Size.Small">Small</UiStatusChip></div><div><span class="badges-label">Medium</span><UiStatusChip Color="Color.Primary">Medium</UiStatusChip></div><div><span class="badges-label">Large</span><UiStatusChip Color="Color.Success" Size="Size.Large">Large</UiStatusChip></div></div><div class="badges-size-extras"><UiStatusChip Size="Size.Large" Outline="true">v2.4.0</UiStatusChip><UiStatusChip Size="Size.Large" Dot="true" Color="Color.Success">All systems go</UiStatusChip></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="removable" Title="Removable chips" Description="Dismissible tags backed by MudChip close actions." Code="@RemoveCode"><div class="badges-selected"><span class="badges-label">Selected teams</span><span class="badges-tag-count" aria-live="polite">@Tags.Count selected</span></div><div class="badges-row badges-tags">@for(var i=0;i<Tags.Count;i++){var tag=Tags[i];var tone=Tones[(i+1)%Tones.Length];<UiStatusChip Color="tone.Color" OnRemove="@(()=>Tags.Remove(tag))" @key="tag">@tag</UiStatusChip>}@if(Tags.Count==0){<MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("RotateCcw")" OnClick="Restore">Restore tags</MudButton>}</div><p class="badges-note">Remove a chip to update the selection. Restore is available when all tags are removed.</p></ButtonShowcaseCard>
        <div class="badges-wide"><ButtonShowcaseCard Id="context" Title="In context" Description="Notification counts, account labels, and statuses in everyday interfaces." Code="@ContextCode"><div class="badges-context"><div class="badges-context-left"><span class="badges-label">Notification counts</span><div class="badges-counters"><MudBadge Content="6" Color="Color.Error" Overlap="true"><MudIconButton Icon="@RynzoIcons.Get("Bell")" Variant="Variant.Outlined" aria-label="Notifications: 6" /></MudBadge><MudBadge Content="24" Color="Color.Primary" Overlap="true"><MudIconButton Icon="@RynzoIcons.Get("MessageSquare")" Variant="Variant.Outlined" aria-label="Messages: 24" /></MudBadge></div><div class="badges-identity"><MudAvatar Size="Size.Medium"><MudImage Src="assets/images/users/user-4.jpg" Alt="Liam Walker" /></MudAvatar><div><b>Liam Walker</b><small>Workspace member</small></div><UiStatusChip Color="Color.Primary">PRO</UiStatusChip></div></div><div class="badges-status-list"><span class="badges-label">Status labels</span>@foreach(var row in new[]{("Order #3201","Paid",Color.Success),("Order #3202","Pending",Color.Warning),("Server","Down",Color.Error)}){<div><span><MudIcon Icon="@RynzoIcons.Get(row.Item1=="Server"?"ServerCrash":"Package")" /><b>@row.Item1</b></span><UiStatusChip Dot="true" Color="row.Item3">@row.Item2</UiStatusChip></div>}</div></div></ButtonShowcaseCard></div>
        <div class="badges-wide"><ButtonShowcaseCard Id="avatars" Title="Avatars" Description="Portrait sizes, presence, a fallback, and a stacked team." Code="@AvatarsCode"><div class="badges-avatar-layout"><div><span class="badges-label">Portrait sizes</span><div class="badges-portraits">@foreach(var person in People){<div><span class="badges-avatar-size @person.Class"><MudAvatar><MudImage Src="@person.Photo" Alt="@person.Name" /></MudAvatar></span><b>@person.Name</b></div>}</div></div><div class="badges-avatar-extras"><div><span class="badges-label">Fallback &amp; presence</span><div class="badges-fallback"><MudAvatar Color="Color.Primary">JC</MudAvatar><UiStatusChip Dot="true" Color="Color.Success">Online</UiStatusChip></div></div><div><span class="badges-label">Team stack</span><div class="badges-stack" aria-label="Four pictured team members and three more">@foreach(var person in People){<MudAvatar><MudImage Src="@person.Photo" Alt="@person.Name" /></MudAvatar>}<MudAvatar Color="Color.Default">+3</MudAvatar></div></div></div></div></ButtonShowcaseCard></div>
    </div>
</div>
@code {
    private static readonly (Color Color,string Label)[] Tones=[(Color.Default,"neutral"),(Color.Primary,"primary"),(Color.Success,"success"),(Color.Warning,"warning"),(Color.Error,"danger"),(Color.Info,"info")];
    private List<string> Tags=["Design","Engineering","Marketing","Research"];
    private static readonly (string Name,string Photo,string Class)[] People=[("Sophie Turner","assets/images/users/user-3.jpg","avatar-xs"),("Liam Walker","assets/images/users/user-4.jpg","avatar-sm"),("Noah Bennett","assets/images/users/user-1.jpg","avatar-md"),("Emma Brooks","assets/images/users/user-3.jpg","avatar-lg")];
    private void Restore()=>Tags=["Design","Engineering","Marketing","Research"];
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private const string SoftCode="<UiStatusChip>neutral</UiStatusChip>\n<UiStatusChip Color=\"Color.Primary\">primary</UiStatusChip>\n<UiStatusChip Color=\"Color.Success\">success</UiStatusChip>";
    private const string SolidCode="<UiStatusChip Solid=\"true\" Color=\"Color.Primary\">primary</UiStatusChip>\n<UiStatusChip Solid=\"true\" Color=\"Color.Error\">danger</UiStatusChip>";
    private const string OutlineCode="<UiStatusChip Outline=\"true\" Color=\"Color.Info\">info</UiStatusChip>";
    private const string DotCode="<UiStatusChip Dot=\"true\" Color=\"Color.Success\">Operational</UiStatusChip>";
    private const string SizesCode="<UiStatusChip Size=\"Size.Small\">Small</UiStatusChip>\n<UiStatusChip Color=\"Color.Primary\">Medium</UiStatusChip>\n<UiStatusChip Size=\"Size.Large\" Color=\"Color.Success\">Large</UiStatusChip>";
    private const string RemoveCode="<UiStatusChip Color=\"Color.Primary\" OnRemove=\"@(() => Tags.Remove(\"Design\"))\">\n    Design\n</UiStatusChip>";
    private const string ContextCode="<MudBadge Content=\"6\" Color=\"Color.Error\" Overlap=\"true\">\n    <MudIconButton Icon=\"@RynzoIcons.Get(\"Bell\")\" aria-label=\"Notifications: 6\" />\n</MudBadge>\n<UiStatusChip Dot=\"true\" Color=\"Color.Success\">Paid</UiStatusChip>";
    private const string AvatarsCode="<MudAvatar><MudImage Src=\"assets/images/users/user-4.jpg\" Alt=\"Liam Walker\" /></MudAvatar>\n<MudAvatar Color=\"Color.Primary\">JC</MudAvatar>\n<UiStatusChip Dot=\"true\" Color=\"Color.Success\">Online</UiStatusChip>";
}
