@page "/ui/chips"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Chips &amp; Tags | Rynzo</PageTitle>
<div class="chips-page">
    <DashboardPageHeader Title="Chips &amp; Tags" Description="Compact labels for filters, people, status, input values, and selected options."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <section class="chips-intro"><span><MudIcon Icon="@RynzoIcons.Get("Tags")" /></span><div><small>Component library / Labels &amp; selection</small><h2>Small labels. Meaningful context.</h2><p>Organize information, refine a view, and keep selected values close at hand.</p></div><div class="chips-intro-note"><UiStatusChip Color="Color.Primary">Design</UiStatusChip><UiStatusChip Dot="true" Color="Color.Success">Active</UiStatusChip></div></section>
    <div class="chips-grid">
        <ButtonShowcaseCard Id="basic" Title="Basic chips" Description="Compact category labels with a clear semantic color system." Code="@BasicCode"><span class="chips-eyebrow">Category palette</span><div class="chips-surface chips-wrap">@foreach(var item in Tones){<UiStatusChip Color="item.Color">@item.Label</UiStatusChip>}</div><p class="chips-caption">Soft surfaces keep short labels readable without dominating the content.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="removable" Title="Removable tags" Description="Remove selected values directly, without reopening a filter menu." Code="@RemovableCode"><div class="chips-section-heading"><span>Selected labels</span><span aria-live="polite">@Tags.Count tags</span></div><div class="chips-surface chips-wrap">@foreach(var tag in Tags.ToArray()){<MudChip T="string" Variant="Variant.Outlined" OnClose="@((MudChip<string> _)=>Remove(tag))" CloseIcon="@RynzoIcons.Get("X")">@tag</MudChip>}@if(Tags.Count==0){<MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("RotateCcw")" OnClick="Restore">Restore tags</MudButton>}</div><p class="chips-caption">Changes are shared with the input tags example.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="input" Title="Input tags" Description="Turn entered text into labels, recipients, or attributes." Code="@InputCode"><label class="chips-input-label" for="chips-tag-input">Workspace labels</label><div class="chips-input-surface"><div class="chips-wrap">@foreach(var tag in Tags.ToArray()){<MudChip T="string" Color="Color.Primary" Variant="Variant.Text" OnClose="@((MudChip<string> _)=>Remove(tag))" CloseIcon="@RynzoIcons.Get("X")">@tag</MudChip>}</div><form @onsubmit="AddTag" @onsubmit:preventDefault="true"><input id="chips-tag-input" aria-label="New tag" @bind="Input" @bind:event="oninput" placeholder="Type and press Enter" autocomplete="off" /><MudIconButton Icon="@RynzoIcons.Get("Plus")" Size="Size.Small" ButtonType="ButtonType.Submit" aria-label="Add tag" /></form></div><p class="chips-caption" aria-live="polite">@(InputMessage??"Press Enter to add a tag. Duplicate labels are kept only once.")</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="filters" Title="Filter chips" Description="Toggle multiple filters without building a large control bar." Code="@FiltersCode"><div class="chips-section-heading"><span>Project status</span><MudIcon Icon="@RynzoIcons.Get("ListFilter")" /></div><div class="chips-filter-group" role="group" aria-label="Project status filters">@foreach(var filter in FilterOptions){<MudButton Variant="@(Filters.Contains(filter)?Variant.Filled:Variant.Outlined)" Color="@(Filters.Contains(filter)?Color.Primary:Color.Default)" StartIcon="@(Filters.Contains(filter)?RynzoIcons.Get("Check"):null)" aria-pressed="@(Filters.Contains(filter)?"true":"false")" OnClick="@(()=>Toggle(filter))">@filter</MudButton>}</div><p class="chips-filter-summary" aria-live="polite">@(Filters.Count>0?$"{string.Join(", ",Filters)} filter{(Filters.Count>1?"s":"")} active":"No filters selected")</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="status" Title="Status chips" Description="Pair concise operational states with a dot or activity indicator." Code="@StatusCode"><span class="chips-eyebrow">Service health</span><div class="chips-surface chips-wrap"><UiStatusChip Dot="true" Color="Color.Success">Operational</UiStatusChip><UiStatusChip Dot="true" Color="Color.Warning">Degraded</UiStatusChip><UiStatusChip Dot="true" Color="Color.Error">Outage</UiStatusChip><MudChip T="string" Variant="Variant.Outlined"><span class="chips-deploying"><UiLoadingIndicator Pixels="12" Color="Color.Info" Label="Deployment in progress" />Deploying</span></MudChip></div><p class="chips-caption">Text carries the meaning alongside color and motion.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="avatars" Title="Avatar chips" Description="Keep people recognizable within a compact label footprint." Code="@AvatarsCode"><span class="chips-eyebrow">Project collaborators</span><div class="chips-avatar-wrap">@foreach(var person in People){<MudChip T="string" Variant="Variant.Outlined"><span class="chips-person"><UiPersonAvatar Name="@person.Name" Src="@person.Photo" Pixels="24" /><span>@person.Name</span></span></MudChip>}</div><p class="chips-caption">Portraits use the existing local image collection.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="icons" Title="Icon chips" Description="Recognizable types, teams, dates, and locations with quick actions." Code="@IconsCode"><span class="chips-eyebrow">Quick context</span><div class="chips-icon-wrap">@foreach(var item in IconItems){<MudChip T="string" Color="item.Color" Variant="Variant.Text" Icon="@RynzoIcons.Get(item.Icon)" OnClick="@(()=>Notify($"{item.Label} selected"))">@item.Label</MudChip>}</div><p class="chips-caption">Select a chip to preview its contextual action.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="counts" Title="Counts and overflow" Description="Summarize collection sizes and keep longer tag sets concise." Code="@CountsCode"><span class="chips-eyebrow">Collection overview</span><div class="chips-count-wrap"><MudChip T="string" Variant="Variant.Outlined"><span>Design <b>6</b></span></MudChip><MudChip T="string" Variant="Variant.Outlined"><span>Comments <b class="is-primary">24</b></span></MudChip><MudChip T="string" Variant="Variant.Outlined">+8 more</MudChip></div><p class="chips-caption">Counts stay aligned within the same compact component.</p></ButtonShowcaseCard>
    </div>
</div>
@code {
    private readonly List<string> Tags=["Design","Frontend","Priority"];
    private readonly List<string> Filters=["Active"];
    private string Input="";
    private string? InputMessage;
    private void Remove(string tag)=>Tags.Remove(tag);
    private void Restore(){Tags.Clear();Tags.AddRange(["Design","Frontend","Priority"]);InputMessage=null;}
    private void AddTag(){var value=Input.Trim();if(value.Length==0){InputMessage="Enter a label to add a tag.";return;}if(Tags.Contains(value)){InputMessage=$"{value} is already added.";return;}Tags.Add(value);Input="";InputMessage=$"{value} added.";}
    private void Toggle(string filter){if(!Filters.Remove(filter))Filters.Add(filter);}
    private void Notify(string message)=>Snackbar.Add(message,Severity.Normal);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private static readonly (string Label,Color Color)[] Tones=[("Neutral",Color.Default),("Primary",Color.Primary),("Success",Color.Success),("Warning",Color.Warning),("Danger",Color.Error)];
    private static readonly string[] FilterOptions=["Active","Planning","At risk","Completed"];
    private static readonly (string Name,string Photo)[] People=[("Sophia Carter","assets/images/users/sophia-carter.jpg"),("Daniel Lee","assets/images/users/user-2.jpg"),("Emma Wilson","assets/images/users/user-3.jpg")];
    private static readonly (string Label,string Icon,Color Color)[] IconItems=[("Design files","Folder",Color.Primary),("Due this week","Calendar",Color.Warning),("Product team","Users",Color.Info),("San Francisco","MapPin",Color.Success)];
    private const string BasicCode="<UiStatusChip Color=\"Color.Primary\">Primary</UiStatusChip>\n<UiStatusChip Color=\"Color.Success\">Success</UiStatusChip>";
    private const string RemovableCode="<MudChip T=\"string\" Variant=\"Variant.Outlined\" OnClose=\"Remove\">Design</MudChip>";
    private const string InputCode="<form @onsubmit=\"AddTag\" @onsubmit:preventDefault=\"true\">\n    <input @bind=\"Input\" @bind:event=\"oninput\" />\n</form>";
    private const string FiltersCode="<MudButton aria-pressed=\"@Filters.Contains(filter)\"\n    OnClick=\"@(() => Toggle(filter))\">Active</MudButton>";
    private const string StatusCode="<UiStatusChip Dot=\"true\" Color=\"Color.Success\">Operational</UiStatusChip>";
    private const string AvatarsCode="<MudChip T=\"string\" Variant=\"Variant.Outlined\">\n    <UiPersonAvatar Name=\"Sophia Carter\" Src=\"assets/images/users/sophia-carter.jpg\" Pixels=\"24\" />\n    Sophia Carter\n</MudChip>";
    private const string IconsCode="<MudChip T=\"string\" Icon=\"@RynzoIcons.Get(\"Folder\")\"\n    OnClick=\"SelectFiles\">Design files</MudChip>";
    private const string CountsCode="<MudChip T=\"string\" Variant=\"Variant.Outlined\">Design <b>6</b></MudChip>";
}
