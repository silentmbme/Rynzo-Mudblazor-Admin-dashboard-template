@page "/ui/loaders"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@implements IDisposable
@inject IJSRuntime JS
<PageTitle>Loaders | Rynzo</PageTitle>
<div class="loaders-page">
    <DashboardPageHeader Title="Loaders" Description="Loading indicators and skeleton states for pending content, actions, and background work."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <MudCard Class="loaders-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span><MudIcon Icon="@RynzoIcons.Get("LoaderCircle")" /></span><div><small>Component library / Feedback</small><h2>Keep every moment moving.</h2><p>Clear waiting states for small actions, background tasks, and content on its way.</p></div><div class="loaders-intro-note"><i></i><i></i><i></i><span>Work in progress</span></div></MudCard>
    <div class="loaders-grid">
        <ButtonShowcaseCard Id="sizes" Title="Spinner sizes" Description="Choose a size that fits the surrounding content." Code="@SizesCode"><div class="loaders-size-grid">@foreach(var item in Sizes){<div><span><UiLoadingIndicator Pixels="item.Pixels" Label="@($"{item.Label} loading indicator")" /></span><b>@item.Label</b><small>@item.Pixels px</small></div>}</div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="colors" Title="Spinner colors" Description="Match the loading indicator to its context or status." Code="@ColorsCode"><div class="loaders-color-grid">@foreach(var item in Colors){<div><span><UiLoadingIndicator Color="item.Color" Label="@($"{item.Label} loading indicator")" /></span><small>@item.Label</small></div>}</div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="dots" Title="Dots and pulse" Description="Gentle activity indicators for inline and assistant states." Code="@DotsCode"><div class="loaders-activity-list"><div><span class="loaders-dots" role="status" aria-label="Assistant is working"><i></i><i></i><i></i></span><span><b>Assistant activity</b><small>Preparing a response</small></span></div><div><span class="loaders-sync"><i></i>Syncing changes</span><small>Background activity</small></div><div><span class="loaders-pulse" role="status" aria-label="Waiting for an update"></span><span><b>Pulse indicator</b><small>A subtle waiting state</small></span></div></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="linear" Title="Linear loader" Description="Show ongoing work when the duration is unknown." Code="@LinearCode"><div class="loaders-linear"><div><span><MudIcon Icon="@RynzoIcons.Get("ChartNoAxesCombined")" /></span><div><h3>Loading analytics</h3><p>Preparing your workspace insights</p></div></div><UiProgressMeter Label="Loading analytics" ShowValue="false" Indeterminate="true" /><div><span><MudIcon Icon="@RynzoIcons.Get("File")" /></span><div><h3>Syncing documents</h3><p>Keeping your files up to date</p></div></div><UiProgressMeter Label="Syncing documents" ShowValue="false" Indeterminate="true" Color="Color.Info" /></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="skeleton" Title="Skeleton loaders" Description="Reserve the shape of cards, lists, and charts while loading." Code="@SkeletonCode"><div class="loaders-skeleton" aria-label="Loading content preview"><div class="loaders-skeleton-person"><MudSkeleton SkeletonType="SkeletonType.Circle" Width="44px" Height="44px" /><div><MudSkeleton Width="128px" Height="15px" /><MudSkeleton Width="192px" Height="13px" /></div></div><MudCard Class="loaders-skeleton-card rynzo-widget-card" Elevation="0" Outlined="true"><MudSkeleton Width="112px" Height="18px" /><MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="96px" /><div>@for(var i=0;i<3;i++){<MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />}</div></MudCard></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="button-loading" Title="Button loading" Description="Show immediate feedback and prevent duplicate submissions." Code="@ButtonCode"><div class="loaders-save-preview"><span><MudIcon Icon="@RynzoIcons.Get("Save")" /></span><h3>Workspace preferences</h3><p>Keep the action visible while the sample save completes.</p><UiActionButton Loading="Saving" StartIcon="@RynzoIcons.Get("Check")" OnClick="Save">@(Saving?"Saving changes":"Save changes")</UiActionButton><small aria-live="polite">@(Saving?"Saving your changes…":Saved?"Changes saved successfully":"Ready to save")</small></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="overlay" Title="Content overlay" Description="Preserve the section's context during a focused refresh." Code="@OverlayCode"><div class="loaders-performance" aria-busy="@(Refreshing?"true":"false")"><div class="loaders-performance-heading"><div><h3>Monthly performance</h3><p>Updated moments ago</p></div><strong>$84,240</strong></div><div class="loaders-chart" role="img" aria-label="Monthly performance: eight bars with values 38, 55, 43, 72, 60, 84, 76, 92">@foreach(var height in Heights){<i style="@($"height:{height}%")"></i>}</div>@if(Refreshing){<div class="loaders-overlay"><div><UiLoadingIndicator Pixels="20" Label="Refreshing data" /><b>Refreshing data</b></div></div>}</div><div class="loaders-refresh-footer"><span aria-live="polite">@(Refreshing?"Updating the preview…":"Your content stays in place.")</span><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="Refreshing" StartIcon="@RynzoIcons.Get("RefreshCw")" OnClick="Refresh">Refresh preview</MudButton></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="empty" Title="Empty loading state" Description="A focused waiting state when there is no content to preserve." Code="@EmptyCode"><div class="loaders-empty"><div class="loaders-empty-ring"><UiLoadingIndicator Pixels="32" Label="Loading projects" /></div><h3>Loading projects</h3><p>Gathering the latest workspace data</p><span>Please wait a moment</span></div></ButtonShowcaseCard>
    </div>
</div>
@code {
    private bool Saving,Saved,Refreshing;
    private readonly CancellationTokenSource Lifetime=new();
    private static readonly (string Label,int Pixels)[] Sizes=[("Small",16),("Medium",24),("Large",40),("Extra large",56)];
    private static readonly (string Label,Color Color)[] Colors=[("Primary",Color.Primary),("Info",Color.Info),("Success",Color.Success),("Warning",Color.Warning),("Danger",Color.Error)];
    private static readonly int[] Heights=[38,55,43,72,60,84,76,92];
    private async Task Save(){if(Saving)return;Saving=true;Saved=false;try{await Task.Delay(1400,Lifetime.Token);Saved=true;}catch(OperationCanceledException){}finally{Saving=false;}}
    private async Task Refresh(){if(Refreshing)return;Refreshing=true;try{await Task.Delay(1800,Lifetime.Token);}catch(OperationCanceledException){}finally{Refreshing=false;}}
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    public void Dispose(){Lifetime.Cancel();Lifetime.Dispose();}
    private const string SizesCode="<UiLoadingIndicator Pixels=\"16\" />\n<UiLoadingIndicator Pixels=\"24\" />\n<UiLoadingIndicator Pixels=\"40\" />\n<UiLoadingIndicator Pixels=\"56\" />";
    private const string ColorsCode="<UiLoadingIndicator Color=\"Color.Primary\" />\n<UiLoadingIndicator Color=\"Color.Success\" />";
    private const string DotsCode="<span class=\"loaders-dots\" role=\"status\" aria-label=\"Assistant is working\">\n    <i></i><i></i><i></i>\n</span>";
    private const string LinearCode="<UiProgressMeter Label=\"Loading analytics\" Indeterminate=\"true\" />\n<UiProgressMeter Label=\"Syncing documents\" Indeterminate=\"true\" Color=\"Color.Info\" />";
    private const string SkeletonCode="<MudSkeleton SkeletonType=\"SkeletonType.Circle\" Width=\"44px\" Height=\"44px\" />\n<MudSkeleton Width=\"128px\" Height=\"15px\" />";
    private const string ButtonCode="<UiActionButton Loading=\"Saving\" OnClick=\"Save\">\n    @(Saving ? \"Saving changes\" : \"Save changes\")\n</UiActionButton>";
    private const string OverlayCode="<div class=\"loaders-performance\" aria-busy=\"@Refreshing\">\n    <!-- Preserve the preview beneath a local loading overlay. -->\n</div>";
    private const string EmptyCode="<UiLoadingIndicator Pixels=\"32\" Label=\"Loading projects\" />\n<h3>Loading projects</h3>\n<p>Gathering the latest workspace data</p>";
}
