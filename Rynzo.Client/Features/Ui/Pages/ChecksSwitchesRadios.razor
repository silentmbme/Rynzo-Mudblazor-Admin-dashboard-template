@page "/forms/checks-switches-radios"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Checks, switches &amp; radios | Rynzo</PageTitle>
<div class="choice-page">
    <DashboardPageHeader Title="Checks, switches &amp; radios" Description="Selection controls for simple choices, preferences, and configuration."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Save")" OnClick="@(()=>Notify("Control preferences saved",Severity.Success))">Save settings</MudButton></Actions></DashboardPageHeader>
    <section class="choice-section"><header class="choice-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("ListChecks")" /></span><div><h2>Checkboxes</h2><p>Select multiple options independently.</p></div></header><div class="choice-grid">
        <FormElementCard Id="basic-checks" Title="Basic checkbox list" Description="Clear labels and supporting context"><div class="choice-check-list"><MudCheckBox T="bool" @bind-Value="Newsletter" Label="Weekly product newsletter" Color="Color.Primary" /><MudText Typo="Typo.caption">A round-up of releases, tips, and product news.</MudText><MudCheckBox T="bool" @bind-Value="Analytics" Label="Share anonymous analytics" Color="Color.Primary" /><MudText Typo="Typo.caption">Help improve the dashboard experience.</MudText><MudCheckBox T="bool" Value="false" Disabled="true" Label="Required compliance setting" /><MudText Typo="Typo.caption">This option is managed by your organization.</MudText></div></FormElementCard>
        <FormElementCard Id="tasks" Title="Task checklist" Description="A compact list with a live selection summary"><div class="choice-task-list">@for(var i=0;i<Tasks.Length;i++){var index=i;var task=Tasks[index];<label class="@(TaskValues[index]?"is-checked":"")"><input type="checkbox" @bind="TaskValues[index]" aria-label="@task.Title" /><span><b>@task.Title</b><small>@task.Copy</small></span>@if(TaskValues[index]){<MudIcon Icon="@RynzoIcons.Get("CircleCheck")" />}</label>}</div><div class="choice-summary"><span>Selected tasks</span><b aria-live="polite">@TaskValues.Count(value=>value) of 3 tasks selected</b></div></FormElementCard>
    </div></section>
    <section class="choice-section"><header class="choice-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("SlidersHorizontal")" /></span><div><h2>Switches</h2><p>Immediate on and off settings with clear context.</p></div></header><div class="choice-grid">
        <FormElementCard Id="preferences" Title="Notification preferences" Description="Settings with a direct on/off action"><div class="choice-switch-list"><div><span><b>Workspace notifications</b><small>Activity and updates from your workspace</small></span><MudSwitch T="bool" @bind-Value="Notifications" Color="Color.Primary" /></div><div><span><b>Product recommendations</b><small>Personalized feature suggestions</small></span><MudSwitch T="bool" Value="true" Color="Color.Primary" /></div><div><span><b>Security activity</b><small>Sign-ins and account changes</small></span><MudSwitch T="bool" Value="true" Color="Color.Primary" /></div></div></FormElementCard>
        <FormElementCard Id="live" Title="Live setting" Description="A shared preference with immediate visual feedback"><div class="choice-live @(Notifications?"is-on":"")"><div><span><MudIcon Icon="@RynzoIcons.Get("BellRing")" /></span><MudSwitch T="bool" @bind-Value="Notifications" Color="Color.Primary" /></div><h3 aria-live="polite">Notifications are @(Notifications?"on":"off")</h3><p>@(Notifications?"You will receive workspace alerts.":"You will not receive workspace alerts.")</p><span class="choice-live-status"><i></i>@(Notifications?"Receiving alerts":"Alerts paused")</span></div></FormElementCard>
    </div></section>
    <section class="choice-section"><header class="choice-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("CircleCheck")" /></span><div><h2>Radio groups</h2><p>One active choice for mutually exclusive options.</p></div></header><div class="choice-grid">
        <FormElementCard Id="billing" Title="Plan selection" Description="Compare billing options with their terms in view"><fieldset class="choice-billing"><legend class="choice-sr-only">Billing plan</legend>@foreach(var item in Plans){<label class="@(Billing==item.Value?"is-selected":"")"><input type="radio" name="choice-billing" value="@item.Value" checked="@(Billing==item.Value)" @onchange="@(()=>Billing=item.Value)" aria-label="@item.Title" /><span><b>@item.Title</b><small>@item.Copy</small></span><strong>@item.Price</strong></label>}</fieldset></FormElementCard>
        <FormElementCard Id="roles" Title="Team role" Description="A single-choice group with a current-value panel"><fieldset class="choice-role-grid"><legend class="choice-sr-only">Team role</legend>@foreach(var item in Roles){<label class="@(Role==item.Value?"is-selected":"")"><input type="radio" name="choice-role" value="@item.Value" checked="@(Role==item.Value)" @onchange="@(()=>Role=item.Value)" aria-label="@item.Title" /><span><MudIcon Icon="@RynzoIcons.Get(item.Icon)" /></span><b>@item.Title</b></label>}</fieldset><div class="choice-summary"><span>Selected role</span><b class="choice-capitalize" aria-live="polite">@Role</b></div></FormElementCard>
    </div></section>
    <section class="choice-section"><header class="choice-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("Settings")" /></span><div><h2>More control patterns</h2><p>Compact selection patterns for everyday product settings.</p></div></header><div class="choice-grid">
        <FormElementCard Id="channels" Title="Notification channels" Description="Select multiple delivery channels"><div class="choice-channel-list">@for(var i=0;i<Channels.Length;i++){var index=i;var item=Channels[index];<label class="@(ChannelValues[index]?"is-checked":"")"><input type="checkbox" @bind="ChannelValues[index]" aria-label="@item.Title" /><span class="choice-channel-icon"><MudIcon Icon="@RynzoIcons.Get(item.Icon)" /></span><span><b>@item.Title</b><small>@item.Copy</small></span></label>}</div></FormElementCard>
        <FormElementCard Id="segmented" Title="Segmented radio control" Description="A compact visual layout for a single choice"><fieldset class="choice-segments"><legend class="choice-sr-only">Workspace view</legend>@foreach(var item in Views){<label class="@(View==item.Value?"is-selected":"")"><input type="radio" name="choice-view" value="@item.Value" checked="@(View==item.Value)" @onchange="@(()=>View=item.Value)" aria-label="@item.Title" /><MudIcon Icon="@RynzoIcons.Get(item.Icon)" /><span>@item.Title</span></label>}</fieldset><div class="choice-view-preview"><span><MudIcon Icon="@RynzoIcons.Get(Views.First(v=>v.Value==View).Icon)" /></span><h3 aria-live="polite">@(char.ToUpperInvariant(View[0])+View[1..]) view selected</h3><p>This keeps the radio behavior but uses a compact visual layout.</p></div></FormElementCard>
        <FormElementCard Id="consent" Title="Consent confirmation" Description="A required acknowledgement before continuing"><div class="choice-consent"><label><input type="checkbox" @bind="Consent" aria-label="I agree to the workspace terms" /><span><b>I agree to the workspace terms</b><small>I understand that this action shares the selected workspace information with invited members.</small></span></label></div><div class="choice-consent-footer"><span>@(Consent?"Ready to continue":"Confirm the terms to continue.")</span><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Consent)" EndIcon="@RynzoIcons.Get("ArrowRight")" OnClick="@(()=>Notify("Workspace created",Severity.Success))">Continue</MudButton></div></FormElementCard>
        <FormElementCard Id="status-switches" Title="Status switches" Description="Operating settings with explicit feedback"><div class="choice-status-list">@for(var i=0;i<StatusItems.Length;i++){var index=i;var item=StatusItems[index];<label><span><b>@item.Label</b><small>@item.Copy</small></span><input class="choice-switch" type="checkbox" role="switch" checked="@StatusValues[index]" @onchange="@(args=>ChangeStatus(index,args))" aria-label="@item.Label" /></label>}</div></FormElementCard>
    </div></section>
    <section class="choice-section"><header class="choice-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("ListChecks")" /></span><div><h2>Checkbox styles</h2><p>Filled, soft, outlined, rounded, and compact selection treatments.</p></div></header><div class="choice-grid">
        <FormElementCard Id="filled-checkboxes" Title="Filled color checkboxes" Description="Solid semantic colors with a clear check mark"><div class="choice-style-palette">@for(var i=0;i<SelectionTones.Length;i++){var index=i;var tone=SelectionTones[index];<UiSelectionOption Label="@($"Filled {tone.Label}")" Tone="@tone.Tone" Contrast="@tone.Contrast" @bind-Checked="FilledChecks[index]" />}</div></FormElementCard>
        <FormElementCard Id="soft-checkboxes" Title="Light color checkboxes" Description="Tinted surfaces for a softer selected state"><div class="choice-style-palette">@for(var i=0;i<SelectionTones.Length;i++){var index=i;var tone=SelectionTones[index];<UiSelectionOption Label="@($"Soft {tone.Label}")" Style="soft" Tone="@tone.Tone" @bind-Checked="SoftChecks[index]" />}</div></FormElementCard>
        <FormElementCard Id="checkbox-shapes" Title="Shapes, sizes &amp; states" Description="Rounded and outlined controls with small and large variants"><div class="choice-style-palette"><UiSelectionOption Label="Rounded checkbox" Style="round" @bind-Checked="ShapeChecks[0]" /><UiSelectionOption Label="Outlined checkbox" Style="outline" @bind-Checked="ShapeChecks[1]" /><UiSelectionOption Label="Small checkbox" Style="small soft" @bind-Checked="ShapeChecks[2]" /><UiSelectionOption Label="Large checkbox" Style="large" @bind-Checked="ShapeChecks[3]" /><UiSelectionOption Label="Disabled checked" Checked="true" Disabled="true" /><UiSelectionOption Label="Disabled unchecked" Disabled="true" /></div></FormElementCard>
        <FormElementCard Id="checkbox-pills" Title="Pill checkboxes" Description="Multiple selections within compact label controls"><div class="choice-pill-options">@for(var i=0;i<PillLabels.Length;i++){var index=i;<UiSelectionOption Label="@PillLabels[index]" Style="pill round" @bind-Checked="PillChecks[index]" />}</div><div class="choice-summary"><span>Selected interests</span><b aria-live="polite">@PillChecks.Count(value=>value) selected</b></div></FormElementCard>
    </div></section>
    <section class="choice-section"><header class="choice-section-heading"><span><MudIcon Icon="@RynzoIcons.Get("CircleCheck")" /></span><div><h2>Radio styles</h2><p>Distinct single-choice treatments with native radio behavior.</p></div></header><div class="choice-grid">
        <FormElementCard Id="filled-radios" Title="Filled color radios" Description="Solid indicators in the shared semantic palette"><fieldset class="choice-style-palette"><legend class="choice-sr-only">Filled radio colors</legend>@foreach(var tone in SelectionTones){<UiSelectionOption Kind="radio" Name="filled-radio-colors" Value="@tone.Label" Label="@($"Filled radio {tone.Label}")" Tone="@tone.Tone" Contrast="@tone.Contrast" Checked="@(FilledRadio==tone.Label)" CheckedChanged="@(_=>FilledRadio=tone.Label)" />}</fieldset></FormElementCard>
        <FormElementCard Id="soft-radios" Title="Light color radios" Description="A soft tint around a contrasting selected dot"><fieldset class="choice-style-palette"><legend class="choice-sr-only">Soft radio colors</legend>@foreach(var tone in SelectionTones){<UiSelectionOption Kind="radio" Name="soft-radio-colors" Value="@tone.Label" Label="@($"Soft radio {tone.Label}")" Style="soft" Tone="@tone.Tone" Checked="@(SoftRadio==tone.Label)" CheckedChanged="@(_=>SoftRadio=tone.Label)" />}</fieldset></FormElementCard>
        <FormElementCard Id="outlined-radios" Title="Outlined radios &amp; sizes" Description="Crisp rings with consistent small, default, and large controls"><fieldset class="choice-style-palette"><legend class="choice-sr-only">Outlined radio sizes</legend>@foreach(var size in RadioSizes){<UiSelectionOption Kind="radio" Name="outline-radio-sizes" Value="@size.Value" Label="@size.Label" Style="@($"outline {size.Value}")" Checked="@(OutlineRadio==size.Value)" CheckedChanged="@(_=>OutlineRadio=size.Value)" />}</fieldset><div class="choice-style-disabled"><UiSelectionOption Kind="radio" Name="disabled-radio-on" Label="Disabled selected radio" Checked="true" Disabled="true" /><UiSelectionOption Kind="radio" Name="disabled-radio-off" Label="Disabled unselected radio" Disabled="true" /></div></FormElementCard>
        <FormElementCard Id="icon-radios" Title="Icon radio cards" Description="Recognizable delivery options within selectable cards"><fieldset class="choice-icon-radio-grid"><legend class="choice-sr-only">Delivery speed</legend>@foreach(var item in DeliveryOptions){<UiSelectionOption Kind="radio" Name="delivery-speed" Value="@item.Label" Label="@item.Label" Style="icon-card" Icon="@item.Icon" Checked="@(Delivery==item.Label)" CheckedChanged="@(_=>Delivery=item.Label)" />}</fieldset><div class="choice-summary"><span>Delivery option</span><b aria-live="polite">@Delivery</b></div></FormElementCard>
    </div></section>
</div>
@code {
    private readonly bool[] FilledChecks=[true,true,true,true,true,true],SoftChecks=[true,true,true,true,true,true],ShapeChecks=[true,true,true,true],PillChecks=[true,false,true];
    private string FilledRadio="Primary",SoftRadio="Success",OutlineRadio="default",Delivery="Standard";
    private static readonly string[] PillLabels=["Design updates","Product news","Team activity"];
    private static readonly (string Value,string Label)[] RadioSizes=[("small","Small outlined radio"),("default","Default outlined radio"),("large","Large outlined radio")];
    private static readonly (string Label,string Icon)[] DeliveryOptions=[("Standard","Package"),("Express","Zap"),("Scheduled","Calendar")];
    private static readonly (string Label,string Tone,string Contrast)[] SelectionTones=[("Primary","var(--primary)","var(--primary-foreground)"),("Secondary","var(--secondary-foreground)","var(--secondary)"),("Success","var(--success)","var(--mud-palette-success-text)"),("Info","var(--info)","var(--mud-palette-info-text)"),("Warning","var(--warning)","var(--mud-palette-warning-text)"),("Danger","var(--destructive)","var(--mud-palette-error-text)")];
    private bool Newsletter=true,Analytics,Notifications=true,Consent;
    private string Billing="monthly",Role="editor",View="board";
    private readonly bool[] TaskValues=[true,false,true],ChannelValues=[true,false,false],StatusValues=[true,false,true];
    private void ChangeStatus(int index,ChangeEventArgs args){StatusValues[index]=args.Value is true;Notify($"{StatusItems[index].Label} updated");}
    private void Notify(string message,Severity severity=Severity.Normal)=>Snackbar.Add(message,severity);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private static readonly (string Title,string Copy)[] Tasks=[("Customer research","Review interview notes"),("Design exploration","Create first concept directions"),("Usability testing","Schedule five participants")];
    private static readonly (string Value,string Title,string Price,string Copy)[] Plans=[("monthly","Monthly","$24 / month","Flexible, cancel any time"),("yearly","Yearly","$19 / month","Save 20% with annual billing"),("enterprise","Enterprise","Talk to us","For teams with custom needs")];
    private static readonly (string Value,string Title,string Icon)[] Roles=[("viewer","Viewer","Eye"),("editor","Editor","Pencil"),("admin","Admin","ShieldCheck")];
    private static readonly (string Title,string Copy,string Icon)[] Channels=[("Email","Receive updates in your inbox","Mail"),("Push notifications","Show browser and mobile alerts","Bell"),("SMS","Use text messages for urgent updates","MessageSquare")];
    private static readonly (string Value,string Title,string Icon)[] Views=[("board","Board","Columns3"),("list","List","List"),("calendar","Calendar","Calendar")];
    private static readonly (string Label,string Copy)[] StatusItems=[("Automations","Run rules when records change"),("Maintenance mode","Temporarily pause public access"),("Public API","Allow external integrations")];
}
