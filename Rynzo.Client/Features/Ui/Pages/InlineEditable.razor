@page "/forms/inline-editable"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
<PageTitle>Inline editable | Rynzo</PageTitle>
<div class="inline-page">
    <DashboardPageHeader Title="Inline editable" Description="Edit the value you need without losing surrounding context."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("RefreshCw")" OnClick="Reset">Reset</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Save")" OnClick="SaveAll">Save changes</MudButton></Actions></DashboardPageHeader>
    <section class="inline-section"><header class="inline-heading"><span><MudIcon Icon="@RynzoIcons.Get("Pencil")" /></span><div><h2>Single-value editing</h2><p>Keep edits local, deliberate, and easy to confirm.</p></div></header><div class="inline-grid">
        <FormElementCard Id="profile" Title="Profile details" Description="Edit one profile value at a time."><div class="inline-list"><InlineRow Label="Display name" Value="@DisplayName" Editing="@EditingName" OnEdit="@(()=>EditingName=true)" OnCancel="@(()=>EditingName=false)" OnSave="SaveName"><Editor><MudTextField T="string" @bind-Value="DisplayName" Variant="Variant.Outlined" Margin="Margin.Dense" /></Editor></InlineRow><InlineRow Label="Job title" Value="@JobTitle" Editing="@EditingTitle" OnEdit="@(()=>EditingTitle=true)" OnCancel="@(()=>EditingTitle=false)" OnSave="SaveTitle"><Editor><MudTextField T="string" @bind-Value="JobTitle" Variant="Variant.Outlined" Margin="Margin.Dense" /></Editor></InlineRow><InlineRow Label="Email" Value="@Email" Editing="@EditingEmail" OnEdit="@(()=>EditingEmail=true)" OnCancel="@(()=>EditingEmail=false)" OnSave="SaveEmail"><Editor><MudTextField T="string" @bind-Value="Email" InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense" /></Editor></InlineRow></div></FormElementCard>
        <FormElementCard Id="select" Title="Editable select" Description="Use the same save-and-cancel pattern for a selected value."><div class="inline-select"><span class="inline-select-icon"><MudIcon Icon="@RynzoIcons.Get("Building2")" /></span><div><small>Team</small>@if(EditingTeam){<MudSelect T="string" @bind-Value="Team" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("Product")">Product</MudSelectItem><MudSelectItem Value="@("Design")">Design</MudSelectItem><MudSelectItem Value="@("Engineering")">Engineering</MudSelectItem></MudSelect>}else{<b>@Team</b>}</div>@if(EditingTeam){<div class="inline-actions"><MudIconButton Icon="@RynzoIcons.Get("Check")" Color="Color.Primary" OnClick="SaveTeam" /><MudIconButton Icon="@RynzoIcons.Get("X")" OnClick="@(()=>EditingTeam=false)" /></div>}else{<MudIconButton Icon="@RynzoIcons.Get("Pencil")" OnClick="@(()=>EditingTeam=true)" />}</div><p class="inline-caption">Current workspace team and permissions update together.</p></FormElementCard>
    </div></section>
    <section class="inline-section"><header class="inline-heading"><span><MudIcon Icon="@RynzoIcons.Get("ListChecks")" /></span><div><h2>Editable records</h2><p>Switch a whole row into edit mode when values belong together.</p></div></header><div class="inline-grid">
        <FormElementCard Id="task" Title="Task record" Description="A compact editable record with a visible save state."><div class="inline-record"><div class="inline-record-head"><UiStatusChip Color="Color.Primary">In progress</UiStatusChip>@if(!EditingTask){<MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@RynzoIcons.Get("Pencil")" OnClick="@(()=>EditingTask=true)">Edit task</MudButton>}</div>@if(EditingTask){<div class="inline-record-fields"><UiFormField Id="inline-task-title" Label="Task title"><MudTextField T="string" @bind-Value="TaskTitle" Variant="Variant.Outlined" Margin="Margin.Dense" /></UiFormField><UiFormField Id="inline-task-owner" Label="Owner"><MudSelect T="string" @bind-Value="TaskOwner" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("Elena Marquez")">Elena Marquez</MudSelectItem><MudSelectItem Value="@("Noah Bennett")">Noah Bennett</MudSelectItem></MudSelect></UiFormField></div><div class="inline-footer"><MudButton Variant="Variant.Text" OnClick="@(()=>EditingTask=false)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTask">Save task</MudButton></div>}else{<h3>@TaskTitle</h3><p>Assigned to @TaskOwner</p>}</div></FormElementCard>
        <FormElementCard Id="status" Title="Quick status" Description="Toggle a short status without opening a full form."><div class="inline-status"><span><MudIcon Icon="@RynzoIcons.Get("CircleCheck")" /></span><div><small>Current status</small><b>@(Available?"Available for review":"Focus time")</b><p>@(Available?"Teammates can request feedback.":"Notifications are paused until you are available.")</p></div><MudSwitch T="bool" @bind-Value="Available" Color="Color.Primary" /></div></FormElementCard>
    </div></section>
</div>
@code {private string DisplayName="Elena Marquez",JobTitle="Product designer",Email="elena@rynzoadmin.com",Team="Product",TaskTitle="Prepare customer interview summary",TaskOwner="Elena Marquez";private bool EditingName,EditingTitle,EditingEmail,EditingTeam,EditingTask,Available=true;private void SaveName(){EditingName=false;Notify("Display name saved");}private void SaveTitle(){EditingTitle=false;Notify("Job title saved");}private void SaveEmail(){EditingEmail=false;Notify("Email saved");}private void SaveTeam(){EditingTeam=false;Notify("Team saved");}private void SaveTask(){EditingTask=false;Notify("Task saved");}private void SaveAll()=>Notify("All inline edits saved");private void Reset(){EditingName=EditingTitle=EditingEmail=EditingTeam=EditingTask=false;Notify("Editing state reset");}private void Notify(string message)=>Snackbar.Add(message,Severity.Success);}
