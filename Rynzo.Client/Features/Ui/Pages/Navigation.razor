@page "/ui/navigation"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Navigation | Rynzo</PageTitle>
<div class="navigation-page">
    <DashboardPageHeader Title="Navigation" Description="Patterns for moving between pages, views, collections, and focused actions."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <section class="navigation-intro"><span><MudIcon Icon="@RynzoIcons.Get("Route")" /></span><div><small>Component library / Navigation</small><h2>A clear direction for every workflow.</h2><p>Help people move between views, find their place, and reach the next action.</p></div><span class="navigation-intro-note">Explore · Switch · Continue</span></section>
    <div class="navigation-grid">
        <ButtonShowcaseCard Id="underline" Title="Underline tabs" Description="Switch between related views with a clear active indicator." Code="@UnderlineCode"><div class="navigation-example-heading"><span>Project workspace</span><UiStatusChip Color="Color.Default">4 views</UiStatusChip></div><nav class="navigation-underline" aria-label="Project views">@foreach(var item in Views){<MudButton Variant="Variant.Text" Class="@(Active==item?"is-active":"")" aria-pressed="@(Active==item?"true":"false")" OnClick="@(()=>Active=item)">@item</MudButton>}</nav><div class="navigation-selected-content" aria-live="polite"><span><MudIcon Icon="@RynzoIcons.Get("LayoutDashboard")" /></span><div><h3>@Active</h3><p><b>@Active</b> content is selected.</p></div></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="pills" Title="Pill navigation" Description="A compact choice for sections within a focused workspace." Code="@PillsCode"><span class="navigation-eyebrow">Workspace insights</span><nav class="navigation-pills" aria-label="Insight views">@foreach(var item in PillViews){<MudButton Variant="Variant.Text" Class="@(Active==item?"is-active":"")" aria-pressed="@(Active==item?"true":"false")" OnClick="@(()=>Active=item)">@item</MudButton>}</nav><div class="navigation-sample-lines" aria-hidden="true"><i></i><i></i><i></i></div><p class="navigation-caption">A contained navigation pattern for closely related sections.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="segmented" Title="Segmented control" Description="A joined selection control for mutually exclusive display modes." Code="@SegmentedCode"><div class="navigation-example-heading"><span>Calendar range</span><MudIcon Icon="@RynzoIcons.Get("Calendar")" /></div><nav class="navigation-segments" aria-label="Calendar range">@foreach(var item in Ranges){<MudButton Variant="Variant.Text" Class="@(Active==item?"is-active":"")" aria-pressed="@(Active==item?"true":"false")" OnClick="@(()=>Active=item)">@item</MudButton>}</nav><p class="navigation-caption">Choose a mode to update the shared view selection.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="sidebar" Title="Sidebar navigation" Description="Icons, active states, and counts for primary workspace areas." Code="@SidebarCode"><div class="navigation-sidebar-demo"><div class="navigation-sidebar-brand"><span><MudIcon Icon="@RynzoIcons.Get("Layers")" /></span><div><b>Design workspace</b><small>Team navigation</small></div></div><nav aria-label="Sidebar example">@foreach(var item in SidebarItems){<MudButton Variant="Variant.Text" Class="@(Side==item.Label?"is-active":"")" aria-current="@(Side==item.Label?"page":null)" OnClick="@(()=>Side=item.Label)"><MudIcon Icon="@RynzoIcons.Get(item.Icon)" /><span>@item.Label</span>@if(item.Label=="Projects"){<b>12</b>}</MudButton>}</nav></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="breadcrumb" Title="Breadcrumb navigation" Description="Keep the current location visible within a deeper hierarchy." Code="@BreadcrumbCode"><span class="navigation-eyebrow">Project settings</span><div class="navigation-breadcrumb-surface"><UiBreadcrumbTrail Items="BreadcrumbPath" ActionLabel="Home" Label="Navigation breadcrumb example"><ItemAction><MudIconButton Size="Size.Small" Icon="@RynzoIcons.Get("Home")" aria-label="Select breadcrumb Home" OnClick="@(()=>Notify("Home selected"))" /></ItemAction></UiBreadcrumbTrail></div><div class="navigation-context-heading"><span><MudIcon Icon="@RynzoIcons.Get("Settings")" /></span><div><h3>Workspace settings</h3><p>Website Redesign / Project preferences</p></div></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="command" Title="Command navigation" Description="Fast paths to common destinations and actions from one control." Code="@CommandCode"><div class="navigation-command"><MudButton Variant="Variant.Text" Class="navigation-command-search" OnClick="@(()=>Notify("Command palette opened"))"><MudIcon Icon="@RynzoIcons.Get("Search")" /><span>Search or jump to...</span><kbd>Ctrl K</kbd></MudButton><div class="navigation-command-actions">@foreach(var item in Commands){<MudButton Variant="Variant.Text" OnClick="@(()=>Notify($"{item.Label} selected",Severity.Success))" StartIcon="@RynzoIcons.Get(item.Icon)">@item.Label</MudButton>}</div></div><p class="navigation-caption">Shortcuts keep frequent destinations within reach.</p></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="mobile" Title="Mobile bottom navigation" Description="Keep key destinations within thumb reach on smaller screens." Code="@MobileCode"><div class="navigation-mobile-preview"><div class="navigation-mobile-content"><span class="navigation-eyebrow">Mobile workspace</span><h3 aria-live="polite">@Mobile</h3><div aria-hidden="true"><i></i><i></i></div></div><nav aria-label="Mobile navigation example">@foreach(var item in MobileItems){<MudButton Variant="Variant.Text" Class="@(Mobile==item.Label?"is-active":"")" aria-current="@(Mobile==item.Label?"page":null)" OnClick="@(()=>Mobile=item.Label)"><MudIcon Icon="@RynzoIcons.Get(item.Icon)" /><span>@item.Label</span></MudButton>}</nav></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="pagination" Title="Pagination navigation" Description="Clear page state for moving through longer collections." Code="@PaginationCode"><div class="navigation-pagination-heading"><span><MudIcon Icon="@RynzoIcons.Get("FolderOpen")" /></span><div><h3>Project directory</h3><p>Browse your workspace collection</p></div></div><UiPageNavigator Count="12" @bind-Selected="Page" Label="Navigation pagination example" /><p class="navigation-caption" aria-live="polite">Viewing page <b>@Page</b> of 12</p></ButtonShowcaseCard>
    </div>
</div>
@code {
    private string Active="Overview",Side="Dashboard",Mobile="Home";
    private int Page=2;
    private static readonly string[] Views=["Overview","Activity","Files","Settings"],PillViews=["Overview","Analytics","Reports"],Ranges=["Day","Week","Month"],BreadcrumbPath=["Home","Projects","Website Redesign","Settings"];
    private static readonly (string Label,string Icon)[] SidebarItems=[("Dashboard","LayoutDashboard"),("Projects","FolderKanban"),("Team","Users"),("Reports","ChartNoAxesCombined"),("Settings","Settings")];
    private static readonly (string Label,string Icon)[] Commands=[("New project","Plus"),("Invite team","Users"),("Create report","File"),("Settings","Settings")];
    private static readonly (string Label,string Icon)[] MobileItems=[("Home","Home"),("Projects","FolderKanban"),("Updates","Bell"),("Profile","UserRound")];
    private void Notify(string message,Severity severity=Severity.Normal)=>Snackbar.Add(message,severity);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private const string UnderlineCode="<nav aria-label=\"Project views\">\n    <MudButton OnClick=\"@(() => Active = \"Overview\")\">Overview</MudButton>\n</nav>";
    private const string PillsCode="<nav class=\"navigation-pills\" aria-label=\"Insight views\">\n    <!-- Shared Active selection with underline and segmented examples. -->\n</nav>";
    private const string SegmentedCode="<nav class=\"navigation-segments\" aria-label=\"Calendar range\">\n    <!-- Day, Week, Month -->\n</nav>";
    private const string SidebarCode="<MudButton aria-current=\"@(Side == label ? \"page\" : null)\"\n    OnClick=\"@(() => Side = label)\">...</MudButton>";
    private const string BreadcrumbCode="<UiBreadcrumbTrail Items=\"BreadcrumbPath\" Label=\"Navigation breadcrumb example\" />";
    private const string CommandCode="<MudButton OnClick=\"OpenCommandPalette\">Search or jump to...</MudButton>\n<kbd>Ctrl K</kbd>";
    private const string MobileCode="<nav aria-label=\"Mobile navigation example\">\n    <!-- Four destinations with icon, label, and current-page state. -->\n</nav>";
    private const string PaginationCode="<UiPageNavigator Count=\"12\" @bind-Selected=\"Page\" />";
}
