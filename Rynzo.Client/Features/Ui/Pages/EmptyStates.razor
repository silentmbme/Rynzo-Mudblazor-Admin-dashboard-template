@page "/ui/empty-states"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Empty States | Rynzo</PageTitle>
<div class="empty-states-page">
    <DashboardPageHeader Title="Empty States" Description="Helpful first-run, no-results, and recovery states that explain what happened and what to do next."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <MudCard Class="empty-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span><MudIcon Icon="@RynzoIcons.Get("LayoutDashboard")" /></span><div><small>Component library / Feedback</small><h2>A helpful next step, even when it’s empty.</h2><p>Guide first actions, explain missing content, and make recovery feel straightforward.</p></div><span class="empty-intro-note">Context + direction</span></MudCard>
    <div class="empty-grid">
        <ButtonShowcaseCard Id="search" Title="No search results" Description="Explain the missing results and offer a low-effort recovery action." Code="@SearchCode"><div class="empty-search-context"><MudIcon Icon="@RynzoIcons.Get("Search")" /><span>annual roadmap</span><UiStatusChip Color="Color.Default">0 results</UiStatusChip></div><UiEmptyPanel Icon="SearchX" Title="No results found" Description="We could not find anything matching annual roadmap. Try another search or clear active filters."><Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(()=>Notify("Filters cleared"))">Clear filters</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(()=>Notify("Search help opened"))">Search tips</MudButton></Actions></UiEmptyPanel></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="first-project" Title="First project" Description="Make the first action clear and give people another way to begin." Code="@ProjectCode"><div class="empty-section-label"><span>Getting started</span><UiStatusChip Color="Color.Primary">Workspace</UiStatusChip></div><UiEmptyPanel Icon="FolderPlus" Title="Create your first project" Description="Projects keep tasks, people and delivery signals in one shared workspace."><Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(()=>Created=true)">Create project</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(()=>Notify("Templates opened"))">Browse templates</MudButton></Actions></UiEmptyPanel></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="notifications" Title="No notifications" Description="A quiet state reassures people that nothing needs attention." Code="@NotificationsCode"><div class="empty-section-label"><span>Workspace inbox</span><span>All clear</span></div><UiEmptyPanel Icon="BellOff" Title="You are all caught up" Description="New workspace activity, mentions and reminders will appear here." Tone="var(--success)" Hint="Nothing needs your attention right now." /></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="upload" Title="Upload empty state" Description="A large target with clear guidance for files and media." Code="@UploadCode"><div class="empty-section-label"><span>Project resources</span><span>No files yet</span></div><UiEmptyPanel Class="upload-panel" Icon="CloudUpload" Title="Drop files here" Description="Drag files here, or choose files from your computer." Hint="PDF, PNG and JPG up to 10 MB"><Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Upload")" OnClick="@(()=>Notify("File picker opened",Severity.Success))">Choose files</MudButton></Actions></UiEmptyPanel></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="permission" Title="Permission state" Description="Explain access limitations and point to the next helpful action." Code="@PermissionCode"><UiEmptyPanel Icon="LockKeyhole" Title="You do not have access" Description="Only workspace admins can view billing information and invoices." Tone="var(--warning)"><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("UserPlus")" OnClick="@(()=>Notify("Admin request sent"))">Request access</MudButton></Actions></UiEmptyPanel></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="error" Title="Error state" Description="Name the problem and offer a clear way to try again." Code="@ErrorCode"><UiEmptyPanel Icon="ServerCrash" Title="Unable to load reports" Description="Something interrupted the request. Your saved reports are safe and have not been changed." Tone="var(--destructive)"><Actions><MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@RynzoIcons.Get("RefreshCw")" OnClick="@(()=>Notify("Reports reloaded",Severity.Success))">Try again</MudButton></Actions></UiEmptyPanel></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="offline" Title="Offline state" Description="Explain where work is saved and when changes will sync." Code="@OfflineCode"><UiEmptyPanel Icon="CloudOff" Title="You are offline" Description="Changes are saved on this device and will sync automatically when you reconnect." Tone="var(--info)"><Actions><MudButton Variant="Variant.Outlined" OnClick="@(()=>Notify("Sync queue opened"))">View queued changes</MudButton></Actions></UiEmptyPanel></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="compact" Title="Compact inline state" Description="A focused empty state for a card, task, or smaller page region." Code="@CompactCode"><div class="empty-attachment-context"><span><MudIcon Icon="@RynzoIcons.Get("ClipboardList")" /></span><div><h3>Task attachments</h3><p>Supporting files for your team</p></div><UiStatusChip Color="Color.Default">0</UiStatusChip></div><UiEmptyPanel Compact="true" Icon="FileX" Title="No files attached" Description="Add a file to help the team review this task." Tone="var(--muted-foreground)"><Actions><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(()=>Notify("Attachment picker opened",Severity.Success))">Attach file</MudButton></Actions></UiEmptyPanel><p class="empty-caption">Keep the next action close to the place it affects.</p></ButtonShowcaseCard>
    </div>
    @if(Created){<section class="empty-created" aria-live="polite"><header><h2>Project created</h2><p>A success state can replace the empty state when the first action completes.</p></header><UiEmptyPanel Compact="true" Icon="CheckCircle2" Title="Website Redesign is ready" Description="Invite teammates or start adding tasks to get underway." Tone="var(--success)"><Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@RynzoIcons.Get("ArrowRight")" OnClick="@(()=>Notify("Project opened",Severity.Success))">Open project</MudButton></Actions></UiEmptyPanel></section>}
</div>
@code {
    private bool Created;
    private void Notify(string message,Severity severity=Severity.Normal)=>Snackbar.Add(message,severity);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private const string SearchCode="<UiEmptyPanel Icon=\"SearchX\" Title=\"No results found\" Description=\"Try another search or clear active filters.\">\n    <Actions><MudButton OnClick=\"ClearFilters\">Clear filters</MudButton></Actions>\n</UiEmptyPanel>";
    private const string ProjectCode="<UiEmptyPanel Icon=\"FolderPlus\" Title=\"Create your first project\" Description=\"...\">\n    <Actions><MudButton OnClick=\"@(() => Created = true)\">Create project</MudButton></Actions>\n</UiEmptyPanel>";
    private const string NotificationsCode="<UiEmptyPanel Icon=\"BellOff\" Title=\"You are all caught up\"\n    Description=\"New activity will appear here.\" Tone=\"var(--success)\" />";
    private const string UploadCode="<UiEmptyPanel Class=\"upload-panel\" Icon=\"CloudUpload\"\n    Title=\"Drop files here\" Hint=\"PDF, PNG and JPG up to 10 MB\" />";
    private const string PermissionCode="<UiEmptyPanel Icon=\"LockKeyhole\" Title=\"You do not have access\"\n    Tone=\"var(--warning)\" Description=\"Only workspace admins can view billing information and invoices.\" />";
    private const string ErrorCode="<UiEmptyPanel Icon=\"ServerCrash\" Title=\"Unable to load reports\" Tone=\"var(--destructive)\">\n    <Actions><MudButton OnClick=\"Retry\">Try again</MudButton></Actions>\n</UiEmptyPanel>";
    private const string OfflineCode="<UiEmptyPanel Icon=\"CloudOff\" Title=\"You are offline\"\n    Tone=\"var(--info)\" Description=\"Changes will sync when you reconnect.\" />";
    private const string CompactCode="<UiEmptyPanel Compact=\"true\" Icon=\"FileX\" Title=\"No files attached\"\n    Description=\"Add a file to help the team review this task.\" />";
}
