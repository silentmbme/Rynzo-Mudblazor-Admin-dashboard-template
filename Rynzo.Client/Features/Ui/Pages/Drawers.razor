@page "/ui/drawers"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Drawers | Rynzo</PageTitle>
<div class="drawers-page"><DashboardPageHeader Title="Drawers" Description="Off-canvas panels for contextual details, tasks, and utility actions."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
<MudCard Class="drawers-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div><small>Component library / Context surfaces</small><h2>Stay in context.<br />Bring the details closer.</h2><p>Purposeful panels for a quick review, a focused task, or the next action.</p></div><div class="drawers-intro-visual" aria-hidden="true"><span><i></i><i></i><i></i></span><div><b></b><i></i><i></i></div><aside><MudIcon Icon="@RynzoIcons.Get("PanelRight")" /><b></b><i></i><i></i></aside></div></MudCard>
<div class="drawers-grid">@foreach(var demo in Demos){<ButtonShowcaseCard Id="@demo.Id" Title="@demo.Title" Description="@demo.Description" Code="@Code(demo.Id)"><div class="drawer-demo"><div class="drawer-demo-mini @demo.Id" aria-hidden="true"><span></span><i></i><b><MudIcon Icon="@RynzoIcons.Get(demo.Icon)" /></b></div><div class="drawer-demo-copy"><span class="drawer-demo-caption">@demo.Caption</span>@if(demo.Id=="positions"){<div class="drawer-demo-buttons">@foreach(var position in new[]{"left","top","bottom"}){<MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>Show(position))">@TitleCase(position)</MudButton>}</div>}else{<MudButton Variant="@(demo.Id is "details" or "workspace"?Variant.Filled:Variant.Outlined)" Color="Color.Primary" EndIcon="@RynzoIcons.Get("ArrowRight")" OnClick="@(()=>Show(demo.Id))">@demo.Button</MudButton>}</div></div></ButtonShowcaseCard>}</div></div>
<UiDrawerShell Open="@(Mode.Length>0)" OpenChanged="@(v=>{if(!v)Mode="";})" Anchor="DrawerAnchor" Width="@(Mode=="workspace"?"720px":"460px")" Title="@PanelTitle" Description="@PanelDescription" Icon="@RynzoIcons.Get(PanelIcon)">
<ChildContent><div class="drawer-content">
@if(Mode=="details"){<div class="drawer-project"><div><span>PRJ-1048</span><UiStatusChip Color="Color.Success">On track</UiStatusChip></div><h3>Website Redesign</h3><p>Design system and storefront update</p><div class="drawer-progress"><i style="width:82%"></i></div><footer><span>82% complete</span><span>Sep 10</span></footer></div><div class="drawer-metrics">@foreach(var item in new[]{("Tasks","48 / 62"),("Budget","$68K"),("Owner","Sophia"),("Team","8 members")}){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>@item.Item1</small><b>@item.Item2</b></MudCard>}</div>}
else if(Mode=="left"){<nav class="drawer-navigation">@foreach(var item in new[]{("Overview","LayoutGrid"),("Projects","Folder"),("Team","Users"),("Settings","Settings")}){<MudButton Variant="Variant.Text" StartIcon="@RynzoIcons.Get(item.Item2)" OnClick="@(()=>Complete(item.Item1+" selected"))">@item.Item1</MudButton>}</nav>}
else if(Mode=="top"){<div class="drawer-search"><label>Search your workspace<input placeholder="Search your workspace" @bind="Query" /></label><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Search")" OnClick='@(()=>Complete("Search ready"))'>Search</MudButton></div>}
else if(Mode=="bottom"){<div class="drawer-bottom-actions">@foreach(var item in new[]{("Create project","Plus"),("Invite teammate","UserPlus"),("New report","FileText")}){<MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get(item.Item2)" OnClick="@(()=>Complete(item.Item1+" selected"))">@item.Item1</MudButton>}</div>}
else if(Mode=="profile"){<div class="drawer-person"><UiPersonAvatar Name="Elena Marquez" Src="assets/images/users/user-1.jpg" Pixels="64" Status="Online" /><h3>Elena Marquez</h3><p>Operations Lead</p><UiStatusChip Color="Color.Success" Dot="true">Available now</UiStatusChip></div><div class="drawer-person-stats">@foreach(var item in new[]{("42","Projects"),("18","Tasks"),("96%","On time")}){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><b>@item.Item1</b><small>@item.Item2</small></MudCard>}</div><dl class="drawer-contact"><div><dt><MudIcon Icon="@RynzoIcons.Get("Mail")" />Email</dt><dd><a href="mailto:elena@rynzo.com">elena@rynzo.com</a></dd></div><div><dt><MudIcon Icon="@RynzoIcons.Get("Clock3")" />Timezone</dt><dd>GMT +5:30</dd></div></dl>}
else if(Mode=="filters"){<div class="drawer-fields"><label>Status<select @bind="Status"><option>All statuses</option><option>On track</option><option>At risk</option><option>Delayed</option></select></label><label>Owner<select @bind="Owner"><option>All owners</option><option>Sophia Carter</option><option>Daniel Lee</option></select></label></div><div class="drawer-filter-progress"><h3>Progress</h3><div>@foreach(var range in new[]{"Any","0-25%","26-75%","76-100%"}){<MudButton Size="Size.Small" Variant="@(Range==range?Variant.Filled:Variant.Outlined)" Color="Color.Primary" aria-pressed="@(Range==range?"true":"false")" OnClick="@(()=>Range=range)">@range</MudButton>}</div></div>}
else if(Mode=="activity"){<div class="drawer-timeline">@foreach(var item in Activities){<article><span style="@($"color:var(--{item.Tone})")"><MudIcon Icon="@RynzoIcons.Get(item.Icon)" /></span><div><b>@item.Title</b><small>@item.Time</small></div></article>}</div>}
else if(Mode=="workspace"){<div class="drawer-workspace"><main><section class="drawer-task-progress"><div><h3>Task progress</h3><UiStatusChip Color="Color.Info">In progress</UiStatusChip></div><div class="drawer-progress"><i style="width:70%"></i></div><p>7 of 10 subtasks complete</p></section><section class="drawer-checklist"><h3>Checklist</h3>@for(var i=0;i<Checks.Length;i++){var index=i;<label><input type="checkbox" @bind="Checked[index]" /><span>@Checks[index]</span></label>}</section></main><aside><UiPersonAvatar Name="Daniel Lee" Src="assets/images/users/user-4.jpg" Pixels="42" /><small>Assignee</small><b>Daniel Lee</b><small>Due date</small><b>Aug 27</b><small>Priority</small><UiStatusChip Color="Color.Warning">High</UiStatusChip></aside></div>}
</div></ChildContent><Actions><MudButton Variant="Variant.Outlined" OnClick="Close">@(Mode=="filters"?"Reset":"Close")</MudButton>@if(Mode=="details"){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick='@(()=>Complete("Project opened"))'>Open project</MudButton>}else if(Mode=="profile"){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick='@(()=>Snackbar.Add("Message composer opened",Severity.Success))'>Message Elena</MudButton>}else if(Mode=="filters"){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick='@(()=>Complete("Filters applied"))'>Apply filters</MudButton>}else if(Mode=="workspace"){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick='@(()=>Complete("Task marked complete"))'>Mark complete</MudButton>}</Actions></UiDrawerShell>
@code {
 private string Mode="",Query="",Status="All statuses",Owner="All owners",Range="Any";private bool[] Checked=[true,true,false];
 private static readonly string[] Checks=["Review desktop layout","Validate payment errors","Add mobile tests"];
 private record Demo(string Id,string Title,string Description,string Caption,string Button,string Icon);
 private static readonly Demo[] Demos=[new("details","Right drawer","Quick contextual information without leaving the workspace.","Project details / Right edge","Open details drawer","PanelRight"),new("positions","Drawer positions","Choose left, top, or bottom to suit the task and screen.","Three directions / One pattern","","ArrowRightLeft"),new("profile","Profile drawer","A professional profile with availability and contact details.","People / Availability","View profile","User"),new("filters","Filters","Keep collection preferences in a focused side panel.","Status / Owner / Progress","Open filters","SlidersHorizontal"),new("activity","Activity drawer","A clear timeline of recent updates and notifications.","Workspace timeline","View activity","BellRing"),new("workspace","Wide work drawer","Review a task and its checklist in a wider work surface.","Task details / Checklist","Open task workspace","ListTodo")];
 private static readonly (string Title,string Time,string Icon,string Tone)[] Activities=[("Sophia completed Design review","12 min ago","CheckCircle2","success"),("Daniel added a file","45 min ago","FilePlus2","primary"),("Budget review is due","2 hours ago","CircleAlert","warning"),("Mia invited a teammate","Yesterday","UserPlus","info")];
 private Anchor DrawerAnchor=>Mode switch{"left"=>Anchor.Left,"top"=>Anchor.Top,"bottom"=>Anchor.Bottom,_=>Anchor.Right};
 private string PanelTitle=>Mode switch{"details"=>"Project details","left"=>"Workspace navigation","top"=>"Quick search","bottom"=>"Choose an action","profile"=>"Team member","filters"=>"Filter projects","activity"=>"Recent activity","workspace"=>"Finalize checkout flow",_=>"Drawer"};
 private string PanelDescription=>Mode switch{"details"=>"Website Redesign - PRJ-1048","left"=>"Quickly switch between areas.","top"=>"Jump to a project, teammate or report.","bottom"=>"Bottom drawers work well for compact mobile actions.","profile"=>"Profile and availability details.","filters"=>"Refine the active project list.","activity"=>"Updates from your workspace.","workspace"=>"Complete the remaining review work before QA handoff.",_=>""};
 private string PanelIcon=>Mode switch{"profile"=>"User","filters"=>"SlidersHorizontal","activity"=>"BellRing","workspace"=>"ListTodo","top"=>"Search",_=>"PanelRight"};
 private void Show(string mode)=>Mode=mode;
 private void Close(){if(Mode=="filters"){Status="All statuses";Owner="All owners";Range="Any";}Mode="";}
 private void Complete(string message){Mode="";Snackbar.Add(message,Severity.Success);}
 private async Task Print()=>await JS.InvokeVoidAsync("print");
 private static string TitleCase(string value)=>char.ToUpperInvariant(value[0])+value[1..];
 private static string Code(string mode)=>$"<UiDrawerShell Open=\"Open\" OpenChanged=\"@(value => Open = value)\"\n    Title=\"{(mode=="positions"?"Workspace navigation":"Context details")}\"\n    Anchor=\"Anchor.{(mode=="positions"?"Left":"Right")}\" Width=\"{(mode=="workspace"?"720":"460")}px\">\n    <ChildContent>...</ChildContent>\n    <Actions><MudButton OnClick=\"Close\">Close</MudButton></Actions>\n</UiDrawerShell>";
}
