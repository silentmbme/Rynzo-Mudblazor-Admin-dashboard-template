@page "/charts/scatter"
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
<PageTitle>Scatter & Bubble Charts | Rynzo</PageTitle>
<div class="scatter-analytics-page"><DashboardPageHeader Title="Scatter & Bubble Charts" Description="Find patterns, clusters, correlations, and exceptions across your operating data."><Actions><MudSelect T="string" @bind-Value="Period" @bind-Value:after="Refresh" Variant="Variant.Outlined" Margin="Margin.Dense" Class="scatter-control" aria-label="Time range">@foreach(var item in Periods){<MudSelectItem Value="@item">@item</MudSelectItem>}</MudSelect><MudSelect T="string" @bind-Value="Focus" Variant="Variant.Outlined" Margin="Margin.Dense" Class="scatter-control" aria-label="Analysis focus">@foreach(var item in Focuses){<MudSelectItem Value="@item">@item</MudSelectItem>}</MudSelect><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export analysis</MudButton></Actions></DashboardPageHeader><section class="scatter-kpis" aria-label="Scatter chart summary"><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span>Total data points</span><b>@PointCount</b><small>Across all active analyses</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span>Average correlation</span><b>@Correlation</b><small>Positive relationship signal</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span>Identified clusters</span><b>4</b><small>Actionable customer segments</small></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span>Detected outliers</span><b>6</b><small>Threshold exceptions to review</small></MudCard></section><section class="scatter-dashboard" aria-label="Interactive scatter and bubble analysis"><MudCard Class="scatter-surface scatter-featured rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><header><div><span class="scatter-kicker">OPPORTUNITY BUBBLE MATRIX</span><h2>Deal size vs. win probability</h2><p>Bubble area represents potential revenue; zoom and hover to explore opportunities.</p></div><span class="scatter-status">Live sample</span></header><DashboardChart Data="@Data" OptionsModule="./scatter-chart-options.js" Kind="opportunity" Height="360" Label="Opportunity bubble matrix"/><footer><span><i></i>Probability on x-axis</span><span><i class="info"></i>Deal size on y-axis</span><b>Focus: @Focus</b></footer></MudCard><MudCard Class="scatter-surface rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><header><div><span class="scatter-kicker">MULTI-SERIES SCATTER</span><h2>Campaign performance</h2><p>Organic, Paid, Referral, and Direct.</p></div><span class="scatter-badge">4 sources</span></header><DashboardChart Data="@Data" OptionsModule="./scatter-chart-options.js" Kind="campaigns" Height="270" Label="Campaign performance scatter chart"/></MudCard><MudCard Class="scatter-surface rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><header><div><span class="scatter-kicker">QUADRANT ANALYSIS</span><h2>Growth efficiency</h2><p>Reference lines reveal priority zones.</p></div><span class="scatter-badge success">Actionable</span></header><DashboardChart Data="@Data" OptionsModule="./scatter-chart-options.js" Kind="quadrant" Height="270" Label="Quadrant analysis scatter chart"/></MudCard><MudCard Class="scatter-surface rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><header><div><span class="scatter-kicker">REGRESSION</span><h2>Spend correlation</h2><p>Linear trendline across campaign activity.</p></div><span class="scatter-badge">r @Correlation</span></header><DashboardChart Data="@Data" OptionsModule="./scatter-chart-options.js" Kind="regression" Height="270" Label="Regression scatter chart"/></MudCard><MudCard Class="scatter-surface rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><header><div><span class="scatter-kicker">SEGMENTATION</span><h2>Customer clusters</h2><p>Value and engagement profiles.</p></div><span class="scatter-badge">4 clusters</span></header><DashboardChart Data="@Data" OptionsModule="./scatter-chart-options.js" Kind="clusters" Height="270" Label="Customer segmentation clusters"/></MudCard><MudCard Class="scatter-surface rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><header><div><span class="scatter-kicker">DENSITY VIEW</span><h2>Usage concentration</h2><p>Opacity reveals high-frequency patterns.</p></div><span class="scatter-badge">@PointCount points</span></header><DashboardChart Data="@Data" OptionsModule="./scatter-chart-options.js" Kind="density" Height="270" Label="Density scatter chart"/></MudCard><MudCard Class="scatter-surface rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><header><div><span class="scatter-kicker">RISK VS RETURN</span><h2>Portfolio exposure</h2><p>Bubble size represents exposure.</p></div><span class="scatter-badge warning">Risk review</span></header><DashboardChart Data="@Data" OptionsModule="./scatter-chart-options.js" Kind="risk" Height="270" Label="Risk versus return bubble chart"/></MudCard><MudCard Class="scatter-surface rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><header><div><span class="scatter-kicker">OUTLIER DETECTION</span><h2>Operational exceptions</h2><p>Threshold markers highlight anomalies.</p></div><span class="scatter-badge danger">6 flagged</span></header><DashboardChart Data="@Data" OptionsModule="./scatter-chart-options.js" Kind="outliers" Height="270" Label="Outlier detection scatter chart"/></MudCard></section></div>
@code { private static readonly string[] Periods=["7 Days","30 Days","90 Days","This Year"]; private static readonly string[] Focuses=["All analyses","Revenue","Customer health","Campaigns"]; private string Period {get;set;}="30 Days"; private string Focus {get;set;}="All analyses"; private int PointCount=>Period=="7 Days"?72:Period=="30 Days"?184:Period=="90 Days"?436:728; private string Correlation=>Period=="7 Days"?"0.71":"0.84"; private object Data=>new { Period, Focus, Count=PointCount }; private void Refresh(){} private void Export()=>Snackbar.Add("Scatter analysis exported",Severity.Success); }
