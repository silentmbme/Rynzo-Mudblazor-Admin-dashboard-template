@page "/ui/alerts"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Alerts | Rynzo</PageTitle>
<div class="alerts-page">
    <DashboardPageHeader Title="Alerts" Description="Contextual feedback, status messages, action prompts, and announcements."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
    <MudCard Class="alerts-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span class="alerts-intro-icon"><MudIcon Icon="@RynzoIcons.Get("BellRing")" /></span><div><span class="alerts-eyebrow">Component library / Feedback</span><h2>The right message, at the right moment.</h2><p>Clear context, meaningful status, and a next step when it matters.</p></div><div class="alerts-key"><span><i class="info"></i>Inform</span><span><i class="success"></i>Confirm</span><span><i class="warning"></i>Guide</span><span><i class="error"></i>Resolve</span></div></MudCard>
    <div class="alerts-grid">
        <ButtonShowcaseCard Id="soft" Title="Soft" Description="Tinted surfaces for everyday feedback in four semantic tones." Code="@SoftCode"><div class="alerts-stack"><UiNotice Title="Heads up" Severity="Severity.Info" Icon="@RynzoIcons.Get("Info")">A new dashboard layout is available in Layout Settings.</UiNotice><UiNotice Title="Saved" Severity="Severity.Success" Icon="@RynzoIcons.Get("CheckCircle2")">Your changes have been saved successfully.</UiNotice><UiNotice Title="Storage almost full" Severity="Severity.Warning" Icon="@RynzoIcons.Get("HardDrive")">You've used 92% of your plan's storage.</UiNotice><UiNotice Title="Payment failed" Severity="Severity.Error" Icon="@RynzoIcons.Get("CircleAlert")">We couldn't process your last invoice.</UiNotice></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="solid" Title="Solid" Description="High-contrast fills for prominent status updates." Code="@SolidCode"><div class="alerts-stack"><UiNotice Title="Scheduled maintenance" Severity="Severity.Info" Variant="Variant.Filled" Icon="@RynzoIcons.Get("CalendarClock")">The API will be read-only on Sunday from 02:00-04:00 UTC.</UiNotice><UiNotice Title="Deployment complete" Severity="Severity.Success" Variant="Variant.Filled" Icon="@RynzoIcons.Get("Rocket")">Version 2.4.0 is now live in production.</UiNotice><UiNotice Title="Certificate expiring" Severity="Severity.Warning" Variant="Variant.Filled" Icon="@RynzoIcons.Get("ShieldAlert")">Your SSL certificate expires in 14 days.</UiNotice><UiNotice Title="Build failed" Severity="Severity.Error" Variant="Variant.Filled" Icon="@RynzoIcons.Get("XCircle")">The main pipeline failed on the test stage.</UiNotice></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="outline" Title="Outline" Description="A light surface with a semantic border and icon." Code="@OutlineCode"><div class="alerts-stack"><UiNotice Title="Tip" Severity="Severity.Info" Variant="Variant.Outlined" Icon="@RynzoIcons.Get("Lightbulb")">Press K to open the command palette anywhere.</UiNotice><UiNotice Title="Backup verified" Severity="Severity.Success" Variant="Variant.Outlined" Icon="@RynzoIcons.Get("DatabaseBackup")">Last night's backup was restored in a test environment.</UiNotice><UiNotice Title="Action required" Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@RynzoIcons.Get("KeyRound")">Two-factor authentication is not enabled on this account.</UiNotice></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="accent" Title="Left accent" Description="Surface cards with a colored edge for a quieter emphasis." Code="@AccentCode"><div class="alerts-stack"><UiNotice Title="New in v2.4" Severity="Severity.Info" Accent="true" Icon="@RynzoIcons.Get("Sparkles")">Custom fields are now available on every record type.</UiNotice><UiNotice Title="Rate limit at 80%" Severity="Severity.Warning" Accent="true" Icon="@RynzoIcons.Get("Gauge")">Consider caching frequent queries to stay under the limit.</UiNotice><UiNotice Title="All checks passed" Severity="Severity.Success" Accent="true" Icon="@RynzoIcons.Get("CheckCheck")">12 of 12 integration checks completed without errors.</UiNotice></div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="actions" Title="With actions" Description="Custom icons, clear next steps, and dismissible feedback." Code="@ActionsCode"><div class="alerts-stack">@if(Visible){<UiNotice Title="Unsaved changes" Severity="Severity.Warning" Icon="@RynzoIcons.Get("Pencil")" OnDismiss="@(()=>Visible=false)"><ChildContent>You have edits on this page that haven't been saved.</ChildContent><Actions><MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick='@(()=>Notify("Changes saved",Severity.Success))'>Save now</MudButton><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick='@(()=>Notify("Changes discarded"))'>Discard</MudButton></Actions></UiNotice><UiNotice Severity="Severity.Info" Icon="@RynzoIcons.Get("SlidersHorizontal")"><ChildContent>A compact alert with no title, just a message.</ChildContent><Actions><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick='@(()=>Notify("Settings opened"))'>Review settings</MudButton></Actions></UiNotice>}else{<div class="alerts-restored"><span><MudIcon Icon="@RynzoIcons.Get("CircleCheck")" /></span><h3>Alert dismissed</h3><p>Restore the example to try the actions again.</p><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("RotateCcw")" OnClick="@(()=>Visible=true)">Restore dismissible alert</MudButton></div>}</div></ButtonShowcaseCard>
        <ButtonShowcaseCard Id="announcement" Title="Announcement" Description="Gradient banners for product news and upcoming events." Code="@AnnouncementCode"><div class="alerts-stack"><UiNotice Title="Introducing AI insights" Severity="Severity.Info" Announcement="true" Icon="@RynzoIcons.Get("Sparkles")"><ChildContent>Ask questions about your data in plain language.</ChildContent><Actions><MudButton Size="Size.Small" Variant="Variant.Outlined" EndIcon="@RynzoIcons.Get("ArrowUpRight")" OnClick='@(()=>Notify("AI insights opened"))'>Try it now</MudButton></Actions></UiNotice><UiNotice Title="Webinar this Thursday" Severity="Severity.Info" Announcement="true" Icon="@RynzoIcons.Get("Video")"><ChildContent>Scaling dashboards to 1M rows - live Q&amp;A with the team.</ChildContent><Actions><MudButton Size="Size.Small" Variant="Variant.Outlined" EndIcon="@RynzoIcons.Get("ArrowRight")" OnClick='@(()=>Notify("Registration opened",Severity.Success))'>Register</MudButton></Actions></UiNotice></div></ButtonShowcaseCard>
    </div>
    <p class="alerts-demo-note"><MudIcon Icon="@RynzoIcons.Get("Info")" />These are component examples. Messages and actions demonstrate UI behavior.</p>
</div>
@code {
    private bool Visible=true;
    private void Notify(string message,Severity severity=Severity.Normal)=>Snackbar.Add(message,severity);
    private async Task Print()=>await JS.InvokeVoidAsync("print");
    private const string SoftCode="<UiNotice Title=\"Heads up\" Severity=\"Severity.Info\">\n    A new dashboard layout is available in Layout Settings.\n</UiNotice>\n<UiNotice Title=\"Saved\" Severity=\"Severity.Success\">\n    Your changes have been saved successfully.\n</UiNotice>";
    private const string SolidCode="<UiNotice Title=\"Scheduled maintenance\"\n          Severity=\"Severity.Info\" Variant=\"Variant.Filled\">\n    The API will be read-only on Sunday from 02:00-04:00 UTC.\n</UiNotice>";
    private const string OutlineCode="<UiNotice Title=\"Backup verified\"\n          Severity=\"Severity.Success\" Variant=\"Variant.Outlined\">\n    Last night's backup was restored in a test environment.\n</UiNotice>";
    private const string AccentCode="<UiNotice Title=\"New in v2.4\" Severity=\"Severity.Info\" Accent=\"true\">\n    Custom fields are now available on every record type.\n</UiNotice>";
    private const string ActionsCode="<UiNotice Title=\"Unsaved changes\" Severity=\"Severity.Warning\"\n          OnDismiss=\"@(() => Visible = false)\">\n    <ChildContent>You have unsaved edits.</ChildContent>\n    <Actions>\n        <MudButton OnClick=\"Save\">Save now</MudButton>\n    </Actions>\n</UiNotice>";
    private const string AnnouncementCode="<UiNotice Title=\"Introducing AI insights\" Announcement=\"true\"\n          Icon=\"@RynzoIcons.Get(\"Sparkles\")\">\n    <ChildContent>Ask questions about your data in plain language.</ChildContent>\n    <Actions><MudButton>Try it now</MudButton></Actions>\n</UiNotice>";
}
