@page "/ui/accordions"
@using Rynzo.Client.Features.Ui.Components
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
<PageTitle>Accordions | Rynzo</PageTitle>
<div class="accordions-page"><DashboardPageHeader Title="Accordions" Description="Expandable content patterns for help, settings, details, and dense information."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Print">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("FilePlus2")">Create report</MudButton></Actions></DashboardPageHeader>
<MudCard Class="accordions-intro rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span><MudIcon Icon="@RynzoIcons.Get("List")" /></span><div><small>Component library / Disclosure</small><h2>More detail. When you need it.</h2><p>Keep content approachable with clear headings and expandable sections.</p></div></MudCard>
<div class="accordions-grid">
<ButtonShowcaseCard Id="single" Title="Single open" Description="One expanded answer at a time, with the option to collapse it." Code="@SingleCode"><UiHelpAccordion /></ButtonShowcaseCard>
<ButtonShowcaseCard Id="multiple" Title="Multiple open" Description="Keep several sections expanded while comparing details." Code="@MultipleCode"><div class="accordion-native"><MudExpansionPanels MultiExpansion="true" Elevation="0">@foreach(var item in Workspace){<MudExpansionPanel Text="@item.Title" Expanded="@Expanded.Contains(item.Id)" ExpandedChanged="@(value=>SetExpanded(item.Id,value))"><p>@item.Answer</p></MudExpansionPanel>}</MudExpansionPanels></div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="icons" Title="Icon headers" Description="Leading icons make related help topics easier to scan." Code="@IconsCode"><UiHelpAccordion Icons="true" /></ButtonShowcaseCard>
<ButtonShowcaseCard Id="boxed" Title="Boxed items" Description="Individual bordered surfaces separate settings sections." Code="@BoxedCode"><div class="accordion-native accordion-boxed"><MudExpansionPanels Elevation="0">@foreach(var item in Preferences){<MudExpansionPanel><TitleContent><span class="accordion-setting-title"><MudIcon Icon="@RynzoIcons.Get(item.Icon)" /><span><b>@item.Title</b><small>@item.Description</small></span></span></TitleContent><ChildContent><p>@item.Answer</p></ChildContent></MudExpansionPanel>}</MudExpansionPanels></div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="status" Title="Status &amp; actions" Description="Status chips and an action for operational review details." Code="@StatusCode"><div class="accordion-native"><MudExpansionPanels Elevation="0"><MudExpansionPanel Expanded="true"><TitleContent><span class="accordion-status-title"><b>Production deployment</b><UiStatusChip Color="Color.Success">Healthy</UiStatusChip></span></TitleContent><ChildContent><p>Version 2.4.0 completed successfully 18 minutes ago. All checks have passed.</p><MudButton Variant="Variant.Outlined" Size="Size.Small" EndIcon="@RynzoIcons.Get("ArrowUpRight")" OnClick="Deployment">View deployment</MudButton></ChildContent></MudExpansionPanel><MudExpansionPanel><TitleContent><span class="accordion-status-title"><b>Nightly backup</b><UiStatusChip Color="Color.Warning">Review</UiStatusChip></span></TitleContent><ChildContent><p>The backup completed, but one archive is awaiting an integrity check.</p></ChildContent></MudExpansionPanel></MudExpansionPanels></div></ButtonShowcaseCard>
<ButtonShowcaseCard Id="controlled" Title="Disabled &amp; controlled" Description="External controls and a visibly unavailable disclosure." Code="@ControlledCode"><div class="accordion-controls"><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="OpenRelease">Open release notes</MudButton><MudButton Size="Size.Small" OnClick="Collapse">Collapse all</MudButton></div><div class="accordion-native"><MudExpansionPanels MultiExpansion="true" Elevation="0"><MudExpansionPanel Text="Release notes" Expanded="@Expanded.Contains("release")" ExpandedChanged="@(value=>SetExpanded("release",value))"><p>Version 2.4 adds custom fields, improved filters and new workspace controls.</p></MudExpansionPanel><MudExpansionPanel Disabled="true"><TitleContent><span class="accordion-status-title"><b>Advanced compliance</b><UiStatusChip Size="Size.Small">Enterprise</UiStatusChip></span></TitleContent><ChildContent><p>This content is unavailable.</p></ChildContent></MudExpansionPanel></MudExpansionPanels></div></ButtonShowcaseCard>
</div></div>
@code {
 private HashSet<string> Expanded=["a"];
 private static readonly (string Id,string Title,string Answer)[] Workspace=[("a","Workspace access","Manage team invitations, roles and workspace permissions from the Team page."),("b","Security controls","Security settings include password, session and two-factor authentication controls."),("c","Billing preferences","Use the Pricing and Invoices pages to manage plans, invoices and payment details.")];
 private static readonly (string Title,string Description,string Answer,string Icon)[] Preferences=[("Notifications","Email, product and task preferences","Control which updates are delivered, how often they arrive, and when you would like to be notified.","Bell"),("Appearance","Theme, accent and display preferences","Choose the theme and accent that work best for your workspace.","Palette")];
 private void SetExpanded(string id,bool value){if(value)Expanded.Add(id);else Expanded.Remove(id);}
 private void OpenRelease()=>Expanded=["release"];
 private void Collapse()=>Expanded=[];
 private async Task Print()=>await JS.InvokeVoidAsync("print");
 private async Task Deployment()=>await JS.InvokeVoidAsync("alert","Deployment details opened");
 private const string SingleCode="<UiHelpAccordion />";
 private const string MultipleCode="<MudExpansionPanels MultiExpansion=\"true\" Elevation=\"0\">\n    <MudExpansionPanel Text=\"Workspace access\">\n        Manage team invitations, roles and permissions.\n    </MudExpansionPanel>\n</MudExpansionPanels>";
 private const string IconsCode="<UiHelpAccordion Icons=\"true\" />";
 private const string BoxedCode="<MudExpansionPanels Elevation=\"0\">\n    <MudExpansionPanel>\n        <TitleContent>Notifications</TitleContent>\n        <ChildContent>Control your updates.</ChildContent>\n    </MudExpansionPanel>\n</MudExpansionPanels>";
 private const string StatusCode="<MudExpansionPanel Expanded=\"true\">\n    <TitleContent>\n        Production deployment\n        <UiStatusChip Color=\"Color.Success\">Healthy</UiStatusChip>\n    </TitleContent>\n    <ChildContent><MudButton OnClick=\"Deployment\">View deployment</MudButton></ChildContent>\n</MudExpansionPanel>";
 private const string ControlledCode="<MudButton OnClick=\"OpenRelease\">Open release notes</MudButton>\n<MudExpansionPanel Text=\"Release notes\" @bind-Expanded=\"ReleaseOpen\">\n    Release details\n</MudExpansionPanel>\n<MudExpansionPanel Text=\"Advanced compliance\" Disabled=\"true\" />";
}
