@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Features.Ecommerce.Services
@using Rynzo.Client.Theme
<div class="order-details-panel"><header><div><h2>@Order.Id</h2><p>@Order.Date @Order.Channel</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close order details" OnClick="@(() => Close.InvokeAsync())" /></header><section class="order-customer"><div><b>@Order.Customer</b><p>@Order.Email</p></div><img src="@OrdersState.Portrait(Order.Customer)" alt="@Order.Customer" /></section><div class="order-detail-statuses"><section><p>Payment</p><OrderBadge Text="@Order.Payment" Tone="@Source.PaymentTone[Order.Payment]" /></section><section><p>Fulfillment</p><OrderBadge Text="@Order.Fulfillment" Tone="@Source.FulfillmentTone[Order.Fulfillment]" /></section><section><p>Order status</p><OrderBadge Text="@Order.Status" Tone="@Source.OrderTone[Order.Status]" /></section></div><section class="order-items"><header><h3>Items</h3><span>@Order.Items item@(Order.Items>1?"s":"")</span></header><div><MudIcon Icon="@RynzoIcons.Get("Package")" /><div><b>Rynzo collection item</b><p>SKU NVA-@Order.Id[^4..] Qty @Order.Items</p></div><b>@Order.Amount</b></div><footer><span>Order total</span><b>@Order.Amount</b></footer></section><section class="order-tracking"><p>Fulfillment</p><b>@(Order.Tracking.Length>0?Order.Tracking:"Tracking number pending")</b><p>Shipping method: Standard delivery</p></section><footer><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("status"))">Update status</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("payment"))">Update payment</MudButton><MudButton Variant="Variant.Outlined" Disabled="@(Order.Payment=="Refunded")" OnClick="@(() => Action.InvokeAsync("refund"))">Refund</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(Order.Status=="Cancelled")" OnClick="@(() => Action.InvokeAsync("cancel"))">Cancel order</MudButton></footer></div>
@code{[Parameter,EditorRequired]public StoreOrder Order{get;set;}=null!;[Parameter,EditorRequired]public OrdersSource Source{get;set;}=null!;[Parameter]public EventCallback Close{get;set;}[Parameter]public EventCallback<string> Action{get;set;}}
