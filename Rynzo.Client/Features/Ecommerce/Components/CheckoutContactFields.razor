@using Rynzo.Client.Features.Ecommerce.Models
<MudGrid Spacing="2">@foreach(var field in Fields){var key=field.Key;<MudItem xs="12" sm="@(key=="company"?12:6)"><MudTextField T="string" Value="@Get(key)" ValueChanged="@((string value) => Set(key,value))" Immediate="true" Placeholder="@field.Label" aria-label="@field.Label" InputType="@(key=="email"?InputType.Email:InputType.Text)" Variant="Variant.Outlined" /></MudItem>}</MudGrid>
@code{[Parameter,EditorRequired]public CheckoutContact Value{get;set;}=null!;private static readonly (string Key,string Label)[] Fields=[("first","First name"),("last","Last name"),("email","Email"),("phone","Phone"),("company","Company (optional)")];private string Get(string key)=>key switch{"first"=>Value.First,"last"=>Value.Last,"email"=>Value.Email,"phone"=>Value.Phone,_=>Value.Company};private void Set(string key,string value){switch(key){case"first":Value.First=value;break;case"last":Value.Last=value;break;case"email":Value.Email=value;break;case"phone":Value.Phone=value;break;default:Value.Company=value;break;}}}
