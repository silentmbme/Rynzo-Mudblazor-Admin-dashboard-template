@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Theme
<div class="product-detail-tabs"><MudTabs Rounded="false" Elevation="0" TabPanelsClass="product-detail-tab-body" Border="true"><MudTabPanel Text="Overview"><div class="detail-overview"><div><h2>Made for long listening sessions</h2><p>Adaptive noise cancellation and soft memory-foam ear cushions help you stay immersed. A 40-hour battery and USB-C fast charging keep the soundtrack moving.</p></div><div>@foreach(var feature in Data.Features){<section><MudIcon Icon="@RynzoIcons.Get(feature[0])" Color="Color.Primary" /><b>@feature[1]</b><p>@feature[2]</p></section>}</div></div></MudTabPanel><MudTabPanel Text="Specifications"><div class="detail-specifications">@foreach(var spec in Data.Specifications){<div><span>@spec[0]</span><b>@spec[1]</b></div>}</div></MudTabPanel><MudTabPanel Text="Reviews" BadgeData="286" BadgeColor="Color.Default"><div class="detail-reviews"><div class="detail-rating"><div><b>4.8</b><div class="detail-stars">@for(var i=0;i<5;i++){<MudIcon Icon="@Icons.Material.Filled.Star" />}</div><p>286 reviews</p></div><div>@foreach(var rating in Data.Distribution){<div><span>@rating[0]</span><MudIcon Icon="@Icons.Material.Filled.Star" /><MudProgressLinear Value="rating[1]" Color="Color.Warning" /><span>@rating[1]%</span></div>}</div></div>@foreach(var review in Data.Reviews){<article><header><div><b>@review[0]</b><p>Verified purchase</p></div><span class="detail-stars">@for(var i=0;i<5;i++){<MudIcon Icon="@Icons.Material.Filled.Star" />}</span></header><p>@review[1]</p></article>}</div></MudTabPanel></MudTabs></div>
@code{[Parameter,EditorRequired]public ProductDetailsData Data{get;set;}=null!;}
