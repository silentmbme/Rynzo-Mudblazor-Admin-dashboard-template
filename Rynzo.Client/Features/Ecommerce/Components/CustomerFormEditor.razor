@using Rynzo.Client.Features.Ecommerce.Models
<MudGrid Spacing="2">@foreach(var field in Fields){var key=field.Key;<MudItem xs="12" sm="6"><MudTextField T="string" Value="@Get(key)" ValueChanged="@((string value) => Set(key,value))" Immediate="true" Label="@field.Label" aria-label="@field.Label" InputType="@(key=="email"?InputType.Email:InputType.Text)" Required="@(key is "first" or "email")" Variant="Variant.Outlined" /></MudItem>}<MudItem xs="12" sm="6"><label class="customer-form-select">Country<select aria-label="Customer country" @bind="Draft.Country">@foreach(var value in Countries){<option>@value</option>}</select></label></MudItem><MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="Draft.City" Immediate="true" Label="City" aria-label="City" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" sm="6"><label class="customer-form-select">Segment<select aria-label="Customer segment" @bind="Draft.Segment">@foreach(var value in Segments){<option>@value</option>}</select></label></MudItem><MudItem xs="12" sm="6"><label class="customer-form-select">Status<select aria-label="Customer status" @bind="Draft.Status">@foreach(var value in Statuses){<option>@value</option>}</select></label></MudItem><MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="Draft.Tags" Immediate="true" Label="Tags (comma separated)" aria-label="Tags (comma separated)" Variant="Variant.Outlined" /></MudItem><MudItem xs="12"><MudTextField T="string" @bind-Value="Draft.Notes" Immediate="true" Label="Internal notes" aria-label="Internal notes" Lines="3" Variant="Variant.Outlined" /></MudItem></MudGrid>
@code{[Parameter,EditorRequired]public CustomerDraft Draft{get;set;}=null!;[Parameter]public string[] Segments{get;set;}=[];[Parameter]public string[] Statuses{get;set;}=[];private static readonly string[] Countries=["United States","United Kingdom","Germany","India","Canada","Australia"];private static readonly (string Key,string Label)[] Fields=[("first","First name"),("last","Last name"),("email","Email"),("phone","Phone"),("company","Company")];private string Get(string key)=>key switch{"first"=>Draft.First,"last"=>Draft.Last,"email"=>Draft.Email,"phone"=>Draft.Phone,_=>Draft.Company};private void Set(string key,string value){switch(key){case"first":Draft.First=value;break;case"last":Draft.Last=value;break;case"email":Draft.Email=value;break;case"phone":Draft.Phone=value;break;default:Draft.Company=value;break;}}}
