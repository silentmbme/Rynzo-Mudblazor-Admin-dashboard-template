@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Features.Ecommerce.Services
@using Rynzo.Client.Theme
<div class="customer-profile-panel"><header><div><h2>@Customer.Name</h2><p>Customer profile and commerce activity</p></div><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close customer profile" OnClick="@(() => Close.InvokeAsync())" /></header><div class="customer-profile-person"><img src="@OrdersState.Portrait(Customer.Name)" alt="@Customer.Name" /><div><b>@Customer.Name</b><p>@Customer.Email</p><div><OrderBadge Text="@Customer.Status" Tone="@Source.StatusTone[Customer.Status]" /><OrderBadge Text="@Customer.Segment" Tone="@Source.SegmentTone[Customer.Segment]" /></div></div></div><div class="customer-profile-metrics">@foreach(var item in new[]{("Total spent",Customer.Total),("Orders",Customer.Orders.ToString()),("Avg. order",Customer.Average),("Lifetime value",Customer.Lifetime)}){<section><p>@item.Item1</p><b>@item.Item2</b></section>}</div><section class="customer-profile-info"><h3>Profile</h3><p>Phone: @Customer.Phone</p><p>Company: @(Customer.Company.Length>0?Customer.Company:"Personal customer")</p><p>Joined: @Customer.Joined</p><p>Address: @Customer.City, @Customer.Country</p></section><section><h3>Recent orders</h3><div class="customer-recent-orders">@for(var index=1;index<=3;index++){<div><span><b>#ORD-@(10482-index)</b><small>@(index*8) days ago</small></span><span><b>@Customer.RecentAmount</b> <OrderBadge Text="Paid" Tone="success" /></span></div>}</div></section><section><h3>Tags</h3><div class="customer-profile-tags">@foreach(var tag in Customer.Tags){<OrderBadge Text="@tag" Tone="muted" />}</div></section><section class="customer-profile-notes"><header><h3>Internal notes</h3><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Action.InvokeAsync("note"))">Add note</MudButton></header>@foreach(var note in Customer.Notes){<p>@note</p>}@if(Customer.Notes.Length==0){<p class="customer-no-notes">No notes yet.</p>}</section><section class="customer-profile-info"><h3>Activity</h3><p>Order #ORD-10482 placed 2 days ago</p><p>Profile updated Aug 10, 2026</p><p>Segment changed to @Customer.Segment Jul 14, 2026</p></section><footer><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("edit"))">Edit customer</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("vip"))">Mark VIP</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("block"))">@(Customer.Status=="Blocked"?"Unblock customer":"Block customer")</MudButton><MudButton Variant="Variant.Outlined" OnClick="@(() => Action.InvokeAsync("archive"))">Archive</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" Class="customer-profile-delete" OnClick="@(() => Action.InvokeAsync("delete"))">Delete customer</MudButton></footer></div>
@code{[Parameter,EditorRequired]public StoreCustomer Customer{get;set;}=null!;[Parameter,EditorRequired]public CustomersSource Source{get;set;}=null!;[Parameter]public EventCallback Close{get;set;}[Parameter]public EventCallback<string> Action{get;set;}}
