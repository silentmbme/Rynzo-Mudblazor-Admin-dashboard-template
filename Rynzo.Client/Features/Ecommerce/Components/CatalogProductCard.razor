@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Theme
<div class="catalog-product-shell"><MudCard Outlined="true" Elevation="0" Class="@((($"catalog-product {(ListView?"list":"grid")} {(Selected?"selected":"")}")) + " rynzo-widget-card")"><article role="button" tabindex="0" data-sku="@Product.Sku" @onclick="@(() => Select.InvokeAsync())" @onkeydown="Key"><div class="catalog-product-image"><img src="@Product.Image" alt="@Product.Name" />@if(!ListView){<div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("ShoppingCart")" OnClick="@(() => Cart.InvokeAsync())">@(InCart?"Added to cart":"Add to cart")</MudButton></div>}</div><div class="catalog-product-info"><b>@Product.Name</b><small>@Product.Sku - @Product.Brand</small><div class="catalog-product-tags"><span>@Product.Category</span><span>@Product.Status</span>@if(Product.LowStock){<span>Low stock: @Product.Stock</span>}</div><footer><b>@Product.Price</b><span>@Product.Rating star - @Product.Sold sold</span></footer></div></article></MudCard></div>
@code{[Parameter,EditorRequired]public CatalogProduct Product{get;set;}=null!;[Parameter]public bool ListView{get;set;}[Parameter]public bool Selected{get;set;}[Parameter]public bool InCart{get;set;}[Parameter]public EventCallback Select{get;set;}[Parameter]public EventCallback Cart{get;set;}private async Task Key(KeyboardEventArgs e){if(e.Key is "Enter" or " ")await Select.InvokeAsync();}}
