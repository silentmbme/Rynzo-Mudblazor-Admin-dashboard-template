@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Theme
<div class="product-pricing"><div><h2>Pricing</h2><p>Set the selling price and margin target.</p><MudTextField T="string" Value="Draft.Price" ValueChanged="Price" Immediate="true" InputType="InputType.Number" UserAttributes="@Attributes("Selling price")" Placeholder="Selling price" Adornment="Adornment.Start" AdornmentText="$" Variant="Variant.Outlined" Class="mt-5" /><MudTextField T="string" @bind-Value="Draft.CompareAt" InputType="InputType.Number" UserAttributes="@Attributes("Compare-at price")" Placeholder="Compare-at price" Adornment="Adornment.Start" AdornmentText="$" Variant="Variant.Outlined" Class="mt-4" /><MudTextField T="string" Value="Draft.Cost" ValueChanged="Cost" Immediate="true" InputType="InputType.Number" UserAttributes="@Attributes("Cost per item")" Placeholder="Cost per item" Adornment="Adornment.Start" AdornmentText="$" Variant="Variant.Outlined" Class="mt-4" /></div><div class="product-margin"><h3>Margin preview <MudIcon Icon="@RynzoIcons.Get("ChartNoAxesCombined")" Color="Color.Primary" Size="Size.Small" /></h3><b data-margin>@Draft.Margin%</b><p>Estimated gross margin per sale</p><div><span>Selling price</span><b>$@Draft.Selling</b></div><div><span>Item cost</span><b>$@Draft.ItemCost</b></div><div><span>Estimated profit</span><b data-profit>$@Draft.Profit</b></div></div></div>
@code{[Parameter,EditorRequired]public ProductDraft Draft{get;set;}=null!;[Parameter]public EventCallback Changed{get;set;}private static Dictionary<string,object> Attributes(string label)=>new(){{"min","0"},{"step","0.01"},{"aria-label",label}};private async Task Price(string value){Draft.Price=value;await Changed.InvokeAsync();}private async Task Cost(string value){Draft.Cost=value;await Changed.InvokeAsync();}}
