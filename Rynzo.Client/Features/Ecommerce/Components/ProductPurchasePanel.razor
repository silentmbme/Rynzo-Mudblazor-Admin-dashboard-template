@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
<div class="product-purchase"><header><div><div class="product-purchase-badges"><MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip><MudChip T="string" Size="Size.Small">Electronics</MudChip><MudChip T="string" Size="Size.Small" Color="Color.Primary">Best seller</MudChip></div><h1>Wireless Headphones Pro</h1><div class="product-purchase-reviews"><span>@for(var i=0;i<5;i++){<MudIcon Icon="@(i<4?Icons.Material.Filled.Star:Icons.Material.Outlined.StarBorder)" />}</span><b>4.8</b><span>286 verified reviews</span></div></div><MudIconButton Icon="@(State.Wishlisted?Icons.Material.Filled.Favorite:RynzoIcons.Get("Heart"))" Color="@(State.Wishlisted?Color.Primary:Color.Default)" Variant="Variant.Outlined" aria-label="Add to wishlist" aria-pressed="@State.Wishlisted" OnClick="@(() => State.Wishlisted=!State.Wishlisted)" /></header><div class="product-purchase-price"><b>$129.00</b><del>$159.00</del><span>Save $30.00</span></div><p class="product-purchase-description">Premium noise-cancelling headphones engineered for focused listening, comfortable all-day wear, and effortless multi-device pairing.</p><div class="product-in-stock"><MudIcon Icon="@RynzoIcons.Get("CircleCheck")" Size="Size.Small" /><b>In stock</b><span>- 24 available for immediate dispatch</span></div><section class="product-finish"><header><b>Finish</b><span>@State.Finish</span></header><div>@foreach(var finish in Finishes){<MudButton Variant="@(State.Finish==finish?Variant.Filled:Variant.Outlined)" Color="@(State.Finish==finish?Color.Primary:Color.Default)" OnClick="@(() => State.Finish=finish)">@finish</MudButton>}</div></section><div class="product-purchase-actions"><div><MudIconButton Icon="@RynzoIcons.Get("Minus")" aria-label="Decrease quantity" OnClick="State.Decrease" /><span data-quantity>@State.Quantity</span><MudIconButton Icon="@RynzoIcons.Get("Plus")" aria-label="Increase quantity" OnClick="State.Increase" /></div><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("ShoppingCart")" OnClick="Add" Class="product-detail-cart">@State.CartLabel</MudButton></div><MudButton Variant="Variant.Outlined" FullWidth="true" Class="product-buy-now" OnClick="@(() => Snackbar.Add("Checkout started",Severity.Success))">Buy it now</MudButton><div class="product-purchase-meta">@foreach(var field in new[]{("SKU","WHP-1048"),("Brand","Rynzo"),("Category","Electronics"),("Warranty","2 years")}){<div><span>@field.Item1</span><b>@field.Item2</b></div>}</div></div>
@code{[Parameter,EditorRequired]public ProductPurchaseState State{get;set;}=null!;[Parameter]public string[] Finishes{get;set;}=[];private void Add(){State.InCart=true;Snackbar.Add($"{State.Quantity} item{(State.Quantity>1?"s":"")} added to cart",Severity.Success);}}
