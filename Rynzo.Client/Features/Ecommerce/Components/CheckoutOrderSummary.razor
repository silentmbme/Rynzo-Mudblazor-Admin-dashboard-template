@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Features.Ecommerce.Services
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@{var totals=State.Totals;}
<div class="checkout-order-summary">@foreach(var item in State.Items){<div class="checkout-cart-item" data-cart-item="@item.Id"><img src="@item.Image" alt="@item.Name" /><div><b>@item.Name</b><small>@item.Variant</small><footer><div><MudIconButton Icon="@RynzoIcons.Get("Minus")" Size="Size.Small" aria-label="@($"Decrease {item.Name}")" OnClick="@(() => Quantity(item.Id,-1))" /><span>@item.Quantity</span><MudIconButton Icon="@RynzoIcons.Get("Plus")" Size="Size.Small" aria-label="@($"Increase {item.Name}")" OnClick="@(() => Quantity(item.Id,1))" /></div><b>@CheckoutTotals.Money(item.Price*item.Quantity)</b></footer></div><MudIconButton Icon="@RynzoIcons.Get("X")" Size="Size.Small" aria-label="@($"Remove {item.Name}")" OnClick="@(() => Remove(item.Id))" /></div>}<section class="checkout-promo"><label>Promo code</label>@if(State.AppliedCoupon.Length>0){<div class="checkout-applied-promo"><span><MudIcon Icon="@RynzoIcons.Get("Check")" Size="Size.Small" />@State.AppliedCoupon applied</span><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => State.AppliedCoupon="")">Remove</MudButton></div>}else{<div class="checkout-promo-input"><MudTextField T="string" @bind-Value="State.Coupon" Immediate="true" Placeholder="SAVE10" aria-label="Promo code" Variant="Variant.Outlined" Margin="Margin.Dense" /><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Coupon">Apply</MudButton></div>}</section><section class="checkout-totals"><div><span>Subtotal</span><span data-subtotal>@CheckoutTotals.Money(totals.Subtotal)</span></div><div><span>Shipping</span><span data-shipping>@(totals.Shipping!=0?CheckoutTotals.Money(totals.Shipping):"Free")</span></div><div><span>Tax</span><span data-tax>@CheckoutTotals.Money(totals.Tax)</span></div>@if(totals.Discount>0){<div class="checkout-discount"><span>Discount</span><span data-discount>-@CheckoutTotals.Money(totals.Discount)</span></div>}<div><b>Total</b><b data-total>@CheckoutTotals.Money(totals.Total)</b></div></section>@if(State.Errors.Length>0){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" NoIcon="true" Class="checkout-errors"><b>Please review:</b><ul>@foreach(var error in State.Errors){<li>@error</li>}</ul></MudAlert>}<MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" StartIcon="@RynzoIcons.Get("LockKeyhole")" OnClick="Place">Place order</MudButton><p class="checkout-security"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" Size="Size.Small" />Secure demo checkout. Card details are not stored.</p></div>
@code{[Parameter,EditorRequired]public CheckoutState State{get;set;}=null!;[Parameter]public EventCallback Changed{get;set;}private async Task Quantity(int id,int delta){State.Quantity(id,delta);await Changed.InvokeAsync();}private async Task Remove(int id){State.Items.RemoveAll(i=>i.Id==id);await Changed.InvokeAsync();}private void Coupon(){if(State.ApplyCoupon())Snackbar.Add(State.AppliedCoupon+" promo applied",Severity.Success);else Snackbar.Add("Try SAVE10, WELCOME15, or FREESHIP",Severity.Error);}private async Task Place(){if(State.Place())Snackbar.Add($"Order {State.Success} placed successfully",Severity.Success);else Snackbar.Add("Please complete the required checkout information",Severity.Error);await Changed.InvokeAsync();}}
