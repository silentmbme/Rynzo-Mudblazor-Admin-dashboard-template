@using Rynzo.Client.Features.Ecommerce.Services
@inject ISnackbar Snackbar
<MudDialog Style="max-height:90vh;overflow-y:auto"><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">@Title</MudText></TitleContent><DialogContent><p class="mb-4">@Description</p>@if(Mode is "add" or "edit"){<CustomerFormEditor Draft="State.Draft" Segments="State.Source.Segments" Statuses="State.Source.Statuses" />}else if(Mode=="note"){<MudTextField T="string" @bind-Value="State.Note" Immediate="true" Placeholder="Write an internal note" aria-label="Write an internal note" Lines="4" Variant="Variant.Outlined" />}else if(Mode is "bulkSegment" or "bulkStatus"){<select aria-label="Customer bulk value" @bind="State.BulkValue" style="height:40px;width:100%;border:1px solid var(--border);border-radius:6px;padding:0 12px;background:var(--background);color:var(--foreground)">@foreach(var value in Mode=="bulkSegment"?State.Source.Segments:State.Source.Statuses.Take(3)){<option>@value</option>}</select>}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(() => Dialog.Cancel())">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="@(Mode is "delete" or "bulkDelete"?Color.Error:Color.Primary)" OnClick="Save">@Action</MudButton></DialogActions></MudDialog>
@code{[Parameter,EditorRequired]public CustomersState State{get;set;}=null!;[Parameter]public string Mode{get;set;}="add";[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private string Title=>Mode switch{"add"=>"Add customer","edit"=>"Edit customer","note"=>"Add Customer Note","block"=>State.Active?.Status=="Blocked"?"Unblock customer?":"Block this customer?","archive"=>"Archive customer?","delete"=>"Delete customer?","bulkSegment"=>"Change customer segment","bulkStatus"=>"Change customer status",_=>"Delete selected customers?"};private string Description=>Mode switch{"block"=>"The customer remains in records but is marked as blocked.","archive"=>"Archived customers remain in records and can be restored later.","delete" or "bulkDelete"=>"This is demo behavior. The selected record will be removed from local data.","note"=>"Internal notes are visible to your team only.",_=>"Complete the details below."};private string Action=>Mode switch{"add"=>"Create customer","edit"=>"Save changes","note"=>"Add note","block"=>State.Active?.Status=="Blocked"?"Unblock customer":"Block customer","archive"=>"Archive","delete" or "bulkDelete"=>"Delete",_=>"Apply changes"};private void Save(){var notify=Mode!="note"||State.Note.Trim().Length>0;if(Mode is "add" or "edit"){if(!State.Save(Mode=="add")){Snackbar.Add("Enter a first name and valid email",Severity.Error);return;}}else State.Confirm(Mode);Dialog.Close(DialogResult.Ok(notify));}}
