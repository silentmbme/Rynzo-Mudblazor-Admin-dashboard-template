@using Rynzo.Client.Features.Ecommerce.Models
<MudGrid Spacing="2">@foreach(var field in Fields){var key=field.Key;<MudItem xs="12" sm="@(key is "line1" or "line2"?12:6)"><MudTextField T="string" Value="@Get(key)" ValueChanged="@((string value) => Set(key,value))" Immediate="true" Placeholder="@field.Label" aria-label="@($"{Prefix} {field.Label}")" InputId="@($"{Prefix}-{key}")" Variant="Variant.Outlined" /></MudItem>}<MudItem xs="12" sm="6"><label class="checkout-country">Country<select id="@($"{Prefix}-country")" aria-label="@($"{Prefix} Country")" @bind="Value.Country">@foreach(var country in new[]{"United States","United Kingdom","Canada","Germany","India","Australia"}){<option>@country</option>}</select></label></MudItem></MudGrid>
@code{[Parameter,EditorRequired]public CheckoutAddress Value{get;set;}=null!;[Parameter]public string Prefix{get;set;}="shipping";private static readonly (string Key,string Label)[] Fields=[("line1","Address line 1"),("line2","Address line 2 (optional)"),("city","City"),("state","State / Province"),("postal","Postal code")];private string Get(string key)=>key switch{"line1"=>Value.Line1,"line2"=>Value.Line2,"city"=>Value.City,"state"=>Value.State,_=>Value.Postal};private void Set(string key,string value){switch(key){case"line1":Value.Line1=value;break;case"line2":Value.Line2=value;break;case"city":Value.City=value;break;case"state":Value.State=value;break;default:Value.Postal=value;break;}}}
