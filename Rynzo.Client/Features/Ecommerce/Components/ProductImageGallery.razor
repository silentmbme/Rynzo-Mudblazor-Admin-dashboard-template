@using Rynzo.Client.Theme
<div class="detail-image-gallery"><div><span>-19%</span><MudIconButton Icon="@RynzoIcons.Get("Maximize2")" aria-label="Expand product image" Variant="Variant.Outlined" /><img src="@_active" alt="Wireless Headphones Pro" /></div><nav>@for(var index=0;index<Images.Length;index++){var image=Images[index];<button class="@(image==_active?"active":"")" @onclick="@(() => _active=image)"><img src="@image" alt="@($"Wireless Headphones view {index+1}")" /></button>}</nav><footer><span><MudIcon Icon="@RynzoIcons.Get("Image")" Color="Color.Primary" Size="Size.Small" />4 product images</span><MudButton Variant="Variant.Text" Color="Color.Primary">Manage media</MudButton></footer></div>
@code{[Parameter,EditorRequired]public string[] Images{get;set;}=[];private string _active="assets/images/products/wireless-headphones-pro.png";}
