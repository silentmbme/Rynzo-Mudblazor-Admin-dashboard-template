@using Rynzo.Client.Features.Ecommerce.Models
<MudDialog><TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">@Title</MudText></TitleContent><DialogContent><p>@Description</p>@if(Action is "status" or "payment"){<select aria-label="Order action value" @bind="_next" style="width:100%;height:40px;border:1px solid var(--border);border-radius:6px;background:var(--background);color:var(--foreground);padding:0 12px;margin-top:16px">@foreach(var option in Options){<option>@option</option>}</select>}</DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(() => Dialog.Cancel())">Back</MudButton><MudButton Variant="Variant.Filled" Color="@(Action=="cancel"?Color.Error:Color.Primary)" OnClick="@(() => Dialog.Close(DialogResult.Ok(_next)))">@(Action=="refund"?"Confirm refund":Action=="cancel"?"Cancel order":"Save changes")</MudButton></DialogActions></MudDialog>
@code{[Parameter,EditorRequired]public StoreOrder Order{get;set;}=null!;[Parameter]public string Action{get;set;}="status";[Parameter]public string[] Options{get;set;}=[];[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private string _next="";protected override void OnInitialized()=>_next=Action=="payment"?Order.Payment:Order.Status;private string Title=>Action=="status"?"Update order status":Action=="payment"?"Update payment status":Action=="refund"?"Issue a refund":"Cancel order";private string Description=>Action=="refund"?$"This will mark {Order.Id} as refunded and returned.":Action=="cancel"?$"This will cancel {Order.Id}. This action is recorded in the order timeline.":$"Choose the new value for {Order.Id}.";}
