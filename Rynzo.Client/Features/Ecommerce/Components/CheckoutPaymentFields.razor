@using Rynzo.Client.Features.Ecommerce.Services
<div class="checkout-payment-choices">@foreach(var method in Methods){<CheckoutChoiceCard Active="@(State.Payment==method.Method)" Title="@method.Method" Detail="@method.Detail" Select="@(() => Choose(method.Method))" />}</div>@if(State.Payment=="Card"){<div class="checkout-card-fields"><MudGrid Spacing="2"><MudItem xs="12"><MudTextField T="string" @bind-Value="State.Card.Holder" Immediate="true" Placeholder="Cardholder name" aria-label="Cardholder name" Variant="Variant.Outlined" /></MudItem><MudItem xs="12"><MudTextField T="string" @bind-Value="State.CardNumber" Immediate="true" Placeholder="Card number" aria-label="Card number" InputMode="InputMode.numeric" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="State.Card.Expiry" Immediate="true" Placeholder="Expiry — MM/YY" aria-label="Expiry" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="State.Card.Cvv" Immediate="true" Placeholder="CVV" aria-label="CVV" InputType="InputType.Password" InputMode="InputMode.numeric" Variant="Variant.Outlined" /></MudItem></MudGrid></div>}else{<p class="checkout-payment-notice">@(State.Payment=="PayPal"?"You will continue securely with PayPal after placing this demo order.":State.Payment=="Bank transfer"?"Bank transfer details will be included with your order confirmation.":"Payment will be collected at delivery.")</p>}
@code{[Parameter,EditorRequired]public CheckoutState State{get;set;}=null!;[Parameter]public EventCallback Changed{get;set;}private static readonly (string Method,string Detail)[] Methods=[("Card","Credit or debit card"),("PayPal","Pay securely with PayPal"),("Bank transfer","Pay from your bank"),("Cash on delivery","Pay when delivered")];private async Task Choose(string method){State.Payment=method;await Changed.InvokeAsync();}}
