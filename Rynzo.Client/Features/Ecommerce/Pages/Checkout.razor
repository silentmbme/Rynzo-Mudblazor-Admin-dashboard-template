@page "/ecommerce/checkout"
@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Features.Ecommerce.Services
@using Rynzo.Client.Features.Ecommerce.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>Checkout | Rynzo</PageTitle>
<div class="checkout-page"><header><PageHeader Title="Checkout" Description="@(_state.Success is not null?"Order confirmation":"Complete customer, shipping and payment information before placing the order.")" Breadcrumbs="Breadcrumbs" />@if(_state.Success is null){<MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("ArrowLeft")" OnClick="Back">Back to cart</MudButton>}</header>@if(_state.Success is not null){<section class="checkout-success"><span><MudIcon Icon="@RynzoIcons.Get("CheckCircle2")" Color="Color.Success" /></span><h2>Order placed successfully</h2><p>Thank you, @_state.Contact.First. Your order has been created and is being processed.</p><div>@foreach(var field in new[]{("Order number",_state.Success),("Order total",CheckoutTotals.Money(_state.Totals.Total)),("Delivery",_state.Delivery+" delivery"),("Payment",_state.Payment)}){<p><small>@field.Item1</small><b>@field.Item2</b></p>}</div><p>Shipping to @_state.Shipping.Line1, @_state.Shipping.City, @_state.Shipping.Country</p><footer><MudButton Variant="Variant.Outlined" OnClick="@(() => Snackbar.Add("Order details are available in Orders",Severity.Success))">View order</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Continue">Continue shopping</MudButton></footer></section>}else{<div class="checkout-columns"><main><section><h2>1. Contact information</h2><div><CheckoutContactFields Value="_state.Contact" /></div></section><section><h2>2. Shipping address</h2><div><div class="checkout-saved-address"><b>Home</b><p>Sophia Carter 24 Madison Avenue New York, NY 10010</p></div><CheckoutAddressFields Value="_state.Shipping" Prefix="shipping" /><MudCheckBox T="bool" @bind-Value="_state.SaveAddress" Label="Save this address" Color="Color.Primary" Size="Size.Small" Class="mt-4" /></div></section><section><h2>3. Delivery method</h2><div class="checkout-delivery">@foreach(var delivery in _state.Source.DeliveryInfo){var method=delivery.Key;<CheckoutChoiceCard Active="@(_state.Delivery==method)" Title="@(method=="Pickup"?"Free Pickup":method+" Delivery")" Detail="@delivery.Value.Description" Price="@(delivery.Value.Price==0?"Free":CheckoutTotals.Money(delivery.Value.Price))" Select="@(() => _state.Delivery=method)" />}</div></section><section><h2>4. Payment method</h2><div><CheckoutPaymentFields State="_state" Changed="Refresh" /></div></section><section><h2>5. Billing address</h2><div><MudCheckBox T="bool" @bind-Value="_state.SameBilling" Label="Billing address is the same as shipping" Color="Color.Primary" Size="Size.Small" />@if(!_state.SameBilling){<div class="mt-4"><CheckoutAddressFields Value="_state.Billing" Prefix="billing" /></div>}</div></section><section><h2>6. Order notes</h2><div><MudTextField T="string" @bind-Value="_state.Notes" Immediate="true" Placeholder="Add delivery instructions or order notes..." aria-label="Order notes" Lines="3" Variant="Variant.Outlined" /></div></section></main><aside><section><h2>Order summary</h2><div><CheckoutOrderSummary State="_state" Changed="Refresh" /></div></section></aside></div>}</div>
@code{private readonly CheckoutState _state=new();private static readonly BreadcrumbItem[] Breadcrumbs=[new("Cart",null),new("Checkout",null,true)];private Task Back()=>JS.InvokeVoidAsync("history.back").AsTask();private void Refresh()=>StateHasChanged();private void Continue(){_state.Success=null;_state.SaveAddress=true;}}
