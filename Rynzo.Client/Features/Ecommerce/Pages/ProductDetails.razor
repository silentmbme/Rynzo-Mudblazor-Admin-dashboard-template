@page "/ecommerce/products/detail"
@page "/ecommerce/product-details"
@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Features.Ecommerce.Components
@using Rynzo.Client.Theme
<PageTitle>Wireless Headphones Pro | Rynzo</PageTitle>
<div class="product-details-page"><header><PageHeader Title="Wireless Headphones Pro" Description="SKU WHP-1048 - Electronics - Updated today" Breadcrumbs="Breadcrumbs" /><nav><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("ArrowLeft")" Href="/ecommerce/products">Back to products</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Pencil")">Edit product</MudButton></nav></header><div class="product-details-top"><section><ProductImageGallery Images="_data.Gallery" /></section><section><ProductPurchasePanel State="_state" Finishes="_data.Finishes" /></section></div><div class="product-details-bottom"><section><ProductDetailTabs Data="_data" /></section><aside><section><h2>Shipping &amp; returns</h2><div class="product-shipping">@foreach(var item in _data.Shipping){<div><span><MudIcon Icon="@RynzoIcons.Get(item[0])" Color="Color.Primary" /></span><div><b>@item[1]</b><p>@item[2]</p></div></div>}</div></section><section><header><h2>You may also like</h2><MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">View all</MudButton></header><div class="product-recommendations">@foreach(var item in _data.Recommendations){<button><img src="@item[2]" alt="" /><span><b>@item[0]</b><small>Recommended for you</small></span><b>@item[1]</b></button>}</div></section></aside></div></div>
@code{private readonly ProductDetailsData _data=ProductDetailsData.Load();private readonly ProductPurchaseState _state=new();private static readonly BreadcrumbItem[] Breadcrumbs=[new("Rynzo",null),new("eCommerce",null),new("Products",null),new("Product details",null,true)];}
