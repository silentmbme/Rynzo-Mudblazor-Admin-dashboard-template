@page "/ecommerce/orders"
@implements IAsyncDisposable
@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Features.Ecommerce.Services
@using Rynzo.Client.Features.Ecommerce.Components
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Orders | Rynzo</PageTitle>
<div class="orders-page">
<PageHeader Title="Orders" Description="Track, fulfill, and resolve every customer order."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export orders</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="@(() => Snackbar.Add("Create order flow is ready for checkout orders",Severity.Success))">Create order</MudButton></Actions></PageHeader>
<div class="orders-metrics">@foreach(var metric in Metrics){<MudCard Class="orders-metric rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><div class="orders-metric-top"><span>@metric.Label</span><span class="orders-metric-icon"><MudIcon Icon="@RynzoIcons.Get(metric.Icon)" /></span></div><b>@metric.Value</b><p><i></i>@metric.Detail</p></MudCard>}</div>
<MudCard Class="orders-workspace rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section">
    <header class="orders-library-heading"><div><span class="orders-eyebrow">ORDER MANAGEMENT</span><h2>Order overview <span>@_state.Orders.Count orders</span></h2><p>Manage purchases from payment through delivery.</p></div><span class="orders-session"><i></i>Session workspace</span></header>
    <nav class="orders-status-tabs" aria-label="Order status tabs">@foreach(var status in new[]{"All statuses","Processing","Shipped","Delivered","Cancelled"}){<button type="button" class="@(_state.Status==status?"is-active":"")" aria-pressed="@(_state.Status==status)" @onclick="@(() => {_state.Status=status;Refresh();})">@(status=="All statuses"?"All orders":status)<span>@_state.Orders.Count(o=>status=="All statuses"||o.Status==status)</span></button>}</nav><div class="orders-filters"><MudTextField T="string" Value="_state.Query" ValueChanged="Search" Immediate="true" Placeholder="Search order, customer, or email" aria-label="Search order, customer, or email" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><div><select aria-label="Order status filter" @bind="_state.Status" @bind:after="Refresh"><option>All statuses</option>@foreach(var status in _state.Source.OrderTone.Keys){<option>@status</option>}</select><select aria-label="Order payment filter" @bind="_state.Payment" @bind:after="Refresh"><option>All payments</option>@foreach(var payment in _state.Source.PaymentTone.Keys){<option>@payment</option>}</select><select aria-label="Order fulfillment filter" @bind="_state.Fulfillment" @bind:after="Refresh"><option>All fulfillment</option>@foreach(var fulfillment in _state.Source.FulfillmentTone.Keys){<option>@fulfillment</option>}</select><select aria-label="Order channel filter" @bind="_state.Channel" @bind:after="Refresh">@foreach(var channel in new[]{"All channels","Online Store","Marketplace","Wholesale"}){<option>@channel</option>}</select><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Reset">Reset</MudButton></div></div>@if(_state.Selected.Count>0){<div class="orders-bulk"><b>@_state.Selected.Count selected</b><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Process">Mark processing</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClearSelection">Clear selection</MudButton></div>}<MudTable T="StoreOrder" Items="_shown" Hover="true" Elevation="0" Breakpoint="Breakpoint.None" Class="orders-table"><HeaderContent><MudTh><MudCheckBox T="bool" Value="_state.SelectedAll" ValueChanged="@((bool _) => _state.SelectAll())" aria-label="Select all orders" Size="Size.Small" /></MudTh><MudTh>Order</MudTh><MudTh>Customer</MudTh><MudTh>Date</MudTh><MudTh>Total</MudTh><MudTh>Payment</MudTh><MudTh>Fulfillment</MudTh><MudTh>Status</MudTh><MudTh><span class="orders-visually-hidden">Actions</span></MudTh></HeaderContent><RowTemplate Context="order"><MudTd><MudCheckBox T="bool" Value="@_state.Selected.Contains(order.Id)" ValueChanged="@((bool _) => _state.Toggle(order.Id))" aria-label="@($"Select {order.Id}")" Size="Size.Small" /></MudTd><MudTd><button class="order-id" @onclick="@(() => _state.Active=order)">@order.Id</button><p>@order.Items item@(order.Items>1?"s":"") @order.Channel</p></MudTd><MudTd><div class="orders-customer"><img src="@OrdersState.Portrait(order.Customer)" alt="@order.Customer" /><div><b>@order.Customer</b><p>@order.Email</p></div></div></MudTd><MudTd>@order.Date</MudTd><MudTd><b class="orders-amount">@order.Amount</b><small class="orders-currency">USD</small></MudTd><MudTd><OrderBadge Text="@order.Payment" Tone="@_state.Source.PaymentTone[order.Payment]" /></MudTd><MudTd><OrderBadge Text="@order.Fulfillment" Tone="@_state.Source.FulfillmentTone[order.Fulfillment]" /></MudTd><MudTd><OrderBadge Text="@order.Status" Tone="@_state.Source.OrderTone[order.Status]" /></MudTd><MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => _state.Active=order)" StartIcon="@RynzoIcons.Get("ArrowUpRight")">Details</MudButton></MudTd></RowTemplate></MudTable>@if(_shown.Length==0){<div class="orders-empty"><MudIcon Icon="@RynzoIcons.Get("SearchX")" /><b>No orders found</b><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Reset">Clear filters</MudButton></div>}<footer><span>Showing @_shown.Length of @_state.Orders.Count orders</span><div><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="true">Previous</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="true">Next</MudButton></div></footer></MudCard></div>
<MudOverlay Visible="DetailsOpen" DarkBackground="true" LockScroll="true" ZIndex="1399" OnClick="Close" /><MudDrawer Open="DetailsOpen" OpenChanged="@((bool open) => {if(!open&&!_actionOpen)_state.Active=null;})" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Overlay="false" Width="576px" Elevation="0" Style="z-index:1400;max-width:100%;background:var(--card);overflow-y:auto" Class="order-details-drawer"><MudFocusTrap Disabled="@(!DetailsOpen)">@if(_state.Active is { } order){<OrderDetailsPanel Order="order" Source="_state.Source" Close="Close" Action="Action" />}</MudFocusTrap></MudDrawer>
@code{
    private readonly OrdersState _state=new();
    private StoreOrder[] _shown=[];
    private bool _actionOpen;
    private bool DetailsOpen=>_state.Active is not null&&!_actionOpen;
    private IJSObjectReference? _download;
    private static readonly BreadcrumbItem[] Breadcrumbs=[new("Rynzo",null),new("eCommerce",null),new("Orders",null,true)];
    private static readonly (string Label,string Value,string Detail,string Icon)[] Metrics=[("Orders today","12","3 awaiting fulfillment","ShoppingBag"),("Revenue today","$1,442","Paid and captured","CreditCard"),("To fulfill","2","Orders need shipping","PackageCheck"),("Returns & refunds","1","Needs review","RotateCcw")];
    protected override void OnInitialized()=>Refresh();
    private void Refresh()=>_shown=_state.Shown;
    private void Search(string value){_state.Query=value;Refresh();}
    private void Reset(){_state.Reset();Refresh();}
    private void Close(){if(!_actionOpen)_state.Active=null;}
    private void Process(){_state.ProcessSelected();Refresh();Snackbar.Add("Selected orders moved to processing",Severity.Success);}
    private void ClearSelection(){_state.Selected.Clear();Snackbar.Add("Selection cleared",Severity.Success);}
    private async Task Export(){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await _download.InvokeVoidAsync("csv","orders-export.csv",_state.Export());Snackbar.Add("Orders export downloaded",Severity.Success);}
    private async Task Action(string action){if(_state.Active is null)return;var id=_state.Active.Id;_actionOpen=true;var dialog=await Dialogs.ShowAsync<OrderActionDialog>("",new DialogParameters<OrderActionDialog>{{d=>d.Order,_state.Active},{d=>d.Action,action},{d=>d.Options,(action=="payment"?_state.Source.PaymentTone.Keys:_state.Source.OrderTone.Keys).ToArray()}},new DialogOptions{CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small});var result=await dialog.Result;if(result is {Canceled:false,Data:string next}){_state.Apply(action,next);Refresh();Snackbar.Add(action=="status"?$"Order {id} status updated":action=="payment"?$"Payment status updated for {id}":action=="refund"?$"Refund initiated for {id}":$"Order {id} cancelled",Severity.Success);}_actionOpen=false;}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}
}
