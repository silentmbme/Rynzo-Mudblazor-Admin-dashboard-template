@page "/ecommerce/customers"
@implements IAsyncDisposable
@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Features.Ecommerce.Services
@using Rynzo.Client.Features.Ecommerce.Components
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Customers | Rynzo</PageTitle>
<div class="customers-page">
<PageHeader Title="Customers" Description="Know your customers. Build stronger relationships."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="@(() => Export(false))">Export customers</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("UserPlus")" OnClick="Add">Add customer</MudButton></Actions></PageHeader>
<MudCard Class="customers-summary rynzo-widget-card" Elevation="0" Outlined="true">@foreach(var item in Summary){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="customer-summary-icon"><MudIcon Icon="@RynzoIcons.Get(item.Icon)" /></span><p>@item.Label</p><b>@item.Value</b></MudCard>}</MudCard>
<MudCard Class="customers-workspace rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header class="customers-library-heading"><div><span class="customers-eyebrow">CUSTOMER RELATIONSHIPS</span><h2>Customer directory <span>@_state.Customers.Count profiles</span></h2><p>Explore purchase activity, customer value, and engagement.</p></div><span class="customers-session"><i></i>Session workspace</span></header>
<nav class="customers-segment-tabs" aria-label="Customer segments">@foreach(var segment in _state.Source.Filters[0]){<button type="button" class="@(_state.Filters[0]==segment?"is-active":"")" aria-pressed="@(_state.Filters[0]==segment)" @onclick="@(() => {_state.Filters[0]=segment;Refresh();})">@segment<span>@_state.Customers.Count(c=>segment=="All Customers"||c.Segment==segment)</span></button>}</nav><div class="customers-filters"><MudTextField T="string" Value="_state.Query" ValueChanged="Search" Immediate="true" Placeholder="Search customer, email, phone, tag or location" aria-label="Search customers" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><div>@for(var index=0;index<_state.Source.Filters.Length;index++){var filter=index;<select aria-label="@FilterLabels[filter]" @bind="_state.Filters[filter]" @bind:after="Refresh">@foreach(var option in _state.Source.Filters[filter]){<option>@option</option>}</select>}<MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Reset">Reset filters</MudButton></div></div>@if(_state.Selected.Count>0){<div class="customers-bulk"><b>@_state.Selected.Count selected</b><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Modal("bulkSegment"))">Change segment</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Modal("bulkStatus"))">Change status</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Bulk(false))">Mark VIP</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Bulk(true))">Archive</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Export(true))">Export selected</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="@(() => Modal("bulkDelete"))">Delete</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _state.Selected.Clear())">Clear</MudButton></div>}<MudTable T="StoreCustomer" Items="_visible" Breakpoint="Breakpoint.None" Hover="true" Elevation="0" Class="customers-table"><HeaderContent><MudTh><MudCheckBox T="bool" Value="_state.AllSelected" ValueChanged="@((bool _) => _state.SelectAll())" aria-label="Select all visible customers" Size="Size.Small" /></MudTh>@foreach(var heading in new[]{"Customer","Location","Orders","Total spent","Avg. order","Last order","Segment","Status",""}){<MudTh>@heading</MudTh>}</HeaderContent><RowTemplate Context="customer"><MudTd><MudCheckBox T="bool" Value="@_state.Selected.Contains(customer.Id)" ValueChanged="@((bool _) => _state.Toggle(customer.Id))" aria-label="@($"Select {customer.Name}")" Size="Size.Small" /></MudTd><MudTd><button class="customer-name" data-customer="@customer.Id" @onclick="@(() => _state.Active=customer)"><img src="@OrdersState.Portrait(customer.Name)" alt="@customer.Name" /><span><b>@customer.Name</b><small>@customer.Email@(customer.Company.Length>0?"  "+customer.Company:"")</small></span></button></MudTd><MudTd><p>@customer.City</p><small>@customer.Country</small></MudTd><MudTd><b>@customer.Orders</b></MudTd><MudTd><b>@customer.Total</b></MudTd><MudTd>@customer.Average</MudTd><MudTd><p>@customer.LastOrder</p>@if(customer.LastOrderDays is not null){<small>@customer.LastOrderDays days ago</small>}</MudTd><MudTd><OrderBadge Text="@customer.Segment" Tone="@_state.Source.SegmentTone[customer.Segment]" /></MudTd><MudTd><OrderBadge Text="@customer.Status" Tone="@_state.Source.StatusTone[customer.Status]" /></MudTd><MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => _state.Active=customer)" StartIcon="@RynzoIcons.Get("ArrowUpRight")">Profile</MudButton></MudTd></RowTemplate></MudTable>@if(_visible.Length==0){<div class="customers-empty"><MudIcon Icon="@RynzoIcons.Get("UsersRound")" /><b>No matching customers</b><p>Try adjusting your filters or search terms.</p><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Reset">Clear filters</MudButton></div>}<footer><span>Showing 1-@_visible.Length of 18,429 customers</span><div><select aria-label="Page size" @bind="_state.PageSize" @bind:after="Refresh">@foreach(var size in PageSizes){<option value="@size">@size</option>}</select><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="true">Previous</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="true">Next</MudButton></div></footer></MudCard></div>
<MudOverlay Visible="DetailsOpen" DarkBackground="true" LockScroll="true" ZIndex="1399" OnClick="Close" /><MudDrawer Open="DetailsOpen" OpenChanged="@((bool open) => {if(!open&&!_modal)_state.Active=null;})" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Overlay="false" Width="576px" Elevation="0" Style="z-index:1400;max-width:100%;background:var(--card);overflow-y:auto" Class="customer-profile-drawer"><MudFocusTrap Disabled="@(!DetailsOpen)">@if(_state.Active is { } customer){<CustomerProfilePanel Customer="customer" Source="_state.Source" Close="Close" Action="ProfileAction" />}</MudFocusTrap></MudDrawer>
@code{
    private static readonly List<int> PageSizes = new() { 20, 50, 100 };
    private readonly CustomersState _state=new();
    private StoreCustomer[] _visible=[];
    private bool _modal;
    private bool DetailsOpen=>_state.Active is not null&&!_modal;
    private IJSObjectReference? _download;
    private static readonly BreadcrumbItem[] Breadcrumbs=[new("Rynzo",null),new("eCommerce",null),new("Customers",null,true)];
    private static readonly string[] FilterLabels=["Customer segment filter","Customer status filter","Customer region filter","Customer spend filter","Customer orders filter","Customer last order filter","Customer sorting"];
    private static readonly (string Label,string Value,string Icon)[] Summary=[("Total Customers","18,429","Users"),("Active","15,862","UserCheck"),("New This Month","1,284","UserPlus"),("VIP","426","Star"),("At Risk","318","CircleAlert"),("Avg. Customer Value","$624","Wallet")];
    protected override void OnInitialized()=>Refresh();
    private void Refresh()=>_visible=_state.Visible;
    private void Search(string value){_state.Query=value;Refresh();}
    private void Reset(){_state.Reset();Refresh();}
    private void Close(){if(!_modal)_state.Active=null;}
    private Task Add(){_state.BeginAdd();return Modal("add");}
    private void Bulk(bool archive){_state.Bulk(c=>archive?c with{Status="Archived"}:c with{Segment="VIP"});Refresh();Snackbar.Add(archive?"Selected customers archived":"Selected customers marked as VIP",Severity.Success);}
    private Task ProfileAction(string mode){if(_state.Active is null)return Task.CompletedTask;if(mode=="vip"){_state.Update(_state.Active.Id,c=>c with{Segment="VIP"});Refresh();Snackbar.Add("Customer marked as VIP",Severity.Success);return Task.CompletedTask;}if(mode=="edit")_state.BeginEdit(_state.Active);return Modal(mode);}
    private async Task Export(bool selected){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await _download.InvokeVoidAsync("csv","customers-export.csv",_state.Export(selected));Snackbar.Add("Customer export downloaded",Severity.Success);}
    private async Task Modal(string mode){if(mode=="bulkSegment")_state.BulkValue="VIP";if(mode=="bulkStatus")_state.BulkValue="Active";var blocked=_state.Active?.Status=="Blocked";_modal=true;var dialog=await Dialogs.ShowAsync<CustomerDialog>("",new DialogParameters<CustomerDialog>{{d=>d.State,_state},{d=>d.Mode,mode}},new DialogOptions{CloseButton=true,CloseOnEscapeKey=true,FullWidth=true,MaxWidth=MaxWidth.Small});var result=await dialog.Result;if(result is {Canceled:false}){Refresh();var message=mode switch{"add"=>"Customer created","edit"=>"Customer updated","note"=>"Note added","block"=>blocked?"Customer unblocked":"Customer blocked","archive"=>"Customer archived","delete"=>"Customer deleted from demo data","bulkSegment"=>"Segment updated for selected customers","bulkStatus"=>"Status updated for selected customers",_=>"Selected customers deleted from demo data"};if(result.Data is not false)Snackbar.Add(message,Severity.Success);}_modal=false;}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}
}
