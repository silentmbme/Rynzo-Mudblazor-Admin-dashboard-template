@page "/ecommerce/add-product"
@page "/ecommerce/products/add"
@using Rynzo.Client.Features.Ecommerce.Models
@using Rynzo.Client.Features.Ecommerce.Components
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Create a new product | Rynzo</PageTitle>
<main class="create-product"><PageHeader Title="Create a new product" Description="Build a complete catalog entry, prepare inventory, and publish when ready." Breadcrumbs="Breadcrumbs"><Actions><MudIconButton Icon="@RynzoIcons.Get("ArrowLeft")" Variant="Variant.Outlined" aria-label="Back to products" OnClick="Back" /><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Save")" OnClick="@(() => Save("Draft"))">Save draft</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Send")" OnClick="@(() => Save("Active"))">Publish product</MudButton></Actions></PageHeader><div class="create-product-stages">@foreach(var stage in new[]{("PackageCheck","Catalog setup","Product details and media",true),("Warehouse","Inventory ready","Stock and fulfillment",_draft.TrackInventory),("Store","Sales channel",_draft.Status=="Active"?"Live on storefront":"Draft not published",_draft.Status=="Active")}){<div><span class="@(stage.Item4?"active":"")"><MudIcon Icon="@RynzoIcons.Get(stage.Item1)" /></span><div><b>@(stage.Item1=="PackageCheck"?"1":stage.Item1=="Warehouse"?"2":"3"). @stage.Item2</b><p>@stage.Item3</p></div></div>}</div><form @onsubmit="@(() => Save("Active"))" @onsubmit:preventDefault="true"><div><section><header><div><h2>Product information</h2><p>Start with the details customers will see first.</p></div><MudChip T="string" Color="Color.Primary" Size="Size.Small">Required</MudChip></header><ProductInformationForm Draft="_draft" /></section><section><header><div><h2>Media gallery</h2><p>Use high-quality images to make the product stand out.</p></div></header><ProductMediaGallery Draft="_draft" /></section><section><ProductPricingEditor Draft="_draft" Changed="Refresh" /></section><section><header><div><h2>Inventory &amp; shipping</h2><p>Keep stock and fulfillment details accurate.</p></div><MudButton Variant="Variant.Text" Color="@(_draft.TrackInventory?Color.Success:Color.Default)" OnClick="@(() => _draft.TrackInventory=!_draft.TrackInventory)">@(_draft.TrackInventory?"Inventory tracking on":"Inventory tracking off")</MudButton></header><MudGrid Spacing="2"><MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_draft.Stock" InputType="InputType.Number" Disabled="@(!_draft.TrackInventory)" Label="Available stock" aria-label="Available stock" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_draft.Reorder" InputType="InputType.Number" Disabled="@(!_draft.TrackInventory)" Label="Reorder level" aria-label="Reorder level" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_draft.Weight" Label="Weight" aria-label="Weight" Adornment="Adornment.End" AdornmentText="kg" Variant="Variant.Outlined" /></MudItem></MudGrid></section></div><aside><section><header><h2>Publishing</h2><MudChip T="string" Size="Size.Small" Color="@(_draft.Status=="Active"?Color.Success:Color.Default)" Class="product-publish-status">@_draft.Status</MudChip></header><MudRadioGroup T="string" @bind-Value="_draft.Status"><div class="product-status-choice"><MudRadio T="string" Value="@("Draft")" Color="Color.Primary">Save as draft</MudRadio><small>Keep it private while you prepare.</small></div><div class="product-status-choice"><MudRadio T="string" Value="@("Active")" Color="Color.Success">Active</MudRadio><small>Available on the storefront.</small></div></MudRadioGroup></section><section><h2>Product organization</h2><MudTextField T="string" @bind-Value="_draft.Collections" Label="Collections" Placeholder="e.g. New arrivals" Variant="Variant.Outlined" Class="mt-4" /><MudTextField T="string" @bind-Value="_draft.Tags" Label="Tags" Variant="Variant.Outlined" Class="mt-4" /><MudSelect T="string" @bind-Value="_draft.Channel" Label="Sales channel" Variant="Variant.Outlined" Class="mt-4">@foreach(var channel in new[]{"Online store","POS","Wholesale"}){<MudSelectItem Value="@channel">@channel</MudSelectItem>}</MudSelect></section><section class="product-publish-callout"><h2><MudIcon Icon="@RynzoIcons.Get("Sparkles")" Color="Color.Primary" Size="Size.Small" />Ready to publish?</h2><p>Add a name, cover image, price, and inventory to complete your listing.</p><MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4" StartIcon="@RynzoIcons.Get("Send")" ButtonType="ButtonType.Submit" OnClick="@(() => Save("Active"))">Publish product</MudButton></section></aside></form></main>
@code{private readonly ProductDraft _draft=new();private static readonly BreadcrumbItem[] Breadcrumbs=[new("eCommerce",null),new("Products",null),new("Add product",null,true)];private Task Back()=>JS.InvokeVoidAsync("history.back").AsTask();private void Refresh()=>StateHasChanged();private void Save(string status){if(!_draft.Save(status)){Snackbar.Add("Add a product name before saving",Severity.Error);return;}Snackbar.Add(status=="Active"?"Product published":"Draft saved",Severity.Success);}}

