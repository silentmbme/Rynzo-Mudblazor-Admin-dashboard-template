@using System.Globalization
@using Rynzo.Client.Features.Finance.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Transactions | Rynzo</PageTitle>
<div class="transactions-page">
<PageHeader Title="Transactions" Description="Track every inflow and outflow with a clear view of your cash movement."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export transactions</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenAdd">Add transaction</MudButton></Actions></PageHeader>
<div class="tx-metrics"><MudCard Class="tx-net rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="tx-eyebrow">NET COMPLETED CASH FLOW</span><b>@Money(ThirdMetric)</b><p><MudIcon Icon="@RynzoIcons.Get("Wallet")" />Current filtered records / USD</p></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="tx-metric-icon income"><MudIcon Icon="@RynzoIcons.Get("ArrowDownLeft")" /></span><small>Completed income</small><b>@Money(Visible.Where(x=>x.Category=="Income"&&x.Status=="Completed").Sum(x=>x.Amount))</b><p>@Visible.Count(x=>x.Category=="Income"&&x.Status=="Completed") completed records</p></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="tx-metric-icon expense"><MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></span><small>Completed expenses</small><b>@Money(Visible.Where(x=>x.Category=="Expense"&&x.Status=="Completed").Sum(x=>x.Amount))</b><p>@Visible.Count(x=>x.Category=="Expense"&&x.Status=="Completed") completed records</p></MudCard><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="tx-metric-icon pending"><MudIcon Icon="@RynzoIcons.Get("Clock3")" /></span><small>Pending value</small><b>@Money(Visible.Where(x=>x.Status=="Pending").Sum(x=>x.Amount))</b><p>@Visible.Count(x=>x.Status=="Pending") awaiting completion</p></MudCard></div>
<div class="tx-analysis"><section class="tx-chart"><header><div><span class="tx-eyebrow">CASH MOVEMENT</span><h2>Cash flow activity</h2><p>Completed income and expenses by record date / USD</p></div><span class="tx-chip">@Visible.Count() records</span></header><DashboardChart Data="ChartData" OptionsModule="./transactions-options.js" Kind="cash" Height="245" Label="Cash flow activity by date" /></section><aside class="tx-breakdown"><span class="tx-eyebrow">TRANSACTION BREAKDOWN</span><h2>Money in perspective.</h2><dl><div><dt>Completed income</dt><dd class="tx-positive">@Money(Visible.Where(x=>x.Category=="Income"&&x.Status=="Completed").Sum(x=>x.Amount))</dd></div><div><dt>Completed expense</dt><dd>@Money(Visible.Where(x=>x.Category=="Expense"&&x.Status=="Completed").Sum(x=>x.Amount))</dd></div><div><dt>Pending transactions</dt><dd>@Visible.Count(x=>x.Status=="Pending") / @Money(Visible.Where(x=>x.Status=="Pending").Sum(x=>x.Amount))</dd></div><div><dt>Total value</dt><dd>@Money(Total)</dd></div></dl><p><MudIcon Icon="@RynzoIcons.Get("Info")" />Sample records. Status updates change this session only and do not process payments.</p></aside></div>
<MudCard Class="tx-ledger rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="tx-eyebrow">TRANSACTION LEDGER</span><h2>All transactions <span>@Visible.Count()</span></h2><p>Your financial activity, organized and easy to review.</p></div><span class="tx-currency">USD</span></header><nav class="tx-tabs" aria-label="Transaction status"><button class="@(_filter=="All"?"is-active":"")" @onclick="@(()=>_filter="All")">All transactions <span>@_records.Count</span></button>@foreach(var status in Statuses){<button class="@(_filter==status?"is-active":"")" @onclick="@(()=>_filter=status)">@status <span>@_records.Count(x=>x.Status==status)</span></button>}</nav><div class="tx-filters"><MudTextField T="string" @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search transaction, name, or category..." aria-label="Search transactions" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Transaction status" @bind="_filter"><option value="All">All statuses</option>@foreach(var status in Statuses){<option>@status</option>}</select><select aria-label="Transaction direction" @bind="_direction"><option value="All">All directions</option><option>Income</option><option>Expense</option></select><select aria-label="Transaction sorting" @bind="_sort"><option value="newest">Newest first</option><option value="largest">Largest amount</option></select><MudButton Variant="Variant.Text" OnClick="@(()=>{_query="";_filter="All";_direction="All";_sort="newest";})">Reset filters</MudButton></div>
<div class="tx-table-scroll" tabindex="0" aria-label="Transactions"><table><thead><tr><th>Transaction</th><th>Reference</th><th>Category</th><th>Date</th><th>Status</th><th>Amount</th><th></th></tr></thead><tbody>@foreach(var record in Visible){<tr><td><button class="tx-record-open" @onclick="@(()=>_selected=record)"><span class="tx-record-icon @(record.Category=="Income"?"income":"expense")"><MudIcon Icon="@RynzoIcons.Get(record.Category=="Income"?"ArrowDownLeft":"ArrowUpRight")" /></span><span><b>@record.Name</b><small>@(record.Category=="Income"?"Incoming transaction":"Outgoing transaction")</small></span></button></td><td><span class="tx-reference">@record.Id</span></td><td>@record.Category</td><td>@record.Date.ToString("MMM dd, yyyy",CultureInfo.GetCultureInfo("en-US"))</td><td><span class="tx-status @(record.Status=="Completed"?"complete":"")"><i></i>@record.Status</span></td><td><b class="tx-amount @(record.Category=="Income"?"tx-positive":"")">@(record.Category=="Income"?"+":"-")@Money(record.Amount)</b><small class="tx-usd">USD</small></td><td><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"Details for {record.Id}")" OnClick="@(()=>_selected=record)" /></td></tr>}</tbody></table></div>@if(!Visible.Any()){<div class="tx-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><b>No matching transactions</b><p>Try adjusting your search or filters.</p></div>}<footer><span>Showing @Visible.Count() of @_records.Count sample records</span><span>Total value <b>@Money(Total)</b></span></footer></MudCard>
</div>
@if(_addOpen){<MudDialog @bind-Visible="_addOpen"><TitleContent><div class="tx-dialog-header"><h2 class="tx-dialog-title">Add transaction</h2><MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Close dialog" ButtonType="ButtonType.Button" @onclick="@(()=>_addOpen=false)" /></div></TitleContent><DialogContent><p class="tx-dialog-note">Create a pending record in this sample session.</p><div class="tx-form"><label><span>Name</span><input aria-label="Transaction name" @bind="_name" placeholder="e.g. Customer payment" /></label><label><span>Category</span><input aria-label="Transaction category" @bind="_category" list="tx-categories" /><datalist id="tx-categories"><option>Income</option><option>Expense</option></datalist></label><label><span>Amount (USD)</span><input type="number" min="0.01" step="0.01" aria-label="Transaction amount" @bind="_amount" /></label><label><span>Date</span><MudDatePicker @bind-Date="_date" Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="Transaction date" /></label></div></DialogContent><DialogActions><MudButton OnClick="@(()=>_addOpen=false)">Cancel</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Add">Add transaction</MudButton></DialogActions></MudDialog>}
@if(_selected is {} selected){<MudDialog @bind-Visible="SelectedVisible"><TitleContent><div class="tx-dialog-header"><h2 class="tx-dialog-title">Transaction details</h2><MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Close dialog" ButtonType="ButtonType.Button" OnClick="@(()=>SelectedVisible=false)" /></div></TitleContent><DialogContent><div class="tx-detail-heading"><span class="tx-record-icon @(selected.Category=="Income"?"income":"expense")"><MudIcon Icon="@RynzoIcons.Get(selected.Category=="Income"?"ArrowDownLeft":"ArrowUpRight")" /></span><h3>@selected.Name</h3><b>@Money(selected.Amount)</b><small>@selected.Id / Sample financial record</small></div><dl class="tx-detail-fields"><div><dt>Category</dt><dd>@selected.Category</dd></div><div><dt>Status</dt><dd>@selected.Status</dd></div><div><dt>Date</dt><dd>@selected.Date.ToString("yyyy-MM-dd")</dd></div></dl><p class="tx-dialog-note">Status changes affect this sample record only.</p></DialogContent><DialogActions><MudButton OnClick="CloseDetail">Close</MudButton>@if(selected.Status is "Pending" or "Unpaid"){<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Update">Mark completed</MudButton>}</DialogActions></MudDialog>}
@code {
    private const string Kind = "transactions";
    private List<FinanceRecord> _records = [];
    private string _query = "", _filter = "All", _direction = "All", _invoiceView = "All invoices", _expenseCategory = "All", _sort = "newest", _name = "", _category = "General";
    private decimal _amount; private DateTime? _date = new(2026,10,9); private bool _addOpen; private FinanceRecord? _selected; private bool SelectedVisible { get => _selected is not null; set { if (!value) _selected = null; } }
    protected override void OnParametersSet() { _records = (Kind switch { "invoices" => FinanceSource.Invoices, "expenses" => FinanceSource.Expenses, "budgets" => FinanceSource.Budgets, _ => FinanceSource.Transactions }).ToList(); _category = Kind == "transactions" ? "Income" : "General"; }
    private string Title => Kind switch { "invoices" => "Finance Invoices", "expenses" => "Expenses", "budgets" => "Budgets", _ => "Transactions" };
    private string Singular => Kind switch { "invoices" => "invoice", "expenses" => "expense", "budgets" => "budget", _ => "transaction" };
    private BreadcrumbItem[] Breadcrumbs => [new("Management", null), new("Finance", null), new(Title, null, true)];
    private IEnumerable<string> Statuses => _records.Select(x => x.Status).Distinct().Order(); private IEnumerable<string> Categories => _records.Select(x => x.Category).Distinct().Order();
    private IEnumerable<FinanceRecord> Visible => _records.Where(x => (_filter == "All" || x.Status == _filter) && (Kind != "transactions" || _direction == "All" || x.Category == _direction) && (Kind != "invoices" || _invoiceView != "Overdue" || (x.Status == "Unpaid" && x.Date < new DateOnly(2026,10,9))) && (Kind != "expenses" || _expenseCategory == "All" || x.Category == _expenseCategory) && $"{x.Id} {x.Name} {x.Category}".Contains(_query, StringComparison.OrdinalIgnoreCase)).OrderByDescending(x => _sort == "largest" ? x.Amount : x.Date.DayNumber);
    private decimal Total => Visible.Sum(x => x.Amount); private decimal ThirdMetric => Kind == "budgets" ? Visible.Sum(x => x.Amount - x.Used) : Kind == "transactions" ? Visible.Where(x => x.Status == "Completed").Sum(x => x.Category == "Income" ? x.Amount : -x.Amount) : Visible.Where(x => x.Status is "Pending" or "Unpaid").Sum(x => x.Amount); private string ThirdMetricLabel => Kind == "budgets" ? "Available budget" : Kind == "transactions" ? "Net completed cash flow" : "Awaiting action";
    private object ChartData => new { dates = Visible.OrderBy(x=>x.Date).Select(x=>x.Date.ToString("MMM dd",CultureInfo.GetCultureInfo("en-US"))).ToArray(), series = new[] { new { name = "Income", data = Visible.OrderBy(x=>x.Date).Select(x => x.Category == "Income" && x.Status == "Completed" ? (double)x.Amount : 0).ToArray() }, new { name = "Expense", data = Visible.OrderBy(x=>x.Date).Select(x => x.Category == "Expense" && x.Status == "Completed" ? (double)x.Amount : 0).ToArray() } } };
    private static string Money(decimal value) => value.ToString("C0", CultureInfo.GetCultureInfo("en-US")); private static Color Tone(string status) => status is "Completed" or "Paid" or "Approved" or "Active" ? Color.Success : status is "Rejected" ? Color.Error : Color.Warning;
    private void OpenAdd(){_name="";_amount=0;_date=new DateTime(2026,10,9);_addOpen=true;} private void CloseDetail()=>_selected=null;
    private void Add(){if(string.IsNullOrWhiteSpace(_name)||_amount<=0){Snackbar.Add("Enter a name and positive amount.",Severity.Error);return;}var prefix=Kind=="transactions"?"TX":Kind=="invoices"?"INV":Kind=="expenses"?"EXP":"BDG";var status=Kind=="invoices"?"Unpaid":Kind=="budgets"?"Active":"Pending";_records.Insert(0,new FinanceRecord($"{prefix}-{1001+_records.Count}",_name.Trim(),string.IsNullOrWhiteSpace(_category)?"General":_category,_amount,0,status,DateOnly.FromDateTime(_date??DateTime.Today)));_addOpen=false;Snackbar.Add("Sample record created.",Severity.Success);}
    private void Update(){if(_selected is null)return;var status=Kind=="invoices"?"Paid":Kind=="expenses"?"Approved":"Completed";var index=_records.FindIndex(x=>x.Id==_selected.Id);_records[index]=_selected with { Status=status };_selected=null;Snackbar.Add("Sample status updated.",Severity.Success);}
    private IJSObjectReference? _download;
    private async Task Export(){var rows=new List<string>{"ID,Name,Category,Amount USD,Spent USD,Status,Date"};rows.AddRange(Visible.Select(x=>string.Join(',',x.Id,$"\"{x.Name.Replace("\"","\"\"")}\"",x.Category,x.Amount,x.Used,x.Status,x.Date.ToString("yyyy-MM-dd"))));_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await _download.InvokeVoidAsync("download",$"finance-{Kind}.csv",string.Join("\r\n",rows),"text/csv;charset=utf-8");Snackbar.Add($"{Title} CSV exported for this source-local session.",Severity.Success);}
    public async ValueTask DisposeAsync(){if(_download is not null){try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
