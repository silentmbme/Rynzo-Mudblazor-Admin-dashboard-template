@using System.Globalization
@using Rynzo.Client.Features.Finance.Models
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Expenses | Rynzo</PageTitle>
<div class="expenses-page">
<PageHeader Title="Expenses" Description="Keep spending visible and expense reviews moving."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export expenses</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenAdd">Add expense</MudButton></Actions></PageHeader>
<div class="exp-metrics"><MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="exp-eyebrow">EXPENSE OVERVIEW / USD</span><b>@Money(Total)</b><p>@Visible.Count() records in view</p></MudCard>@foreach(var status in StatusOptions){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><span class="exp-metric-icon @status.ToLowerInvariant()"><MudIcon Icon="@RynzoIcons.Get(status=="Approved"?"CircleCheck":status=="Rejected"?"X":"Clock3")" /></span><small>@status expenses</small><b>@Money(Visible.Where(x=>x.Status==status).Sum(x=>x.Amount))</b><p>@Visible.Count(x=>x.Status==status) records</p></MudCard>}</div>
<div class="exp-workbench"><aside class="exp-category-panel"><header><span class="exp-eyebrow">SPEND DISTRIBUTION</span><h2>Expense categories</h2><p>Current filtered sample records</p></header>@foreach(var group in Visible.GroupBy(x=>x.Category).OrderByDescending(g=>g.Sum(x=>x.Amount))){var amount=group.Sum(x=>x.Amount);<div class="exp-category-row"><div><span>@group.Key</span><b>@Money(amount)</b></div><i><em style="@($"width:{(Total==0?0:amount/Total*100).ToString(CultureInfo.InvariantCulture)}%")"></em></i><small>@group.Count() records / @(Total==0?0:Math.Round(amount/Total*100))% of value</small></div>}@if(!Visible.Any()){<p class="exp-category-empty">No spending matches your filters.</p>}<div class="exp-review-note"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" /><p>Review with context.<small>Approving an expense updates the sample record only. Changes stay in this page session.</small></p></div></aside>
<MudCard Class="exp-library rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="exp-eyebrow">EXPENSE REGISTER</span><h2>All expenses <span>@Visible.Count()</span></h2><p>Review the details behind every expense.</p></div><span class="exp-session">USD</span></header><nav class="exp-tabs" aria-label="Expense statuses"><button class="@(_status=="All"?"is-active":"")" @onclick="@(()=>_status="All")">All expenses <span>@_records.Count</span></button>@foreach(var status in StatusOptions){<button class="@(_status==status?"is-active":"")" @onclick="@(()=>_status=status)">@status <span>@_records.Count(x=>x.Status==status)</span></button>}</nav><div class="exp-filters"><MudTextField T="string" @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search expenses or references..." aria-label="Search expenses" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Expense status" @bind="_status"><option value="All">All statuses</option>@foreach(var status in StatusOptions){<option>@status</option>}</select><select aria-label="Expense category" @bind="_categoryFilter"><option value="All">All categories</option>@foreach(var category in _records.Select(x=>x.Category).Distinct().Order()){<option>@category</option>}</select><select aria-label="Expense sorting" @bind="_sort"><option value="newest">Newest first</option><option value="largest">Largest amount</option></select><MudButton Variant="Variant.Text" OnClick="Reset">Reset filters</MudButton></div>
<div class="exp-table-scroll" tabindex="0" aria-label="Expenses"><table><thead><tr><th>Expense</th><th>Category</th><th>Amount</th><th>Status</th><th>Date</th><th></th></tr></thead><tbody>@foreach(var expense in Visible){<tr><td><button class="exp-open" @onclick="@(()=>_selected=expense)"><span class="exp-file"><MudIcon Icon="@RynzoIcons.Get(CategoryIcon(expense.Category))" /></span><span><b>@expense.Name</b><small>@expense.Id</small></span></button></td><td><span class="exp-category-tag">@expense.Category</span></td><td><b class="exp-amount">@Money(expense.Amount)</b><small class="exp-usd">USD</small></td><td><span class="exp-status @expense.Status.ToLowerInvariant()"><i></i>@expense.Status</span></td><td>@expense.Date.ToString("MMM dd, yyyy",CultureInfo.GetCultureInfo("en-US"))</td><td><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"View {expense.Id}")" OnClick="@(()=>_selected=expense)" /></td></tr>}</tbody></table></div>@if(!Visible.Any()){<div class="exp-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No matching expenses</h3><p>Try another search or reset your filters.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}<footer><span>Showing @Visible.Count() of @_records.Count sample expenses</span><span>Total value <b>@Money(Total)</b></span></footer></MudCard></div>
</div>@if(_adding){<MudDialog @bind-Visible="_adding"><TitleContent><h2 class="exp-dialog-title">Add expense</h2></TitleContent><DialogContent><p class="exp-dialog-note">Create an pending expense in this sample workspace.</p><div class="exp-form"><label><span>Expense name</span><input aria-label="Expense name" @bind="_name" placeholder="e.g. Team travel" /></label><label><span>Category</span><input aria-label="Expense category" @bind="_category" /></label><label><span>Amount (USD)</span><input type="number" min="0.01" step="0.01" aria-label="Expense amount" @bind="_amount" /></label><label><span>Expense date</span><MudDatePicker @bind-Date="_date" Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="Expense date" /></label></div></DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>_adding=false)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add">Add expense</MudButton></DialogActions></MudDialog>}
@if(_selected is {} selectedExpense){<MudDialog @bind-Visible="DetailVisible"><TitleContent><div class="exp-dialog-heading"><span><MudIcon Icon="@RynzoIcons.Get("FileText")" /></span><div><small>SAMPLE INVOICE</small><h2>@selectedExpense.Id</h2></div></div></TitleContent><DialogContent><div class="exp-detail-total"><small>Expense amount</small><b>@Money(selectedExpense.Amount)</b><span>@selectedExpense.Status</span></div><dl class="exp-detail-fields"><div><dt>Client</dt><dd>@selectedExpense.Name</dd></div><div><dt>Category</dt><dd>@selectedExpense.Category</dd></div><div><dt>Expense date</dt><dd>@selectedExpense.Date.ToString("yyyy-MM-dd")</dd></div><div><dt>Status</dt><dd>@selectedExpense.Status</dd></div></dl><p class="exp-dialog-note">Sample financial record. Status updates do not process payments.</p></DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>_selected=null)">Close</MudButton>@if(selectedExpense.Status=="Pending"){<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Approve">Approve expense</MudButton>}</DialogActions></MudDialog>}
@code{
    private readonly List<FinanceRecord> _records=FinanceSource.Expenses.ToList();
    private static readonly string[] StatusOptions=["Pending","Approved","Rejected"];
    private string _query="",_status="All",_categoryFilter="All",_sort="newest",_name="",_category="General";
    private decimal _amount;
    private DateTime? _date=new(2026,10,9);
    private bool _adding;
    private FinanceRecord? _selected;
    private IJSObjectReference? _download;
    private bool DetailVisible{get=>_selected is not null;set{if(!value)_selected=null;}}
    private IEnumerable<FinanceRecord> Visible=>_records.Where(x=>(_status=="All"||x.Status==_status)&&(_categoryFilter=="All"||x.Category==_categoryFilter)&&$"{x.Id} {x.Name} {x.Category}".Contains(_query,StringComparison.OrdinalIgnoreCase)).OrderByDescending(x=>_sort=="largest"?x.Amount:x.Date.DayNumber);
    private decimal Total=>Visible.Sum(x=>x.Amount);
    private static string Money(decimal value)=>value.ToString("C0",CultureInfo.GetCultureInfo("en-US"));
    private static string CategoryIcon(string category)=>category switch{"Travel"=>"ArrowUpRight","Software"=>"Monitor","Meals"=>"ShoppingBag","Training"=>"GraduationCap",_=>"BriefcaseBusiness"};
    private void Reset(){_query="";_status="All";_categoryFilter="All";_sort="newest";}
    private void OpenAdd(){_name="";_category="General";_amount=0;_date=new DateTime(2026,10,9);_adding=true;}
    private void Add(){if(string.IsNullOrWhiteSpace(_name)||_amount<=0){Snackbar.Add("Enter a name and positive amount.",Severity.Error);return;}_records.Insert(0,new($"EXP-{1001+_records.Count}",_name.Trim(),string.IsNullOrWhiteSpace(_category)?"General":_category,_amount,0,"Pending",DateOnly.FromDateTime(_date??DateTime.Today)));_adding=false;Snackbar.Add("Sample expense created.",Severity.Success);}
    private void Approve(){if(_selected is null)return;var index=_records.FindIndex(x=>x.Id==_selected.Id);if(index>=0)_records[index]=_selected with{Status="Approved"};_selected=null;Snackbar.Add("Sample expense approved.",Severity.Success);}
    private async Task Export(){static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new List<string>{"ID,Name,Category,Amount USD,Spent USD,Status,Date"};rows.AddRange(Visible.Select(x=>string.Join(",",new[]{x.Id,x.Name,x.Category,x.Amount.ToString(CultureInfo.InvariantCulture),x.Used.ToString(CultureInfo.InvariantCulture),x.Status,x.Date.ToString("yyyy-MM-dd")}.Select(Cell))));_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await _download.InvokeVoidAsync("download","finance-expenses.csv",string.Join("\r\n",rows),"text/csv;charset=utf-8");Snackbar.Add("Expense CSV exported.",Severity.Success);}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}
}