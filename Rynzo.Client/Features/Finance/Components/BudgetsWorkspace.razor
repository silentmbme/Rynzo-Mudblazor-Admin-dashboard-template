@using System.Globalization
@using Rynzo.Client.Features.Finance.Models
@using Rynzo.Client.Theme
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Budgets | Rynzo</PageTitle>
<div class="budgets-page">
<PageHeader Title="Budgets" Description="Plan allocations, monitor spending, and keep your budget in balance."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export budgets</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Plus")" OnClick="OpenAdd">Add budget</MudButton></Actions></PageHeader>
<MudCard Class="bdg-overview rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="bdg-overview-title"><span class="bdg-eyebrow">ALLOCATION OVERVIEW / USD</span><h2>Make room for what matters.</h2><p>Current filtered sample budgets</p></div><div class="bdg-totals"><div><small>Allocated budget</small><b>@Money(Total)</b><span>@Visible.Count() records in view</span></div><div><small>Spent to date</small><b>@Money(Used)</b><span>@Utilization% utilized</span></div><div><small>Available balance</small><b class="bdg-positive">@Money(Total-Used)</b><span>Across filtered allocations</span></div></div><div class="bdg-overall-track"><span style="@($"width:{Math.Min(Utilization,100)}%")"></span></div></MudCard>
<div class="bdg-workbench"><MudCard Class="bdg-library rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="bdg-eyebrow">BUDGET DIRECTORY</span><h2>Your allocations <span>@Visible.Count()</span></h2><p>Follow utilization and available funds by category.</p></div></header><div class="bdg-filters"><MudTextField T="string" @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search budgets or categories..." aria-label="Search budgets" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Budget status" @bind="_status"><option value="All">All statuses</option>@foreach(var status in _records.Select(x=>x.Status).Distinct()){<option>@status</option>}</select><select aria-label="Budget sorting" @bind="_sort"><option value="newest">Newest first</option><option value="largest">Largest allocation</option></select><MudButton Variant="Variant.Text" OnClick="Reset">Reset filters</MudButton></div><div class="bdg-cards">@foreach(var budget in Visible){var percent=Percent(budget);<MudCard Class="bdg-card rynzo-widget-card" Style="@($"--budget-tone:var(--{(percent>=80?"warning":"primary")})")" Elevation="0" Outlined="true" data-widget-element="article"><header><span class="bdg-category-icon"><MudIcon Icon="@RynzoIcons.Get("Wallet")" /></span><span class="bdg-card-status"><i></i>@budget.Status</span><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"View {budget.Id}")" OnClick="@(()=>_selected=budget)" /></header><button class="bdg-open" @onclick="@(()=>_selected=budget)"><small>@budget.Id / @budget.Category</small><b>@budget.Name</b></button><div class="bdg-card-allocation"><small>Allocated</small><b>@Money(budget.Amount)</b></div><div class="bdg-utilization"><span>Utilization <b>@percent%</b></span><i><em style="@($"width:{Math.Min(percent,100)}%")"></em></i></div><div class="bdg-card-balances"><div><small>Spent</small><b>@Money(budget.Used)</b></div><div><small>Available</small><b>@Money(budget.Amount-budget.Used)</b></div></div><footer><span><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />@budget.Date.ToString("MMM dd, yyyy",CultureInfo.GetCultureInfo("en-US"))</span><span>@(percent>=80?"Watch spending":"Within budget")</span></footer></MudCard>}</div>@if(!Visible.Any()){<div class="bdg-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No matching budgets</h3><p>Try another search or reset the filters.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}<footer class="bdg-results">Showing @Visible.Count() of @_records.Count sample budgets</footer></MudCard><aside class="bdg-sidebar"><MudCard Class="bdg-watch rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><span><MudIcon Icon="@RynzoIcons.Get("CircleAlert")" /></span><div><span class="bdg-eyebrow">EARLY VISIBILITY</span><h2>Budget watch</h2></div></header><p>Allocations with 80% or more spent.</p><div class="bdg-watch-list">@foreach(var budget in Visible.Where(x=>x.Amount>0&&x.Used/x.Amount>=.8m)){<button @onclick="@(()=>_selected=budget)"><span><b>@budget.Name</b><small>@Money(budget.Amount-budget.Used) remaining</small></span><strong>@Percent(budget)%</strong></button>}@if(!Visible.Any(x=>x.Amount>0&&x.Used/x.Amount>=.8m)){<div class="bdg-watch-empty">All budgets are below the watch threshold.</div>}</div></MudCard><MudCard Class="bdg-category-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header class="bu-header"><span class="bdg-eyebrow">SPENDING BY CATEGORY</span><h2>Budget utilization</h2><p>Spent, allocated, and available funds.</p></header><div class="bu-total"><span>Overall utilization</span><b>@Utilization<small>%</small></b><small>@Money(Used) spent of @Money(Total)</small></div><div class="bu-categories">@foreach(var group in Visible.GroupBy(x=>x.Category).OrderByDescending(g=>g.Sum(x=>x.Amount))){var amount=group.Sum(x=>x.Amount);var spent=group.Sum(x=>x.Used);var percent=amount==0?0:Math.Round(spent/amount*100);<article class="bu-row" style="@($"--utilization-tone:var(--{(percent>=100?"destructive":percent>=80?"warning":"primary")})")"><div class="bu-row-heading"><span><i></i>@group.Key</span><b>@percent%</b></div><div class="bu-row-amount"><b>@Money(spent)</b><span>of @Money(amount)</span></div><footer><span>@Money(amount-spent) available</span>@if(percent>=80){<b>@(percent>=100?"At limit":"Near limit")</b>}</footer></article>}@if(!Visible.Any()){<p class="bu-empty">No categories match your filters.</p>}</div></MudCard><p class="bdg-session-note"><MudIcon Icon="@RynzoIcons.Get("Info")" />Sample financial records. Changes stay in this page session.</p></aside></div></div>@if(_adding){<MudDialog @bind-Visible="_adding"><TitleContent><h2 class="bdg-dialog-title">Add budget</h2></TitleContent><DialogContent><p class="bdg-dialog-note">Create an active budget in this sample workspace.</p><div class="bdg-form"><label><span>Budget name</span><input aria-label="Budget name" @bind="_name" placeholder="e.g. Operations budget" /></label><label><span>Category</span><input aria-label="Budget category" @bind="_category" /></label><label><span>Amount (USD)</span><input type="number" min="0.01" step="0.01" aria-label="Budget amount" @bind="_amount" /></label><label><span>Budget date</span><MudDatePicker @bind-Date="_date" Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="Budget date" /></label></div></DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>_adding=false)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add">Add budget</MudButton></DialogActions></MudDialog>}
@if(_selected is {} selectedBudget){<MudDialog @bind-Visible="DetailVisible"><TitleContent><div class="bdg-dialog-heading"><span><MudIcon Icon="@RynzoIcons.Get("FileText")" /></span><div><small>SAMPLE BUDGET</small><h2>@selectedBudget.Id</h2></div></div></TitleContent><DialogContent><div class="bdg-detail-total"><small>Budget amount</small><b>@Money(selectedBudget.Amount)</b><span>@selectedBudget.Status</span></div><dl class="bdg-detail-fields"><div><dt>Budget</dt><dd>@selectedBudget.Name</dd></div><div><dt>Category</dt><dd>@selectedBudget.Category</dd></div><div><dt>Budget date</dt><dd>@selectedBudget.Date.ToString("yyyy-MM-dd")</dd></div><div><dt>Status</dt><dd>@selectedBudget.Status</dd></div><div><dt>Spent</dt><dd>@Money(selectedBudget.Used)</dd></div><div><dt>Available</dt><dd>@Money(selectedBudget.Amount-selectedBudget.Used)</dd></div></dl><p class="bdg-dialog-note">Sample financial record. Status updates do not process payments.</p></DialogContent><DialogActions><MudButton Variant="Variant.Outlined" OnClick="@(()=>_selected=null)">Close</MudButton></DialogActions></MudDialog>}
@code{
    private readonly List<FinanceRecord> _records=FinanceSource.Budgets.ToList();
    private string _query="",_status="All",_sort="newest",_name="",_category="General";
    private decimal _amount;
    private DateTime? _date=new(2026,10,9);
    private bool _adding;
    private FinanceRecord? _selected;
    private IJSObjectReference? _download;
    private bool DetailVisible{get=>_selected is not null;set{if(!value)_selected=null;}}
    private IEnumerable<FinanceRecord> Visible=>_records.Where(x=>(_status=="All"||x.Status==_status)&&$"{x.Id} {x.Name} {x.Category}".Contains(_query,StringComparison.OrdinalIgnoreCase)).OrderByDescending(x=>_sort=="largest"?x.Amount:x.Date.DayNumber);
    private decimal Total=>Visible.Sum(x=>x.Amount);
    private decimal Used=>Visible.Sum(x=>x.Used);
    private int Utilization=>Total==0?0:(int)Math.Round(Used/Total*100);
    private static int Percent(FinanceRecord budget)=>budget.Amount==0?0:(int)Math.Round(budget.Used/budget.Amount*100);
    private static string Money(decimal value)=>value.ToString("C0",CultureInfo.GetCultureInfo("en-US"));
    private void Reset(){_query="";_status="All";_sort="newest";}
    private void CloseDetail()=>_selected=null;
    private void OpenAdd(){_name="";_category="General";_amount=0;_date=new DateTime(2026,10,9);_adding=true;}
    private void Add(){if(string.IsNullOrWhiteSpace(_name)||_amount<=0){Snackbar.Add("Enter a name and positive allocation.",Severity.Error);return;}_records.Insert(0,new($"BDG-{1001+_records.Count}",_name.Trim(),string.IsNullOrWhiteSpace(_category)?"General":_category,_amount,0,"Active",DateOnly.FromDateTime(_date??DateTime.Today)));_adding=false;Snackbar.Add("Sample budget created.",Severity.Success);}
    private async Task Export(){static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new List<string>{"ID,Name,Category,Amount USD,Spent USD,Status,Date"};rows.AddRange(Visible.Select(x=>string.Join(",",new[]{x.Id,x.Name,x.Category,x.Amount.ToString(CultureInfo.InvariantCulture),x.Used.ToString(CultureInfo.InvariantCulture),x.Status,x.Date.ToString("yyyy-MM-dd")}.Select(Cell))));_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await _download.InvokeVoidAsync("download","finance-budgets.csv",string.Join("\r\n",rows),"text/csv;charset=utf-8");Snackbar.Add("Budget CSV exported.",Severity.Success);}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}
}