@using System.Globalization
@using Rynzo.Client.Features.Finance.Models
@using Rynzo.Client.Features.Dashboard.Components
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>@Title | Rynzo</PageTitle>
<div class="finance-workspace">
    <PageHeader Title="@Title" Description="Manage financial records with a clear view of every detail." Breadcrumbs="Breadcrumbs" />
    <div class="finance-note">Sample financial records · USD · Changes stay in this page session. Status updates do not process payments.</div>
    <div class="finance-metrics">
        <MudCard Outlined="true" Elevation="0" Class="finance-metric rynzo-widget-card"><span class="finance-metric-icon primary"><MudIcon Icon="@Icons.Material.Filled.Description" /></span><div><small>Records in view</small><b>@Visible.Count()</b></div></MudCard>
        <MudCard Outlined="true" Elevation="0" Class="finance-metric rynzo-widget-card"><span class="finance-metric-icon info"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" /></span><div><small>@(Kind == "budgets" ? "Allocated budget" : "Total value")</small><b>@Money(Total)</b></div></MudCard>
        <MudCard Outlined="true" Elevation="0" Class="finance-metric rynzo-widget-card"><span class="finance-metric-icon success"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" /></span><div><small>@ThirdMetricLabel</small><b>@Money(ThirdMetric)</b></div></MudCard>
    </div>
    @if (Kind == "transactions")
    {
        <div class="finance-detail-grid"><DashboardCard Title="Cash flow activity" Description="Completed income and expenses by record date · USD"><ChildContent><DashboardChart Data="ChartData" OptionsModule="./finance-options.js" Kind="cash" Height="265" Label="Cash flow activity by date" /></ChildContent></DashboardCard><MudCard Outlined="true" Elevation="0" Class="finance-secondary-card rynzo-widget-card"><h3>Transaction breakdown</h3><small>Current filtered records</small><div class="finance-breakdown-list"><div><span>Completed income</span><b class="finance-positive">@Money(Visible.Where(x=>x.Category=="Income" && x.Status=="Completed").Sum(x=>x.Amount))</b></div><div><span>Completed expense</span><b class="finance-warning">@Money(Visible.Where(x=>x.Category=="Expense" && x.Status=="Completed").Sum(x=>x.Amount))</b></div><div><span>Pending transactions</span><b>@Visible.Count(x=>x.Status=="Pending") / @Money(Visible.Where(x=>x.Status=="Pending").Sum(x=>x.Amount))</b></div></div></MudCard></div>
    }
    @if (Kind == "invoices")
    {
        <div class="finance-detail-grid"><MudCard Outlined="true" Elevation="0" Class="finance-secondary-card finance-receivables rynzo-widget-card"><h3>Receivables overview</h3><small>Sample balances · As of October 9, 2026</small><div class="finance-summary-grid"><div><small>Paid invoices</small><b class="finance-positive">@Money(Visible.Where(x=>x.Status=="Paid").Sum(x=>x.Amount))</b></div><div><small>Open receivables</small><b>@Money(Visible.Where(x=>x.Status=="Unpaid").Sum(x=>x.Amount))</b></div><div><small>Overdue balance</small><b class="finance-warning">@Money(Visible.Where(x=>x.Status=="Unpaid" && x.Date < new DateOnly(2026,10,9)).Sum(x=>x.Amount))</b></div></div><p>Overdue balances are part of open receivables. Marking paid updates the sample record only.</p></MudCard><MudCard Outlined="true" Elevation="0" Class="finance-secondary-card rynzo-widget-card"><h3>Collection progress</h3><small>Paid value as a share of invoice value</small><b class="finance-progress-value">@(Total == 0 ? 0 : (int)(Visible.Where(x=>x.Status=="Paid").Sum(x=>x.Amount)/Total*100))%</b><MudProgressLinear Value="@(Total == 0 ? 0 : (double)(Visible.Where(x=>x.Status=="Paid").Sum(x=>x.Amount)/Total*100))" Color="Color.Success" /><p>@Visible.Count(x=>x.Status=="Paid") paid / @Visible.Count() invoices in view</p></MudCard></div>
    }
    @if (Kind is "expenses" or "budgets")
    {
        <div class="finance-detail-grid"><MudCard Outlined="true" Elevation="0" Class="finance-breakdown rynzo-widget-card"><h3>@(Kind == "expenses" ? "Expense categories" : "Budget utilization")</h3><small>Current filtered sample records</small>@foreach (var group in Visible.GroupBy(x => x.Category).OrderByDescending(x => x.Sum(y => y.Amount))) { var total = group.Sum(x => x.Amount); var used = group.Sum(x => Kind == "budgets" ? x.Used : x.Amount); <div><span>@group.Key</span><b>@Money(used)@(Kind == "budgets" ? $" / {Money(total)}" : "")</b><MudProgressLinear Value="@(total == 0 ? 0 : (double)(used / total * 100))" Color="Color.Primary" /></div>}</MudCard><MudCard Outlined="true" Elevation="0" Class="finance-secondary-card rynzo-widget-card"><h3>@(Kind == "expenses" ? "Approval overview" : "Budget watch")</h3><small>@(Kind == "expenses" ? "Expense amounts by review status" : "Allocations with 80% or more spent")</small>@if(Kind=="expenses"){<div class="finance-status-grid">@foreach(var status in new[]{"Pending","Approved","Rejected"}){<div><MudChip T="string" Size="Size.Small" Color="Tone(status)">@status</MudChip><b>@Money(Visible.Where(x=>x.Status==status).Sum(x=>x.Amount))</b><small>@Visible.Count(x=>x.Status==status) records</small></div>}</div>}else{ @foreach(var budget in Visible.Where(x=>x.Amount>0 && x.Used/x.Amount>=.8m)){<MudCard Class="finance-watch rynzo-widget-card" Elevation="0" Outlined="true"><span>@budget.Name<small>@Money(budget.Amount-budget.Used) remaining</small></span><b>@Math.Round(budget.Used/budget.Amount*100)%</b></MudCard>} @if(!Visible.Any(x=>x.Amount>0 && x.Used/x.Amount>=.8m)){<p>All budgets are below the watch threshold.</p>}}</MudCard></div>
    }
    <MudCard Outlined="true" Elevation="0" Class="finance-table-shell rynzo-widget-card">
        <div class="finance-toolbar"><div><h2>@Title</h2><small>@Visible.Count() matching records</small></div><div class="finance-actions"><MudButton Variant="Variant.Outlined" OnClick="Export">Export</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAdd">Add @(Kind == "budgets" ? "budget" : Kind == "invoices" ? "invoice" : Kind == "expenses" ? "expense" : "transaction")</MudButton></div></div>
        <div class="finance-filters"><MudTextField T="string" @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Search records" Placeholder="Search records" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" /><MudSelect T="string" @bind-Value="_filter" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Status"><MudSelectItem Value="@("All")">All statuses</MudSelectItem>@foreach(var status in Statuses){<MudSelectItem Value="@status">@status</MudSelectItem>}</MudSelect>@if(Kind=="transactions"){<MudSelect T="string" @bind-Value="_direction" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Direction"><MudSelectItem Value="@("All")">All directions</MudSelectItem><MudSelectItem Value="@("Income")">Income</MudSelectItem><MudSelectItem Value="@("Expense")">Expense</MudSelectItem></MudSelect>}@if(Kind=="invoices"){<MudSelect T="string" @bind-Value="_invoiceView" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Invoice view"><MudSelectItem Value="@("All invoices")">All invoices</MudSelectItem><MudSelectItem Value="@("Overdue")">Overdue</MudSelectItem></MudSelect>}@if(Kind=="expenses"){<MudSelect T="string" @bind-Value="_expenseCategory" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Expense category"><MudSelectItem Value="@("All")">All categories</MudSelectItem>@foreach(var category in Categories){<MudSelectItem Value="@category">@category</MudSelectItem>}</MudSelect>}<MudSelect T="string" @bind-Value="_sort" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Sort records"><MudSelectItem Value="@("newest")">Newest</MudSelectItem><MudSelectItem Value="@("largest")">Largest</MudSelectItem></MudSelect></div>
        <MudTable Items="Visible" Hover="true" Dense="true" Striped="true"><HeaderContent><MudTh>ID</MudTh><MudTh>Name</MudTh><MudTh>Category</MudTh><MudTh>Amount</MudTh><MudTh>Status</MudTh><MudTh>Date</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd DataLabel="ID">@context.Id</MudTd><MudTd DataLabel="Name"><b>@context.Name</b></MudTd><MudTd DataLabel="Category">@context.Category</MudTd><MudTd DataLabel="Amount">@Money(context.Amount)</MudTd><MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="Tone(context.Status)">@context.Status</MudChip></MudTd><MudTd DataLabel="Date">@context.Date.ToString("yyyy-MM-dd")</MudTd><MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(()=>_selected=context)">Details</MudButton></MudTd></RowTemplate></MudTable>
    </MudCard>
</div>
@if (_addOpen)
{
    <MudDialog @bind-Visible="_addOpen"><DialogContent><MudText Typo="Typo.h6">Add @Singular</MudText><MudTextField T="string" @bind-Value="_name" Label="Name" Required="true" /><MudTextField T="string" @bind-Value="_category" Label="Category" /><MudNumericField T="decimal" @bind-Value="_amount" Label="Amount" Min="0.01m" /><MudDatePicker @bind-Date="_date" Label="Date" /></DialogContent><DialogActions><MudButton OnClick="@(()=>_addOpen=false)">Cancel</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Add">Add</MudButton></DialogActions></MudDialog>
}
@if (_selected is not null)
{
    <MudDialog @bind-Visible="SelectedVisible"><DialogContent><MudText Typo="Typo.h6">@_selected.Name</MudText><p>@_selected.Id · Sample financial record</p><p><b>Category:</b> @_selected.Category</p><p><b>Amount:</b> @Money(_selected.Amount)</p><p><b>Status:</b> @_selected.Status</p><p><b>Date:</b> @_selected.Date.ToString("yyyy-MM-dd")</p>@if(Kind=="budgets"){<p><b>Available:</b> @Money(_selected.Amount-_selected.Used)</p>}</DialogContent><DialogActions><MudButton OnClick="CloseDetail">Close</MudButton>@if(_selected.Status is "Pending" or "Unpaid"){<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Update">Mark @(Kind=="invoices"?"paid":Kind=="expenses"?"approved":"completed")</MudButton>}</DialogActions></MudDialog>
}
@code {
    [Parameter] public string Kind { get; set; } = "transactions";
    private List<FinanceRecord> _records = [];
    private string _query = "", _filter = "All", _direction = "All", _invoiceView = "All invoices", _expenseCategory = "All", _sort = "newest", _name = "", _category = "General";
    private decimal _amount; private DateTime? _date = new(2026,10,9); private bool _addOpen; private FinanceRecord? _selected; private bool SelectedVisible { get => _selected is not null; set { if (!value) _selected = null; } }
    protected override void OnParametersSet() { _records = (Kind switch { "invoices" => FinanceSource.Invoices, "expenses" => FinanceSource.Expenses, "budgets" => FinanceSource.Budgets, _ => FinanceSource.Transactions }).ToList(); _category = Kind == "transactions" ? "Income" : "General"; }
    private string Title => Kind switch { "invoices" => "Finance Invoices", "expenses" => "Expenses", "budgets" => "Budgets", _ => "Transactions" };
    private string Singular => Kind switch { "invoices" => "invoice", "expenses" => "expense", "budgets" => "budget", _ => "transaction" };
    private BreadcrumbItem[] Breadcrumbs => [new("Management", null), new("Finance", null), new(Title, null, true)];
    private IEnumerable<string> Statuses => _records.Select(x => x.Status).Distinct().Order(); private IEnumerable<string> Categories => _records.Select(x => x.Category).Distinct().Order();
    private IEnumerable<FinanceRecord> Visible => _records.Where(x => (_filter == "All" || x.Status == _filter) && (Kind != "transactions" || _direction == "All" || x.Category == _direction) && (Kind != "invoices" || _invoiceView != "Overdue" || (x.Status == "Unpaid" && x.Date < new DateOnly(2026,10,9))) && (Kind != "expenses" || _expenseCategory == "All" || x.Category == _expenseCategory) && $"{x.Id} {x.Name} {x.Category}".Contains(_query, StringComparison.OrdinalIgnoreCase)).OrderByDescending(x => _sort == "largest" ? x.Amount : x.Date.DayNumber);
    private decimal Total => Visible.Sum(x => x.Amount); private decimal ThirdMetric => Kind == "budgets" ? Visible.Sum(x => x.Amount - x.Used) : Kind == "transactions" ? Visible.Where(x => x.Status == "Completed").Sum(x => x.Category == "Income" ? x.Amount : -x.Amount) : Visible.Where(x => x.Status is "Pending" or "Unpaid").Sum(x => x.Amount); private string ThirdMetricLabel => Kind == "budgets" ? "Available budget" : Kind == "transactions" ? "Net completed cash flow" : "Awaiting action";
    private object ChartData => new { series = new[] { new { name = "Income", data = Visible.OrderBy(x=>x.Date).Select(x => x.Category == "Income" && x.Status == "Completed" ? (double)x.Amount : 0).ToArray() }, new { name = "Expense", data = Visible.OrderBy(x=>x.Date).Select(x => x.Category == "Expense" && x.Status == "Completed" ? (double)x.Amount : 0).ToArray() } } };
    private static string Money(decimal value) => value.ToString("C0", CultureInfo.GetCultureInfo("en-US")); private static Color Tone(string status) => status is "Completed" or "Paid" or "Approved" or "Active" ? Color.Success : status is "Rejected" ? Color.Error : Color.Warning;
    private void OpenAdd(){_name="";_amount=0;_date=new DateTime(2026,10,9);_addOpen=true;} private void CloseDetail()=>_selected=null;
    private void Add(){if(string.IsNullOrWhiteSpace(_name)||_amount<=0){Snackbar.Add("Enter a name and positive amount.",Severity.Error);return;}var prefix=Kind=="transactions"?"TX":Kind=="invoices"?"INV":Kind=="expenses"?"EXP":"BDG";var status=Kind=="invoices"?"Unpaid":Kind=="budgets"?"Active":"Pending";_records.Insert(0,new FinanceRecord($"{prefix}-{1001+_records.Count}",_name.Trim(),string.IsNullOrWhiteSpace(_category)?"General":_category,_amount,0,status,DateOnly.FromDateTime(_date??DateTime.Today)));_addOpen=false;Snackbar.Add("Sample record created.",Severity.Success);}
    private void Update(){if(_selected is null)return;var status=Kind=="invoices"?"Paid":Kind=="expenses"?"Approved":"Completed";var index=_records.FindIndex(x=>x.Id==_selected.Id);_records[index]=_selected with { Status=status };_selected=null;Snackbar.Add("Sample status updated.",Severity.Success);}
    private IJSObjectReference? _download;
    private async Task Export(){var rows=new List<string>{"ID,Name,Category,Amount USD,Spent USD,Status,Date"};rows.AddRange(Visible.Select(x=>string.Join(',',x.Id,$"\"{x.Name.Replace("\"","\"\"")}\"",x.Category,x.Amount,x.Used,x.Status,x.Date.ToString("yyyy-MM-dd"))));_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/ai-workspace-download.js");await _download.InvokeVoidAsync("download",$"finance-{Kind}.csv",string.Join("\r\n",rows),"text/csv;charset=utf-8");Snackbar.Add($"{Title} CSV exported for this source-local session.",Severity.Success);}
    public async ValueTask DisposeAsync(){if(_download is not null){try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}}
}
