@using System.Globalization
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable
<PageTitle>Crypto Wallet | Rynzo</PageTitle>
<div class="wallet-page">
<PageHeader Title="Crypto Wallet" Description="A clear view of your digital assets, balances, and portfolio allocation."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export balances</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("ArrowDownUp")" Href="/crypto/exchange">Exchange preview</MudButton></Actions></PageHeader>
<div class="wallet-overview"><MudCard Class="wallet-balance rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><span class="wallet-brand"><MudIcon Icon="@RynzoIcons.Get("Wallet")" />Portfolio overview</span><span class="wallet-demo"><i></i>Sample wallet</span></header><span class="wallet-eyebrow">TOTAL ASSET VALUE / USD</span><h2>@Money(Total)</h2><div class="wallet-return @(Total-CostBasis<0?"is-negative":"")"><MudIcon Icon="@RynzoIcons.Get(Total>=CostBasis?"TrendingUp":"TrendingDown")" /><b>@Signed(Total-CostBasis)</b><span>unrealized gain / loss</span></div><div class="wallet-summary-values"><div><small>Cost basis</small><b>@Money(CostBasis)</b></div><div><small>Assets held</small><b>@_source.Assets.Length</b></div><div><small>Portfolio return</small><b>@(CostBasis==0?"0.0":Pct((Total-CostBasis)/CostBasis*100))%</b></div></div><footer><span><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" />Illustrative balances. No connected wallet.</span><a href="/crypto/transactions">Transaction history <MudIcon Icon="@RynzoIcons.Get("ArrowUpRight")" /></a></footer></MudCard><MudCard Class="wallet-allocation rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="wallet-eyebrow">PORTFOLIO COMPOSITION</span><h2>Asset allocation</h2></div><span>USD</span></header><div class="wallet-allocation-body"><div class="wallet-donut"><DashboardChart Data="AllocationData" OptionsModule="./crypto-workspace-options.js" Kind="allocation" Height="235" Label="Sample portfolio asset allocation" /></div><div class="wallet-allocation-list">@foreach(var asset in _source.Assets){<button @onclick="@(()=>_selected=asset)"><span><i style="@($"background:var({asset.Color})")"></i>@asset.Symbol</span><b>@Pct(Share(asset))%</b></button>}</div></div></MudCard></div>
<section class="wallet-library"><header><div><span class="wallet-eyebrow">YOUR ASSET LIBRARY</span><h2>Asset balances <span>@VisibleAssets.Count() assets</span></h2><p>Review holdings, cost basis, and unrealized performance.</p></div><div class="wallet-controls"><MudTextField T="string" @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search assets or symbols..." aria-label="Search wallet assets" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Sort wallet assets" @bind="_sort"><option value="cap">Market cap</option><option value="value">Holding value</option><option value="name">Asset name</option></select></div></header><div class="wallet-assets">@foreach(var asset in VisibleAssets){var gain=asset.Holding*(asset.Price-asset.Entry);<MudCard Class="wallet-asset rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="article"><header><CryptoCoin Asset="asset" /><div><button class="wallet-asset-open" @onclick="@(()=>_selected=asset)">@asset.Name</button><small>@asset.Symbol</small></div><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"View {asset.Symbol} balance")" OnClick="@(()=>_selected=asset)" /></header><div class="wallet-asset-value"><small>Holding value</small><b>@Money(asset.Holding*asset.Price)</b><span>@asset.Holding.ToString("0.########",English) @asset.Symbol</span></div><div class="wallet-asset-stats"><div><small>Sample price</small><b>@Money(asset.Price)</b></div><div><small>Portfolio share</small><b>@Pct(Share(asset))%</b></div></div><footer><span><small>Unrealized gain / loss</small><b class="@(gain>=0?"wallet-positive":"wallet-negative")">@Signed(gain)</b></span><button @onclick="@(()=>_selected=asset)">Details <MudIcon Icon="@RynzoIcons.Get("ChevronRight")" /></button></footer></MudCard>}</div>@if(!VisibleAssets.Any()){<div class="wallet-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No matching assets</h3><p>Search by asset name or symbol.</p><MudButton Variant="Variant.Outlined" OnClick="@(()=>_query="")">Clear search</MudButton></div>}<p class="wallet-results">Showing @VisibleAssets.Count() of @_source.Assets.Length sample assets</p></section><p class="wallet-note"><MudIcon Icon="@RynzoIcons.Get("Info")" />Illustrative prices and balances. No live feed or real transactions. Changes stay in this page session.</p>
</div>
@if(_selected is {} selectedAsset){<MudDialog @bind-Visible="DetailVisible"><TitleContent><div class="wallet-dialog-title"><CryptoCoin Asset="selectedAsset" /><div><small>SAMPLE ASSET BALANCE</small><h2>@selectedAsset.Name / @selectedAsset.Symbol</h2></div></div></TitleContent><DialogContent><div class="wallet-detail-value"><small>Holding value</small><b>@Money(selectedAsset.Holding*selectedAsset.Price)</b><span>@selectedAsset.Holding.ToString("0.########",English) @selectedAsset.Symbol</span></div><dl class="wallet-detail-fields">@foreach(var field in new[]{("Sample price",Money(selectedAsset.Price)),("24h change",Pct(selectedAsset.Change)+"%"),("Market cap",Compact(selectedAsset.MarketCap*1e6)),("24h volume",Compact(selectedAsset.Volume*1e6)),("Cost basis",Money(selectedAsset.Holding*selectedAsset.Entry)),("Portfolio share",Pct(Share(selectedAsset))+"%"),("Unrealized gain / loss",Signed(selectedAsset.Holding*(selectedAsset.Price-selectedAsset.Entry)))}){<div><dt>@field.Item1</dt><dd>@field.Item2</dd></div>}</dl><p class="wallet-dialog-note">Sample balance and cost basis. No connected wallet or live market feed.</p></DialogContent><DialogActions><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(()=>_selected=null)">Close balance details</MudButton></DialogActions></MudDialog>}
@code{
    private readonly CryptoSourceData _source=CryptoSourceData.Load();
    private static readonly CultureInfo English=CultureInfo.GetCultureInfo("en-US");
    private string _query="",_sort="cap";
    private CryptoAsset? _selected;
    private IJSObjectReference? _download;
    private object _allocationData=null!;
    private bool DetailVisible{get=>_selected is not null;set{if(!value)_selected=null;}}
    private double Total=>_source.Assets.Sum(a=>a.Holding*a.Price);
    private double CostBasis=>_source.Assets.Sum(a=>a.Holding*a.Entry);
    private double Share(CryptoAsset asset)=>Total==0?0:asset.Holding*asset.Price/Total*100;
    private object AllocationData=>_allocationData;
    protected override void OnInitialized()=>_allocationData=new{Holdings=Total,Assets=_source.Assets};
    private IEnumerable<CryptoAsset> VisibleAssets{get{var assets=_source.Assets.Where(a=>$"{a.Name} {a.Symbol}".Contains(_query,StringComparison.OrdinalIgnoreCase));return _sort switch{"name"=>assets.OrderBy(a=>a.Name),"value"=>assets.OrderByDescending(a=>a.Holding*a.Price),_=>assets.OrderByDescending(a=>a.MarketCap)};}}
    private static string Money(double value)=>value.ToString("C2",English);
    private static string Pct(double value)=>value.ToString("F1",English);
    private static string Signed(double value)=>(value>=0?"+":"-")+Money(Math.Abs(value));
    private static string Compact(double value)=>value>=1e12?"$"+(value/1e12).ToString("0.#",English)+"T":value>=1e9?"$"+(value/1e9).ToString("0.#",English)+"B":Money(value);
    private async Task Export(){static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new List<string>{"Asset,Name,Sample price USD,Holding,Value USD"};rows.AddRange(VisibleAssets.Select(a=>string.Join(",",new[]{a.Symbol,a.Name,a.Price.ToString(English),a.Holding.ToString(English),(a.Holding*a.Price).ToString(English)}.Select(Cell))));_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await _download.InvokeVoidAsync("csv","crypto-wallet.csv",string.Join("\r\n",rows));Snackbar.Add("Wallet balances exported.",Severity.Success);}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}
}
