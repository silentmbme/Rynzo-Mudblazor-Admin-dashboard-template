@using System.Globalization
@using Rynzo.Client.Features.Crypto.Models
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable
<PageTitle>Crypto Transactions | Rynzo</PageTitle>
<div class="crypto-transactions-page">
<div class="ct-page-heading"><PageHeader Title="Crypto Transactions" Description="Review asset movements, transaction status, and activity history."><Actions><div class="ct-header-actions"><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("WalletCards")" Href="/crypto/wallet">View wallet</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("ArrowDownToLine")" OnClick="Export">Export transactions</MudButton></div></Actions></PageHeader></div>
<MudCard Class="ct-summary rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="ct-summary-intro"><span class="ct-eyebrow">ACTIVITY SNAPSHOT</span><h2>Your asset movements,<br />clearly connected.</h2><p>Illustrative records / USD values at fixed sample prices.</p></div><div class="ct-summary-values"><div><small>Transactions in view</small><b>@Records.Count</b></div><div><small>Completed records</small><b class="ct-positive">@Records.Count(r=>r.Status=="Completed")</b></div><div><small>Pending records</small><b>@Records.Count(r=>r.Status=="Pending")</b></div><div><small>Illustrative value</small><b>@Money(Records.Where(r=>r.Status!="Failed").Sum(Value))</b></div></div></MudCard>
<MudCard Class="ct-library rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="ct-eyebrow">TRANSACTION LEDGER</span><h2>Transaction history <span>@Records.Count records</span></h2><p>Review buys, sells, and asset transfers in one place.</p></div><span class="ct-demo"><i></i>Sample activity</span></header><nav class="ct-tabs" aria-label="Transaction types">@foreach(var type in Types){<button class="@(_type==type?"is-active":"")" aria-pressed="@(_type==type)" @onclick="@(()=>_type=type)">@(type=="All"?"All transactions":type)<span>@Activity.Count(r=>type=="All"||r.Type==type)</span></button>}</nav><div class="ct-filters"><MudTextField T="string" @bind-Value="_query" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search reference, asset, or type..." aria-label="Search crypto transactions" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" /><select aria-label="Transaction type" @bind="_type">@foreach(var type in Types){<option value="@type">@(type=="All"?"All types":type)</option>}</select><select aria-label="Crypto transaction status" @bind="_status"><option value="All">All statuses</option><option>Completed</option><option>Pending</option><option>Failed</option></select><select aria-label="Sort crypto transactions" @bind="_sort"><option value="newest">Newest first</option><option value="value">Largest value</option></select><MudButton Variant="Variant.Text" OnClick="Reset">Reset filters</MudButton></div><div class="ct-table-scroll" tabindex="0" aria-label="Crypto transaction history"><table><thead><tr><th>Transaction</th><th>Asset</th><th>Quantity</th><th>Sample value</th><th>Status</th><th>Date</th><th></th></tr></thead><tbody>@foreach(var record in Records){var asset=Asset(record);<tr><td><button class="ct-open" @onclick="@(()=>_selected=record)"><span class="ct-type-icon ct-type-@record.Type.ToLowerInvariant()"><MudIcon Icon="@RynzoIcons.Get(TypeIcon(record.Type))" /></span><span><b>@record.Type @record.Asset</b><small>@record.Id</small></span></button></td><td><div class="ct-asset"><CryptoCoin Asset="asset" Small="true" /><span><b>@asset.Name</b><small>@asset.Symbol</small></span></div></td><td><b class="ct-quantity">@record.Amount.ToString("0.########",English)</b><small class="ct-symbol">@record.Asset</small></td><td><b class="ct-value">@Money(Value(record))</b><small class="ct-symbol">USD</small></td><td><span class="ct-status @record.Status.ToLowerInvariant()"><i></i>@record.Status</span></td><td>@record.Date</td><td><MudIconButton Icon="@RynzoIcons.Get("Eye")" aria-label="@($"View {record.Id}")" OnClick="@(()=>_selected=record)" /></td></tr>}</tbody></table></div>@if(Records.Count==0){<div class="ct-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No matching transactions</h3><p>Try another search or reset your filters.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}<footer><span>Showing @Records.Count of @Activity.Length sample records</span><span>Values use fixed sample prices.</span></footer></MudCard><p class="ct-note"><MudIcon Icon="@RynzoIcons.Get("Info")" />No live feed, connected wallet, or real transactions. USD values are illustrative, not historical execution prices.</p>
</div>
@if(_selected is {} selected){var asset=Asset(selected);<MudDialog @bind-Visible="DetailVisible"><TitleContent><div class="ct-dialog-heading"><span class="ct-type-icon ct-type-@selected.Type.ToLowerInvariant()"><MudIcon Icon="@RynzoIcons.Get(TypeIcon(selected.Type))" /></span><div><small>TRANSACTION DETAILS</small><h2>@selected.Type @selected.Asset</h2></div></div></TitleContent><DialogContent><div class="ct-detail-total"><span class="ct-status @selected.Status.ToLowerInvariant()"><i></i>@selected.Status</span><b>@selected.Amount.ToString("0.########",English) @selected.Asset</b><small>@Money(Value(selected)) at current sample price</small></div><dl class="ct-detail-fields">@foreach(var field in new[]{("Reference",selected.Id),("Asset",asset.Name),("Type",selected.Type),("Date",selected.Date),("Status",selected.Status)}){<div><dt>@field.Item1</dt><dd>@field.Item2</dd></div>}</dl><p class="ct-dialog-note">Sample record, not an on-chain transaction. No wallet address or transaction hash is connected.</p></DialogContent><DialogActions><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(()=>_selected=null)">Close details</MudButton></DialogActions></MudDialog>}
@code{
    private readonly CryptoSourceData _source=CryptoSourceData.Load();
    private static readonly CultureInfo English=CultureInfo.GetCultureInfo("en-US");
    private static readonly string[] Types=["All","Buy","Sell","Receive","Send"];
    private string _query="",_type="All",_status="All",_sort="newest";
    private CryptoActivity? _selected;
    private IJSObjectReference? _download;
    private bool DetailVisible{get=>_selected is not null;set{if(!value)_selected=null;}}
    private CryptoAsset Asset(CryptoActivity record)=>_source.Assets.Single(a=>a.Symbol==record.Asset);
    private double Value(CryptoActivity record)=>record.Amount*Asset(record).Price;
    private static string Money(double value)=>value.ToString("C2",English);
    private List<CryptoActivity> Records=>Activity.Where(r=>(_type=="All"||r.Type==_type)&&(_status=="All"||r.Status==_status)&&$"{r.Id} {r.Asset} {r.Type}".Contains(_query,StringComparison.OrdinalIgnoreCase)).OrderBy(r=>_sort=="value"?-Value(r):0).ThenByDescending(r=>r.Date).ToList();
    private static string TypeIcon(string type)=>type switch { "Buy"=>"Plus", "Sell"=>"ArrowLeftRight", "Receive"=>"ArrowDownToLine", _=>"ArrowUpRight" };
    private void Reset(){_query="";_type="All";_status="All";_sort="newest";}
    private async Task Export(){static string Cell(string value)=>"\""+value.Replace("\"","\"\"")+"\"";var rows=new List<string>{"ID,Asset,Type,Amount,Status,Date"};rows.AddRange(Records.Select(r=>string.Join(",",new[]{r.Id,r.Asset,r.Type,r.Amount.ToString(English),r.Status,r.Date}.Select(Cell))));_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");await _download.InvokeVoidAsync("csv","crypto-transactions.csv",string.Join("\r\n",rows));Snackbar.Add("Crypto transactions exported.",Severity.Success);}
    public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}}private static readonly CryptoActivity[] Activity=[new("CTX-101","BTC","Buy",.025,"Completed","2026-10-09"),new("CTX-102","ETH","Receive",.4,"Completed","2026-10-08"),new("CTX-103","SOL","Sell",3,"Pending","2026-10-08"),new("CTX-104","BNB","Receive",.6,"Completed","2026-10-07"),new("CTX-105","BTC","Send",.012,"Completed","2026-10-06"),new("CTX-106","ETH","Buy",.8,"Completed","2026-10-05"),new("CTX-107","SOL","Receive",12,"Completed","2026-10-04"),new("CTX-108","AVAX","Send",5,"Failed","2026-10-03"),new("CTX-109","BNB","Sell",1.2,"Completed","2026-10-02"),new("CTX-110","ETH","Send",.15,"Pending","2026-10-01")];
}