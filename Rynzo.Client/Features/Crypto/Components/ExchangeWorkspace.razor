@using System.Globalization
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Theme
<PageTitle>Exchange Preview | Rynzo</PageTitle>
<div class="exchange-page">
<PageHeader Title="Exchange Preview" Description="Explore an asset conversion with a clear view of the rate and fee."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Wallet")" Href="/crypto/wallet">View wallet</MudButton></Actions></PageHeader>
<div class="ex-layout"><MudCard Class="ex-converter rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><span class="ex-eyebrow">ASSET CONVERSION</span><h2>Build your exchange estimate.</h2><p>Choose your assets and review the sample quote.</p></header><div class="ex-pay"><div class="ex-box-heading"><label for="exchange-pay">You pay</label><span>Sample balance: @Source.Holding.ToString("0.########",English) @Source.Symbol</span></div><div class="ex-amount-row"><input id="exchange-pay" aria-label="Exchange amount" type="number" min="0" step="any" placeholder="0.00" value="@_amount" @oninput="@(e=>_amount=e.Value?.ToString()??"")" /><div class="ex-asset-picker"><CryptoCoin Asset="Source" Small="true" /><select aria-label="From asset" @bind="_from">@foreach(var asset in _source.Assets){<option>@asset.Symbol</option>}</select></div></div><div class="ex-box-footer"><span>@Money(Gross) USD</span><div>@foreach(var percentage in Shortcuts){<button type="button" @onclick="@(()=>SetAmount(percentage))">@(percentage==100?"Max":percentage+"%")</button>}</div></div></div><div class="ex-reverse-row"><i></i><MudIconButton Icon="@RynzoIcons.Get("ArrowDownUp")" aria-label="Reverse exchange pair" OnClick="Reverse" /><i></i></div><div class="ex-receive"><div class="ex-box-heading"><span>You receive</span><span>Estimated after fee</span></div><div class="ex-amount-row"><output aria-label="Estimated receive amount">@Receive.ToString("F6",English)</output><div class="ex-asset-picker"><CryptoCoin Asset="Target" Small="true" /><select aria-label="To asset" @bind="_to">@foreach(var asset in _source.Assets){<option>@asset.Symbol</option>}</select></div></div><div class="ex-box-footer"><span>@Money(Gross-Fee) USD</span><span>@Target.Name</span></div></div><div class="ex-rate"><MudIcon Icon="@RynzoIcons.Get("ArrowRight")" /><span>1 @_from = @((Source.Price/Target.Price).ToString("F6",English)) @_to</span><b>Fixed sample rate</b></div>@if(!Valid){<p class="ex-validation" role="status">Choose different assets and enter a positive amount up to 1,000,000.</p>}<MudButton Class="ex-review" FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Valid)" EndIcon="@RynzoIcons.Get("ArrowRight")" OnClick="OpenPreview">Review exchange estimate</MudButton><p class="ex-preview-note"><MudIcon Icon="@RynzoIcons.Get("ShieldCheck")" />Preview only. No order or payment is submitted.</p></MudCard>
<aside class="ex-sidebar"><MudCard Class="ex-quote rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><span class="ex-eyebrow">QUOTE BREAKDOWN</span><h2>Every detail, upfront.</h2><p>Fixed sample prices / 0.25% fee</p></header><div class="ex-pair"><div><CryptoCoin Asset="Source" Small="true" /><span><b>@Source.Name</b><small>@_from</small></span></div><MudIcon Icon="@RynzoIcons.Get("ArrowRight")" /><div><CryptoCoin Asset="Target" Small="true" /><span><b>@Target.Name</b><small>@_to</small></span></div></div><dl>@foreach(var row in QuoteRows){<div><dt>@row.Item1</dt><dd>@row.Item2</dd></div>}</dl><footer><span>Estimated receive</span><b>@Receive.ToString("F6",English) @_to</b></footer></MudCard><MudCard Class="ex-guide rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span class="ex-eyebrow">HOW IT WORKS</span><h2>A simple way to compare.</h2>@foreach(var step in GuideSteps.Select((text,index)=>(text,index))){<div><b>@(step.index+1)</b><p>@step.text</p></div>}</MudCard></aside></div><p class="ex-disclosure"><MudIcon Icon="@RynzoIcons.Get("Info")" />Illustrative prices and balances. No live feed, connected wallet, or real transactions. Changes stay in this page session.</p>
</div>
@if(_preview){<MudDialog @bind-Visible="_preview"><TitleContent><div class="ex-dialog-title"><span><MudIcon Icon="@RynzoIcons.Get("ArrowDownUp")" /></span><div><small>EXCHANGE ESTIMATE</small><h2>Review your conversion</h2></div></div></TitleContent><DialogContent><p class="ex-dialog-note">Estimate only. No order is placed or balance changed.</p><div class="ex-review-pair"><div><CryptoCoin Asset="Source" /><section><small>You pay</small><b>@_amount @_from</b></section></div><span class="ex-review-arrow"><MudIcon Icon="@RynzoIcons.Get("ArrowDown")" /></span><div><CryptoCoin Asset="Target" /><section><small>You receive</small><b>@Receive.ToString("F6",English) @_to</b></section></div></div><dl class="ex-review-fees"><div><dt>Sample fee (0.25%)</dt><dd>@Money(Fee)</dd></div><div><dt>After fee</dt><dd>@Money(Gross-Fee)</dd></div></dl><p class="ex-dialog-note">This preview uses fixed sample prices.</p></DialogContent><DialogActions><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(()=>_preview=false)">Close preview</MudButton></DialogActions></MudDialog>}
@code{
    private readonly CryptoSourceData _source=CryptoSourceData.Load();
    private static readonly CultureInfo English=CultureInfo.GetCultureInfo("en-US");
    private static readonly List<int> Shortcuts=new(){25,50,100};
    private static readonly string[] GuideSteps=["Choose the source and destination assets.","Enter an amount or use a sample balance shortcut.","Review the estimate using fixed prices."];
    private string _from="BTC",_to="ETH",_amount="0.1";
    private bool _preview;
    private CryptoAsset Source=>_source.Assets.Single(a=>a.Symbol==_from);
    private CryptoAsset Target=>_source.Assets.Single(a=>a.Symbol==_to);
    private double Amount=>double.TryParse(_amount,NumberStyles.Float,English,out var value)?value:double.NaN;
    private bool Valid=>double.IsFinite(Amount)&&Amount>0&&Amount<=1000000&&_from!=_to;
    private double Gross=>Valid?Amount*Source.Price:0;
    private double Fee=>Gross*.0025;
    private double Receive=>(Gross-Fee)/Target.Price;
    private static string Money(double value)=>value.ToString("C2",English);
    private (string,string)[] QuoteRows=>[("Source price",Money(Source.Price)),("Destination price",Money(Target.Price)),("Input value",Money(Gross)),("Sample fee (0.25%)",Money(Fee)),("After fee",Money(Gross-Fee))];
    private void SetAmount(int percentage)=>_amount=Math.Round(Source.Holding*percentage/100,8,MidpointRounding.AwayFromZero).ToString(English);
    private void Reverse(){(_from,_to)=(_to,_from);_amount="";}
    private void OpenPreview(){if(Valid)_preview=true;}
}
