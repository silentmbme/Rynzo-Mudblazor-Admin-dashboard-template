@implements IAsyncDisposable
@using System.Globalization
@using Rynzo.Client.Features.Crypto.Models
@using Rynzo.Client.Features.Dashboard.Models
@using Rynzo.Client.Features.Dashboard.Services
@using Rynzo.Client.Features.Dashboard.Components
@using Rynzo.Client.Components.Common
@using Rynzo.Client.Theme
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<PageTitle>@Title | Rynzo</PageTitle>
<div class="crypto-workspace crypto-@Kind"><header><PageHeader Title="@Title" Description="Explore sample digital asset data in a focused workspace." Breadcrumbs="Breadcrumbs"><Actions>@if(Kind!="exchange"){<MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export</MudButton>}</Actions></PageHeader></header><div class="crypto-notice">Illustrative prices and balances. No live feed, connected wallet, or real transactions. Changes stay in this page session.</div>
@if(Kind=="market") { <section class="crypto-metrics">@foreach(var item in MarketMetrics){<MudCard Outlined="true" Elevation="0" Class="rynzo-widget-card"><small>@item.Item1</small><b>@item.Item2</b><small>Sample tracked asset universe</small></MudCard>}</section><section class="crypto-market-charts"><DashboardCard Title="@($"{ChartAsset.Name} price activity")" Description="Illustrative price history ending October 9, 2026"><Actions><select aria-label="Chart asset" @bind="_chartSymbol" @bind:after="Refresh">@foreach(var a in _source.Assets){<option>@a.Symbol</option>}</select>@foreach(var period in Ranges){<MudButton Size="Size.Small" Variant="@(_range==period?Variant.Filled:Variant.Outlined)" OnClick="@(()=>{_range=period;Refresh();})">@period</MudButton>}</Actions><ChildContent><p class="crypto-price">@Money(ChartAsset.Price) <CryptoChange Value="_history.Change"/></p><DashboardChart Data="_chartData" OptionsModule="./crypto-workspace-options.js" Kind="price" Height="265" Label="Crypto asset price history"/></ChildContent></DashboardCard><DashboardCard Title="Market movers" Description="Highest sample 24h changes"><ChildContent>@foreach(var a in _source.Assets.OrderByDescending(x=>x.Change).Take(4)){<MudButton FullWidth="true" Variant="Variant.Outlined" Class="crypto-mover" OnClick="@(()=>{_chartSymbol=a.Symbol;Refresh();})"><CryptoCoin Asset="a" Small="true"/><span><b>@a.Symbol</b><small>@Money(a.Price)</small></span><CryptoChange Value="a.Change"/></MudButton>}</ChildContent></DashboardCard></section> }
@if(Kind=="wallet") { <section class="crypto-wallet-summary"><MudCard Outlined="true" Elevation="0" Class="rynzo-widget-card"><div><MudIcon Icon="@RynzoIcons.Get("Wallet")" Color="Color.Primary"/><b>Portfolio overview</b><MudChip T="string" Size="Size.Small" Color="Color.Primary">Sample wallet</MudChip></div><small>Total asset value · USD</small><strong>@Money(Total)</strong><div class="crypto-wallet-values"><p>Cost basis<b>@Money(CostBasis)</b></p><p>Unrealized gain / loss<b>@Money(Total-CostBasis)</b></p><p>Assets held<b>@_source.Assets.Length</b></p></div></MudCard><DashboardCard Title="Asset allocation" Description="Share of the complete sample portfolio"><ChildContent><DashboardChart Data="_chartData" OptionsModule="./crypto-workspace-options.js" Kind="allocation" Height="285" Label="Sample portfolio asset allocation" /><div class="crypto-allocation-list">@foreach(var a in _source.Assets){<p><CryptoCoin Asset="a" Small="true"/><span>@a.Symbol</span><b>@Pct(a.Holding*a.Price/Total*100)%</b></p>}</div></ChildContent></DashboardCard></section> }
@if(Kind=="exchange") { <section class="crypto-exchange-layout"><MudCard Outlined="true" Elevation="0" Class="crypto-exchange-card rynzo-widget-card"><h2>Exchange assets</h2><p>Explore a quote before you decide</p><MudTextField T="string" @bind-Value="_amount" Immediate="true" Label="You pay" InputType="InputType.Number" aria-label="Exchange amount"/><label>From asset<select aria-label="From asset" @bind="_from">@foreach(var a in _source.Assets){<option>@a.Symbol</option>}</select></label><div class="crypto-shortcuts">@foreach(var pct in new[]{25,50,100}){<MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>_amount=Math.Round((Source.Holding*pct)/100,8,MidpointRounding.AwayFromZero).ToString(CultureInfo.InvariantCulture))">@(pct==100?"Max":pct+"%")</MudButton>}</div><MudIconButton Icon="@RynzoIcons.Get("ArrowDownUp")" aria-label="Reverse exchange pair" OnClick="Reverse"/><label>To asset<select aria-label="To asset" @bind="_to">@foreach(var a in _source.Assets){<option>@a.Symbol</option>}</select></label><MudCard Outlined="true" Elevation="0" Class="crypto-receive rynzo-widget-card"><small>You receive</small><b>@Receive.ToString("F6",English) @_to</b><small>@Target.Name / @Money(Gross-Fee) after sample fee</small></MudCard>@if(!Valid){<p role="status">Choose different assets and enter a positive amount up to 1,000,000.</p>}<MudButton FullWidth="true" Disabled="@(!Valid)" OnClick="Preview">Review exchange estimate</MudButton><small>Preview only. No order or payment is submitted.</small></MudCard><DashboardCard Title="Quote breakdown" Description="Fixed sample prices / 0.25% fee"><ChildContent>@foreach(var row in QuoteRows){<p class="crypto-quote"><span>@row.Item1</span><b>@row.Item2</b></p>}<MudDivider/><p>1 @_from = @((Source.Price/Target.Price).ToString("F6",English)) @_to</p></ChildContent></DashboardCard><MudCard Outlined="true" Elevation="0" Class="rynzo-widget-card"><h2>How this preview works</h2><ol><li>Choose the source and destination assets.</li><li>Enter an amount or use a sample balance shortcut.</li><li>Review the estimate using fixed prices.</li></ol></MudCard></section> }
@if(Kind=="transactions") { <section class="crypto-metrics">@foreach(var item in TransactionMetrics){<MudCard Outlined="true" Elevation="0" Class="rynzo-widget-card"><small>@item.Item1</small><b>@item.Item2</b></MudCard>}</section> }
@if(Kind is "market" or "wallet" or "transactions") { <DashboardCard Title="@(Kind=="market"?"Market watch":Kind=="wallet"?"Asset balances":"Transaction history")" Description="Sample records"><Actions><MudTextField T="string" @bind-Value="_query" Immediate="true" Placeholder="Search assets or records…" aria-label="Search crypto records" Variant="Variant.Outlined" Margin="Margin.Dense"/>@if(Kind=="market"){<select aria-label="Sort market assets" @bind="_sort"><option value="cap">Market cap</option><option value="gainers">Top gainers</option><option value="losers">Top losers</option><option value="volume">Volume</option></select><MudButton Variant="@(_onlyFavorites?Variant.Filled:Variant.Outlined)" OnClick="@(()=>_onlyFavorites=!_onlyFavorites)">Watchlist</MudButton>}else if(Kind=="transactions"){<select aria-label="Transaction type" @bind="_transactionType"><option>All</option>@foreach(var type in new[]{"Buy","Sell","Receive","Send"}){<option>@type</option>}</select><select aria-label="Sort crypto transactions" @bind="_transactionSort"><option value="newest">Newest first</option><option value="value">Largest value</option></select><select aria-label="Crypto transaction status" @bind="_status"><option>All</option><option>Completed</option><option>Pending</option><option>Failed</option></select>}</Actions><ChildContent>@if(Kind=="transactions"){<MudTable T="CryptoActivity" Items="Records" Breakpoint="Breakpoint.None"><HeaderContent><MudTh>ID</MudTh><MudTh>Asset</MudTh><MudTh>Type</MudTh><MudTh>Quantity</MudTh><MudTh>Sample value</MudTh><MudTh>Status</MudTh><MudTh>Date</MudTh><MudTh></MudTh></HeaderContent><RowTemplate Context="r"><MudTd>@r.Id</MudTd><MudTd>@r.Asset</MudTd><MudTd>@r.Type</MudTd><MudTd>@r.Amount @r.Asset</MudTd><MudTd>@Money(TransactionValue(r))</MudTd><MudTd><StatusBadge Text="@r.Status" Tone="@(r.Status=="Completed"?"success":"warning")"/></MudTd><MudTd>@r.Date</MudTd><MudTd><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>TransactionDetail(r))">Details</MudButton></MudTd></RowTemplate></MudTable>}else if(Kind=="wallet"){<div class="crypto-balances">@foreach(var a in VisibleAssets){<MudCard Outlined="true" Elevation="0" Class="rynzo-widget-card"><CryptoCoin Asset="a"/><h2>@a.Name</h2><p>@a.Holding @a.Symbol</p><b>@Money(a.Holding*a.Price)</b><MudProgressLinear Value="@(a.Holding*a.Price/Total*100)" /><small>@Pct(a.Holding*a.Price/Total*100)% of sample portfolio</small><small>Unrealized gain / loss</small><b>@Money(a.Holding*(a.Price-a.Entry))</b><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>AssetDetail(a))">Details</MudButton></MudCard>}</div>}else{<MudTable T="CryptoAsset" Items="VisibleAssets" Breakpoint="Breakpoint.None"><HeaderContent><MudTh></MudTh><MudTh>Asset</MudTh><MudTh>Price</MudTh><MudTh>24h change</MudTh><MudTh>Sample volume</MudTh><MudTh>Market cap</MudTh><MudTh></MudTh></HeaderContent><RowTemplate Context="a"><MudTd><MudIconButton Icon="@RynzoIcons.Get("Star")" Color="@(_favorites.Contains(a.Symbol)?Color.Warning:Color.Default)" aria-label="@($"Watch {a.Symbol}")" OnClick="@(()=>Toggle(a.Symbol))"/></MudTd><MudTd>@a.Name <small>@a.Symbol</small></MudTd><MudTd>@Money(a.Price)</MudTd><MudTd><CryptoChange Value="a.Change"/></MudTd><MudTd>@Compact(a.Volume*1000000)</MudTd><MudTd>@Compact(a.MarketCap*1000000)</MudTd><MudTd><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>AssetDetail(a))">Details</MudButton></MudTd></RowTemplate></MudTable>}@if((Kind=="transactions"?Records.Count():VisibleAssets.Count())==0){<p class="crypto-empty">No matching records.</p>}</ChildContent></DashboardCard> }
</div>
@code { [Parameter] public string Kind {get;set;}="market"; private readonly CryptoSourceData _source=CryptoSourceData.Load(); private static readonly CultureInfo English=CultureInfo.GetCultureInfo("en-US"); private readonly List<string> _favorites=["BTC","ETH"]; private string _query="",_sort="cap",_chartSymbol="BTC",_range="24h",_from="BTC",_to="ETH",_amount="0.1",_transactionType="All",_transactionSort="newest",_status="All"; private bool _onlyFavorites; private CryptoHistory _history=null!; private object _chartData=new(); private IJSObjectReference? _download; private static readonly string[] Ranges=["24h","7d","30d"]; private static readonly CryptoActivity[] Activity=[new("CTX-101","BTC","Buy",.025,"Completed","2026-10-09"),new("CTX-102","ETH","Receive",.4,"Completed","2026-10-08"),new("CTX-103","SOL","Sell",3,"Pending","2026-10-08"),new("CTX-104","BNB","Receive",.6,"Completed","2026-10-07"),new("CTX-105","BTC","Send",.012,"Completed","2026-10-06"),new("CTX-106","ETH","Buy",.8,"Completed","2026-10-05"),new("CTX-107","SOL","Receive",12,"Completed","2026-10-04"),new("CTX-108","AVAX","Send",5,"Failed","2026-10-03"),new("CTX-109","BNB","Sell",1.2,"Completed","2026-10-02"),new("CTX-110","ETH","Send",.15,"Pending","2026-10-01")]; private string Title=>Kind switch{"wallet"=>"Crypto Wallet","exchange"=>"Exchange Preview","transactions"=>"Crypto Transactions",_=>"Crypto Market"}; private BreadcrumbItem[] Breadcrumbs=>[new("Management",null),new("Crypto",null),new(Title,null,true)]; private CryptoAsset ChartAsset=>_source.Assets.Single(a=>a.Symbol==_chartSymbol); private CryptoAsset Source=>_source.Assets.Single(a=>a.Symbol==_from); private CryptoAsset Target=>_source.Assets.Single(a=>a.Symbol==_to); private double Amount=>double.TryParse(_amount,NumberStyles.Float,English,out var n)?n:double.NaN; private bool Valid=>double.IsFinite(Amount)&&Amount>0&&Amount<=1000000&&_from!=_to; private double Gross=>Valid?Amount*Source.Price:0; private double Fee=>Gross*.0025; private double Receive=>(Gross-Fee)/Target.Price; private double Total=>_source.Assets.Sum(a=>a.Holding*a.Price); private double CostBasis=>_source.Assets.Sum(a=>a.Holding*a.Entry); private IEnumerable<CryptoAsset> VisibleAssets=>_source.Assets.Where(a=>$"{a.Name} {a.Symbol}".Contains(_query,StringComparison.OrdinalIgnoreCase)&&(!_onlyFavorites||_favorites.Contains(a.Symbol))).OrderBy(a=>_sort=="gainers"?-a.Change:_sort=="losers"?a.Change:_sort=="volume"?-a.Volume:-a.MarketCap); private List<CryptoActivity> Records=>Activity.Where(r=>(_status=="All"||r.Status==_status)&&(_transactionType=="All"||r.Type==_transactionType)&&$"{r.Id} {r.Asset} {r.Type}".Contains(_query,StringComparison.OrdinalIgnoreCase)).OrderBy(r=>_transactionSort=="value"?-TransactionValue(r):0).ThenByDescending(r=>r.Date).ToList(); private (string,string)[] MarketMetrics=>[("Tracked market cap",Compact(_source.Assets.Sum(a=>a.MarketCap*1e6))),("Sample 24h volume",Compact(_source.Assets.Sum(a=>a.Volume*1e6))),("Advancing assets",$"{_source.Assets.Count(a=>a.Change>0)} / {_source.Assets.Length}"),("Watchlist assets",_favorites.Count.ToString())]; private (string,string)[] TransactionMetrics=>[("Transactions in view",Records.Count.ToString()),("Completed records",Records.Count(r=>r.Status=="Completed").ToString()),("Pending records",Records.Count(r=>r.Status=="Pending").ToString()),("Illustrative value",Money(Records.Where(r=>r.Status!="Failed").Sum(TransactionValue)))]; private (string,string)[] QuoteRows=>[("Source price",Money(Source.Price)),("Destination price",Money(Target.Price)),("Input value",Money(Gross)),("Sample fee (0.25%)",Money(Fee)),("After fee",Money(Gross-Fee))]; protected override void OnInitialized()=>Refresh(); private void Refresh(){_history=CryptoDashboardCalculator.History(ChartAsset,_range);_chartData=new{Asset=ChartAsset,Range=_range,History=_history,Holdings=Total,Assets=_source.Assets};} private static string Money(double n)=>n.ToString("C2",English); private static string Pct(double n)=>n.ToString("F1",English); private static string Compact(double n)=>n>=1e12?(n/1e12).ToString("0.#",English)+"T":n>=1e9?(n/1e9).ToString("0.#",English)+"B":n>=1e6?(n/1e6).ToString("0.#",English)+"M":n>=1e3?(n/1e3).ToString("0.#",English)+"K":n.ToString("0.#",English); private double TransactionValue(CryptoActivity r)=>r.Amount*_source.Assets.FirstOrDefault(a=>a.Symbol==r.Asset)?.Price??0; private void Toggle(string symbol){if(!_favorites.Remove(symbol))_favorites.Add(symbol);} private void Reverse(){(_from,_to)=(_to,_from);_amount="";} private async Task Export(){_download??=await JS.InvokeAsync<IJSObjectReference>("import","./theme/dashboard-download.js");var rows=Kind=="transactions"?"ID,Asset,Type,Amount,Status,Date"+string.Concat(Records.Select(r=>$"\n{r.Id},{r.Asset},{r.Type},{r.Amount.ToString(English)},{r.Status},{r.Date}")):"Asset,Name,Sample price USD,Holding,Value USD"+string.Concat(VisibleAssets.Select(a=>$"\n{a.Symbol},{a.Name},{a.Price.ToString(English)},{a.Holding.ToString(English)},{(a.Holding*a.Price).ToString(English)}"));var quote=((char)34).ToString();var quoted=string.Join("\r\n",rows.Split('\n').Select(row=>string.Join(',',row.Split(',').Select(v=>quote+v.Replace(quote,quote+quote)+quote))));await _download.InvokeVoidAsync("csv",$"crypto-{Kind}.csv",quoted);Snackbar.Add("Crypto export downloaded",Severity.Success);} private async Task AssetDetail(CryptoAsset a){var dialog=await Dialogs.ShowAsync<CryptoDetailsDialog>("",new DialogParameters<CryptoDetailsDialog>{{d=>d.Asset,a},{d=>d.Wallet,Kind=="wallet"},{d=>d.Total,Total}},new DialogOptions{CloseButton=true,FullWidth=true,MaxWidth=MaxWidth.Small});var result=await dialog.Result;if(result is {Canceled:false}){_chartSymbol=a.Symbol;Refresh();}}
private async Task TransactionDetail(CryptoActivity r)=>await Dialogs.ShowAsync<CryptoDetailsDialog>("",new DialogParameters<CryptoDetailsDialog>{{d=>d.Activity,r},{d=>d.Asset,_source.Assets.Single(a=>a.Symbol==r.Asset)}},new DialogOptions{CloseButton=true,FullWidth=true,MaxWidth=MaxWidth.Small});
private async Task Preview()=>await Dialogs.ShowAsync<CryptoDetailsDialog>("",new DialogParameters<CryptoDetailsDialog>{{d=>d.Preview,true},{d=>d.Pay,_amount+" "+_from},{d=>d.Receive,Receive.ToString("F6",English)+" "+_to},{d=>d.Fee,Fee}},new DialogOptions{CloseButton=true,FullWidth=true,MaxWidth=MaxWidth.Small});
public async ValueTask DisposeAsync(){if(_download is not null)try{await _download.DisposeAsync();}catch(JSDisconnectedException){}} }
