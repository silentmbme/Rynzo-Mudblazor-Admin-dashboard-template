@using System.Globalization
@using Rynzo.Client.Features.Projects.Models
@using Rynzo.Client.Theme
@using Rynzo.Client.Assets
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="projects-page">
    @if (Mode == "detail")
    {
        <div class="project-detail-workspace">
        <PageHeader Title="Website Redesign" Description="PRJ-1048 / Nexora customer experience program"><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("ArrowLeft")" Href="/projects/list">All projects</MudButton><MudButton Variant="@(Following?Variant.Outlined:Variant.Filled)" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Bell")" OnClick="ToggleFollowing">@(Following?"Following":"Follow project")</MudButton></Actions></PageHeader>
        <section class="pd-hero"><div class="pd-hero-main"><div class="pd-reference"><span>PRJ-1048</span><i></i>Nexora <span class="pd-active">Active</span><span class="pd-health"><i></i>Healthy</span></div><h2>A better digital experience,<br />built together.</h2><p>A focused redesign program for the Nexora customer experience.</p><div class="pd-hero-team"><div class="pd-avatar-stack">@foreach(var member in Team.Take(4)){<img src="@Photo(member.Name)" alt="@member.Name" title="@member.Name" />}</div><span>4 people bringing this project to life</span></div></div><div class="pd-hero-progress"><span class="pd-eyebrow">DELIVERY SNAPSHOT</span><div class="pd-percent"><b>82<span>%</span></b><span>Project progress</span></div><div class="pd-progress-track"><i style="width:82%"></i></div><div class="pd-hero-due"><span><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />Target launch</span><b>Sep 10</b></div><div class="pd-hero-owner"><img src="@Photo("Sophia Carter")" alt="" /><div><small>Project owner</small><b>Sophia Carter</b></div></div></div></section>
        <div class="pd-metric-strip"><div><span><MudIcon Icon="@RynzoIcons.Get("ListTodo")" /></span><section><small>Tasks complete</small><b>48 <em>/ 62</em></b></section></div><div><span><MudIcon Icon="@RynzoIcons.Get("Users")" /></span><section><small>Team members</small><b>4</b></section></div><div><span><MudIcon Icon="@RynzoIcons.Get("CircleAlert")" /></span><section><small>Open risks</small><b>3</b></section></div><div><span><MudIcon Icon="@RynzoIcons.Get("Wallet")" /></span><section><small>Budget used</small><b>$68K <em>/ $80K</em></b></section></div></div>
        <nav class="pd-tabs" aria-label="Project sections" role="tablist">@foreach(var tab in DetailTabs.Select((label,index)=>(label,index))){<button type="button" role="tab" id="@($"project-tab-{tab.index}")" aria-selected="@(DetailTab==tab.index)" aria-controls="project-detail-content" class="@(DetailTab==tab.index?"is-active":"")" @onclick="@(()=>DetailTab=tab.index)">@tab.label</button>}</nav>
        <div id="project-detail-content" role="tabpanel" aria-labelledby="@($"project-tab-{DetailTab}")">
        @if(DetailTab==0){<div class="pd-overview-grid"><div class="pd-overview-main"><MudCard Class="pd-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="pd-eyebrow">PROJECT BRIEF</span><h3>Overview</h3></div><span class="pd-panel-label">Customer experience</span></header><p class="pd-description">A focused redesign program for the Nexora customer experience.</p><div class="pd-brief-meta"><div><small>Client</small><b>Nexora</b></div><div><small>Project ID</small><b>PRJ-1048</b></div><div><small>Delivery health</small><b class="pd-green">Healthy</b></div></div></MudCard><MudCard Class="pd-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="pd-eyebrow">DELIVERY ROADMAP</span><h3>Milestones</h3></div><span class="pd-panel-label">2 of 3 complete</span></header><div class="pd-milestone-list">@foreach(var milestone in Milestones){<div class="pd-milestone"><span class="pd-milestone-dot @(milestone.Status=="Complete"?"is-complete":"")"><MudIcon Icon="@RynzoIcons.Get(milestone.Status=="Complete"?"Check":"Clock3")" /></span><div><small>@milestone.Due</small><b>@milestone.Title</b><p>@milestone.Note</p></div><span class="pd-milestone-status">@milestone.Status</span></div>}</div></MudCard></div><aside class="pd-overview-aside"><MudCard Class="pd-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="pd-eyebrow">FINANCIAL OVERVIEW</span><h3>Project budget</h3></div><MudIcon Icon="@RynzoIcons.Get("Wallet")" /></header><div class="pd-budget-number"><b>$68,000</b><span>of $80,000 allocated</span></div><div class="pd-progress-track"><i style="width:85%"></i></div><div class="pd-budget-balance"><span>85% utilized</span><b>$12,000 remaining</b></div></MudCard><MudCard Class="pd-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="pd-eyebrow">THE PEOPLE BEHIND IT</span><h3>Project team</h3></div><span class="pd-panel-label">4 members</span></header><div class="pd-team-list">@foreach(var member in Team.Take(4)){<div><img src="@Photo(member.Name)" alt="@member.Name" /><span><b>@member.Name</b><small>@member.Role</small></span></div>}</div><MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="OpenTeam">Manage team</MudButton></MudCard></aside></div>}
        else if(DetailTab==1){<MudCard Class="pd-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="pd-eyebrow">WORK IN PROGRESS</span><h3>Project tasks</h3></div><span class="pd-panel-label">@TaskRows.Length tasks shown</span></header><div class="pd-task-list">@foreach(var task in TaskRows){<div><span class="pd-task-check @(task.Item3?"is-done":"")"><MudIcon Icon="@RynzoIcons.Get(task.Item3?"CircleCheck":"Circle")" /></span><b>@task.Item1</b><span class="pd-task-owner"><img src="@Photo(task.Item2)" alt="" />@task.Item2</span><span class="pd-task-status">@(task.Item3?"Done":"Open")</span></div>}</div></MudCard>}
        else if(DetailTab==2){<MudCard Class="pd-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="pd-eyebrow">DELIVERY ROADMAP</span><h3>All milestones</h3></div><span class="pd-panel-label">3 checkpoints</span></header><div class="pd-milestone-list">@foreach(var milestone in Milestones){<div class="pd-milestone"><span class="pd-milestone-dot @(milestone.Status=="Complete"?"is-complete":"")"><MudIcon Icon="@RynzoIcons.Get(milestone.Status=="Complete"?"Check":"Clock3")" /></span><div><small>@milestone.Due</small><b>@milestone.Title</b><p>@milestone.Note</p></div><span class="pd-milestone-status">@milestone.Status</span></div>}</div></MudCard>}
        else if(DetailTab==3){<MudCard Class="pd-panel pd-files rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><span><MudIcon Icon="@RynzoIcons.Get("Folder")" /></span><h3>Your project files, together.</h3><p>Project files are available through the existing Files workspace.</p><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("ArrowUpRight")" Href="/apps/files">Open Files workspace</MudButton></MudCard>}
        else{<MudCard Class="pd-panel rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header><div><span class="pd-eyebrow">PROJECT HISTORY</span><h3>Recent activity</h3></div></header><div class="pd-activity-list">@foreach(var activity in new[]{("Design review approved","Palette"),("Homepage milestone completed","CircleCheck"),("Project created by Sophia Carter","Plus")}){<div><span><MudIcon Icon="@RynzoIcons.Get(activity.Item2)" /></span><div><b>@activity.Item1</b><small>Website Redesign / PRJ-1048</small></div></div>}</div></MudCard>}
        </div></div>
    }    else if (Mode == "team")
    {
        <div class="project-team-workspace">
        <PageHeader Title="Project team" Description="Connect the right people with the work that matters."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("BriefcaseBusiness")" Href="/projects/list">View projects</MudButton></Actions></PageHeader>
        <MudCard Class="pt-summary rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="pt-summary-heading"><span><MudIcon Icon="@RynzoIcons.Get("Users")" /></span><div><small>PEOPLE &amp; CAPACITY</small><h2>A shared view of your team's capacity.</h2><p>Balance delivery, skills, and availability across projects.</p></div></div><div class="pt-summary-values">@foreach(var metric in new[]{("Team members","42"),("Available now","18"),("Fully allocated","17"),("Need attention","4"),("On leave","3"),("Average utilization","74%")}){<div><small>@metric.Item1</small><b>@metric.Item2</b></div>}</div></MudCard>
        <section class="pt-directory"><header class="pt-directory-header"><div><span class="pt-eyebrow">TEAM DIRECTORY</span><h2>Your people <span>@FilteredTeam.Count() members</span></h2><p>Find expertise. Plan the next step.</p></div><div class="pt-view-switch" role="group" aria-label="Team display"><MudIconButton Icon="@RynzoIcons.Get("LayoutGrid")" Class="@(TeamView=="grid"?"is-active":"")" aria-label="Team grid view" aria-pressed="@(TeamView=="grid")" OnClick="SetGridView" /><MudIconButton Icon="@RynzoIcons.Get("List")" Class="@(TeamView=="list"?"is-active":"")" aria-label="Team list view" aria-pressed="@(TeamView=="list")" OnClick="SetListView" /></div></header><div class="pt-toolbar"><MudTextField T="string" @bind-Value="TeamQuery" Immediate="true" Placeholder="Search people, roles, or skills..." aria-label="Search team" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" Variant="Variant.Outlined" Margin="Margin.Dense" /><select aria-label="Team availability" @bind="Availability"><option>All</option><option>Available</option><option>Partially available</option><option>Fully allocated</option><option>Overloaded</option></select><MudButton Variant="Variant.Text" OnClick="@(()=>{TeamQuery="";Availability="All";})">Reset filters</MudButton><span>@FilteredTeam.Count() sample members</span></div></section>
        @if(TeamView=="grid"){<div class="pt-cards">@foreach(var member in FilteredTeam){var tone=member.Utilization>100?"destructive":member.Availability=="Available"?"success":"primary";<MudCard Class="pt-card rynzo-widget-card" Style="@($"--member-tone:var(--{tone})")" Elevation="0" Outlined="true" data-widget-element="article"><header><span class="pt-department">@member.Department</span><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"View {member.Name}")" OnClick="@(()=>ActiveMember=member)" /></header><button class="pt-member-open" @onclick="@(()=>ActiveMember=member)"><img src="@Photo(member.Name)" alt="@member.Name" /><b>@member.Name</b><small>@member.Role</small></button><span class="pt-availability"><i></i>@member.Availability</span><div class="pt-workload"><div><span>Weekly utilization</span><b>@member.Utilization%</b></div><i><em style="@($"width:{Math.Min(member.Utilization,100)}%")"></em></i><small>@(member.Utilization>100?"Above planned capacity":member.Availability=="Available"?"Capacity for new work":"Current project allocation")</small></div><div class="pt-card-metrics"><div><b>@member.ActiveTasks</b><small>Active tasks</small></div><div><b>@member.Projects.Length</b><small>Projects</small></div></div><div class="pt-skills">@foreach(var skill in member.Skills){<span>@skill</span>}</div><footer><span><MudIcon Icon="@RynzoIcons.Get("BriefcaseBusiness")" />@member.Projects[0]</span><button @onclick="@(()=>ActiveMember=member)">Profile <MudIcon Icon="@RynzoIcons.Get("ChevronRight")" /></button></footer></MudCard>}</div>}
        else{<div class="pt-table-scroll" tabindex="0" aria-label="Team list"><table class="pt-table"><thead><tr><th>Team member</th><th>Department</th><th>Weekly workload</th><th>Availability</th><th>Projects / tasks</th><th>Skills</th><th></th></tr></thead><tbody>@foreach(var member in FilteredTeam){<tr><td><button class="pt-list-person" @onclick="@(()=>ActiveMember=member)"><img src="@Photo(member.Name)" alt="" /><span><b>@member.Name</b><small>@member.Role</small></span></button></td><td>@member.Department</td><td><div class="pt-list-workload"><b>@member.Utilization%</b><i><em style="@($"width:{Math.Min(member.Utilization,100)}%;background:var(--{(member.Utilization>100?"destructive":"primary")})")"></em></i></div></td><td><span class="pt-list-availability">@member.Availability</span></td><td><b>@member.Projects.Length projects</b><small>@member.ActiveTasks active tasks</small></td><td><div class="pt-skills">@foreach(var skill in member.Skills){<span>@skill</span>}</div></td><td><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"View {member.Name}")" OnClick="@(()=>ActiveMember=member)" /></td></tr>}</tbody></table></div>}
        @if(!FilteredTeam.Any()){<div class="pt-empty"><MudIcon Icon="@RynzoIcons.Get("Users")" /><h3>No members match your filters</h3><p>Try another name, role, skill, or availability.</p><MudButton Variant="Variant.Outlined" OnClick="@(()=>{TeamQuery="";Availability="All";})">Reset filters</MudButton></div>}
        <p class="pt-result-count">Showing @FilteredTeam.Count() of @Team.Length sample team members</p>
        </div>
    }    else if (Mode == "list")
    {
        <div class="project-list-workspace">
        <PageHeader Title="Projects" Description="Keep delivery on track, from the first milestone to the finish line."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export projects</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("LayoutGrid")" Href="/projects/grid">Grid view</MudButton></Actions></PageHeader>
        <section class="pl-portfolio"><div class="pl-portfolio-title"><span><MudIcon Icon="@RynzoIcons.Get("BriefcaseBusiness")" /></span><div><small>DELIVERY WORKSPACE</small><h2>Your portfolio, in focus.</h2><p>People, priorities, and progress in one place.</p></div></div><div class="pl-metrics">@foreach(var metric in new[]{("Total projects","148"),("Active","84"),("On track","62"),("At risk","12"),("Delayed","10"),("Completed","42"),("Total budget","$2.84M")}){<MudCard Class="rynzo-widget-card" Elevation="0" Outlined="true"><small>@metric.Item1</small><b>@metric.Item2</b></MudCard>}</div></section>
        <MudCard Class="pl-library rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><header class="pl-library-heading"><div><span class="pl-eyebrow">PROJECT DIRECTORY</span><h2>All projects <span>@VisibleProjects.Count() in view</span></h2><p>Monitor delivery health and the work that matters next.</p></div><span class="pl-session"><i></i>Sample workspace</span></header>
        <nav class="pl-tabs" aria-label="Project statuses"><button class="@(Status=="All statuses"?"is-active":"")" aria-pressed="@(Status=="All statuses")" @onclick="@(()=>Status="All statuses")">All projects <span>@Projects.Length</span></button>@foreach(var status in Projects.Select(p=>p.Status).Distinct()){<button class="@(Status==status?"is-active":"")" aria-pressed="@(Status==status)" @onclick="@(()=>Status=status)">@status <span>@Projects.Count(p=>p.Status==status)</span></button>}</nav>
        <div class="pl-toolbar"><MudTextField T="string" @bind-Value="Query" Immediate="true" Placeholder="Search projects, clients, or people..." aria-label="Search projects" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" Variant="Variant.Outlined" Margin="Margin.Dense" /><div class="pl-filter-fields"><select aria-label="Project status" @bind="Status"><option>All statuses</option>@foreach(var value in Projects.Select(p=>p.Status).Distinct().Order()){<option>@value</option>}</select><select aria-label="Project priority" @bind="Priority"><option>All priorities</option>@foreach(var value in Projects.Select(p=>p.Priority).Distinct().Order()){<option>@value</option>}</select><select aria-label="Project client" @bind="Client"><option>All clients</option>@foreach(var value in Projects.Select(p=>p.Client).Distinct().Order()){<option>@value</option>}</select><select aria-label="Project owner" @bind="Owner"><option>All owners</option>@foreach(var value in Projects.Select(p=>p.Owner).Distinct().Order()){<option>@value</option>}</select><select aria-label="Project risk" @bind="Risk"><option>All risks</option><option>Healthy</option><option>Watch</option><option>At Risk</option></select><MudButton Variant="Variant.Text" OnClick="Reset">Reset filters</MudButton></div></div>
        <div class="pl-table-scroll" tabindex="0" aria-label="Project list"><table class="pl-table"><thead><tr><th>Project / client</th><th>Owner</th><th>Delivery progress</th><th>Budget utilization</th><th>Due date</th><th>Health / status</th><th><span class="pl-sr-only">Actions</span></th></tr></thead><tbody>@foreach(var project in VisibleProjects){<tr @key="project.Id"><td><div class="pl-project-identity"><span class="pl-project-symbol"><MudIcon Icon="@RynzoIcons.Get(project.Tags.Contains("Design")?"Palette":project.Tags.Contains("Mobile")?"Smartphone":"Layers")" /></span><div><button class="pl-project-open" @onclick="@(()=>ActiveProject=project)">@project.Name</button><small>@project.Id <i>/</i> @project.Client</small><div class="pl-project-tags"><span class="pl-priority @(project.Priority=="Critical"?"is-critical":"")">@project.Priority</span>@foreach(var tag in project.Tags){<span>@tag</span>}</div></div></div></td><td><div class="pl-owner"><img src="@Photo(project.Owner)" alt="" /><span>@project.Owner</span></div></td><td><div class="pl-progress"><span><b>@project.Progress%</b><small>@project.Tasks tasks</small></span><i><em style="@($"width:{project.Progress}%")"></em></i></div></td><td><div class="pl-budget"><b>@Money(project.Spent) <small>/ @Money(project.Budget)</small></b><span>@Math.Round(project.Spent/project.Budget*100)% used</span></div></td><td><span class="pl-due"><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />@project.Due</span></td><td><div class="pl-statuses"><span class="pl-health" style="@($"--health-tone:var(--{(project.Risk=="Healthy"?"success":project.Risk=="At Risk"?"destructive":"warning")})")"><i></i>@project.Risk</span><span class="pl-status">@project.Status</span></div></td><td><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"View {project.Name}")" OnClick="@(()=>ActiveProject=project)" /></td></tr>}</tbody></table></div>
        @if(!VisibleProjects.Any()){<div class="pl-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No projects match your filters</h3><p>Try another search or reset the filters.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}
        <footer class="pl-footer"><span>Showing @VisibleProjects.Count() of @Projects.Length sample projects</span><span><i></i>Progress and budget at a glance</span></footer>
        </MudCard>
        </div>
    }
    else if (Mode == "grid")
    {
        <div class="project-grid-workspace">
        <PageHeader Title="Project grid" Description="A clearer view of your projects, people, and delivery priorities."><Actions><MudButton Variant="Variant.Outlined" StartIcon="@RynzoIcons.Get("Download")" OnClick="Export">Export projects</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("List")" Href="/projects/list">List view</MudButton></Actions></PageHeader>
        <MudCard Class="pg-summary rynzo-widget-card" Elevation="0" Outlined="true" data-widget-element="section"><div class="pg-summary-title"><span><MudIcon Icon="@RynzoIcons.Get("LayoutGrid")" /></span><div><small>PORTFOLIO SNAPSHOT</small><h2>Great work starts with a clear view.</h2></div></div><div class="pg-summary-values">@foreach(var metric in new[]{("Total projects","148"),("Active","84"),("On track","62"),("At risk","12"),("Delayed","10"),("Completed","42"),("Total budget","$2.84M")}){<div><small>@metric.Item1</small><b>@metric.Item2</b></div>}</div></MudCard>
        <section class="pg-controls"><div class="pg-controls-heading"><div><h2>Your projects <span>@VisibleProjects.Count()</span></h2><p>Follow progress. Keep your team aligned.</p></div><MudTextField T="string" @bind-Value="Query" Immediate="true" Placeholder="Search projects, clients, or people..." aria-label="Search grid projects" Adornment="Adornment.Start" AdornmentIcon="@RynzoIcons.Get("Search")" Variant="Variant.Outlined" Margin="Margin.Dense" /></div><div class="pg-filters"><select aria-label="Grid project status" @bind="Status"><option>All statuses</option>@foreach(var value in Projects.Select(p=>p.Status).Distinct().Order()){<option>@value</option>}</select><select aria-label="Grid project priority" @bind="Priority"><option>All priorities</option>@foreach(var value in Projects.Select(p=>p.Priority).Distinct().Order()){<option>@value</option>}</select><select aria-label="Grid project client" @bind="Client"><option>All clients</option>@foreach(var value in Projects.Select(p=>p.Client).Distinct().Order()){<option>@value</option>}</select><select aria-label="Grid project owner" @bind="Owner"><option>All owners</option>@foreach(var value in Projects.Select(p=>p.Owner).Distinct().Order()){<option>@value</option>}</select><select aria-label="Grid project risk" @bind="Risk"><option>All risks</option><option>Healthy</option><option>Watch</option><option>At Risk</option></select><MudButton Variant="Variant.Text" OnClick="Reset">Reset filters</MudButton></div></section>
        <div class="pg-cards">@foreach(var project in VisibleProjects){var healthTone=project.Risk=="Healthy"?"success":project.Risk=="At Risk"?"destructive":"warning";<MudCard @key="project.Id" Class="pg-card rynzo-widget-card" Style="@($"--project-health:var(--{healthTone})")" Elevation="0" Outlined="true" data-widget-element="article"><header><span class="pg-project-icon"><MudIcon Icon="@RynzoIcons.Get(project.Tags.Contains("Design")?"Palette":project.Tags.Contains("Mobile")?"Smartphone":"Layers")" /></span><span class="pg-health"><i></i>@project.Risk</span><MudIconButton Icon="@RynzoIcons.Get("ArrowUpRight")" aria-label="@($"View {project.Name}")" OnClick="@(()=>ActiveProject=project)" /></header><div class="pg-card-body"><small class="pg-reference">@project.Id <span>/</span> @project.Client</small><button class="pg-project-open" @onclick="@(()=>ActiveProject=project)">@project.Name</button><div class="pg-tags"><span class="pg-priority @(project.Priority=="Critical"?"is-critical":"")">@project.Priority priority</span>@foreach(var tag in project.Tags){<span>@tag</span>}</div><div class="pg-progress"><div><span>Delivery progress</span><b>@project.Progress%</b></div><i><em style="@($"width:{project.Progress}%")"></em></i><small>@project.Tasks tasks complete</small></div><div class="pg-financials"><div><small>Budget used</small><b>@Money(project.Spent)</b><span>of @Money(project.Budget)</span></div><div><small>Target date</small><b><MudIcon Icon="@RynzoIcons.Get("CalendarDays")" />@project.Due</b><span>@project.Status</span></div></div></div><footer><div class="pg-owner"><img src="@Photo(project.Owner)" alt="" /><span><small>Project owner</small><b>@project.Owner</b></span></div><div class="pg-team" aria-label="Project team">@foreach(var initials in project.Team){var memberName=ProjectMemberName(initials);<img src="@Photo(memberName)" alt="@memberName" title="@memberName" />}</div></footer></MudCard>}</div>
        @if(!VisibleProjects.Any()){<div class="pg-empty"><MudIcon Icon="@RynzoIcons.Get("Search")" /><h3>No projects match your filters</h3><p>Try another search or reset the filters.</p><MudButton Variant="Variant.Outlined" OnClick="Reset">Reset filters</MudButton></div>}
        <p class="pg-result-count">Showing @VisibleProjects.Count() of @Projects.Length sample projects</p>
        </div>
    }
</div>
@if (ActiveProject is { } selectedProject)
{
    <MudDrawer Open="true" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="560px" Style="max-width:100vw;background:var(--card);overflow-y:auto">
        <div class="drawer-content"><MudIconButton Icon="@RynzoIcons.Get("X")" OnClick="CloseProject" Class="close-button" /><MudChip T="string" Color="@StatusColor(selectedProject.Status)" Size="Size.Small">@selectedProject.Status</MudChip><MudText Typo="Typo.h4">@selectedProject.Name</MudText><MudText Class="muted">@selectedProject.Id · @selectedProject.Client</MudText><MudProgressLinear Value="@selectedProject.Progress" Color="Color.Primary" Rounded="true" Class="drawer-progress" /><div class="detail-stats"><Metric Label="Budget used" Value="@Money(selectedProject.Spent)" /><Metric Label="Due date" Value="@selectedProject.Due" /><Metric Label="Open tasks" Value="@selectedProject.Tasks" /></div><MudText Typo="Typo.h6" Class="section-title">Project team</MudText><div class="inner-card">@foreach(var member in Team.Take(4)){<div class="member-row"><img class="project-avatar small" src="@Photo(member.Name)" alt="@member.Name" /><span><b>@member.Name</b><small>@member.Email</small></span></div>}<MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OpenTeam">Manage</MudButton></div><MudText Typo="Typo.h6" Class="section-title">Tags</MudText><div class="tag-row">@foreach(var tag in selectedProject.Tags){<MudChip T="string" Size="Size.Small">@tag</MudChip>}</div></div>
    </MudDrawer>
}
