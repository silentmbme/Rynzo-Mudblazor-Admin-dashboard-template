@using Rynzo.Client.Theme
<MudDialog Style="width:min(576px,100vw);max-width:576px;max-height:calc(100dvh - 8px);overflow-y:auto" aria-label="Compose email"><TitleContent><div class="d-flex justify-space-between align-center"><MudText Typo="Typo.h6" HtmlTag="h2">New message</MudText><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Close">Close</MudButton></div></TitleContent><DialogContent><MudTextField T="string" @bind-Value="_to" Placeholder="To" InputType="InputType.Email" aria-label="To" Variant="Variant.Outlined" /><MudTextField T="string" @bind-Value="_subject" Placeholder="Subject" aria-label="Subject" Variant="Variant.Outlined" Class="mt-3" /><MudTextField T="string" @bind-Value="_body" Placeholder="Write your message..." aria-label="Write your message" Lines="6" Variant="Variant.Outlined" Class="mt-3" /><div class="d-flex justify-space-between flex-wrap gap-3 mt-3"><MudButton Variant="Variant.Outlined" OnClick="Close">Save draft</MudButton><div class="d-flex gap-2"><MudButton Variant="Variant.Text" OnClick="Close">Discard</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@RynzoIcons.Get("Send")" OnClick="Close">Send</MudButton></div></div></DialogContent></MudDialog>
@code{[CascadingParameter]public IMudDialogInstance Dialog{get;set;}=null!;private string _to="",_subject="",_body="";private void Close()=>Dialog.Close(DialogResult.Ok(true));}
