@using Rynzo.Client.Features.Mail.Models
@using Rynzo.Client.Theme
<article class="mail-details" role="dialog" aria-modal="true" aria-label="Email details"><header><div><p>Mail details</p><strong>@Message.Subject</strong></div><div><MudIconButton Icon="@RynzoIcons.Get("Star")" Color="@(Starred?Color.Warning:Color.Default)" aria-label="@(Starred?"Remove star":"Star email")" OnClick="@(() => ToggleStar.InvokeAsync())" /><MudIconButton Icon="@RynzoIcons.Get("MoreHorizontal")" aria-label="More email actions" title="More actions" /><MudIconButton Icon="@RynzoIcons.Get("X")" aria-label="Close email details" title="Close" OnClick="@(() => Close.InvokeAsync())" /></div></header><div class="mail-detail-body"><div class="mail-sender-row"><div><MudAvatar><MudImage Src="@Message.Portrait" Alt="" /></MudAvatar><div><div class="mail-sender-name"><b>@Message.Sender</b><MudChip T="string" Color="Color.Success" Size="Size.Small">Verified sender</MudChip></div><p>@Message.Address</p><button type="button">to avery@rynzo.example <MudIcon Icon="@RynzoIcons.Get("ChevronRight")" /></button></div></div><aside><b>@Message.Time</b><p>Inbox</p></aside></div><section class="mail-subject"><div><MudChip T="string" Color="Color.Primary" Size="Size.Small">Inbox</MudChip><MudChip T="string" Size="Size.Small">Unread</MudChip></div><h2>@Message.Subject</h2><p>@Message.Preview</p></section><div class="mail-letter"><p>Hi Avery,</p><p>I wanted to share the latest update and make sure you have the context needed for the next step. The details are ready for review, and the team is available if you would like to discuss them.</p><p>Please let us know if there are any questions or if another follow-up would be helpful.</p><p>Thanks,<br /><b>@Message.Sender</b></p></div>@if(Message.Index==0){<section class="mail-attachment" aria-label="Email attachment"><span><MudIcon Icon="@RynzoIcons.Get("FileText")" /></span><div><b>q3-design-review.pdf</b><p>PDF document - 2.4 MB</p></div><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@RynzoIcons.Get("Download")" aria-label="Download attachment">Download</MudButton></section>}<section class="mail-quick-reply" aria-label="Quick reply"><h3><MudIcon Icon="@RynzoIcons.Get("Reply")" />Quick reply</h3><MudTextField T="string" Value="@QuickReply" ValueChanged="QuickReplyChanged" Immediate="true" Placeholder="@($"Reply to {Message.Sender}...")" aria-label="Quick reply text" Lines="4" Variant="Variant.Outlined" /><div class="mail-quick-reply-actions"><MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@RynzoIcons.Get("Paperclip")" aria-label="Add attachment">Attach</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@RynzoIcons.Get("Send")" Disabled="@(string.IsNullOrWhiteSpace(QuickReply))" OnClick="@(() => QuickReplyChanged.InvokeAsync(""))">Send reply</MudButton></div></section></div><footer><div><MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@RynzoIcons.Get("Archive")" title="Archive email">Archive</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@RynzoIcons.Get("Trash2")" title="Delete email">Delete</MudButton></div><div><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@RynzoIcons.Get("Forward")" OnClick="@(() => Compose.InvokeAsync())">Forward</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@RynzoIcons.Get("Reply")" OnClick="@(() => Compose.InvokeAsync())">Reply</MudButton></div></footer></article>
@code{[Parameter,EditorRequired]public MailMessage Message{get;set;}=null!;[Parameter]public bool Starred{get;set;}[Parameter]public string QuickReply{get;set;}="";[Parameter]public EventCallback<string> QuickReplyChanged{get;set;}[Parameter]public EventCallback ToggleStar{get;set;}[Parameter]public EventCallback Close{get;set;}[Parameter]public EventCallback Compose{get;set;}}


