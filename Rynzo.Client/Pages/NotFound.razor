@page "/not-found"
@page "/auth/errors/404"
@layout MainLayout
<PageTitle>404 · Page not found | Rynzo</PageTitle>
<main class="not-found-page" aria-labelledby="not-found-title">
    <header class="not-found-header"><span>RYNZO WORKSPACE</span><span class="route-label">404 / PAGE NOT FOUND</span></header>
    <div class="not-found-map" aria-hidden="true">
        <div class="map-grid"></div>
        <svg class="route-map" viewBox="0 0 640 280" fill="none">
            <path class="map-street" d="M0 65H640M0 215H640M120 0V280M500 0V280M230 0V70L410 215V280M0 140H125L245 240H640" />
            <rect class="map-block" x="142" y="15" width="61" height="32" rx="6"/><rect class="map-block" x="20" y="162" width="75" height="32" rx="6"/><rect class="map-block" x="528" y="88" width="80" height="54" rx="8"/><rect class="map-block" x="422" y="20" width="54" height="28" rx="6"/>
            <path class="map-trail" d="M80 216H173Q188 216 188 200V123Q188 109 204 109H275" />
            <circle cx="80" cy="216" r="7" class="map-start"/><circle cx="80" cy="216" r="15" class="map-start-ring"/>
            <path class="map-missing" d="M370 109H444Q458 109 458 95V65"/><circle cx="458" cy="65" r="5" class="map-end"/>
        </svg>
        <div class="destination-pin"><MudIcon Icon="@Icons.Material.Outlined.WrongLocation" /></div>
        <div class="map-tag tag-start"><span></span>Your workspace</div><div class="map-tag tag-end">Destination not found</div>
        <div class="map-coordinate"><span>WORKSPACE MAP</span><i></i><span>UNMAPPED ROUTE</span></div>
    </div>
    <section class="not-found-copy">
        <div class="not-found-code">404</div>
        <h1 id="not-found-title">Looks like you've taken<br class="desktop-break" /> a wrong turn.</h1>
        <p>This page may have moved, the link may be outdated, or the address may be incomplete. Let's get you back to familiar ground.</p>
        <Rynzo.Client.Components.Common.ErrorRecoveryActions Code="404" />
    </section>
    <footer class="not-found-footer"><MudIcon Icon="@Icons.Material.Outlined.Explore" /><span>Find your next destination in the sidebar, or return to your dashboard.</span></footer>
</main>
