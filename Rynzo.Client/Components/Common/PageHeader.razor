<div class="mb-6 rynzo-page-header">
    <Rynzo.Client.Features.Dashboard.Components.DashboardPageHeader Title="@Title" Description="@Description" Actions="Actions" />
</div>
@code {
    // Retained for existing callers; all page headings now use the dashboard pattern.
    [Parameter] public IReadOnlyList<BreadcrumbItem>? Breadcrumbs { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
